{
 "_readme": "Source of truth for the mobile icon set. Run `npm ci && npm run generate` in scripts/icons after editing. Sizes are the SVG width/height in dp; groups are the IconPark colour slots (outer stroke, external fill, internal outline, internal fill) for Multicolor, or the single colour for linear. Material entries are tinted with `fill`. An entry with `solid` true has the shapes IconPark left hollow filled with the group’s external-fill slot, for glyphs whose template fills nothing and would otherwise read as a wire outline. Not generated: the vendor sign-in marks, the splash gradient, the monochrome Android notification icon, the bottom-nav tab icons, icon_chatbot.svg, which is the 240dp chat launcher illustration rather than an icon, and the two icon_caret_down files, a bespoke 18x9 chevron matched to the filter chips, which render it at 14x7 and leave no square glyph legible.",
 "iconpark": {
  "package": "@icon-park/svg",
  "version": "1.4.2",
  "strokeWidth": 2,
  "strokeLinecap": "round",
  "strokeLinejoin": "round",
  "badge": {
   "scale": 0.625,
   "x": 17,
   "y": 2,
   "baseScale": 0.74,
   "baseY": 12.5,
   "note": "Composes two glyphs into one file: the badge at scale in the top-right, drawn solid in ink behind the subject, which is drawn at baseScale anchored bottom-left over it. x and y anchor the badge inside the 48-unit box and have to move with scale.",
   "ink": "#1884DC",
   "strokeWidth": 1,
   "solid": true
  },
  "note": "strokeWidth is on the 48-unit grid: 2 = 1px at 24dp. The hand-drawn set used 2px; the thinner stroke is what takes the hard edge off the four-colour glyphs."
 },

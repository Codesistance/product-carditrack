  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.DataProtection.Repositories.FileSystemXmlRepository": "Error",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Apm": {
    "Engine": "",
    "Data": {
      "IngestUrl": "",
      "IngestToken": ""
    },
    "MinimumLogLevel": "Warning",
    "TracesSampleRatio": 0.2

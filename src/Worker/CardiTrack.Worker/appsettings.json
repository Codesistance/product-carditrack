{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Encryption": {
    "Key": ""
  },
  "DeviceProviders": [
    {
      "Provider": "Fitbit",
      "ClientId": "",
      "ClientSecret": "",

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Core\CardiTrack.Application\CardiTrack.Application.csproj" />
    <ProjectReference Include="..\..\Core\CardiTrack.Domain\CardiTrack.Domain.csproj" />
    <ProjectReference Include="..\CardiTrack.Shared\CardiTrack.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FcmNotificationChannel's payload builder is internal — the privacy invariant (no PHI in
         the FCM request body) is worth testing directly rather than through the FirebaseAdmin SDK. -->
    <InternalsVisibleTo Include="CardiTrack.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.40.0" />
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
    <!-- Explicit, though FirebaseAdmin already drags it in transitively: MedGemmaIdentityTokenHandler
         mints the OIDC token that Cloud Run's IAM check requires, so this is load-bearing for the
         medical inference path. A transitive reference would let a future FirebaseAdmin bump or
         removal break MedGemma auth as a side effect. -->
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <!-- Member profile photos live in a private GCS bucket, served via short-lived V4 signed
         URLs; the client is confined to GcsProfilePhotoStorage (architecture test). -->
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.15.0" />
    <!-- Re-encodes uploaded photos (validate, downscale, strip EXIF/GPS) before storage.
         In-process; no network; not a subprocessor. Confined to ImageSharpProfilePhotoProcessor.
         Pinned to the 3.x line deliberately: 4.x moved to a paid Six Labors license and its
         missing-license-key MSBuild warning would break the warning-free build gate. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!-- In-process numerical engine for SSA (symmetric EVD) and descriptive statistics.
         MIT; no network; not a subprocessor. See docs/technical/mathnet_numerics.md. -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

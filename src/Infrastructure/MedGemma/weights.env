# Where the vendored MedGemma weights come from, and where we keep our own copy.
# Read by scripts/fetch-medgemma-weights.sh and both MedGemma workflows. Every file this names
# must have a line in weights.sha256 beside it; the hash is the pin, this is the provenance.
HF_REPO=unsloth/medgemma-1.5-4b-it-GGUF
HF_REVISION=3855f948626b7ae42bccd082757f15078c53e758
GCS_BUCKET=carditrack-common-model-weights
GCS_PREFIX=medgemma-1.5-4b-it

{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=carditrack;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Auth0": {
    "Domain": "YOUR_AUTH0_DOMAIN.us.auth0.com",
    "Audience": "https://api.carditrack.com",
    "ClientId": "YOUR_CLIENT_ID",
    "ClientSecret": "YOUR_CLIENT_SECRET",
    "CallbackUrl": "https://localhost:7001/api/auth/callback",
    "LogoutUrl": "https://localhost:7001/"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7002",
      "http://localhost:3000"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "CardiTrack.Infrastructure.ExternalClients.Medical": "Information",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.DataProtection.KeyManagement.XmlKeyManager": "Error",
        "Microsoft.AspNetCore.DataProtection.Repositories.FileSystemXmlRepository": "Error",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Apm": {
    "Engine": "",
    "Data": {
      "IngestUrl": "",
      "IngestToken": ""
    },
    "TracesSampleRatio": 1.0
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 1000
      },
      {
        "Endpoint": "*:/api/v1/auth/resend-verification",
        "Period": "1h",
        "Limit": 5
      },
      {
        "Endpoint": "*:/api/v1/notifications/*/delivered",
        "Period": "1m",
        "Limit": 20
      },
      {
        "Endpoint": "post:/api/v1/member-chat/members/*/messages",
        "Period": "1m",
        "Limit": 6
      },
      {
        "Endpoint": "post:/api/v1/member-chat/members/*/messages",
        "Period": "1h",
        "Limit": 30
      }
    ]
  },
  "Encryption": {
    "Key": ""
  },
  "Storage": {
    "MemberPhotos": {
      "Bucket": ""
    }
  },
  "DeviceProviders": [
    {
      "Provider": "GoogleHealth",
      "DeviceTypes": ["Fitbit", "GooglePixelWatch"],
      "ClientId": "YOUR_GOOGLE_OAUTH_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_OAUTH_CLIENT_SECRET",
      "AuthorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
      "TokenUrl": "https://oauth2.googleapis.com/token",
      "ApiBaseUrl": "https://health.googleapis.com",
      "Scopes": [
        "https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly",
        "https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly",
        "https://www.googleapis.com/auth/googlehealth.sleep.readonly",
        "https://www.googleapis.com/auth/googlehealth.settings.readonly"
      ],
      "RedirectUri": "https://localhost:7001/api/v1/oauth/redirect/fitbit",
      "AdditionalAuthorizationParams": {
        "access_type": "offline"
      },
      "FirstConsentAuthorizationParams": {
        "prompt": "consent"
      },
      "TokenLifetimeHours": 1
    },
    {
      "Provider": "GarminConnect",
      "DeviceTypes": ["Garmin"],
      "ClientId": "YOUR_GARMIN_CLIENT_ID",
      "ClientSecret": "YOUR_GARMIN_CLIENT_SECRET",
      "AuthorizationUrl": "https://connect.garmin.com/oauthConfirm",
      "TokenUrl": "https://connectapi.garmin.com/oauth-service/oauth/token",
      "ApiBaseUrl": "https://apis.garmin.com",
      "Scopes": [ "HEALTH_API" ],
      "RedirectUri": "",
      "TokenLifetimeHours": 3600
    },
    {
      "Provider": "Withings",
      "DeviceTypes": ["Withings"],
      "ClientId": "YOUR_WITHINGS_CLIENT_ID",
      "ClientSecret": "YOUR_WITHINGS_CLIENT_SECRET",
      "AuthorizationUrl": "https://account.withings.com/oauth2_user/authorize2",
      "TokenUrl": "https://wbsapi.withings.net/v2/oauth2",
      "ApiBaseUrl": "https://wbsapi.withings.net",
      "Scopes": [ "user.metrics", "user.activity" ],
      "RedirectUri": "",
      "TokenLifetimeHours": 3
    },
    {
      "Provider": "Oura",
      "DeviceTypes": ["Oura"],
      "ClientId": "YOUR_OURA_CLIENT_ID",
      "ClientSecret": "YOUR_OURA_CLIENT_SECRET",
      "AuthorizationUrl": "https://cloud.ouraring.com/oauth/authorize",
      "TokenUrl": "https://api.ouraring.com/oauth/token",
      "ApiBaseUrl": "https://api.ouraring.com",
      "Scopes": [ "daily", "heartrate", "sleep" ],
      "RedirectUri": "",
      "TokenLifetimeHours": 24
    },
    {
      "Provider": "Whoop",
      "DeviceTypes": ["Whoop"],
      "ClientId": "YOUR_WHOOP_CLIENT_ID",
      "ClientSecret": "YOUR_WHOOP_CLIENT_SECRET",
      "AuthorizationUrl": "https://api.prod.whoop.com/oauth/oauth2/auth",
      "TokenUrl": "https://api.prod.whoop.com/oauth/oauth2/token",
      "ApiBaseUrl": "https://api.prod.whoop.com",
      "Scopes": [ "read:recovery", "read:cycles", "read:sleep", "read:body_measurement" ],
      "RedirectUri": "",
      "TokenLifetimeHours": 24
    }
  ],
  "AI": {
    "Public": {
      "Kind": "Gemini",
      "Model": "gemini-2.0-flash",
      "ApiKey": "unset-local-placeholder",
      "BaseUrl": "",
      "TimeoutSeconds": 60,
      "MaxOutputTokens": 16000
    },
    "Private": {
      "Model": "hf.co/unsloth/medgemma-1.5-4b-it-GGUF:Q4_K_M",
      "BaseUrl": "http://localhost:11434",
      "TimeoutSeconds": 300,
      "UseIdentityToken": false,
      "WarmUpEnabled": true,
      "WarmUpMinimumIntervalSeconds": 300
    },
    "Rewrite": {
      "Kind": "Ollama",
      "Model": "gemma3:4b-it-qat",
      "BaseUrl": "http://localhost:11434",
      "TimeoutSeconds": 300,
      "UseIdentityToken": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

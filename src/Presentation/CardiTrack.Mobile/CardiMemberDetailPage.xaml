<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.CardiMemberDetailPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- Same root as the tab pages: top keeps the inset the header band is drawn against;
         bottom releases it so BottomNavBar can claim it and run white to the screen edge.
         Without this the page kept the bottom inset itself and the bar sat 14dp higher than on
         the tabs, floating on a strip of page ground with the gesture pill on it. -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto" SafeAreaEdges="None, Container, None, None">

        <!-- ════════════════════════════════════════
             GRADIENT HEADER — the app-wide band (Controls/HeaderBand).
             ════════════════════════════════════════ -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <!-- Fill + width-bound-to-height: the circle runs from the title's top to
                         the description's bottom and stays square at whatever that is, so every
                         header's icon matches its own text block exactly. The 40 floor keeps the
                         back button a real tap target; 99 clamps to a circle at any size. -->
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <ImageButton Source="icon_back_white.svg"
                                 WidthRequest="20" HeightRequest="20"
                                 BackgroundColor="Transparent"
                                 Clicked="OnBackClicked"/>
                </controls:SquareBorder>

                <!-- Title with what the page is tight beneath it — one stack, top-aligned
                     with the icon. The description is declared after the title, so screen
                     readers announce them in reading order. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Member Details"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label Text="Here is what we know"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <!-- Alerts and Edit, icon-only. Alerts was a full-width "View Alerts" button
                     halfway down the page; it is navigation, not a setting, and it belongs beside
                     the other way out of this screen rather than competing with the member's own
                     details for the middle of the page. -->
                <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Start">
                    <Border WidthRequest="40" HeightRequest="40"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource White}"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <ImageButton Source="icon_bell.svg"
                                     WidthRequest="20" HeightRequest="20"
                                     BackgroundColor="Transparent"
                                     SemanticProperties.Description="View alerts"
                                     SemanticProperties.Hint="Opens the alerts list"
                                     Clicked="OnViewAlertsClicked"/>
                    </Border>

                    <!-- Named on the Border, not the button inside it: hiding the button alone
                         left its white chip behind as an empty square for everyone who isn't the
                         primary caregiver. -->
                    <Border x:Name="EditButton"
                            WidthRequest="40" HeightRequest="40"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource White}"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <ImageButton Source="icon_edit.svg"
                                     WidthRequest="20" HeightRequest="20"
                                     BackgroundColor="Transparent"
                                     SemanticProperties.Description="Edit member"
                                     Clicked="OnEditClicked"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <!-- ════════════════════════════════════════
             CONTENT
             ════════════════════════════════════════ -->
        <RefreshView x:Name="Refresher"
                     Grid.Row="1"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView x:Name="DetailScroller">
                <Grid Padding="20,16,20,28">

                    <!-- ── Loading ── -->
                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                        <controls:SkeletonView HeightRequest="110"/>
                        <controls:SkeletonView HeightRequest="150"/>
                        <controls:SkeletonView HeightRequest="110"/>
                        <controls:SkeletonView HeightRequest="60"/>
                    </VerticalStackLayout>

                    <!-- ── Error ── -->
                    <VerticalStackLayout x:Name="ErrorPanel"
                                         Spacing="10"
                                         IsVisible="False"
                                         Padding="0,60,0,0">
                        <Label Text="We couldn't load these details"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="ErrorDetailLabel"
                               Style="{StaticResource Body2}"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="Try again"
                                Style="{StaticResource SecondaryOutlineButton}"
                                HorizontalOptions="Center"
                                Clicked="OnRetryClicked"/>
                    </VerticalStackLayout>

                    <!-- ── Loaded ── -->
                    <VerticalStackLayout x:Name="ContentPanel" Spacing="14" IsVisible="False">

                        <controls:OfflineStatusBanner x:Name="OfflineBanner"/>

                        <!-- Profile: name, age/relationship, then the data-pipeline freshness
                             dot + last-contact age. Three rows next to the avatar, so the
                             display picture is a step larger than the default 64 so it still
                             sits against the block rather than floating in leftover space.
                             The Monitoring Status card used to carry device count and last
                             contact; last contact lives here, and devices stay on M1-15. -->
                        <Border Style="{StaticResource ElevatedCard}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <controls:MemberAvatar x:Name="Avatar"
                                                       Grid.Column="0"
                                                       BoxWidth="80"
                                                       VerticalOptions="Start"/>

                                <!-- The identity spans the avatar's height. The name and who they
                                     are lead by a step and sit at the box's top; the "Updated"
                                     line is bookkeeping, drops a step, and is pushed to the box's
                                     bottom by the star row between them — who they are and how
                                     current we are on them are the two ends of the same box, and
                                     what sits between just fills. -->
                                <Grid Grid.Column="1"
                                      RowDefinitions="Auto,Auto,*"
                                      VerticalOptions="Fill">
                                    <Label x:Name="NameLabel" Grid.Row="0" Style="{StaticResource Heading2}" FontSize="24"/>
                                    <Label x:Name="AgeRelationshipLabel" Grid.Row="1" Style="{StaticResource Body2}" FontSize="15"/>
                                    <HorizontalStackLayout x:Name="ConnectionStatusRow"
                                                           Grid.Row="2"
                                                           VerticalOptions="End"
                                                           Spacing="6">
                                        <Ellipse x:Name="ConnectionStatusDot"
                                                 WidthRequest="10" HeightRequest="10"
                                                 VerticalOptions="Center"
                                                 AutomationProperties.IsInAccessibleTree="False"/>
                                        <Label x:Name="LastContactLabel"
                                               Style="{StaticResource Body2}"
                                               FontSize="12"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation"/>
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Last-session weather (EnvironmentalReading — not live, no
                                     stored coordinate). Same chip and popup as the dashboard hero
                                     card; hidden when the member has no reading or hasn't
                                     consented to environmental context. -->
                                <HorizontalStackLayout x:Name="WeatherChip"
                                                        Grid.Column="2"
                                                        Spacing="4"
                                                        VerticalOptions="Center"
                                                        IsVisible="False">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnWeatherTapped"/>
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <Label x:Name="WeatherGlyphLabel" FontSize="16" VerticalOptions="Center"/>
                                    <Label x:Name="WeatherTemperatureLabel"
                                           Style="{StaticResource Body2Dark}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Paused banner -->
                        <Border x:Name="PausedBanner"
                                IsVisible="False"
                                BackgroundColor="{StaticResource StaleBannerBackground}"
                                StrokeThickness="0"
                                Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label x:Name="PausedBannerLabel"
                                   Style="{StaticResource Body2Medium}"/>
                        </Border>

                        <!-- Summary (issue #188): replaces "Baseline Status: Learning" with the
                             MedGemma-generated family digest, under the same clipboard icon
                             treatment the other section headers wear. The title is the digest's own
                             headline rather than a fixed "Daily Summary" — summaries are recomputed
                             as data lands, not once a morning, so a standing "Daily" would be a
                             claim about the cadence that is no longer true, and the headline says
                             what this summary is about instead of restating which screen it is on.
                             Empty until the pipeline has generated one for this member (dev only
                             today — see infrastructure/environments/prod.tfvars,
                             enable_pipeline_jobs). -->
                        <!-- A floor, not a fit: the placeholder is shorter than the summary that
                             replaces it, and on a first load the swap would otherwise shove the
                             trends below it down the page. A member who has none yet gets a
                             slightly roomy card rather than the whole screen moving under the
                             caregiver; a generated summary now runs to four to six sentences and
                             fills this and then some, so the card grows to the words rather than
                             leaving the floor showing under them. -->
                        <Border x:Name="SummaryCard"
                                Style="{StaticResource ElevatedCard}"
                                MinimumHeightRequest="150">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <!-- Decorative: the title beside it is the header. Out of the
                                         accessibility tree so focus lands on the words. -->
                                    <Image Grid.Column="0"
                                           Source="icon_clipboard.svg"
                                           WidthRequest="20" HeightRequest="20"
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"
                                           AutomationProperties.IsInAccessibleTree="False"/>
                                    <Label x:Name="SummaryTitleLabel"
                                           Grid.Column="1"
                                           Style="{StaticResource DashboardSectionTitle}"
                                           LineBreakMode="WordWrap"/>
                                    <!-- "When" belongs next to a summary that is recomputed:
                                         without it there is no way to tell a minutes-old
                                         reading from yesterday's. It sits on the icon's own
                                         line rather than under the title, so the header stays
                                         a single row; pinned to Start so a headline that wraps
                                         leaves it beside its first line. -->
                                    <Label x:Name="SummaryGeneratedLabel"
                                           Grid.Column="2"
                                           FontFamily="Quicksand"
                                           FontSize="12"
                                           TextColor="{StaticResource BodyText}"
                                           VerticalOptions="Start"
                                           Margin="0,5,0,0"
                                           LineBreakMode="TailTruncation"
                                           IsVisible="False"/>
                                </Grid>
                                <!-- Same weight as the Something-to-try paragraphs below it: both are
                                     the message to the caregiver, and in regular type this one read
                                     as the lighter of the two cards though the ink is the same. -->
                                <Label x:Name="SummaryLabel"
                                       Style="{StaticResource Message}"/>

                                <!-- The model's own urgency read, alongside — never instead of —
                                     the card's dashboard-driven status colour above. Hidden when
                                     this generation returned nothing parseable. -->
                                <HorizontalStackLayout x:Name="UrgencyRow" Spacing="6" IsVisible="False">
                                    <Ellipse x:Name="UrgencyDot"
                                             WidthRequest="8" HeightRequest="8"
                                             VerticalOptions="Center"/>
                                    <Label x:Name="UrgencyLabel"
                                           Style="{StaticResource Message}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Advise: a suggestion grounded in this member's readings and
                             public-health guidelines, generated by the pipeline's batch pass —
                             not the Digest-sourced tip the summary card used to trail (that card
                             restated what the summary had just said, and went). Hidden outright
                             when there is nothing to suggest. "Worth mentioning to a clinician,
                             never a diagnosis" is the boundary its generation is held to. -->
                        <Border x:Name="AdviseCard"
                                Style="{StaticResource ElevatedCard}"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="10">
                                <!-- Sparkles, matching icon_advise.svg on the Dashboard card's
                                     button that leads here — the button and the card it opens have
                                     to be the same symbol, or the pulse points at nothing
                                     recognisable. "Something to try", not "Wellness suggestion":
                                     the words match what the card holds — one everyday thing the
                                     family could help with — where "wellness" claimed a category
                                     the product is careful not to speak for. -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="&#x2728;"
                                           FontSize="16"
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"
                                           AutomationProperties.IsInAccessibleTree="False"/>
                                    <Label x:Name="AdviseTitleLabel"
                                           Grid.Column="1"
                                           Style="{StaticResource DashboardSectionTitle}"
                                           Text="Something to try"
                                           LineBreakMode="WordWrap"/>
                                    <!-- Same "when" the summary card carries, and here it is
                                         load-bearing: this card regenerates daily where the
                                         summary above it moves hourly, and on the one day the two
                                         disagree, the age is what tells a caregiver they are
                                         reading yesterday's suggestion beside today's summary. -->
                                    <Label x:Name="AdviseGeneratedLabel"
                                           Grid.Column="2"
                                           FontFamily="Quicksand"
                                           FontSize="12"
                                           TextColor="{StaticResource BodyText}"
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"
                                           LineBreakMode="TailTruncation"
                                           IsVisible="False"/>
                                </Grid>
                                <!-- Both paragraphs are the message to the caregiver, and both
                                     carry the same weight: the summary used to sit in regular
                                     type beside the bold suggestion and read as a lighter aside.
                                     Only the time and the source-and-disclaimer footnote stay
                                     muted — they are about the message, not the message. -->
                                <Label x:Name="AdviseSummaryLabel"
                                       Style="{StaticResource Message}"
                                       LineBreakMode="WordWrap"/>
                                <Label x:Name="AdviseSuggestionLabel"
                                       Style="{StaticResource Message}"
                                       LineBreakMode="WordWrap"/>
                                <!-- One footnote, not two: the guideline the suggestion rests on and
                                     the safety framing read as a single sentence ("Based on … —
                                     just a suggestion, never medical advice; worth mentioning to
                                     their doctor"). The framing is fixed copy in the code-behind,
                                     not model output: it must always be present and identically
                                     worded, so it lives in the chrome — the generation guards
                                     reject a suggestion that spends its own words restating it. -->
                                <Label x:Name="AdviseGuidelineLabel"
                                       FontSize="12"
                                       TextColor="{StaticResource MutedText}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- A question the service is asking the family, when there is one waiting.
                             Sits with the summary and the suggestions because it comes from the
                             same reading of the same day — and inline, never as a popup: a
                             caregiver who opened this page to check on someone should not have to
                             dismiss something first. -->
                        <controls:QuestionCard x:Name="PendingQuestionCard" IsVisible="False"/>

                        <!-- Key metric trends (issue #188): one swipeable card per metric, over the
                             same daily Series the dashboard's Key Metrics already carry, across a
                             caregiver-chosen 7/14/30-day window. Deliberately not wrapped in a card
                             of its own — the slides are the cards, and nesting them would read as
                             chrome inside chrome. -->
                        <VerticalStackLayout x:Name="TrendsSection" Spacing="12" IsVisible="False">
                            <Label Text="Key Metric Trends"
                                   Style="{StaticResource DashboardSectionTitle}"/>

                            <controls:TrendWindowSelector x:Name="TrendWindowPicker"/>

                            <!-- Margin cancels the page's own 20dp gutter so a card can slide the
                                 full width of the screen; the cards carry their own inset.
                                 Loop so a swipe past the last metric lands on the first. -->
                            <CarouselView x:Name="TrendsCarousel"
                                          Margin="-20,0"
                                          Loop="True"
                                          IsScrollAnimated="True"
                                          HorizontalScrollBarVisibility="Never"
                                          PeekAreaInsets="20,0"
                                          HorizontalOptions="Fill">
                                <CarouselView.ItemTemplate>
                                    <DataTemplate x:DataType="controls:MetricTrend">
                                        <controls:MetricTrendCard/>
                                    </DataTemplate>
                                </CarouselView.ItemTemplate>
                            </CarouselView>

                            <!-- Pill indicators, same treatment as the welcome carousel's. -->
                            <HorizontalStackLayout x:Name="TrendIndicatorPanel"
                                                   HorizontalOptions="Center"
                                                   Spacing="6"/>
                        </VerticalStackLayout>

                        <!-- Emergency contact and the member's own phone as looping slides —
                             same wrap-around as Key Metric Trends, so a swipe past Phone
                             returns to Emergency Contact. Peek of the page gutter matches
                             the cards' own inset. -->
                        <VerticalStackLayout x:Name="ContactsSection" Spacing="12">
                            <CarouselView x:Name="ContactsCarousel"
                                          Margin="-20,0"
                                          Loop="True"
                                          IsScrollAnimated="True"
                                          HorizontalScrollBarVisibility="Never"
                                          PeekAreaInsets="20,0"
                                          HorizontalOptions="Fill"
                                          HeightRequest="132">
                                <CarouselView.ItemTemplate>
                                    <DataTemplate x:DataType="controls:ContactCardItem">
                                        <Grid>
                                            <Border Style="{StaticResource ElevatedCard}"
                                                    Margin="3,3,3,10">
                                                <VerticalStackLayout Spacing="10">
                                                    <Label Text="{Binding Title}"
                                                           Style="{StaticResource DashboardSectionTitle}"/>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <!-- Display only. The whole number column
                                                             used to be a hidden tap target for the
                                                             edit screen, which is an edit with no
                                                             affordance saying so and no way to read
                                                             the card without risking it — the pencil
                                                             opposite says it instead. -->
                                                        <VerticalStackLayout Grid.Column="0"
                                                                             Spacing="2"
                                                                             VerticalOptions="Center">
                                                            <!-- One line, whatever the name: the
                                                                 carousel is a fixed height, and a
                                                                 long name wrapping is what would
                                                                 push the number out of the card. -->
                                                            <Label Text="{Binding Primary}"
                                                                   Style="{StaticResource Body1SemiBoldDark}"
                                                                   LineBreakMode="TailTruncation"/>
                                                            <Label Text="{Binding Secondary}"
                                                                   Style="{StaticResource Body2}"
                                                                   IsVisible="{Binding HasSecondary}"/>
                                                        </VerticalStackLayout>
                                                        <HorizontalStackLayout Grid.Column="1"
                                                                               Spacing="10"
                                                                               VerticalOptions="Center">
                                                            <Border WidthRequest="40" HeightRequest="40"
                                                                    StrokeThickness="0"
                                                                    BackgroundColor="{StaticResource SelectedOptionBackground}"
                                                                    VerticalOptions="Center"
                                                                    IsVisible="{Binding ShowCall}"
                                                                    SemanticProperties.Description="Call"
                                                                    SemanticProperties.Hint="Dials this number">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="12"/>
                                                                </Border.StrokeShape>
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnContactCallTapped"/>
                                                                </Border.GestureRecognizers>
                                                                <Image Source="icon_action_call.svg"
                                                                       WidthRequest="20" HeightRequest="20"
                                                                       HorizontalOptions="Center"
                                                                       VerticalOptions="Center"/>
                                                            </Border>
                                                            <Border WidthRequest="40" HeightRequest="40"
                                                                    StrokeThickness="0"
                                                                    BackgroundColor="{StaticResource SelectedOptionBackground}"
                                                                    VerticalOptions="Center"
                                                                    IsVisible="{Binding ShowMessage}"
                                                                    SemanticProperties.Description="Message"
                                                                    SemanticProperties.Hint="Opens a text message to this number">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="12"/>
                                                                </Border.StrokeShape>
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnContactMessageTapped"/>
                                                                </Border.GestureRecognizers>
                                                                <Image Source="icon_action_sms.svg"
                                                                       WidthRequest="20" HeightRequest="20"
                                                                       HorizontalOptions="Center"
                                                                       VerticalOptions="Center"/>
                                                            </Border>
                                                            <!-- Both slides carry it, and it is
                                                                 the record's only way in now:
                                                                 shown whenever the caregiver is
                                                                 the primary — the only one the
                                                                 API lets change these — rather
                                                                 than only on an empty phone card,
                                                                 which offered to add a number and
                                                                 nothing to fix a wrong one. -->
                                                            <Border WidthRequest="40" HeightRequest="40"
                                                                    StrokeThickness="0"
                                                                    BackgroundColor="{StaticResource SelectedOptionBackground}"
                                                                    VerticalOptions="Center"
                                                                    IsVisible="{Binding ShowEdit}"
                                                                    SemanticProperties.Description="{Binding EditDescription}"
                                                                    SemanticProperties.Hint="Opens a form for just this record">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="12"/>
                                                                </Border.StrokeShape>
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnContactEditTapped"/>
                                                                </Border.GestureRecognizers>
                                                                <Image Source="icon_edit.svg"
                                                                       WidthRequest="20" HeightRequest="20"
                                                                       HorizontalOptions="Center"
                                                                       VerticalOptions="Center"/>
                                                            </Border>
                                                        </HorizontalStackLayout>
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CarouselView.ItemTemplate>
                            </CarouselView>
                            <HorizontalStackLayout x:Name="ContactIndicatorPanel"
                                                   HorizontalOptions="Center"
                                                   Spacing="6"/>
                        </VerticalStackLayout>

                        <!-- Questions and answers, once any have been asked. A row rather than a
                             section: the answers are worth keeping and worth editing, but they are
                             not what a caregiver opens this page to read. It leads the two rows
                             under it because it is the only one that goes somewhere: those two
                             open in place, so leaving this one below them would have put a
                             navigation row wherever the open one happened to end. -->
                        <Border x:Name="QuestionsRow"
                                Style="{StaticResource ElevatedCard}"
                                Padding="14,4"
                                IsVisible="False">
                            <!-- Described on the Grid, which is the tap target: a layout carrying
                                 nothing but a gesture recognizer is not an accessibility node, so
                                 without this the row is neither announced nor reachable. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52"
                                  SemanticProperties.Description="Questions and answers"
                                  SemanticProperties.Hint="Opens the answers saved for this CardiMember">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuestionsTapped"/>
                                </Grid.GestureRecognizers>
                                <!-- Call-outs rather than the clipboard: the summary card two
                                     sections up is already a clipboard, and a row repeating it
                                     read as more of that card rather than as a way somewhere
                                     else. Two bubbles — one asked, one answered. -->
                                <Image Grid.Column="0" Source="icon_callout.svg"
                                       WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Questions &amp; Answers"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Their daybook — the finished days this page's live view sits on
                             top of. Same row shape as Questions & Answers: a way in, not a
                             preview. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52"
                                  SemanticProperties.Description="CardiJournal"
                                  SemanticProperties.Hint="Opens this CardiMember's CardiJournal of finished days">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDaybookTapped"/>
                                </Grid.GestureRecognizers>
                                <!-- A book, not the tab bar's written page: that glyph is drawn
                                     in the unselected-tab grey and read as a disabled row beside
                                     the blue ones either side of it. -->
                                <Image Grid.Column="0" Source="icon_book.svg"
                                       WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="CardiJournal"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Medical information. A way in rather than a drop down, now the same
                             kind of row as Questions & Answers above it and pointing at the same
                             kind of thing: something the family keeps, of no fixed length. As a
                             drop down it pushed everything under it — the whole Management group —
                             off the bottom of the screen for as long as it stayed open, which is
                             the wrong trade for content nobody reads on their way past. -->
                        <Border x:Name="MedicalRow"
                                Style="{StaticResource ElevatedCard}"
                                Padding="14,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52"
                                  SemanticProperties.Description="Medical Information"
                                  SemanticProperties.Hint="Opens the medical notes kept for this CardiMember">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMedicalTapped"/>
                                </Grid.GestureRecognizers>
                                <!-- The medical mark itself. The padlock this replaces described
                                     how the notes are held rather than what they are, and read as
                                     "locked" to the one caregiver who can open them. -->
                                <Image Grid.Column="0"
                                       Source="icon_medical_cross.svg"
                                       WidthRequest="22" HeightRequest="22"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Medical Information"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- The conversation about this member's readings, persisted rather than
                             the single-shot Ask card elsewhere. No Figma frame — as-built, see the
                             design-sync backlog. Always available, not gated on any data existing
                             yet.

                             Last of the four, after the medical notes: the rows above are the
                             record — what is known, what was written down, what the family keeps —
                             and this is the way to interrogate it. It also reads as "chat
                             history" rather than "start a chat", which is what it opens: the
                             thread resumes where it left off. The Dashboard's floating button
                             remains the way in for someone who has a question and no interest in
                             this page. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52"
                                  SemanticProperties.Description="Chat history"
                                  SemanticProperties.Hint="Opens the conversation about this CardiMember's readings">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChatTapped"/>
                                </Grid.GestureRecognizers>
                                <!-- The bot, monochrome: the same character as the floating
                                     launcher rather than a generic speech bubble, drawn in the
                                     row set's flat blue so it does not announce itself beside
                                     the four glyphs above it. -->
                                <Image Grid.Column="0" Source="icon_chatbot_mono.svg"
                                       WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Chat history"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Management / danger zone -->
                        <VerticalStackLayout Spacing="4" Margin="0,10,0,0">
                            <Label Text="Management" Style="{StaticResource DashboardSectionTitle}"/>
                            <Label Text="Alerts, the journal, devices, monitoring and removal"
                                   Style="{StaticResource Body2}"/>
                        </VerticalStackLayout>

                        <!-- Which alerts CardiTrack checks for. In Management rather than up with the
                             rows about the member: it is not a fact about them, it is a setting for
                             how CardiTrack watches them, which is what this group already collects.

                             It leads the group. What a caregiver comes to Management to change is
                             usually what CardiTrack watches for; the four rows under it are the
                             journal's schedule they will set once, a device they will set up once,
                             a pause they will use rarely, and a removal they will use never.
                             Ordering by consequence — the harmless row first, the destructive one
                             last — put the most-used row behind the least-used ones, which is a
                             tidy rule and the wrong outcome. Pause and Remove keep their places at
                             the bottom, which is what that rule was really protecting.

                             A page rather than a row that opens in place, like Journal Settings
                             beside it: the catalogue has grown to more clusters than fit under a
                             row without burying the four rows beneath, and two settings pages for
                             two neighbouring rows should look and behave the same. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52"
                                  SemanticProperties.Description="Alert Settings"
                                  SemanticProperties.Hint="Choose which alerts CardiTrack checks for">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAlertSettingsTapped"/>
                                </Grid.GestureRecognizers>
                                <!-- A bell wearing a cog. The bell says which subject, and the cog
                                     says these are the settings behind the alerts rather than the
                                     alerts themselves — which is what keeps it apart from the
                                     header's plain bell, the inbox of what CardiTrack has already
                                     found. -->
                                <Image Grid.Column="0"
                                       Source="icon_bell_cog.svg"
                                       WidthRequest="22" HeightRequest="22"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Alert Settings"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- The caregiver's own thresholds, directly under the rules CardiTrack
                             checks on its own. The pairing is the point: one row says what
                             CardiTrack looks for, the next says what you have asked it to look for
                             on top of that, and a caregiver wondering "why did I get told about
                             this" has both answers in one place.

                             R2, and no Figma frame — on the design-sync backlog. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52"
                                  SemanticProperties.Description="Your Alarms"
                                  SemanticProperties.Hint="Set the levels you want to be told about">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMetricAlarmsTapped"/>
                                </Grid.GestureRecognizers>
                                <!-- The same bell-and-cog as Alert Settings above it: same subject,
                                     same kind of setting. What separates the two rows is their
                                     labels, and separating them by icon as well would suggest they
                                     were different sorts of thing. -->
                                <Image Grid.Column="0"
                                       Source="icon_bell_cog.svg"
                                       WidthRequest="22" HeightRequest="22"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Your Alarms"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- When each book is written. In Management rather than under the
                             CardiJournal row it used to sit beneath: the journal is something you
                             read, and this is a setting for how CardiTrack behaves — which is what
                             this group collects. It follows Alert Settings for the same reason that
                             one leads: both are what CardiTrack does on its own, and neither
                             changes anything about the member.

                             Named for the whole setting rather than the one question on the page,
                             so the row reads as a destination beside Manage Device rather than a
                             sentence fragment beside it. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52"
                                  SemanticProperties.Description="Journal Settings"
                                  SemanticProperties.Hint="Choose what time of day each book is written up">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnJournalTimingTapped"/>
                                </Grid.GestureRecognizers>
                                <!-- The CardiJournal row's book wearing the same cog Alert Settings
                                     wears: the journal is the subject, the cog is what makes this
                                     the setting for it rather than the journal itself. -->
                                <Image Grid.Column="0" Source="icon_book_cog.svg"
                                       WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Journal Settings"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Manage Device, which used to be one of a pair of outline buttons
                             halfway up the page. It is the same kind of thing as the rows either
                             side of it — a way in to managing this member rather than a fact about
                             them — and like the alert rules above it, it changes nothing on its
                             own. The two rows below do. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnManageDevicesTapped"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52">
                                <Image Grid.Column="0" Source="icon_watch.svg"
                                       WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Manage Device"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                            <VerticalStackLayout x:Name="PauseRowLayout">
                                <!-- The recognizer sits on the header row, not the card, so taps
                                     on a duration below reach their own row instead of
                                     re-toggling the drop down. -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPauseMonitoringTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Image Grid.Column="0" Source="icon_pause.svg"
                                           WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                                    <!-- Amber, and the icon with it: pausing is the one row here
                                         that stops CardiTrack watching, so it should not read as
                                         another neutral way in. Amber rather than red because it
                                         is reversible from this same row — red is kept for the
                                         removal below it. -->
                                    <Label x:Name="PauseRowLabel"
                                           Grid.Column="1"
                                           Text="Pause Monitoring"
                                           Style="{StaticResource Body1SemiBoldDark}"
                                           TextColor="{StaticResource CautionAmber}"
                                           VerticalTextAlignment="Center"/>
                                    <Image x:Name="PauseRowChevron"
                                           Grid.Column="2" Source="icon_chevron.svg"
                                           WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                                </Grid>

                                <!-- Duration drop down. The durations used to arrive as a modal
                                     list of buttons; they now open in place under the row that
                                     asks for them. Rows are built in code-behind from the same
                                     PauseDurations table the confirm step reads, and the open
                                     /close animation is AccordionSection's — a clipping Border
                                     grown to the measured height, since a plain layout wouldn't
                                     clip its content mid-slide. -->
                                <Border x:Name="PauseDurationsClip"
                                        StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        Padding="0"
                                        HeightRequest="0">
                                    <VerticalStackLayout x:Name="PauseDurationsHost"
                                                         Padding="0,0,0,10"
                                                         VerticalOptions="Start"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- The destructive one: removal takes the member, the caregiver links to
                             them and their device connections off this account, and the confirm
                             step behind it should not be the first hint of that. A deeper red than
                             the severity token (#E53E3E) — that one is drawn as a fill or a dot,
                             this is 16px label text on white and has to clear 4.5:1 against it. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRemoveMemberTapped"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52">
                                <Image Grid.Column="0" Source="icon_person_remove.svg"
                                       WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Remove CardiMember"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       TextColor="{StaticResource DangerRed}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <!-- M1-13/M1-14/M1-15 all show the bottom nav in Figma, and these pages sit on
             top of the Dashboard tab. Tapping Home here pops back down to it. -->
        <controls:BottomNavBar Grid.Row="2" Tab="Dashboard"/>

        <!-- Chat from anywhere — alongside this page's "Ask about their readings" row, which
             stays: the row is the discoverable entry, the floating bot is the consistent one. -->
        <controls:ChatBotLauncher x:Name="ChatBot" Grid.Row="1"/>
    </Grid>
</ContentPage>

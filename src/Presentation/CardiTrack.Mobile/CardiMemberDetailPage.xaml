<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.CardiMemberDetailPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ════════════════════════════════════════
             GRADIENT HEADER — the app-wide band (Controls/HeaderBand).
             ════════════════════════════════════════ -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,16,20,26">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Grid.Column="0"
                        WidthRequest="38" HeightRequest="38"
                        StrokeThickness="0"
                        BackgroundColor="#33FFFFFF"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19"/>
                    </Border.StrokeShape>
                    <ImageButton Source="icon_back_white.svg"
                                 WidthRequest="20" HeightRequest="20"
                                 BackgroundColor="Transparent"
                                 Clicked="OnBackClicked"/>
                </Border>

                <Label Grid.Column="1"
                       Text="Member Details"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"
                       VerticalTextAlignment="Center"/>

                <!-- Alerts and Edit, icon-only. Alerts was a full-width "View Alerts" button
                     halfway down the page; it is navigation, not a setting, and it belongs beside
                     the other way out of this screen rather than competing with the member's own
                     details for the middle of the page. -->
                <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                    <Border WidthRequest="40" HeightRequest="40"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource White}"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <ImageButton Source="icon_bell.svg"
                                     WidthRequest="20" HeightRequest="20"
                                     BackgroundColor="Transparent"
                                     SemanticProperties.Description="View alerts"
                                     SemanticProperties.Hint="Opens the alerts list"
                                     Clicked="OnViewAlertsClicked"/>
                    </Border>

                    <!-- Named on the Border, not the button inside it: hiding the button alone
                         left its white chip behind as an empty square for everyone who isn't the
                         primary caregiver. -->
                    <Border x:Name="EditButton"
                            WidthRequest="40" HeightRequest="40"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource White}"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <ImageButton Source="icon_edit.svg"
                                     WidthRequest="20" HeightRequest="20"
                                     BackgroundColor="Transparent"
                                     SemanticProperties.Description="Edit member"
                                     Clicked="OnEditClicked"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <!-- ════════════════════════════════════════
             CONTENT
             ════════════════════════════════════════ -->
        <RefreshView x:Name="Refresher"
                     Grid.Row="1"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView x:Name="DetailScroller">
                <Grid Padding="20,16,20,28">

                    <!-- ── Loading ── -->
                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                        <controls:SkeletonView HeightRequest="88"/>
                        <controls:SkeletonView HeightRequest="150"/>
                        <controls:SkeletonView HeightRequest="110"/>
                        <controls:SkeletonView HeightRequest="60"/>
                    </VerticalStackLayout>

                    <!-- ── Error ── -->
                    <VerticalStackLayout x:Name="ErrorPanel"
                                         Spacing="10"
                                         IsVisible="False"
                                         Padding="0,60,0,0">
                        <Label Text="We couldn't load these details"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="ErrorDetailLabel"
                               Style="{StaticResource Body2}"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="Try again"
                                Style="{StaticResource SecondaryOutlineButton}"
                                HorizontalOptions="Center"
                                Clicked="OnRetryClicked"/>
                    </VerticalStackLayout>

                    <!-- ── Loaded ── -->
                    <VerticalStackLayout x:Name="ContentPanel" Spacing="14" IsVisible="False">

                        <controls:OfflineStatusBanner x:Name="OfflineBanner"/>

                        <!-- Profile -->
                        <Border Style="{StaticResource ElevatedCard}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <!-- This screen's own display image box, lifted into a shared
                                     control so the dashboard hero can wear it too — and it now
                                     shows the member's photo when there is one, not just their
                                     initials. -->
                                <controls:MemberAvatar x:Name="Avatar"
                                                       Grid.Column="0"
                                                       VerticalOptions="Center"/>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label x:Name="NameLabel" Style="{StaticResource Heading2}"/>
                                    <Label x:Name="AgeRelationshipLabel" Style="{StaticResource Body2}"/>
                                </VerticalStackLayout>

                                <!-- Last-session weather (EnvironmentalReading — not live, no
                                     stored coordinate). Same chip and popup as the dashboard hero
                                     card; hidden when the member has no reading or hasn't
                                     consented to environmental context. -->
                                <HorizontalStackLayout x:Name="WeatherChip"
                                                        Grid.Column="2"
                                                        Spacing="4"
                                                        VerticalOptions="Center"
                                                        IsVisible="False">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnWeatherTapped"/>
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <Label x:Name="WeatherGlyphLabel" FontSize="16" VerticalOptions="Center"/>
                                    <Label x:Name="WeatherTemperatureLabel"
                                           Style="{StaticResource Body2Dark}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Paused banner -->
                        <Border x:Name="PausedBanner"
                                IsVisible="False"
                                BackgroundColor="{StaticResource StaleBannerBackground}"
                                StrokeThickness="0"
                                Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label x:Name="PausedBannerLabel"
                                   Style="{StaticResource Body2Medium}"/>
                        </Border>

                        <!-- Monitoring status -->
                        <Border Style="{StaticResource ElevatedCard}">
                            <VerticalStackLayout Spacing="12">
                                <HorizontalStackLayout Spacing="8">
                                    <Image Source="icon_monitoring.svg"
                                           WidthRequest="20" HeightRequest="20"
                                           VerticalOptions="Center"/>
                                    <Label Text="Monitoring Status"
                                           Style="{StaticResource DashboardSectionTitle}"
                                           VerticalTextAlignment="Center"/>
                                </HorizontalStackLayout>

                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="Connected Devices"
                                           Style="{StaticResource Body2}"/>
                                    <Label x:Name="DeviceCountLabel"
                                           Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource Body2Medium}"
                                           TextColor="{StaticResource Primary}"/>

                                    <!-- Replaces "Monitoring Since" (issue #188) — when the
                                         member was added is less useful than whether their
                                         device is actually still talking to us. -->
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="Time of Last Contact"
                                           Style="{StaticResource Body2}"/>
                                    <Label x:Name="LastContactLabel"
                                           Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource Body2Medium}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Summary (issue #188): replaces "Baseline Status: Learning" with the
                             MedGemma-generated family digest, under the same clipboard icon
                             treatment the other section headers wear. The title is the digest's own
                             headline rather than a fixed "Daily Summary" — summaries are recomputed
                             as data lands, not once a morning, so a standing "Daily" would be a
                             claim about the cadence that is no longer true, and the headline says
                             what this summary is about instead of restating which screen it is on.
                             Empty until the pipeline has generated one for this member (dev only
                             today — see infrastructure/environments/prod.tfvars,
                             enable_pipeline_jobs). -->
                        <!-- A floor, not a fit: the placeholder is shorter than the summary that
                             replaces it, and on a first load the swap would otherwise shove the
                             trends below it down the page. A member who has none yet gets a
                             slightly roomy card rather than the whole screen moving under the
                             caregiver; a generated summary now runs to four to six sentences and
                             fills this and then some, so the card grows to the words rather than
                             leaving the floor showing under them. -->
                        <Border x:Name="SummaryCard"
                                Style="{StaticResource ElevatedCard}"
                                MinimumHeightRequest="150">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <!-- Decorative: the title beside it is the header. Out of the
                                         accessibility tree so focus lands on the words. -->
                                    <Image Grid.Column="0"
                                           Source="icon_clipboard.svg"
                                           WidthRequest="20" HeightRequest="20"
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"
                                           AutomationProperties.IsInAccessibleTree="False"/>
                                    <Label x:Name="SummaryTitleLabel"
                                           Grid.Column="1"
                                           Style="{StaticResource DashboardSectionTitle}"
                                           LineBreakMode="WordWrap"/>
                                    <!-- "When" belongs next to a summary that is recomputed:
                                         without it there is no way to tell a minutes-old
                                         reading from yesterday's. It sits on the icon's own
                                         line rather than under the title, so the header stays
                                         a single row; pinned to Start so a headline that wraps
                                         leaves it beside its first line. -->
                                    <Label x:Name="SummaryGeneratedLabel"
                                           Grid.Column="2"
                                           FontFamily="Quicksand"
                                           FontSize="12"
                                           TextColor="{StaticResource BodyText}"
                                           VerticalOptions="Start"
                                           Margin="0,5,0,0"
                                           LineBreakMode="TailTruncation"
                                           IsVisible="False"/>
                                </Grid>
                                <Label x:Name="SummaryLabel" Style="{StaticResource Body2Dark}"/>

                                <!-- The model's own urgency read, alongside — never instead of —
                                     the card's dashboard-driven status colour above. Hidden when
                                     this generation returned nothing parseable. -->
                                <HorizontalStackLayout x:Name="UrgencyRow" Spacing="6" IsVisible="False">
                                    <Ellipse x:Name="UrgencyDot"
                                             WidthRequest="8" HeightRequest="8"
                                             VerticalOptions="Center"/>
                                    <Label x:Name="UrgencyLabel"
                                           Style="{StaticResource Body2Dark}"
                                           FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Tips. Generated with the summary above and from the same readings, so
                             what it proposes follows from what the summary just said rather than
                             from a fixed list. Hidden outright when this generation produced none.
                             Support, never treatment: the register is "ask how they slept" or a
                             scheduled-medication reminder, never a diagnosis or a dose. -->
                        <Border x:Name="SuggestionsCard"
                                Style="{StaticResource ElevatedCard}"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="10">
                                <!-- Sits under the same icon-then-title treatment as the cards
                                     above, pinned to Start so a heading that wraps keeps it beside
                                     its first line. Decorative, so out of the accessibility tree —
                                     the heading is the words. -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="&#x1F4A1;"
                                           FontSize="16"
                                           VerticalOptions="Start"
                                           Margin="0,2,0,0"
                                           AutomationProperties.IsInAccessibleTree="False"/>
                                    <Label x:Name="SuggestionsTitleLabel"
                                           Grid.Column="1"
                                           Style="{StaticResource DashboardSectionTitle}"
                                           LineBreakMode="WordWrap"/>
                                </Grid>
                                <Label x:Name="SuggestionLabel"
                                       Style="{StaticResource Body2Dark}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- A question the service is asking the family, when there is one waiting.
                             Sits with the summary and the suggestions because it comes from the
                             same reading of the same day — and inline, never as a popup: a
                             caregiver who opened this page to check on someone should not have to
                             dismiss something first. -->
                        <controls:QuestionCard x:Name="PendingQuestionCard" IsVisible="False"/>

                        <!-- Key metric trends (issue #188): one swipeable card per metric, over the
                             same daily Series the dashboard's Key Metrics already carry, across a
                             caregiver-chosen 7/14/30-day window. Deliberately not wrapped in a card
                             of its own — the slides are the cards, and nesting them would read as
                             chrome inside chrome. -->
                        <VerticalStackLayout x:Name="TrendsSection" Spacing="12" IsVisible="False">
                            <Label Text="Key Metric Trends"
                                   Style="{StaticResource DashboardSectionTitle}"/>

                            <controls:TrendWindowSelector x:Name="TrendWindowPicker"/>

                            <!-- Margin cancels the page's own 20dp gutter so a card can slide the
                                 full width of the screen; the cards carry their own inset. -->
                            <CarouselView x:Name="TrendsCarousel"
                                          Margin="-20,0"
                                          Loop="False"
                                          IsScrollAnimated="True"
                                          HorizontalScrollBarVisibility="Never"
                                          PeekAreaInsets="20,0"
                                          HorizontalOptions="Fill">
                                <CarouselView.ItemTemplate>
                                    <DataTemplate x:DataType="controls:MetricTrend">
                                        <controls:MetricTrendCard/>
                                    </DataTemplate>
                                </CarouselView.ItemTemplate>
                            </CarouselView>

                            <!-- Pill indicators, same treatment as the welcome carousel's. -->
                            <HorizontalStackLayout x:Name="TrendIndicatorPanel"
                                                   HorizontalOptions="Center"
                                                   Spacing="6"/>
                        </VerticalStackLayout>

                        <!-- Emergency contact -->
                        <Border Style="{StaticResource ElevatedCard}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Emergency Contact"
                                       Style="{StaticResource DashboardSectionTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label x:Name="EmergencyNameLabel"
                                               Style="{StaticResource Body1SemiBoldDark}"/>
                                        <Label x:Name="EmergencyPhoneLabel"
                                               Style="{StaticResource Body2}"/>
                                    </VerticalStackLayout>
                                    <!-- 40, matching the header's own icon buttons and the phone
                                         card below, so the two contact cards stand the same
                                         height as each other. -->
                                    <Border x:Name="EmergencyCallButton"
                                            Grid.Column="1"
                                            WidthRequest="40" HeightRequest="40"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource SelectedOptionBackground}"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCallEmergencyContactTapped"/>
                                        </Border.GestureRecognizers>
                                        <Image Source="icon_action_call.svg"
                                               WidthRequest="20" HeightRequest="20"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Personal phone (issue #162) — distinct from the emergency contact
                             above; same graceful-absence treatment. Primary caregivers can tap
                             the number column (or the edit affordance when empty) to jump
                             straight to the phone field on M1-14 — #280. The action buttons stay
                             outside that tap target so the gestures cannot collide.

                             The same shape as the emergency contact card above: title, one line of
                             dark text, 40dp action buttons on the right. The number used to be
                             muted body copy floating in the middle of a 44dp row, which left the
                             card visibly baggier than its neighbour for the same one line of
                             content.

                             It rides a little tighter than that card rather than exactly as tall.
                             The 40dp buttons set the row height and stay 40 — they match the
                             header's icon buttons and the emergency card's, and shrinking them
                             here would break that everywhere it is read — so the height comes off
                             the padding and the title gap instead. The emergency card carries two
                             lines of text in the same frame; matching its height around one line
                             is what made this one read as slack. -->
                        <Border x:Name="PhoneCard"
                                Style="{StaticResource ElevatedCard}"
                                Padding="14,12,13,12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Phone"
                                       Style="{StaticResource DashboardSectionTitle}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout x:Name="PhoneEditTarget"
                                                         Grid.Column="0"
                                                         VerticalOptions="Center">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEditPhoneTapped"/>
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label x:Name="PhoneLabel"
                                               Style="{StaticResource Body1SemiBoldDark}"
                                               VerticalOptions="Center"/>
                                    </VerticalStackLayout>

                                    <!-- Call and message sit side by side: a caregiver checking in
                                         reaches for one or the other, and only calling was
                                         reachable from here. The stack collapses whichever button
                                         does not apply, so the row is the same height either way. -->
                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="10"
                                                           VerticalOptions="Center">
                                        <Border x:Name="PhoneCallButton"
                                                WidthRequest="40" HeightRequest="40"
                                                StrokeThickness="0"
                                                BackgroundColor="{StaticResource SelectedOptionBackground}"
                                                VerticalOptions="Center"
                                                SemanticProperties.Description="Call"
                                                SemanticProperties.Hint="Dials their phone number">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnCallPhoneTapped"/>
                                            </Border.GestureRecognizers>
                                            <Image Source="icon_action_call.svg"
                                                   WidthRequest="20" HeightRequest="20"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Border x:Name="PhoneMessageButton"
                                                WidthRequest="40" HeightRequest="40"
                                                StrokeThickness="0"
                                                BackgroundColor="{StaticResource SelectedOptionBackground}"
                                                VerticalOptions="Center"
                                                SemanticProperties.Description="Message"
                                                SemanticProperties.Hint="Opens a text message to their phone number">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnMessagePhoneTapped"/>
                                            </Border.GestureRecognizers>
                                            <Image Source="icon_action_sms.svg"
                                                   WidthRequest="20" HeightRequest="20"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Border x:Name="PhoneEditButton"
                                                WidthRequest="40" HeightRequest="40"
                                                StrokeThickness="0"
                                                BackgroundColor="{StaticResource SelectedOptionBackground}"
                                                VerticalOptions="Center"
                                                IsVisible="False"
                                                SemanticProperties.Description="Edit phone number"
                                                SemanticProperties.Hint="Opens the profile form on their phone number">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnEditPhoneTapped"/>
                                            </Border.GestureRecognizers>
                                            <Image Source="icon_edit.svg"
                                                   WidthRequest="20" HeightRequest="20"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Questions and answers, once any have been asked. A row rather than a
                             section: the answers are worth keeping and worth editing, but they are
                             not what a caregiver opens this page to read. It leads the two rows
                             under it because it is the only one that goes somewhere: those two
                             open in place, so leaving this one below them would have put a
                             navigation row wherever the open one happened to end. -->
                        <Border x:Name="QuestionsRow"
                                Style="{StaticResource ElevatedCard}"
                                Padding="14,4"
                                IsVisible="False">
                            <!-- Described on the Grid, which is the tap target: a layout carrying
                                 nothing but a gesture recognizer is not an accessibility node, so
                                 without this the row is neither announced nor reachable. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52"
                                  SemanticProperties.Description="Questions and answers"
                                  SemanticProperties.Hint="Opens the answers saved for this CardiMember">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuestionsTapped"/>
                                </Grid.GestureRecognizers>
                                <Image Grid.Column="0" Source="icon_clipboard.svg"
                                       WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Questions &amp; Answers"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Medical information. A way in rather than a drop down, now the same
                             kind of row as Questions & Answers above it and pointing at the same
                             kind of thing: something the family keeps, of no fixed length. As a
                             drop down it pushed everything under it — the whole Management group —
                             off the bottom of the screen for as long as it stayed open, which is
                             the wrong trade for content nobody reads on their way past. -->
                        <Border x:Name="MedicalRow"
                                Style="{StaticResource ElevatedCard}"
                                Padding="14,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52"
                                  SemanticProperties.Description="Medical Information"
                                  SemanticProperties.Hint="Opens the medical notes kept for this CardiMember">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMedicalTapped"/>
                                </Grid.GestureRecognizers>
                                <Image Grid.Column="0"
                                       Source="icon_lock.svg"
                                       WidthRequest="22" HeightRequest="22"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Medical Information"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <!-- Management / danger zone -->
                        <VerticalStackLayout Spacing="4" Margin="0,10,0,0">
                            <Label Text="Management" Style="{StaticResource DashboardSectionTitle}"/>
                            <Label Text="Alerts, devices, monitoring and removal"
                                   Style="{StaticResource Body2}"/>
                        </VerticalStackLayout>

                        <!-- Alert rules (per-CardiMember generation toggles; instant save). In
                             Management rather than up with the rows about the member: it is not a
                             fact about them, it is a setting for how CardiTrack watches them,
                             which is what this group already collects.

                             It leads the group. What a caregiver comes to Management to change is
                             usually what CardiTrack watches for; the three rows under it are a
                             device they will set up once, a pause they will use rarely, and a
                             removal they will use never. Ordering by consequence — the harmless
                             row first, the destructive one last — put the most-used row second
                             behind the least-used one, which is a tidy rule and the wrong outcome.
                             Pause and Remove keep their places at the bottom, which is what that
                             rule was really protecting.

                             Still a row that opens in place rather than a page: the switches are
                             the content, there is no reading to do, and a caregiver changing two
                             of them should not have to travel for it. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52"
                                      SemanticProperties.Description="Alert Rules"
                                      SemanticProperties.Hint="Shows or hides which alerts CardiTrack checks for">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToggleAlertRulesTapped"/>
                                    </Grid.GestureRecognizers>
                                    <!-- Sliders, not the bell the header already uses for the
                                         alerts inbox: this opens what CardiTrack watches for, not
                                         what it has found. -->
                                    <Image Grid.Column="0"
                                           Source="icon_sliders.svg"
                                           WidthRequest="22" HeightRequest="22"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="Alert Rules"
                                           Style="{StaticResource Body1SemiBoldDark}"
                                           VerticalTextAlignment="Center"/>
                                    <!-- Rotated rather than swapped for a second glyph, so the
                                         arrow turns to point at what it opened. Matches
                                         AccordionSection, which every other collapsible is on. -->
                                    <Image x:Name="AlertRulesChevron"
                                           Grid.Column="2"
                                           Source="icon_chevron_down.svg"
                                           WidthRequest="20" HeightRequest="20"
                                           VerticalOptions="Center"/>
                                </Grid>

                                <VerticalStackLayout x:Name="AlertRulesBody"
                                                     IsVisible="False"
                                                     Spacing="10"
                                                     Margin="0,0,0,12">
                                    <!-- Inside the body rather than under the header: it explains
                                         what the switches do, so it is only worth reading once
                                         they are on screen. -->
                                    <Label Text="Turn a rule off and CardiTrack will not check for it"
                                           Style="{StaticResource Body2}"/>

                                    <!-- Cluster cards are built in code-behind as OutlinedCards:
                                         they sit on this card now rather than on the page ground,
                                         and a second elevation there reads as clutter. -->
                                    <VerticalStackLayout x:Name="AlertRulesHost" Spacing="10"/>

                                    <Border x:Name="AlertRulesSkeleton"
                                            Style="{StaticResource OutlinedCard}"
                                            IsVisible="False">
                                        <controls:SkeletonView HeightRequest="120"/>
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Manage Device, which used to be one of a pair of outline buttons
                             halfway up the page. It is the same kind of thing as the rows either
                             side of it — a way in to managing this member rather than a fact about
                             them — and like the alert rules above it, it changes nothing on its
                             own. The two rows below do. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnManageDevicesTapped"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52">
                                <Image Grid.Column="0" Source="icon_watch.svg"
                                       WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Manage Device"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                            <VerticalStackLayout x:Name="PauseRowLayout">
                                <!-- The recognizer sits on the header row, not the card, so taps
                                     on a duration below reach their own row instead of
                                     re-toggling the drop down. -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPauseMonitoringTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Image Grid.Column="0" Source="icon_pause.svg"
                                           WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                                    <!-- Amber, and the icon with it: pausing is the one row here
                                         that stops CardiTrack watching, so it should not read as
                                         another neutral way in. Amber rather than red because it
                                         is reversible from this same row — red is kept for the
                                         removal below it. -->
                                    <Label x:Name="PauseRowLabel"
                                           Grid.Column="1"
                                           Text="Pause Monitoring"
                                           Style="{StaticResource Body1SemiBoldDark}"
                                           TextColor="{StaticResource CautionAmber}"
                                           VerticalTextAlignment="Center"/>
                                    <Image x:Name="PauseRowChevron"
                                           Grid.Column="2" Source="icon_chevron.svg"
                                           WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                                </Grid>

                                <!-- Duration drop down. The durations used to arrive as a modal
                                     list of buttons; they now open in place under the row that
                                     asks for them. Rows are built in code-behind from the same
                                     PauseDurations table the confirm step reads, and the open
                                     /close animation is AccordionSection's — a clipping Border
                                     grown to the measured height, since a plain layout wouldn't
                                     clip its content mid-slide. -->
                                <Border x:Name="PauseDurationsClip"
                                        StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        Padding="0"
                                        HeightRequest="0">
                                    <VerticalStackLayout x:Name="PauseDurationsHost"
                                                         Padding="0,0,0,10"
                                                         VerticalOptions="Start"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- The destructive one: removal takes the member, the caregiver links to
                             them and their device connections off this account, and the confirm
                             step behind it should not be the first hint of that. A deeper red than
                             the severity token (#E53E3E) — that one is drawn as a fill or a dot,
                             this is 16px label text on white and has to clear 4.5:1 against it. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRemoveMemberTapped"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="52">
                                <Image Grid.Column="0" Source="icon_person_remove.svg"
                                       WidthRequest="22" HeightRequest="22" VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Remove CardiMember"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       TextColor="{StaticResource DangerRed}"
                                       VerticalTextAlignment="Center"/>
                                <Image Grid.Column="2" Source="icon_chevron.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <!-- M1-13/M1-14/M1-15 all show the bottom nav in Figma, and these pages sit on
             top of the Dashboard tab. Tapping Home here pops back down to it. -->
        <controls:BottomNavBar Grid.Row="2" Tab="Dashboard"/>
    </Grid>
</ContentPage>

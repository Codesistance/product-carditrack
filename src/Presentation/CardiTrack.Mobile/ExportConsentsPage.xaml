<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.ExportConsentsPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- Needs design sync — no Figma frame. Settings subpage for standing
         export confirmations: stop one still in force, and read every earlier one. -->
    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None, Container, None, None">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <controls:SquareBorder Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           SemanticProperties.Description="Back"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Export confirmations"
                           Style="{StaticResource Heading3}"
                           TextColor="{StaticResource White}"/>
                    <Label Text="Stop a kept one, or see earlier ones"
                            FontFamily="Quicksand"
                            FontSize="12"
                            TextColor="{StaticResource White}"
                            Opacity="0.85"
                            LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,24" Spacing="12">

                <ActivityIndicator x:Name="Loading"
                                   IsRunning="True"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   Margin="0,24"/>

                <VerticalStackLayout x:Name="Panel" IsVisible="False" Spacing="12">
                    <Label Text="A confirmation you keep for a week, two weeks or a month can be reused on later exports. We always tell you when that happens. Stopping it means the next export asks again."
                           Style="{StaticResource Body2}"/>

                    <VerticalStackLayout x:Name="ActiveList" Spacing="10"/>

                    <Label x:Name="HistoryTitle"
                           Text="Earlier confirmations"
                           Style="{StaticResource DashboardSectionTitle}"
                           Margin="4,8,4,0"
                           IsVisible="False"/>

                    <VerticalStackLayout x:Name="HistoryList" Spacing="10"/>

                    <Label x:Name="EmptyLabel"
                           Text="You haven't confirmed an export yet."
                           Style="{StaticResource Body2}"
                           IsVisible="False"/>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="10" Margin="0,24">
                    <Label Text="Couldn't load your export confirmations."
                           Style="{StaticResource Body1SemiBoldDark}"
                           HorizontalTextAlignment="Center"/>
                    <Button Text="Try again"
                            Style="{StaticResource PrimaryGradientButton}"
                            HorizontalOptions="Center"
                            Clicked="OnRetryClicked"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

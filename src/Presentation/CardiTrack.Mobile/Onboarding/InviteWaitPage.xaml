<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Onboarding.InviteWaitPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageGround}">

    <Grid>
        <Grid RowDefinitions="Auto,*"
              SafeAreaEdges="None, Container, None, None">

            <controls:WizardHeader x:Name="Header"
                                   Grid.Row="0"
                                   Title="Waiting for them"
                                   Step="They finish on their own device"
                                   BackRequested="OnCancelTapped"
                                   ContentPadding="20,14,20,16"/>

            <ScrollView Grid.Row="1">
                <Grid Padding="20,24,20,36">
                    <VerticalStackLayout Spacing="0">

                        <Label x:Name="TitleHeading"
                               Text="Ask them to scan this"
                               Style="{StaticResource Heading2}"
                               HorizontalTextAlignment="Center"/>

                        <Label x:Name="SubHeading"
                               Text="Hold your phone up so they can scan it with their camera."
                               Style="{StaticResource Body2}"
                               HorizontalTextAlignment="Center"
                               Margin="0,10,0,0"/>

                        <!-- The code itself. White plate under it on purpose: a QR scanned off a
                             screen needs the quiet zone to be genuinely white, and the page ground
                             is not. -->
                        <Border x:Name="QrPlate"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource Divider}"
                                StrokeThickness="1"
                                Padding="18"
                                HorizontalOptions="Center"
                                Margin="0,22,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <Image x:Name="QrImage"
                                   WidthRequest="220"
                                   HeightRequest="220"
                                   Aspect="AspectFit"/>
                        </Border>

                        <!-- Shown instead of the code when the caregiver asked for a link. The
                             link itself is on the screen: nothing has been sent, and sending it is
                             the caregiver's own deliberate tap below. -->
                        <Border x:Name="LinkPlate"
                                IsVisible="False"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource Divider}"
                                StrokeThickness="1"
                                Padding="16,10,10,10"
                                Margin="0,22,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                <!-- Truncated rather than wrapped: the caregiver shares or copies
                                     this, they never have to read it. -->
                                <Label x:Name="LinkLabel"
                                       Text=""
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource HeadingText}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center"/>

                                <!-- Padding rather than a bigger glyph: a 24dp icon is the right
                                     size to look at and the wrong size to hit. -->
                                <Image x:Name="CopyIcon"
                                       Grid.Column="1"
                                       Source="icon_clipboard.svg"
                                       WidthRequest="24" HeightRequest="24"
                                       Margin="8"
                                       VerticalOptions="Center"
                                       SemanticProperties.Description="Copy link">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCopyTapped"/>
                                    </Image.GestureRecognizers>
                                </Image>

                                <Image x:Name="ShareIcon"
                                       Grid.Column="2"
                                       Source="icon_share.svg"
                                       WidthRequest="24" HeightRequest="24"
                                       Margin="8"
                                       VerticalOptions="Center"
                                       SemanticProperties.Description="Share link">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnShareClicked"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </Border>

                        <!-- Live status: what they have done so far, and how long is left. -->
                        <Border x:Name="StatusPlate"
                                BackgroundColor="{StaticResource White}"
                                Stroke="{StaticResource Divider}"
                                StrokeThickness="1"
                                Padding="16,14"
                                Margin="0,22,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <ActivityIndicator x:Name="StatusSpinner"
                                                   IsRunning="True"
                                                   Color="{StaticResource Primary}"
                                                   WidthRequest="20" HeightRequest="20"
                                                   VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label x:Name="StatusLabel"
                                           Text="Waiting for them to open it"
                                           Style="{StaticResource Body1SemiBoldDark}"/>
                                    <Label x:Name="CountdownLabel"
                                           Text=""
                                           Style="{StaticResource Body2}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Label x:Name="WaitError"
                               Style="{StaticResource AuthErrorLabel}"
                               FontSize="14"
                               IsVisible="False"
                               HorizontalTextAlignment="Center"
                               Margin="0,16,0,0"/>

                        <controls:AppButton x:Name="ResendBtn"
                                            Text="Send again"
                                            HorizontalOptions="Fill"
                                            IsVisible="False"
                                            Margin="0,24,0,0"
                                            Clicked="OnResendClicked"
                                            Tone="Primary"
                                            Size="L"/>

                        <Label x:Name="CancelLink"
                               Text="Cancel"
                               Style="{StaticResource PrimaryLink}"
                               TextDecorations="None"
                               FontSize="16"
                               HorizontalOptions="Center"
                               Margin="0,20,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCancelTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>

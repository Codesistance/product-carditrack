<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Onboarding.AccountSetupPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageGround}">

    <Grid RowDefinitions="Auto,*">

        <!-- ════════════════════════════════════════
             GRADIENT HEADER
             ════════════════════════════════════════ -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,48,20,32">
            <VerticalStackLayout Spacing="4">
                <Label Text="Almost There"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}" />
                <Label Text="Getting CardiTrack ready for you"
                       Style="{StaticResource Body1SemiBold}" />
            </VerticalStackLayout>
        </controls:HeaderBand>

        <!-- ════════════════════════════════════════
             SETUP PROGRESS
             Nothing left to ask: an account made on the phone is always a family
             account, and its name comes from the signed-in user. The page runs the
             setup call itself and only ever reports progress or offers a retry.
             ════════════════════════════════════════ -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="20,20,20,36"
                             Spacing="14"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

            <ActivityIndicator x:Name="SetupSpinner"
                               IsRunning="True"
                               WidthRequest="44" HeightRequest="44"/>

            <Label x:Name="SetupStatus"
                   Text="Setting up your account..."
                   Style="{StaticResource Body1SemiBoldDark}"
                   HorizontalTextAlignment="Center"/>

            <Label x:Name="SetupError"
                   Style="{StaticResource AuthErrorLabel}"
                   IsVisible="False"
                   HorizontalTextAlignment="Center"/>

            <Button x:Name="RetryBtn"
                    Text="Try again"
                    Style="{StaticResource AuthGradientButton}"
                    IsVisible="False"
                    Margin="0,10,0,0"
                    Clicked="OnRetryClicked"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>

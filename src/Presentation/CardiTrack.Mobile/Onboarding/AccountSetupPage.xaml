<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Onboarding.AccountSetupPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- Top safe area claimed by this layout, not the page (see AlertsPage): the header band
         is drawn against the status-bar inset, so it takes the same compact padding as every
         other screen's header. -->
    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None, Container, None, None">

        <!-- ════════════════════════════════════════
             GRADIENT HEADER
             ════════════════════════════════════════ -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                <!-- The circle every header carries, but not a back arrow: this page is the
                     window's root — PostLoginRouter swaps it in, with no shell and nothing
                     behind it — so there is no screen to go back to, and an arrow that does
                     nothing reads as a broken screen. Decorative, like the wizard's terminal
                     steps (WizardHeader with IsBackVisible off): the title beside it is what
                     screen readers announce. -->
                <controls:SquareBorder Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill"
                        InputTransparent="True"
                        AutomationProperties.IsInAccessibleTree="False">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <Image Source="icon_home_white.svg"
                           WidthRequest="20" HeightRequest="20"
                           AutomationProperties.IsInAccessibleTree="False"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Almost There"
                           Style="{StaticResource Heading3}"
                           TextColor="{StaticResource White}"/>
                    <Label Text="Getting CardiTrack ready for you"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <!-- ════════════════════════════════════════
             SETUP PROGRESS
             Nothing left to ask: an account made on the phone is always a family
             account, and its name comes from the signed-in user. The page runs the
             setup call itself and only ever reports progress or offers a retry.
             ════════════════════════════════════════ -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="20,20,20,36"
                             Spacing="14"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

            <ActivityIndicator x:Name="SetupSpinner"
                               IsRunning="True"
                               WidthRequest="44" HeightRequest="44"/>

            <Label x:Name="SetupStatus"
                   Text="Setting up your account..."
                   Style="{StaticResource Body1SemiBoldDark}"
                   HorizontalTextAlignment="Center"/>

            <Label x:Name="SetupError"
                   Style="{StaticResource AuthErrorLabel}"
                   IsVisible="False"
                   HorizontalTextAlignment="Center"/>

            <controls:AppButton x:Name="RetryBtn"
                                Text="Try again"
                                IsVisible="False"
                                Margin="0,10,0,0"
                                Clicked="OnRetryClicked"
                                Tone="Primary"
                                Size="L"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Onboarding.AccountSetupPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageGround}">

    <ScrollView>
        <Grid RowDefinitions="Auto,*">

            <!-- ════════════════════════════════════════
                 GRADIENT HEADER
                 ════════════════════════════════════════ -->
            <controls:HeaderBand Grid.Row="0" ContentPadding="20,48,20,32">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Almost There"
                           Style="{StaticResource Heading3}"
                           TextColor="{StaticResource White}" />
                    <Label Text="Tell us how you'll use CardiTrack"
                           Style="{StaticResource Body1SemiBold}" />
                </VerticalStackLayout>
            </controls:HeaderBand>

            <!-- ════════════════════════════════════════
                 SETUP FORM (full-bleed)
                 ════════════════════════════════════════ -->
            <Grid Grid.Row="1"
                  Padding="20,20,20,36">
                <VerticalStackLayout Spacing="12">

                    <!-- Family option -->
                    <Border x:Name="FamilyCard"
                            BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource InputBorder}"
                            StrokeThickness="1.5"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFamilyTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Grid WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                                <Ellipse x:Name="FamilyRing"
                                         Stroke="{StaticResource InputBorder}"
                                         StrokeThickness="2"
                                         Fill="Transparent"/>
                                <Ellipse x:Name="FamilyDot"
                                         WidthRequest="12" HeightRequest="12"
                                         HorizontalOptions="Center" VerticalOptions="Center"
                                         Fill="{StaticResource Primary}"
                                         Opacity="0" Scale="0.5"/>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="My Family"
                                       FontFamily="Quicksand" FontAttributes="Bold" FontSize="18"
                                       TextColor="{StaticResource HeadingText}"/>
                                <Label Text="I'm watching over my parents or loved ones"
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource BodyText}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Business option -->
                    <Border x:Name="BusinessCard"
                            BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource InputBorder}"
                            StrokeThickness="1.5"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBusinessTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Grid WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                                <Ellipse x:Name="BusinessRing"
                                         Stroke="{StaticResource InputBorder}"
                                         StrokeThickness="2"
                                         Fill="Transparent"/>
                                <Ellipse x:Name="BusinessDot"
                                         WidthRequest="12" HeightRequest="12"
                                         HorizontalOptions="Center" VerticalOptions="Center"
                                         Fill="{StaticResource Primary}"
                                         Opacity="0" Scale="0.5"/>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="My Organization"
                                       FontFamily="Quicksand" FontAttributes="Bold" FontSize="18"
                                       TextColor="{StaticResource HeadingText}"/>
                                <Label Text="I provide care professionally (care home, agency)"
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource BodyText}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Organization name (business only) -->
                    <VerticalStackLayout x:Name="OrgNameSection"
                                         IsVisible="False"
                                         Spacing="6"
                                         Margin="0,8,0,0">
                        <Label Text="Organization Name" Style="{StaticResource AuthFieldLabel}"/>
                        <Border x:Name="OrgNameBorder" Style="{StaticResource AuthEntryBorder}">
                            <Entry x:Name="OrgNameEntry"
                                   Style="{StaticResource AuthEntry}"
                                   Placeholder="e.g. Sunrise Care Home"
                                   ReturnType="Done"/>
                        </Border>
                        <Label x:Name="OrgNameError" Style="{StaticResource AuthErrorLabel}" IsVisible="False"/>
                    </VerticalStackLayout>

                    <!-- Inline error -->
                    <Label x:Name="SetupError"
                           Style="{StaticResource AuthErrorLabel}"
                           IsVisible="False"
                           Margin="0,8,0,0"/>

                    <!-- Continue -->
                    <Button x:Name="ContinueBtn"
                            Text="Continue"
                            Style="{StaticResource AuthGradientButton}"
                            HorizontalOptions="Fill"
                            Margin="0,20,0,0"
                            IsEnabled="False"
                            Clicked="OnContinueClicked"/>

                </VerticalStackLayout>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>

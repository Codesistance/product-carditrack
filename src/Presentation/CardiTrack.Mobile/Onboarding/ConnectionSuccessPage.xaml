<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Onboarding.ConnectionSuccessPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource White}">

    <ScrollView>
        <Grid RowDefinitions="Auto,*">

            <controls:WizardHeader Grid.Row="0"
                                   Title="Fitbit Connection"
                                   IsBackVisible="False"/>

            <Grid Grid.Row="1"
                  BackgroundColor="{StaticResource White}"
                  Padding="20,28,20,36">
                <VerticalStackLayout Spacing="0">

                    <!-- Success check (M1-07) -->
                    <Border WidthRequest="104" HeightRequest="104"
                            BackgroundColor="#2ECC80"
                            StrokeThickness="0"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="52"/>
                        </Border.StrokeShape>
                        <Label Text="&#x2713;"
                               FontSize="48" FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="You're all set!"
                           Style="{StaticResource Heading2}"
                           HorizontalTextAlignment="Center"
                           Margin="0,20,0,0"/>
                    <Label x:Name="ConnectedLabel"
                           Text="The Fitbit is now connected"
                           Style="{StaticResource Body2}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           Margin="0,6,0,0"/>

                    <!-- Latest Data preview card -->
                    <Border Style="{StaticResource DashboardCard}" Margin="0,28,0,0">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Latest Data" Style="{StaticResource DashboardSectionTitle}"/>
                                <Border x:Name="SyncBadge"
                                        Grid.Column="1"
                                        BackgroundColor="#E3F1FE"
                                        StrokeThickness="0"
                                        Padding="10,4"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <Label x:Name="SyncBadgeLabel"
                                           Text="SYNCING"
                                           FontFamily="QuicksandSemiBold"
                                           FontSize="10"
                                           TextColor="{StaticResource Primary}"/>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,18,0,0">
                                <Image Source="icon_metric_steps.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Steps Today" Style="{StaticResource Body1SemiBoldDark}" VerticalOptions="Center"/>
                                <Label x:Name="StepsValue" Grid.Column="2" Text="Syncing..." Style="{StaticResource MetricValue}" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView Style="{StaticResource DividerLine}" Margin="0,14,0,0"/>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,14,0,0">
                                <Image Source="icon_refresh.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Last Synced" Style="{StaticResource Body1SemiBoldDark}" VerticalOptions="Center"/>
                                <Label x:Name="SyncedValue" Grid.Column="2" Text="Just now" Style="{StaticResource Body2}" FontSize="16" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView Style="{StaticResource DividerLine}" Margin="0,14,0,0"/>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,14,0,0">
                                <Image Source="icon_metric_heart.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Heart Rate" Style="{StaticResource Body1SemiBoldDark}" VerticalOptions="Center"/>
                                <Label x:Name="HeartRateValue" Grid.Column="2" Text="Syncing..." Style="{StaticResource MetricValue}" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="&#x2295; Add Another Device"
                            Style="{StaticResource SecondaryOutlineButton}"
                            HorizontalOptions="Fill"
                            Margin="0,32,0,0"
                            Clicked="OnAddAnotherClicked"/>

                    <Button Text="Continue to Dashboard"
                            Style="{StaticResource AuthGradientButton}"
                            HorizontalOptions="Fill"
                            Margin="0,14,0,0"
                            Clicked="OnContinueClicked"/>

                    <Label Text="You can sync multiple devices to get a more accurate picture of their health."
                           Style="{StaticResource Body2}"
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           Margin="24,14,24,0"/>

                </VerticalStackLayout>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Onboarding.ConnectionSuccessPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- Same scaffold as Dashboard/Alerts: the gradient band is pinned, not inside the
         scroller, and the top safe-area is claimed here so WizardHeader can use the compact
         inset those screens use rather than a second status-bar pad. -->
    <Grid RowDefinitions="Auto,*"
          SafeAreaEdges="None, Container, None, None">

        <controls:WizardHeader Grid.Row="0"
                               Title="Device Connection"
                               IsBackVisible="False"
                               ContentPadding="20,14,20,16"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,24,20,36" Spacing="0">

                <!-- Same success glyph the dashboard hero uses for "all steady". -->
                <Border WidthRequest="104" HeightRequest="104"
                        BackgroundColor="{StaticResource PillGreenBackground}"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="52"/>
                    </Border.StrokeShape>
                    <Image Source="icon_status_check.svg"
                           WidthRequest="56" HeightRequest="56"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <Label Text="You're all set!"
                       Style="{StaticResource Heading3}"
                       HorizontalTextAlignment="Center"
                       Margin="0,20,0,0"/>
                <Label x:Name="ConnectedLabel"
                       Text="The device is now connected"
                       Style="{StaticResource Body2}"
                       HorizontalTextAlignment="Center"
                       Margin="0,6,0,0"/>

                <Border Style="{StaticResource ElevatedCard}" Margin="0,28,0,0">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Latest Data" Style="{StaticResource DashboardSectionTitle}"/>
                            <Border x:Name="SyncBadge"
                                    Grid.Column="1"
                                    BackgroundColor="{StaticResource SelectedOptionBackground}"
                                    StrokeThickness="0"
                                    Padding="10,4"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label x:Name="SyncBadgeLabel"
                                       Text="SYNCING"
                                       FontFamily="QuicksandSemiBold"
                                       FontSize="10"
                                       TextColor="{StaticResource Primary}"/>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,18,0,0">
                            <Image Source="icon_metric_steps.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Steps Today" Style="{StaticResource Body1SemiBoldDark}" VerticalOptions="Center"/>
                            <Label x:Name="StepsValue" Grid.Column="2" Text="Syncing..." Style="{StaticResource MetricValue}" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView Style="{StaticResource DividerLine}" Margin="0,14,0,0"/>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,14,0,0">
                            <Image Source="icon_refresh.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Last Synced" Style="{StaticResource Body1SemiBoldDark}" VerticalOptions="Center"/>
                            <Label x:Name="SyncedValue" Grid.Column="2" Text="Just now" Style="{StaticResource Body2}" FontSize="16" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView Style="{StaticResource DividerLine}" Margin="0,14,0,0"/>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,14,0,0">
                            <Image Source="icon_metric_heart.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Heart Rate" Style="{StaticResource Body1SemiBoldDark}" VerticalOptions="Center"/>
                            <Label x:Name="HeartRateValue" Grid.Column="2" Text="Syncing..." Style="{StaticResource MetricValue}" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Outline chrome matches SecondaryOutlineButton; the plus is the same SVG
                     Device Management uses rather than a unicode glyph in the label. -->
                <Border Style="{StaticResource GoogleButton}"
                        Stroke="{StaticResource PrimaryDark}"
                        Margin="0,32,0,0"
                        SemanticProperties.Description="Add another device">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddAnotherClicked"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="10"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                        <Image Source="icon_plus.svg"
                               WidthRequest="22" HeightRequest="22"
                               VerticalOptions="Center"/>
                        <Label Text="Add Another Device"
                               FontFamily="Quicksand"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Button x:Name="ContinueBtn"
                        Text="Continue"
                        Style="{StaticResource AuthGradientButton}"
                        HorizontalOptions="Fill"
                        Margin="0,14,0,0"
                        Clicked="OnContinueClicked"/>

                <Label Text="You can sync multiple devices to get a more accurate picture of their health."
                       Style="{StaticResource Body2}"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       Margin="24,14,24,0"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

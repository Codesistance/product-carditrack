<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.JournalEntryPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- One day's review in full, pushed above the Daybook tab the way an alert's detail is
         pushed above the Alerts list. A page rather than an in-card expansion because the account
         runs to a dozen sentences and now carries the trend charts beneath it — content that
         would make the list unscannable expanded in place.

         No Figma frame, like JournalPage — see the design-sync backlog. -->

    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="None, Container, None, None">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <!-- Fill + width-bound-to-height: the circle runs from the title's top to
                         the description's bottom and stays square at whatever that is, so every
                         header's icon matches its own text block exactly. The 40 floor keeps the
                         back button a real tap target; 99 clamps to a circle at any size. -->
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"/>
                </controls:SquareBorder>

                <!-- Whose daybook this is. The list passes the name so the header is right
                     from the first frame; a deep link without one falls back to the bare word
                     until the member fetch fills it in. -->
                <!-- Title with what the page is tight beneath it — one stack, top-aligned
                     with the icon. The description is declared after the title, so screen
                     readers announce them in reading order. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label x:Name="HeaderTitle"
                       Text="Daybook"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label Text="One day, read against what is usual for them"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <RefreshView x:Name="Refresher"
                     Grid.Row="1"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView>
                <Grid Padding="20,20,20,24">

                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                        <Border Style="{StaticResource ElevatedCard}" HeightRequest="220"/>
                        <Border Style="{StaticResource ElevatedCard}" HeightRequest="260"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="12">
                        <Border Style="{StaticResource ElevatedCard}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Couldn't load this entry"
                                       Style="{StaticResource Body1SemiBoldDark}"/>
                                <Label x:Name="ErrorDetailLabel"
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource BodyText}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Button Text="Try again"
                                Style="{StaticResource SecondaryOutlineButton}"
                                Clicked="OnRetryClicked"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ContentPanel" Spacing="14" IsVisible="False">

                        <!-- The entry itself: when, what it was about, the account, and the
                             suggestion beneath it. How soon it asks for attention is the rail
                             down the left, the same construction the list tiles and the alert
                             tiles use — a coloured rect under a white card inset 4px — rather
                             than a word in a pill. -->
                        <Border x:Name="EntryRail"
                                StrokeThickness="0"
                                Padding="4,0,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.15" Radius="14" Offset="0,4"/>
                            </Border.Shadow>

                        <Border BackgroundColor="{StaticResource White}"
                                StrokeThickness="0"
                                Padding="20">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label x:Name="DayLabel"
                                               Style="{StaticResource Heading2}"/>
                                        <!-- Dark like the account below it: the headline is what the day
                                             was about, which is the message, not a caption on it. -->
                                        <Label x:Name="HeadlineLabel"
                                               Style="{StaticResource Body2Dark}"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <Label x:Name="TextLabel"
                                       Style="{StaticResource Body2Dark}"
                                       LineBreakMode="WordWrap"/>

                                <BoxView x:Name="SuggestionDivider"
                                         HeightRequest="1"
                                         Color="{StaticResource Divider}"/>
                                <Label Text="One thing you could do"
                                       x:Name="SuggestionTitle"
                                       Style="{StaticResource DashboardSectionTitle}"/>
                                <Label x:Name="SuggestionLabel"
                                       Style="{StaticResource Body2Dark}"/>

                                <Label x:Name="GeneratedLabel"
                                       Style="{StaticResource MetricRowCaption}"
                                       TextColor="{StaticResource MutedText}"/>
                            </VerticalStackLayout>
                        </Border>
                        </Border>

                        <!-- The trends the review can be read against: the fortnight ending on
                             the entry's own day, titled with that day. A daybook is a closure
                             summary — days after its day, today included, are of no consequence
                             to it — so an entry the series no longer reaches back to hides this
                             whole section rather than drawing a window shifted toward the
                             present. The awareness lines below count the same days the chart
                             draws. Text is a fallback; ApplyTrends names the actual day. -->
                        <Label x:Name="TrendsTitle"
                               Text="The 14 days up to this day"
                               Style="{StaticResource DashboardSectionTitle}"
                               Margin="0,6,0,0"/>

                        <VerticalStackLayout x:Name="TrendsHost" Spacing="14"/>

                        <!-- The regulatory footing, on the screen rather than in a policy: these
                             are counts a caregiver can check against the charts above, not a
                             finding about the person. -->
        <!-- Start, overriding the caption style's End: the keys under the charts sit right,
                             the way chart captions do, but this is a standing statement the page
                             makes and it reads from the left like the prose above it. -->
                        <Label x:Name="AwarenessFooter"
                               Text="For awareness, not medical advice — CardiTrack never diagnoses. Talk to a clinician about anything that worries you."
                               Style="{StaticResource MetricRowCaption}"
                               TextColor="{StaticResource MutedText}"
                               HorizontalTextAlignment="Start"
                               LineBreakMode="WordWrap"/>

                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <controls:BottomNavBar Grid.Row="2" Tab="Journal"/>

        <!-- Chat from anywhere; the code-behind feeds it this entry's member. -->
        <controls:ChatBotLauncher x:Name="ChatBot" Grid.Row="1"/>
    </Grid>
</ContentPage>

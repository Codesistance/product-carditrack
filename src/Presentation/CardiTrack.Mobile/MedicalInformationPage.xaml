<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.MedicalInformationPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- The notes a family keeps about a CardiMember — allergies, chronic conditions, anything a
         caregiver arriving in a hurry would want to have read already.

         A page rather than the drop down it used to be, matching Questions & Answers next to it.
         Both are somewhere the family keeps something, both can run to any length, and a drop down
         that long pushed everything under it — the whole Management group — off the bottom of the
         screen for as long as it stayed open. Full-bleed, like every page. -->

    <Grid RowDefinitions="Auto,*">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,26">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <!-- Fill + width-bound-to-height: the circle runs from the title's top to
                         the description's bottom and stays square at whatever that is, so every
                         header's icon matches its own text block exactly. The 40 floor keeps the
                         back button a real tap target; 99 clamps to a circle at any size. -->
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"
                           SemanticProperties.Description="Back"/>
                </controls:SquareBorder>

                <!-- Title with what the page is tight beneath it — one stack, top-aligned
                     with the icon. The description is declared after the title, so screen
                     readers announce them in reading order. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Medical Information"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label Text="The notes their readings are read alongside"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <!-- Named on the Border rather than the image inside it, the way Member Detail's
                     own edit affordance is: hiding the inner element alone would leave the tinted
                     chip behind as an empty square for everyone who is not the primary caregiver. -->
                <Border x:Name="EditButton"
                        Grid.Column="2"
                        WidthRequest="40" HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource White}"
                        IsVisible="False"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Edit medical information"
                        SemanticProperties.Hint="Opens the profile form on the medical notes">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditTapped"/>
                    </Border.GestureRecognizers>
                    <Image Source="icon_edit.svg" WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>
        </controls:HeaderBand>

        <Grid Grid.Row="1">

            <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" Padding="20,20" IsVisible="False">
                <controls:SkeletonView HeightRequest="160"/>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ErrorPanel" Spacing="12" Padding="20,60,20,20" IsVisible="False">
                <Label Text="We couldn't load this"
                       Style="{StaticResource Heading3}"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="ErrorDetailLabel"
                       Style="{StaticResource Body2}"
                       TextColor="{StaticResource BodyText}"
                       HorizontalTextAlignment="Center"/>
                <Button Text="Try again"
                        Style="{StaticResource SecondaryOutlineButton}"
                        HorizontalOptions="Center"
                        Clicked="OnRetryClicked"/>
            </VerticalStackLayout>

            <RefreshView x:Name="Refresher" Refreshing="OnPullToRefresh">
                <ScrollView>
                    <VerticalStackLayout x:Name="ContentPanel"
                                         Spacing="14"
                                         Padding="20,20,20,32"
                                         IsVisible="False">

                        <Border Style="{StaticResource ElevatedCard}">
                            <VerticalStackLayout Spacing="10">
                                <Label x:Name="NotesTitleLabel"
                                       Text="Medical Notes"
                                       Style="{StaticResource DashboardSectionTitle}"/>
                                <Label x:Name="NotesLabel"
                                       Style="{StaticResource Body2}"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Only for the caregiver who can act on it. The API refuses an edit from
                             anyone else, so offering the button to them would be a trap. -->
                        <Button x:Name="AddNotesButton"
                                Text="Add medical notes"
                                Style="{StaticResource SecondaryOutlineButton}"
                                IsVisible="False"
                                Clicked="OnEditClicked"/>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>

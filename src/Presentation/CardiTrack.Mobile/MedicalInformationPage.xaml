<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.MedicalInformationPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- The medical information a family keeps about a CardiMember, as a ledger of lines —
         conditions, allergies, medications — each dated and signed, with a history of what changed.

         A page rather than the drop down it used to be, matching Questions & Answers next to it.
         Both are somewhere the family keeps something, both can run to any length, and a drop down
         that long pushed everything under it — the whole Management group — off the bottom of the
         screen for as long as it stayed open. Full-bleed, like every page. -->

    <!-- Top safe area claimed by this layout, not the page (see AlertsPage): the header band is
         drawn against the status-bar inset; the bottom is released like every other page's. -->
    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None, Container, None, None">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <!-- Fill + width-bound-to-height: the circle runs from the title's top to
                         the description's bottom and stays square at whatever that is, so every
                         header's icon matches its own text block exactly. The 40 floor keeps the
                         back button a real tap target; 99 clamps to a circle at any size. -->
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"
                           SemanticProperties.Description="Back"/>
                </controls:SquareBorder>

                <!-- Title with what the page is tight beneath it — one stack, top-aligned
                     with the icon. The description is declared after the title, so screen
                     readers announce them in reading order. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Medical Information"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label Text="What a caregiver should know before they arrive"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <Grid Grid.Row="1">

            <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" Padding="20,20" IsVisible="False">
                <controls:SkeletonView HeightRequest="160"/>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ErrorPanel" Spacing="12" Padding="20,60,20,20" IsVisible="False">
                <Label Text="We couldn't load this"
                       Style="{StaticResource Heading3}"/>
                <Label x:Name="ErrorDetailLabel"
                       Style="{StaticResource Body2}"
                       TextColor="{StaticResource BodyText}"/>
                <controls:AppButton Text="Try again"
                                    HorizontalOptions="Start"
                                    Clicked="OnRetryClicked"
                                    Tone="Secondary"
                                    Size="L"/>
            </VerticalStackLayout>

            <RefreshView x:Name="Refresher" Refreshing="OnPullToRefresh">
                <ScrollView>
                    <VerticalStackLayout x:Name="ContentPanel"
                                         Spacing="14"
                                         Padding="20,20,20,32"
                                         IsVisible="False">
                        <controls:SavedDataBanner x:Name="SavedBanner"/>

                        <!-- The ledger: one ruled line per condition, allergy or medication, grouped
                             under its kind — allergies and medicines first — with who wrote it and
                             when underneath. Lines are built in code (ShowLedger); a tap on one
                             offers what can be done with it. -->
                        <Border Style="{StaticResource ElevatedCard}">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label Text="On file"
                                           Style="{StaticResource DashboardSectionTitle}"
                                           VerticalOptions="Center"/>
                                    <!-- Only for the caregiver who can act on it: the API refuses a
                                         change from anyone else, so offering it would be a trap. -->
                                    <controls:AppButton x:Name="AddButton"
                                                        Grid.Column="1"
                                                        Text="Add"
                                                        Icon="icon_btn_plus.svg"
                                                        IsVisible="False"
                                                        Clicked="OnAddClicked"
                                                        Tone="Primary"
                                                        Size="M"/>
                                </Grid>

                                <!-- Where the list stands, as a chip: green while every line is
                                     confirmed within six months, amber once it is due a check, red
                                     while something on it has never been confirmed. The one-tap
                                     confirmation sits beside it, and only when the chip is not
                                     green — confirming a list checked two days ago is noise. -->
                                <Grid x:Name="StatusRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                      Margin="0,8,0,0" IsVisible="False">
                                    <Border x:Name="StatusChip"
                                            StrokeThickness="0"
                                            Padding="10,4"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Label x:Name="StatusLabel"
                                               FontFamily="QuicksandSemiBold"
                                               FontSize="12"/>
                                    </Border>
                                    <controls:AppButton x:Name="AllAccurateButton"
                                                        Grid.Column="2"
                                                        Text="All accurate"
                                                        Icon="icon_btn_resolve.svg"
                                                        IsVisible="False"
                                                        Clicked="OnAllAccurateClicked"
                                                        Tone="Primary"
                                                        Size="M"/>
                                </Grid>

                                <!-- A block of old notes, written before there were lines: offered
                                     to be sorted into lines so an allergy or a medicine in it stands
                                     where it can be seen. Filled in code (ShowSortPrompt). -->
                                <Border x:Name="SortPrompt"
                                        Margin="0,12,0,0"
                                        Padding="12,10"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource PillYellowBackground}"
                                        IsVisible="False">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="These notes are one block"
                                               FontFamily="QuicksandSemiBold"
                                               FontSize="14"
                                               TextColor="{StaticResource ActionAmberInk}"/>
                                        <Label Text="Sort them into lines so allergies and medicines stand out."
                                               FontSize="13"
                                               TextColor="{StaticResource ActionAmberInk}"/>
                                        <controls:AppButton Text="Sort into lines"
                                                            Margin="0,6,0,0"
                                                            Icon="icon_btn_sort.svg"
                                                            HorizontalOptions="Start"
                                                            Clicked="OnSortClicked"
                                                            Tone="Tonal"
                                                            Size="M"/>
                                    </VerticalStackLayout>
                                </Border>

                                <VerticalStackLayout x:Name="LedgerList" Margin="0,4,0,0"/>

                                <Label x:Name="EmptyLabel"
                                       Margin="0,12,0,0"
                                       Style="{StaticResource Body2}"
                                       IsVisible="False"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- What the record used to say: lines changed or taken off, most recent
                             first. Folded away by default — it is for looking back, not for the
                             caregiver arriving in a hurry the card above is written for. -->
                        <Border x:Name="HistoryCard"
                                Style="{StaticResource ElevatedCard}"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                      SemanticProperties.Hint="Shows or hides the history">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnHistoryToggled"/>
                                    </Grid.GestureRecognizers>
                                    <Label x:Name="HistoryTitleLabel"
                                           Style="{StaticResource DashboardSectionTitle}"
                                           VerticalOptions="Center"/>
                                    <Image x:Name="HistoryChevron"
                                           Grid.Column="1"
                                           Source="icon_chevron_down.svg"
                                           WidthRequest="20" HeightRequest="20"
                                           VerticalOptions="Center"/>
                                </Grid>
                                <VerticalStackLayout x:Name="HistoryList" Margin="0,8,0,0" IsVisible="False"/>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Grid>

        <!-- Chat from anywhere; the code-behind feeds it this page's member. -->
        <controls:ChatBotLauncher x:Name="ChatBot" Grid.Row="1"/>

        <!-- The second-long "Updating…" while saved notes are replaced by live data — last, so it
             covers everything. See UpdatingOverlay. -->
        <controls:UpdatingOverlay x:Name="Updating" Grid.RowSpan="2"/>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.NotificationPreferencesPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- The caregiver's own notification preferences (GET/PUT /api/v1/notifications/preferences):
         quiet hours, lock-screen detail, and which categories are muted. User-scoped, not
         per-member — each family member sleeps their own hours — which is why this lives under
         Settings rather than on a CardiMember. Every change saves as it is made; there is no
         Save button to forget. -->
    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None, Container, None, None">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <controls:SquareBorder Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           SemanticProperties.Description="Back"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Notifications"
                           Style="{StaticResource Heading3}"
                           TextColor="{StaticResource White}"/>
                    <Label Text="When and how CardiTrack reaches you"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,24" Spacing="12">

                <ActivityIndicator x:Name="Loading"
                                   IsRunning="True"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   Margin="0,24"/>

                <VerticalStackLayout x:Name="Panel" IsVisible="False" Spacing="14">
                    <controls:SavedDataBanner x:Name="SavedBanner"/>

                    <!-- Alert Settings' shape, which is the app's shape for a page of settings:
                         one elevated card per section, a title and a line of what the section is
                         for, then an outlined card of rows with hairlines between them. The page
                         used to alternate loose section labels with one card per row, so three
                         switches read as three unrelated objects rather than as one page. -->
                    <Border Style="{StaticResource ElevatedCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Quiet hours"
                                   Style="{StaticResource DashboardSectionTitle}"/>
                            <!-- Fixed copy, in the contract's own words: a caregiver setting quiet
                                 hours must know what will still wake them. -->
                            <Label Text="Non-urgent notifications wait until they end. Safety notifications — a device gone quiet, nobody listening — always come through."
                                   Style="{StaticResource Body2}"
                                   LineBreakMode="WordWrap"/>

                            <Border Style="{StaticResource OutlinedCard}" Padding="14,4">
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                          Padding="0,8" MinimumHeightRequest="48"
                                          SemanticProperties.Description="Quiet hours"
                                          SemanticProperties.Hint="Choose the hours when non-urgent notifications wait">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnQuietHoursTapped"/>
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="When they run"
                                                   Style="{StaticResource Body1SemiBoldDark}"
                                                   FontSize="15"/>
                                            <Label Text="The hours you would rather not hear from us"
                                                   Style="{StaticResource Body2}"
                                                   FontSize="13"
                                                   LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                        <Label x:Name="QuietHoursValue"
                                               Grid.Column="1"
                                               Style="{StaticResource Body1SemiBoldDark}"
                                               FontSize="15"
                                               TextColor="{StaticResource Primary}"
                                               VerticalTextAlignment="Center"
                                               VerticalOptions="Center"/>
                                    </Grid>

                                    <BoxView Style="{StaticResource DividerLine}"/>

                                    <!-- D-8's answer, kept where it can be changed. The accept
                                         flow asks this question once and writes it here; a
                                         caregiver who chose in a hurry, or who backed out and
                                         kept the default, needs somewhere to put it right. In
                                         this section because it is the exception to it. -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                          Padding="0,8" MinimumHeightRequest="48">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="Wake me for an unanswered alert"
                                                   Style="{StaticResource Body1SemiBoldDark}"
                                                   FontSize="15"
                                                   LineBreakMode="WordWrap"/>
                                            <Label Text="A red alert nobody has answered after five minutes comes to everybody watching. This decides whether yours waits for your quiet hours to end."
                                                   Style="{StaticResource Body2}"
                                                   FontSize="13"
                                                   LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                        <Switch x:Name="EscalatedSwitch"
                                                Grid.Column="1"
                                                OnColor="{StaticResource Primary}"
                                                VerticalOptions="Center"
                                                Toggled="OnEscalatedToggled"
                                                SemanticProperties.Description="Wake me for an alert nobody else answered"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ElevatedCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="On the lock screen"
                                   Style="{StaticResource DashboardSectionTitle}"/>
                            <Label Text="What somebody glancing at your phone can read without unlocking it."
                                   Style="{StaticResource Body2}"
                                   LineBreakMode="WordWrap"/>

                            <Border Style="{StaticResource OutlinedCard}" Padding="14,4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                      Padding="0,8" MinimumHeightRequest="48">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Show details"
                                               Style="{StaticResource Body1SemiBoldDark}"
                                               FontSize="15"/>
                                        <Label Text="Off shows only that there is something to read"
                                               Style="{StaticResource Body2}"
                                               FontSize="13"
                                               LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                    <Switch x:Name="LockScreenSwitch"
                                            Grid.Column="1"
                                            OnColor="{StaticResource Primary}"
                                            VerticalOptions="Center"
                                            Toggled="OnLockScreenToggled"
                                            SemanticProperties.Description="Show details on the lock screen"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ElevatedCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="What to hear about"
                                   Style="{StaticResource DashboardSectionTitle}"/>
                            <Label Text="Turn off the kinds you would rather not hear. Safety is listed so the page says what cannot be silenced."
                                   Style="{StaticResource Body2}"
                                   LineBreakMode="WordWrap"/>

                            <!-- One row per category the API lets a caregiver mute, built in
                                 code-behind into the same outlined card the sections above use. -->
                            <Border Style="{StaticResource OutlinedCard}" Padding="14,4">
                                <VerticalStackLayout x:Name="CategoryRows" Spacing="0"/>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="10" Margin="0,24">
                    <Label Text="Couldn't load your notification preferences."
                           Style="{StaticResource Body1SemiBoldDark}"
                           HorizontalTextAlignment="Center"/>
                    <controls:AppButton Text="Try again"
                                        HorizontalOptions="Center"
                                        Clicked="OnRetryClicked"
                                        Tone="Primary"
                                        Size="L"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- The second-long "Updating…" while saved notification preferences are replaced by live data —
             last, so it covers everything. See UpdatingOverlay. -->
        <controls:UpdatingOverlay x:Name="Updating" Grid.RowSpan="2"/>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.AlertsPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- M1-10 Alerts List. Figma 101:6525 (default), 101:3840 (empty), 101:6206 (filtered
         empty), 101:4509 (loading). -->

    <!-- Safe area is claimed per edge, and by this layout rather than by the ContentPage:
         SafeAreaEdges is honoured on layouts, and setting it on the page above has no
         effect on Android (verified on API 37). Top keeps the status-bar inset the header
         band is drawn against; bottom releases it, so BottomNavBar can run to the screen
         edge and pad itself instead — see that control. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" SafeAreaEdges="None, Container, None, None">

        <!-- Back arrow, title, and the filter button Figma's header carried. The button opens
             the filter sheet (AlertFilterSheetPage); it replaced the row of five chips that sat
             under the header, which could hold one choice at a time out of three different
             questions and put a caret on every chip that opened nothing. -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <!-- Fill + width-bound-to-height: the circle runs from the title's top to
                         the description's bottom and stays square at whatever that is, so every
                         header's icon matches its own text block exactly. The 40 floor keeps the
                         back button a real tap target; 99 clamps to a circle at any size. -->
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"/>
                </controls:SquareBorder>

                <!-- Title with what the page is tight beneath it — one stack, top-aligned
                     with the icon. The description is declared after the title, so screen
                     readers announce them in reading order. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Alerts"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <!-- Says what the list is narrowed to while it is, so a filtered list can
                         be told from a quiet one without scrolling back to the strip. -->
                    <Label x:Name="SubtitleLabel"
                           Text="Everything that asked for your attention"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <!-- The white square every header uses for its trailing action (the Dashboard's
                     bell, Connected Devices' add): radius 12, no shadow. Filled PrimaryDark with a
                     white glyph while a filter is on, and a count of the parts narrowing the list
                     on its corner — white, not a status colour: a filter is not an alarm. -->
                <Grid Grid.Column="2" VerticalOptions="Start">
                    <Border x:Name="FilterButton"
                            WidthRequest="40" HeightRequest="40"
                            BackgroundColor="{StaticResource White}"
                            StrokeThickness="0"
                            SemanticProperties.Description="Filter alerts">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterTapped"/>
                        </Border.GestureRecognizers>
                        <Image x:Name="FilterIcon"
                               Source="icon_filter.svg"
                               WidthRequest="24" HeightRequest="24"/>
                    </Border>
                    <Border x:Name="FilterCountBadge"
                            IsVisible="False"
                            BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource PrimaryDark}"
                            StrokeThickness="1"
                            WidthRequest="18" HeightRequest="18"
                            HorizontalOptions="End" VerticalOptions="Start"
                            TranslationX="6" TranslationY="-6"
                            InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="9"/>
                        </Border.StrokeShape>
                        <Label x:Name="FilterCountLabel"
                               FontSize="10"
                               FontFamily="QuicksandSemiBold"
                               TextColor="{StaticResource PrimaryDark}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </controls:HeaderBand>

        <!-- What the list is narrowed to, one removable pill per part and a way to clear them
             all — only while a filter is on. Outside the scroller so it stays in view while the
             list scrolls: a filtered list must never be mistaken for the whole one. The bottom
             margin is the gap a scrolled card keeps from the strip. -->
        <ScrollView x:Name="FilterStrip"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="0,16,0,4"
                    IsVisible="False">
            <HorizontalStackLayout x:Name="FilterStripHost" Spacing="8" Padding="20,0"/>
        </ScrollView>

        <RefreshView x:Name="Refresher"
                     Grid.Row="2"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView>
                <Grid Padding="20,20,20,24">

                    <!-- ── M1-10d loading: sync card over skeleton rows ── -->
                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="27" IsVisible="False">

                        <Border BackgroundColor="{StaticResource White}"
                                StrokeThickness="0"
                                Padding="20,26,20,28"
                                Margin="0,12,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource CardCornerRadius}"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.15" Radius="14" Offset="0,4"/>
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="14">
                                <Border WidthRequest="78" HeightRequest="78"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource SelectedOptionBackground}"
                                        HorizontalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Image Source="icon_refresh.svg"
                                           WidthRequest="42" HeightRequest="42"/>
                                </Border>

                                <Label Text="Syncing with Device…"
                                       Style="{StaticResource Heading2}"
                                       HorizontalTextAlignment="Center"/>

                                <Label Text="We are fetching your latest cardiac health data from your wearable. This usually takes a few seconds."
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource HeadingText}"
                                       HorizontalTextAlignment="Center"/>

                                <!-- Re-triggers the fetch; the designed affordance for a load
                                     that is taking longer than it should. -->
                                <Button x:Name="SyncRefreshButton"
                                        Text="Refresh Now"
                                        ImageSource="icon_refresh_white.svg"
                                        ContentLayout="Right,4"
                                        FontFamily="QuicksandSemiBold"
                                        FontSize="12"
                                        TextColor="{StaticResource White}"
                                        Background="{StaticResource GradientButtonBrush}"
                                        CornerRadius="5"
                                        Padding="6,4"
                                        HeightRequest="34"
                                        WidthRequest="114"
                                        Margin="0,13,0,0"
                                        HorizontalOptions="Center"
                                        Clicked="OnRefreshClicked"/>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Spacing="11">
                            <controls:AlertSkeletonCard/>
                            <controls:AlertSkeletonCard/>
                            <controls:AlertSkeletonCard/>
                            <controls:AlertSkeletonCard/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- ── Error ── -->
                    <VerticalStackLayout x:Name="ErrorPanel"
                                         Spacing="10"
                                         IsVisible="False"
                                         Padding="0,60,0,0">
                        <Label Text="We couldn't load your alerts"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="ErrorDetailLabel"
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource BodyText}"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="Try again"
                                Style="{StaticResource SecondaryOutlineButton}"
                                HorizontalOptions="Center"
                                Clicked="OnRefreshClicked"/>
                    </VerticalStackLayout>

                    <!-- ── M1-10a loaded: date-grouped cards, with the two empty states
                           living inside the same panel so the archive toggle stays reachable
                           when a filter empties the list ── -->
                    <VerticalStackLayout x:Name="ContentPanel" Spacing="20" IsVisible="False">

                        <controls:SavedDataBanner x:Name="SavedBanner"/>

                        <!-- M1-10b empty / M1-10c filtered empty. One card, two sets of copy:
                             which one shows depends on whether a filter is doing the emptying. -->
                        <Border x:Name="EmptyPanel"
                                Style="{StaticResource ElevatedCard}"
                                Padding="20,17,20,20"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="4">
                                <Image Source="illustration_alerts_bell.png"
                                       WidthRequest="128" HeightRequest="128"
                                       HorizontalOptions="Center"/>
                                <Label x:Name="EmptyTitleLabel"
                                       Style="{StaticResource Heading2}"
                                       HorizontalTextAlignment="Center"/>
                                <Label x:Name="EmptyDetailLabel"
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource HeadingText}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout x:Name="GroupsStack" Spacing="20"/>

                        <!-- Figma's "View Archived Alerts" CTA. There is no archive screen, so
                             it switches this list to resolved alerts in place rather than
                             pushing one, and flips back the same way.

                             Always shown, in both directions. It used to hide on an empty list,
                             back when the list carried resolved rows too and so could stand in
                             for "is there an archive?". The list now asks for the open alerts
                             only, so a member whose every episode has been resolved shows an
                             empty list over a full archive — and hiding the button there would
                             strand that history behind a screen saying "Nothing to worry about". -->
                        <Button x:Name="ArchiveButton"
                                Style="{StaticResource AuthGradientButton}"
                                Clicked="OnArchiveClicked"/>

                        <!-- Data-completeness items, in their own section below the health ones.
                             Sectioned and never interleaved: a caregiver scanning this screen is
                             looking for something about their relative, and a missing phone
                             number must not sit in that stream. It lives here rather than on a
                             screen of its own because the bell is the one place people look for
                             "what needs me", and a second inbox nobody opens helps nobody.

                             Safety banners first and on their own — they say monitoring is
                             degraded, which is the closest this section gets to being about the
                             person — then the Dashboard's own "Complete the picture" card, so a
                             missing emergency contact is one ring on both screens rather than a
                             ring on one and a loose row on the other. -->
                        <VerticalStackLayout x:Name="NudgeSection" Spacing="10" IsVisible="False">
                            <VerticalStackLayout x:Name="SafetyBannerList" Spacing="10" IsVisible="False"/>
                            <controls:CompleteThePictureCard x:Name="CompleteThePicture"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <controls:BottomNavBar Grid.Row="3" Tab="Alerts"/>

        <!-- Chat from anywhere: no single-member context on this cross-member list, so the
             launcher resolves the account's members itself on tap — see ChatBotLauncher. -->
        <controls:ChatBotLauncher Grid.Row="2"/>

        <!-- The second-long "Updating…" while a saved page is replaced by live data — last, so
             it covers everything including the chips and the nav bar. See UpdatingOverlay. -->
        <controls:UpdatingOverlay x:Name="Updating" Grid.RowSpan="4"/>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.AlertsPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource White}">
    <Grid RowDefinitions="*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="20,24" Spacing="8">
            <Label Text="Alerts" Style="{StaticResource Heading2}"/>
            <Label Text="Alert history (M1-10) is coming soon."
                   Style="{StaticResource Body2}"
                   TextColor="{StaticResource BodyText}"/>
        </VerticalStackLayout>

        <controls:BottomNavBar Grid.Row="1" Tab="Alerts"/>
    </Grid>
</ContentPage>

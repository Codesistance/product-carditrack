<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.SettingsPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">
    <!-- Safe area is claimed per edge, and by this layout rather than by the ContentPage:
         SafeAreaEdges is honoured on layouts, and setting it on the page above has no
         effect on Android (verified on API 37). Top keeps the status-bar inset the header
         band is drawn against; bottom releases it, so BottomNavBar can run to the screen
         edge and pad itself instead — see that control. -->
    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="None, Container, None, None">

        <!-- Back arrow, same reasoning as Alerts: Settings has real deep-link entry points from
             push notifications (notification preferences, timezone), so a caregiver can land here
             with nothing behind it in the app's own history and needs an obvious way back. -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <!-- Fill + width-bound-to-height: the circle runs from the title's top to
                         the description's bottom and stays square at whatever that is, so every
                         header's icon matches its own text block exactly. The 40 floor keeps the
                         back button a real tap target; 99 clamps to a circle at any size. -->
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"/>
                </controls:SquareBorder>

                <!-- Title with what the page is tight beneath it — one stack, top-aligned
                     with the icon. The description is declared after the title, so screen
                     readers announce them in reading order. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Settings"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label Text="Your account, and how CardiTrack behaves"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,24" Spacing="14">

                <Border Style="{StaticResource ElevatedCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="AccountNameLabel"
                               Style="{StaticResource Body1SemiBoldDark}"/>
                        <Label x:Name="AccountEmailLabel"
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource BodyText}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Notification silences. Every mute the user holds is listed and reversible
                     here — a silence they cannot find again later is a bug, not a preference. -->
                <Border x:Name="MutesCard" Style="{StaticResource ElevatedCard}" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Image Source="icon_section_muted.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            <Label Text="Silenced reminders"
                                   Style="{StaticResource Body1SemiBoldDark}"/>
                        </HorizontalStackLayout>
                        <Label x:Name="MutesSubtitle"
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource BodyText}"/>

                        <VerticalStackLayout x:Name="MutesList" Spacing="8"/>

                        <controls:AppButton x:Name="ResetMutesBtn"
                                            Text="Show me everything again"
                                            HorizontalOptions="Fill"
                                            Margin="0,4,0,0"
                                            Clicked="OnResetMutesClicked"
                                            Tone="Secondary"
                                            Size="M"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Grouped the way Journal Settings groups: a section card that names the group
                     and says in one line what it is for, and inside it an outlined card of rows
                     parted by hairlines — each row a title, one line of what it does, and on the
                     right the control that changes it (a chevron into a screen, a switch, or a
                     value). The rows already followed that shape; the cards did not, so a reader
                     coming from Journal Settings met four loose headings over eight separate
                     cards and had to work out the grouping from the spacing.

                     Per-member settings (alert rules, journal timing, devices) stay on Member
                     Details: this page is about the caregiver and the app. -->
                <Border Style="{StaticResource ElevatedCard}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Image Source="icon_section_notifications.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            <Label Text="Notifications" Style="{StaticResource DashboardSectionTitle}"/>
                        </HorizontalStackLayout>
                        <Label Text="Quiet hours, and what a locked screen shows."
                               Style="{StaticResource Body2}"/>
                        <Border Style="{StaticResource OutlinedCard}" Padding="14,4">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                      SemanticProperties.Description="Notification preferences"
                                      SemanticProperties.Hint="Quiet hours, lock-screen detail and what to hear about">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnNotificationPreferencesTapped"/>
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Quiet hours and what to hear about"
                                               Style="{StaticResource Body1SemiBoldDark}" FontSize="15"/>
                                        <Label x:Name="NotificationSummary"
                                               Text="Loading…"
                                               Style="{StaticResource Body2}" FontSize="13"/>
                                    </VerticalStackLayout>
                                    <Label Text="›" Grid.Column="1" FontSize="26" TextColor="{StaticResource MutedText}"
                                           VerticalTextAlignment="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ElevatedCard}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Image Source="icon_section_account.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            <Label Text="Account" Style="{StaticResource DashboardSectionTitle}"/>
                        </HorizontalStackLayout>
                        <Label Text="Your sign-in, and copies you can take with you."
                               Style="{StaticResource Body2}"/>
                        <Border Style="{StaticResource OutlinedCard}" Padding="14,4">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                      SemanticProperties.Description="Change password"
                                      SemanticProperties.Hint="Emails you a link to set a new password">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnChangePasswordTapped"/>
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Change password"
                                               Style="{StaticResource Body1SemiBoldDark}" FontSize="15"/>
                                        <Label x:Name="ChangePasswordDetail"
                                               Text="We'll email you a link to set a new one"
                                               Style="{StaticResource Body2}" FontSize="13"/>
                                    </VerticalStackLayout>
                                    <Label Text="›" Grid.Column="1" FontSize="26" TextColor="{StaticResource MutedText}"
                                           VerticalTextAlignment="Center"/>
                                </Grid>

                                <BoxView Style="{StaticResource DividerLine}"/>

                                <!-- M1-17's second entry point. Under Account rather than its own
                                     group: it is a thing the caregiver does with their data,
                                     alongside the password and the deletion request at the foot. -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                      SemanticProperties.Description="Export health data"
                                      SemanticProperties.Hint="Download records as a PDF, spreadsheet or FHIR bundle">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnExportHealthDataTapped"/>
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Export health data"
                                               Style="{StaticResource Body1SemiBoldDark}" FontSize="15"/>
                                        <!-- Not the three formats: naming PDF, spreadsheet and FHIR
                                             wrapped the line and asked a caregiver to pick a file
                                             format before they had decided to export anything. The
                                             formats are on the export screen, where choosing one is
                                             the actual question. -->
                                        <Label Text="Hard copy for a doctor's visit"
                                               Style="{StaticResource Body2}" FontSize="13"/>
                                    </VerticalStackLayout>
                                    <Label Text="›" Grid.Column="1" FontSize="26" TextColor="{StaticResource MutedText}"
                                           VerticalTextAlignment="Center"/>
                                </Grid>

                                <BoxView Style="{StaticResource DividerLine}"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                      SemanticProperties.Description="Export confirmations"
                                      SemanticProperties.Hint="Stop a kept confirmation, or see earlier ones">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnExportConsentsTapped"/>
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Export confirmations"
                                               Style="{StaticResource Body1SemiBoldDark}" FontSize="15"/>
                                        <Label Text="Stop a kept confirmation, or see earlier ones"
                                               Style="{StaticResource Body2}" FontSize="13"/>
                                    </VerticalStackLayout>
                                    <Label Text="›" Grid.Column="1" FontSize="26" TextColor="{StaticResource MutedText}"
                                           VerticalTextAlignment="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ElevatedCard}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Image Source="icon_section_privacy.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            <Label Text="Privacy" Style="{StaticResource DashboardSectionTitle}"/>
                        </HorizontalStackLayout>
                        <!-- Session telemetry is on by default and disclosed in the Terms of Service
                             and Privacy Policy. On, the app sends its own logs, network timings and
                             screen views so a crash can be traced; it never sends health data — the
                             monitoring SDK is handed none, and Session Replay is not enabled. Off is a
                             real off, at any time: nothing is collected and held waiting for a yes. -->
                        <Label Text="What this phone says about how the app is running."
                               Style="{StaticResource Body2}"/>
                        <Border Style="{StaticResource OutlinedCard}" Padding="14,4">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Send session telemetry"
                                               Style="{StaticResource Body1SemiBoldDark}" FontSize="15"/>
                                        <Label Text="On by default. Which screens you open, errors, crashes and how fast the app responds — never health data. Turn off any time. Crash reports from before sign-in still go through so a freeze on the login screen can be fixed."
                                               Style="{StaticResource Body2}" FontSize="13"
                                               LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                    <Switch x:Name="DiagnosticsSwitch"
                                            Grid.Column="1"
                                            OnColor="{StaticResource Primary}"
                                            VerticalOptions="Center"
                                            Toggled="OnDiagnosticsToggled"
                                            SemanticProperties.Description="Send session telemetry"
                                            SemanticProperties.Hint="Off stops session telemetry. Crash reports from the sign-in screen may still be sent."/>
                                </Grid>

                                <BoxView Style="{StaticResource DividerLine}"/>

                                <!-- Under the toggle rather than in About: both rows are about
                                     what this phone can say about the app going wrong. The
                                     difference is who sends it — the switch above lets the app
                                     send on its own, this one is the caregiver handing a file
                                     over themselves, which is why it works with the switch off. -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                      SemanticProperties.Description="Share app logs"
                                      SemanticProperties.Hint="Sends the error records kept on this phone wherever you choose">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnShareAppLogsTapped"/>
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Share app logs"
                                               Style="{StaticResource Body1SemiBoldDark}" FontSize="15"/>
                                        <Label Text="Send the error records kept on this phone wherever you choose. This does not use the switch above."
                                               Style="{StaticResource Body2}" FontSize="13"
                                               LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                    <Label Text="›" Grid.Column="1" FontSize="26" TextColor="{StaticResource MutedText}"
                                           VerticalTextAlignment="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ElevatedCard}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Image Source="icon_section_about.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            <Label Text="About" Style="{StaticResource DashboardSectionTitle}"/>
                        </HorizontalStackLayout>
                        <Label Text="What you agreed to, and which build you are running."
                               Style="{StaticResource Body2}"/>
                        <Border Style="{StaticResource OutlinedCard}" Padding="14,4">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                      SemanticProperties.Description="Terms of Service">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTermsTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label Text="Terms of Service" Style="{StaticResource Body1SemiBoldDark}"
                                           FontSize="15" VerticalTextAlignment="Center"/>
                                    <Label Text="›" Grid.Column="1" FontSize="26" TextColor="{StaticResource MutedText}"
                                           VerticalTextAlignment="Center"/>
                                </Grid>

                                <BoxView Style="{StaticResource DividerLine}"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                      SemanticProperties.Description="Privacy Policy">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPrivacyTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label Text="Privacy Policy" Style="{StaticResource Body1SemiBoldDark}"
                                           FontSize="15" VerticalTextAlignment="Center"/>
                                    <Label Text="›" Grid.Column="1" FontSize="26" TextColor="{StaticResource MutedText}"
                                           VerticalTextAlignment="Center"/>
                                </Grid>

                                <BoxView Style="{StaticResource DividerLine}"/>

                                <!-- The one row here that is not a way through to something else, so
                                     its value stays in the muted ink rather than the accent one a
                                     tappable value wears on Journal Settings. -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48">
                                    <Label Text="Version" Style="{StaticResource Body1SemiBoldDark}"
                                           FontSize="15" VerticalTextAlignment="Center"/>
                                    <Label x:Name="VersionLabel" Grid.Column="1" Style="{StaticResource Body2}"
                                           FontSize="13" VerticalTextAlignment="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Two taps, like leaving the app: the first arms it and raises the same deep-red
                     banner the dashboard shows for a back-swipe, the second inside the window
                     signs out. A dialog asked the same question with more ceremony and a button
                     to find. -->
                <!-- In the red of the banner it raises, carrying that banner's power glyph. It
                     used to wear the neutral outline every "Try again" in the app wears, one
                     card above the deletion box: the only part of leaving that did not look
                     like leaving. -->
                <controls:AppButton x:Name="SignOutBtn"
                                    Text="Sign out"
                                    Icon="icon_power_white.svg"
                                    HorizontalOptions="Fill"
                                    Margin="0,12,0,0"
                                    Clicked="OnSignOutClicked"
                                    Tone="Danger"
                                    Size="L"/>

                <!-- The privacy policy promises erasure within 30 days of a request. No endpoint
                     exists yet, so the card starts the request the way the policy page does — a
                     pre-addressed email to support — rather than leaving a published promise
                     with no path from inside the app. A red card rather than a red line: what
                     happens is spelled out here, and the tick box is the caregiver saying they
                     read it; the button stays off until they have. Last, because it is the one
                     thing on this page that cannot be undone. -->
                <Border BackgroundColor="{StaticResource AlertTileRed}"
                        StrokeThickness="1"
                        Stroke="{StaticResource QuickActionTintRed}"
                        Padding="18,16"
                        Margin="0,8,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CardCornerRadius}"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Image Source="icon_section_delete.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            <Label Text="Delete my account"
                                   Style="{StaticResource Body1SemiBoldDark}"
                                   TextColor="{StaticResource DangerRed}"/>
                        </HorizontalStackLayout>
                        <Label Text="If you go ahead, within 30 days of your request:"
                               Style="{StaticResource Body2Dark}"/>
                        <!-- The same rows every other list in the app draws, in the danger
                             palette, and a caution mark rather than a tick. These are
                             consequences rather than reassurances: a tick beside "nothing can be
                             recovered afterwards" reads as approval of it, whatever its colour. -->
                        <controls:FindingsList x:Name="DeletionConsequences" Margin="4,0,0,0"/>
                        <!-- The label ticks the box on its own now — that is the control's, not a
                             gesture this page wires — and the tick is DangerRed, as the box was.

                             The negative margin is CheckField's own geometry, not a nudge by eye:
                             its 22pt box is centred in a 44pt tap target, so the box draws 11pt in
                             from the control's left edge and sat indented from every line of text
                             above it. Pulling the control back by that 11 puts the box on the same
                             left edge as the wording it is confirming. The -8 top closes the gap
                             the same tap target opens above the box. -->
                        <controls:CheckField x:Name="DeleteConfirmCheck"
                                             Margin="-11,-8,0,0"
                                             Text="I understand this can't be undone"
                                             CheckedColor="{StaticResource DangerRed}"
                                             CheckedChanged="OnDeleteConfirmChanged"
                                             SemanticProperties.Hint="Ticking this turns on the deletion request button"/>
                        <!-- This button is where the danger outline came from; it spelled the
                             two colours out inline before there was a style for them. -->
                        <controls:AppButton x:Name="DeleteAccountBtn"
                                            Text="Start deletion request"
                                            IsEnabled="False"
                                            HorizontalOptions="Fill"
                                            Clicked="OnDeleteAccountClicked"
                                            SemanticProperties.Hint="Asks us to delete your account. Checks your fingerprint or face first, then signs you out. Monitoring stops straight away and you have 30 days to cancel"
                                            Tone="Danger"
                                            Size="L"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- The dashboard's leave-the-app banner, worn by Sign out: same scrim, same deep red,
             same power glyph, same window — one look for "CardiTrack is about to stop
             watching", wherever it is about to happen. -->
        <BoxView x:Name="ExitHintScrim"
                 Grid.Row="1"
                 Color="{StaticResource ScrimOverlay}"
                 IsVisible="False"
                 InputTransparent="True"/>
        <Border x:Name="ExitHintBanner"
                Grid.Row="1"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                IsVisible="False"
                InputTransparent="True"
                BackgroundColor="{StaticResource DangerRed}"
                StrokeThickness="0"
                Margin="20,0,20,16"
                Padding="16,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.25" Radius="14" Offset="0,4"/>
            </Border.Shadow>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Image Source="icon_power_white.svg"
                       WidthRequest="18" HeightRequest="18"
                       VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False"/>
                <Label Text="Tap Sign out again to sign out"
                       Style="{StaticResource Body1SemiBoldDark}"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </HorizontalStackLayout>
        </Border>

        <controls:BottomNavBar Grid.Row="2" Tab="Settings"/>

        <!-- Chat from anywhere: Settings has no member context, so the launcher resolves the
             account's members itself on tap — see ChatBotLauncher. -->
        <controls:ChatBotLauncher Grid.Row="1"/>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.SettingsPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">
    <!-- Safe area is claimed per edge, and by this layout rather than by the ContentPage:
         SafeAreaEdges is honoured on layouts, and setting it on the page above has no
         effect on Android (verified on API 37). Top keeps the status-bar inset the header
         band is drawn against; bottom releases it, so BottomNavBar can run to the screen
         edge and pad itself instead — see that control. -->
    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="None, Container, None, None">

        <!-- Back arrow, same reasoning as Alerts: Settings has real deep-link entry points from
             push notifications (notification preferences, timezone), so a caregiver can land here
             with nothing behind it in the app's own history and needs an obvious way back. -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <!-- Fill + width-bound-to-height: the circle runs from the title's top to
                         the description's bottom and stays square at whatever that is, so every
                         header's icon matches its own text block exactly. The 40 floor keeps the
                         back button a real tap target; 99 clamps to a circle at any size. -->
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"/>
                </controls:SquareBorder>

                <!-- Title with what the page is tight beneath it — one stack, top-aligned
                     with the icon. The description is declared after the title, so screen
                     readers announce them in reading order. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Settings"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label Text="Your account, and how CardiTrack behaves"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,24" Spacing="14">

                <Border Style="{StaticResource ElevatedCard}">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="AccountNameLabel"
                               Style="{StaticResource Body1SemiBoldDark}"/>
                        <Label x:Name="AccountEmailLabel"
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource BodyText}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Notification silences. Every mute the user holds is listed and reversible
                     here — a silence they cannot find again later is a bug, not a preference. -->
                <Border x:Name="MutesCard" Style="{StaticResource ElevatedCard}" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Silenced reminders"
                               Style="{StaticResource Body1SemiBoldDark}"/>
                        <Label x:Name="MutesSubtitle"
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource BodyText}"/>

                        <VerticalStackLayout x:Name="MutesList" Spacing="8"/>

                        <Button x:Name="ResetMutesBtn"
                                Text="Show me everything again"
                                Style="{StaticResource SecondaryOutlineButton}"
                                HeightRequest="42"
                                HorizontalOptions="Fill"
                                Margin="0,4,0,0"
                                Clicked="OnResetMutesClicked"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Rows follow Journal Settings' shape — title, one line of what it does, the
                     current value or a chevron on the right — so the two settings screens read
                     as one. Per-member settings (alert rules, journal timing, devices) stay on
                     Member Details: this page is about the caregiver and the app. -->
                <Label Text="Notifications"
                       Style="{StaticResource DashboardSectionTitle}"
                       Margin="4,8,4,-4"/>

                <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" HeightRequest="60"
                          SemanticProperties.Description="Notification preferences"
                          SemanticProperties.Hint="Quiet hours, lock-screen detail and what to hear about">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationPreferencesTapped"/>
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Quiet hours and what to hear about" Style="{StaticResource Body1SemiBoldDark}"/>
                            <Label x:Name="NotificationSummary"
                                   Text="Loading…"
                                   Style="{StaticResource Body2}"/>
                        </VerticalStackLayout>
                        <Label Text="›" Grid.Column="1" FontSize="26" TextColor="{StaticResource MutedText}"
                               VerticalTextAlignment="Center"/>
                    </Grid>
                </Border>

                <Label Text="Account"
                       Style="{StaticResource DashboardSectionTitle}"
                       Margin="4,8,4,-4"/>

                <Border Style="{StaticResource ElevatedCard}" Padding="14,4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" HeightRequest="60"
                          SemanticProperties.Description="Change password"
                          SemanticProperties.Hint="Emails you a link to set a new password">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangePasswordTapped"/>
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Change password" Style="{StaticResource Body1SemiBoldDark}"/>
                            <Label x:Name="ChangePasswordDetail"
                                   Text="We'll email you a link to set a new one"
                                   Style="{StaticResource Body2}"/>
                        </VerticalStackLayout>
                        <Label Text="›" Grid.Column="1" FontSize="26" TextColor="{StaticResource MutedText}"
                               VerticalTextAlignment="Center"/>
                    </Grid>
                </Border>

                <Label Text="About"
                       Style="{StaticResource DashboardSectionTitle}"
                       Margin="4,8,4,-4"/>

                <Border Style="{StaticResource ElevatedCard}" Padding="14,6">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" HeightRequest="48"
                              SemanticProperties.Description="Terms of Service">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTermsTapped"/>
                            </Grid.GestureRecognizers>
                            <Label Text="Terms of Service" Style="{StaticResource Body1SemiBoldDark}" VerticalTextAlignment="Center"/>
                            <Label Text="›" Grid.Column="1" FontSize="26" TextColor="{StaticResource MutedText}" VerticalTextAlignment="Center"/>
                        </Grid>
                        <BoxView Style="{StaticResource DividerLine}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" HeightRequest="48"
                              SemanticProperties.Description="Privacy Policy">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyTapped"/>
                            </Grid.GestureRecognizers>
                            <Label Text="Privacy Policy" Style="{StaticResource Body1SemiBoldDark}" VerticalTextAlignment="Center"/>
                            <Label Text="›" Grid.Column="1" FontSize="26" TextColor="{StaticResource MutedText}" VerticalTextAlignment="Center"/>
                        </Grid>
                        <BoxView Style="{StaticResource DividerLine}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" HeightRequest="48">
                            <Label Text="Version" Style="{StaticResource Body1SemiBoldDark}" VerticalTextAlignment="Center"/>
                            <Label x:Name="VersionLabel" Grid.Column="1" Style="{StaticResource Body2}" VerticalTextAlignment="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Two taps, like leaving the app: the first arms it and raises the same deep-red
                     banner the dashboard shows for a back-swipe, the second inside the window
                     signs out. A dialog asked the same question with more ceremony and a button
                     to find. -->
                <Button x:Name="SignOutBtn"
                        Text="Sign out"
                        Style="{StaticResource SecondaryOutlineButton}"
                        HorizontalOptions="Fill"
                        Margin="0,12,0,0"
                        Clicked="OnSignOutClicked"/>

                <!-- The privacy policy promises erasure within 30 days of a request. No endpoint
                     exists yet, so the card starts the request the way the policy page does — a
                     pre-addressed email to support — rather than leaving a published promise
                     with no path from inside the app. A red card rather than a red line: what
                     happens is spelled out here, and the tick box is the caregiver saying they
                     read it; the button stays off until they have. Last, because it is the one
                     thing on this page that cannot be undone. -->
                <Border BackgroundColor="{StaticResource AlertTileRed}"
                        StrokeThickness="1"
                        Stroke="{StaticResource QuickActionTintRed}"
                        Padding="18,16"
                        Margin="0,8,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Delete my account"
                               Style="{StaticResource Body1SemiBoldDark}"
                               TextColor="{StaticResource DangerRed}"/>
                        <Label Text="If you go ahead, within 30 days of your request:"
                               Style="{StaticResource Body2Dark}"/>
                        <VerticalStackLayout Spacing="4" Margin="4,0,0,0">
                            <Label Text="•  Your sign-in is removed and you can't get back in." Style="{StaticResource Body2Dark}"/>
                            <Label Text="•  Every reading, alert and journal entry for the people you watch over is deleted." Style="{StaticResource Body2Dark}"/>
                            <Label Text="•  Their devices are disconnected from CardiTrack." Style="{StaticResource Body2Dark}"/>
                            <Label Text="•  Nothing can be recovered afterwards." Style="{StaticResource Body2Dark}"/>
                        </VerticalStackLayout>
                        <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                            <CheckBox x:Name="DeleteConfirmCheck"
                                      Color="{StaticResource DangerRed}"
                                      WidthRequest="20" HeightRequest="20"
                                      VerticalOptions="Center"
                                      CheckedChanged="OnDeleteConfirmChanged"
                                      SemanticProperties.Description="I understand this can't be undone"
                                      SemanticProperties.Hint="Ticking this turns on the deletion request button"/>
                            <Label Text="I understand this can't be undone"
                                   Style="{StaticResource Body2Medium}"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDeleteConfirmLabelTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                        <Button x:Name="DeleteAccountBtn"
                                Text="Start deletion request"
                                Style="{StaticResource SecondaryOutlineButton}"
                                TextColor="{StaticResource DangerRed}"
                                BorderColor="{StaticResource DangerRed}"
                                FontSize="16"
                                HeightRequest="46"
                                IsEnabled="False"
                                Opacity="0.5"
                                HorizontalOptions="Fill"
                                Clicked="OnDeleteAccountClicked"
                                SemanticProperties.Hint="Opens an email to support asking for your account to be deleted"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- The dashboard's leave-the-app banner, worn by Sign out: same scrim, same deep red,
             same power glyph, same window — one look for "CardiTrack is about to stop
             watching", wherever it is about to happen. -->
        <BoxView x:Name="ExitHintScrim"
                 Grid.Row="1"
                 Color="#80343434"
                 IsVisible="False"
                 InputTransparent="True"/>
        <Border x:Name="ExitHintBanner"
                Grid.Row="1"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                IsVisible="False"
                InputTransparent="True"
                BackgroundColor="{StaticResource DangerRed}"
                StrokeThickness="0"
                Margin="20,0,20,16"
                Padding="16,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.25" Radius="14" Offset="0,4"/>
            </Border.Shadow>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <Image Source="icon_power_white.svg"
                       WidthRequest="18" HeightRequest="18"
                       VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False"/>
                <Label Text="Tap Sign out again to sign out"
                       Style="{StaticResource Body1SemiBoldDark}"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </HorizontalStackLayout>
        </Border>

        <controls:BottomNavBar Grid.Row="2" Tab="Settings"/>

        <!-- Chat from anywhere: Settings has no member context, so the launcher resolves the
             account's members itself on tap — see ChatBotLauncher. -->
        <controls:ChatBotLauncher Grid.Row="1"/>
    </Grid>
</ContentPage>

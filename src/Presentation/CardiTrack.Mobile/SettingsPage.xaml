<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.SettingsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource White}">
    <VerticalStackLayout Padding="20,24" Spacing="12">
        <Label Text="Settings" Style="{StaticResource Heading2}"/>

        <Border Style="{StaticResource DashboardCard}">
            <VerticalStackLayout Spacing="2">
                <Label x:Name="AccountNameLabel"
                       Style="{StaticResource Body1SemiBoldDark}"/>
                <Label x:Name="AccountEmailLabel"
                       Style="{StaticResource Body2}"
                       TextColor="{StaticResource BodyText}"/>
            </VerticalStackLayout>
        </Border>

        <Label Text="More settings (M2-01) are coming soon."
               Style="{StaticResource Body2}"
               TextColor="{StaticResource BodyText}"/>

        <Button x:Name="SignOutBtn"
                Text="Sign out"
                Style="{StaticResource SecondaryOutlineButton}"
                HorizontalOptions="Fill"
                Margin="0,12,0,0"
                Clicked="OnSignOutClicked"/>
    </VerticalStackLayout>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.AlertSettingsPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- Which alerts CardiTrack checks for on this CardiMember. A switch saves the moment it is
         flipped, the way Journal Settings' rows do — there is nothing here to hold half-made.

         The same page as Journal Settings, on purpose: both are settings for how CardiTrack
         watches a member rather than facts about them, they sit as neighbouring rows in Member
         Details' Management group, and a caregiver who has learned one should find nothing to
         learn in the other. Each rule cluster is a section card that says what the cluster is
         for, and inside it an outlined card of rows parted by hairlines — a title, one line of
         what the rule looks for, and its switch on the right where Journal Settings puts a value.

         The clusters come down from the API's alert catalogue, so the sections are built in
         code-behind; the frame around them is the only thing declared here.

         No Figma frame — see the design-sync backlog. -->

    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None, Container, None, None">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                <controls:SquareBorder Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label x:Name="HeaderTitle"
                           Text="Alert Settings"
                           Style="{StaticResource Heading3}"
                           TextColor="{StaticResource White}"/>
                    <Label x:Name="HeaderSubtitle"
                           Text="Their alerts"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="12">

                <ActivityIndicator x:Name="LoadingSpinner"
                                   IsRunning="True"
                                   IsVisible="True"
                                   HorizontalOptions="Center"
                                   Margin="0,24"/>

                <VerticalStackLayout x:Name="SettingsPanel" IsVisible="False" Spacing="14">
                    <!-- What a switch does, said once above the sections rather than once per
                         cluster: it is the same sentence for every rule on the page. -->
                    <Label x:Name="IntroLabel" Style="{StaticResource Body2}"/>

                    <!-- One section card per rule cluster, built in code-behind. -->
                    <VerticalStackLayout x:Name="ClustersHost" Spacing="14"/>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="12">
                    <Border Style="{StaticResource ElevatedCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Couldn't load these settings"
                                   Style="{StaticResource Body1SemiBoldDark}"/>
                            <Label x:Name="ErrorDetailLabel" Style="{StaticResource Body2}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

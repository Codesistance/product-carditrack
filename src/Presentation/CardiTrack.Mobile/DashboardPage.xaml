<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.DashboardPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ════════════════════════════════════════
             FIXED HEADER (Figma 101:2872) — edge to edge, so it sits outside the
             content padding rather than inside it.
             ════════════════════════════════════════ -->
        <controls:DashboardHeader x:Name="Header" Grid.Row="0"/>

        <!-- ════════════════════════════════════════
             VERIFY-EMAIL NUDGE (dismissible)
             ════════════════════════════════════════ -->
        <Border x:Name="VerifyEmailBanner"
                Grid.Row="1"
                IsVisible="False"
                BackgroundColor="{StaticResource StaleBannerBackground}"
                StrokeThickness="0"
                Margin="20,20,20,0"
                Padding="14,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label x:Name="VerifyEmailLabel"
                       Grid.Column="0"
                       Style="{StaticResource Body2}"
                       TextColor="{StaticResource HeadingText}"
                       VerticalOptions="Center"/>
                <Button Grid.Column="1"
                        Text="✕"
                        FontSize="14"
                        TextColor="{StaticResource BodyText}"
                        BackgroundColor="Transparent"
                        Padding="6,0"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        VerticalOptions="Center"
                        Clicked="OnDismissVerifyEmailClicked"/>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════
             CONTENT
             ════════════════════════════════════════ -->
        <RefreshView x:Name="Refresher"
                     Grid.Row="2"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView>
                <Grid Padding="20,20,20,24">

                    <!-- ── Loading skeleton (M1-09a) — block heights track the loaded
                           layout so the content doesn't jump when it arrives ── -->
                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="20" IsVisible="False">
                        <controls:SkeletonView HeightRequest="102"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                            <controls:SkeletonView Grid.Column="0" HeightRequest="84"/>
                            <controls:SkeletonView Grid.Column="1" HeightRequest="84"/>
                            <controls:SkeletonView Grid.Column="2" HeightRequest="84"/>
                        </Grid>
                        <VerticalStackLayout Spacing="11">
                            <controls:SkeletonView HeightRequest="108"/>
                            <controls:SkeletonView HeightRequest="108"/>
                            <controls:SkeletonView HeightRequest="108"/>
                        </VerticalStackLayout>
                        <controls:SkeletonView HeightRequest="96"/>
                    </VerticalStackLayout>

                    <!-- ── Error state ── -->
                    <VerticalStackLayout x:Name="ErrorPanel"
                                         Spacing="10"
                                         IsVisible="False"
                                         Padding="0,60,0,0">
                        <Label Text="We couldn't load the dashboard"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="ErrorDetailLabel"
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource BodyText}"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="Try again"
                                Style="{StaticResource SecondaryOutlineButton}"
                                HorizontalOptions="Center"
                                Clicked="OnRefreshClicked"/>
                    </VerticalStackLayout>

                    <!-- ── No CardiMember yet ── -->
                    <VerticalStackLayout x:Name="NoMemberPanel"
                                         Spacing="10"
                                         IsVisible="False"
                                         Padding="0,60,0,0">
                        <Label Text="Who are you watching over?"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Add the family member you want CardiTrack to keep an eye on."
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource BodyText}"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="Add CardiMember"
                                Style="{StaticResource AuthGradientButton}"
                                HorizontalOptions="Center"
                                Clicked="OnAddMemberClicked"/>
                    </VerticalStackLayout>

                    <!-- ── Loaded content ── -->
                    <VerticalStackLayout x:Name="ContentPanel" Spacing="20" IsVisible="False">

                        <!-- Safety notifications: monitoring is degraded and nothing else on this
                             screen would say so. First in the stack and deliberately unmutable —
                             with one channel, prominence is the only escalation this engine has,
                             so it is spent here and nowhere else. -->
                        <VerticalStackLayout x:Name="SafetyBannerList" Spacing="10" IsVisible="False"/>

                        <!-- "Complete the picture": the top two open nudges. Two, because a third
                             makes it a list, and a list is not a prompt. -->
                        <Border x:Name="CompleteThePictureCard"
                                IsVisible="False"
                                Style="{StaticResource ElevatedCard}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="Complete the picture"
                                           Style="{StaticResource DashboardSectionTitle}"/>
                                    <Label x:Name="CompleteThePictureLink"
                                           Grid.Column="1"
                                           Text="See all"
                                           Style="{StaticResource SectionLink}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSeeAllNudgesTapped"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                                <VerticalStackLayout x:Name="NudgeList" Spacing="10"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Monitoring paused (M1-13) — takes precedence over the stale
                             banner, which would otherwise blame a sync that is paused on purpose. -->
                        <Border x:Name="PausedBanner"
                                IsVisible="False"
                                BackgroundColor="{StaticResource StaleBannerBackground}"
                                StrokeThickness="0"
                                Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label x:Name="PausedBannerLabel"
                                   Style="{StaticResource Body2Medium}"
                                   TextColor="{StaticResource HeadingText}"/>
                        </Border>

                        <!-- Stale data banner (M1-09c) -->
                        <Border x:Name="StaleBanner"
                                IsVisible="False"
                                Opacity="0"
                                BackgroundColor="{StaticResource StaleBannerBackground}"
                                StrokeThickness="0"
                                Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label x:Name="StaleBannerLabel"
                                   Style="{StaticResource Body2}"
                                   TextColor="{StaticResource HeadingText}"/>
                        </Border>

                        <!-- No device connected (M1-09d) -->
                        <Border x:Name="NoDeviceCard"
                                IsVisible="False"
                                Style="{StaticResource ElevatedCard}">
                            <VerticalStackLayout Spacing="8">
                                <Label x:Name="NoDeviceLabel"
                                       Style="{StaticResource Body2Medium}"
                                       TextColor="{StaticResource HeadingText}"/>
                                <Button Text="Connect a device"
                                        Style="{StaticResource SecondaryOutlineButton}"
                                        HorizontalOptions="Start"
                                        Clicked="OnConnectDeviceClicked"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- CardiMember card: hero, data-freshness/baseline-progress, quick
                             actions and Key Metrics all in one card so a second/third CardiMember
                             can be another instance of the same card, stacked, once multi-member
                             support lands. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="16,15">
                            <VerticalStackLayout Spacing="16">

                                <controls:StatusHeroCard x:Name="HeroCard"/>

                                <!-- Data-pipeline freshness (deterministic — see
                                     MemberInsightsCalculator.ComputeDataFreshness), the baseline
                                     learning progress while it's still running, and "Updated X
                                     ago" (issue #188 — it used to sit under the CardiMember's
                                     name).

                                     One line, not two. The freshness message ("Data updated") and
                                     the age under it ("Updated 4 minutes ago") were the same fact
                                     said twice, so the age line is the one that stays — it is the
                                     specific one — and it carries the freshness in its colour.
                                     The message itself is not lost: it goes to the label's
                                     semantic description, so a screen reader still hears the
                                     state that sighted readers now take from the colour. -->
                                <VerticalStackLayout x:Name="FreshnessBlock" Spacing="8" Margin="0,-4,0,0">
                                    <ProgressBar x:Name="LearningProgress"
                                                 IsVisible="False"
                                                 HeightRequest="6"/>
                                    <Label x:Name="LastUpdatedFooterLabel"
                                           FontFamily="QuicksandSemiBold"
                                           FontSize="14"/>
                                </VerticalStackLayout>

                                <!-- Quick actions (issue #162): Call and Message reach the
                                     CardiMember's own phone directly. SOS is visually distinct
                                     (tinted, not a plain white tile) precisely because it dials
                                     someone else, not the member this card is about — its label
                                     dropped the member's name (issue: names vary in length once
                                     more than one CardiMember can appear). Each tile dims
                                     independently when its own number is missing (issue #67's
                                     dim-not-hide pattern) — they stay tappable so the tap can
                                     explain why, the only affordance a dimmed tile has on touch.
                                     SOS leads the row: it is the one action with a deadline on it,
                                     and the first tile is where a thumb lands and where the eye
                                     starts. The others are reachable in the seconds that emergency
                                     is not. -->
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                    <Border x:Name="EmergencyCallAction"
                                            Grid.Column="0"
                                            BackgroundColor="{StaticResource AlertTileRed}"
                                            StrokeThickness="0"
                                            Padding="6,16,6,11"
                                            SemanticProperties.Description="SOS: call emergency contact"
                                            SemanticProperties.Hint="Dials the emergency contact number, not the CardiMember directly">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEmergencyCallTapped"/>
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="13">
                                            <Image Source="icon_action_call.svg"
                                                   WidthRequest="24" HeightRequest="24"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="SOS"
                                                   Style="{StaticResource QuickActionLabel}"
                                                   TextColor="{StaticResource StatusRed}"
                                                   LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border x:Name="CallAction"
                                            Grid.Column="1"
                                            BackgroundColor="{StaticResource QuickActionTint}"
                                            StrokeThickness="0"
                                            Padding="6,16,6,11">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCallTapped"/>
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="13">
                                            <Image Source="icon_action_call.svg"
                                                   WidthRequest="24" HeightRequest="24"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Call"
                                                   Style="{StaticResource QuickActionLabel}"
                                                   LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border x:Name="MessageAction"
                                            Grid.Column="2"
                                            BackgroundColor="{StaticResource QuickActionTint}"
                                            StrokeThickness="0"
                                            Padding="6,16,6,11">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMessageTapped"/>
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="13">
                                            <Image Source="icon_action_sms.svg"
                                                   WidthRequest="24" HeightRequest="24"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Message" Style="{StaticResource QuickActionLabel}"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="3"
                                            BackgroundColor="{StaticResource QuickActionTint}"
                                            StrokeThickness="0"
                                            Padding="6,16,6,11">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnViewDetailsTapped"/>
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="13">
                                            <Image Source="icon_action_details.svg"
                                                   WidthRequest="24" HeightRequest="24"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Details" Style="{StaticResource QuickActionLabel}"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Poor-sleep nudge (issue #188): points at the real Sleep alert
                                     StatisticalAlertWorker already raises (AlertType.Sleep) rather
                                     than re-deriving a second, parallel judgement of its own —
                                     dismissing this is a local/session convenience, not an
                                     acknowledgement; the alert itself still lives in Alerts until
                                     acted on there. -->
                                <Border x:Name="SleepConcernBanner"
                                        IsVisible="False"
                                        BackgroundColor="{StaticResource StaleBannerBackground}"
                                        StrokeThickness="0"
                                        Padding="14,10">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               x:Name="SleepConcernBannerLabel"
                                               Style="{StaticResource Body2}"
                                               TextColor="{StaticResource HeadingText}"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnSleepConcernTapped"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Button Grid.Column="1"
                                                Text="✕"
                                                FontSize="14"
                                                TextColor="{StaticResource BodyText}"
                                                BackgroundColor="Transparent"
                                                Padding="6,0"
                                                MinimumWidthRequest="32"
                                                MinimumHeightRequest="32"
                                                VerticalOptions="Center"
                                                Clicked="OnDismissSleepConcernClicked"/>
                                    </Grid>
                                </Border>

                                <!-- Key metrics: collapsed by default behind AccordionSection, two
                                     per row instead of full-width so the card has room to stay
                                     compact once more CardiMember cards can stack below it. The
                                     tiles sit directly on the CardiMember card — no wash behind
                                     the grid, so the card carries one surface, not two.

                                     Declared in the order they are read — the night first, then
                                     the day — which is the order DashboardPage.LayoutMetricCards
                                     packs them in: the pairing below is what a member whose
                                     device reports everything sees, and the slots are reassigned
                                     at render time for one whose device reports less (skin
                                     temperature, SpO2 and breathing rate are each optional) so no
                                     tile is left beside a gap. -->
                                <controls:AccordionSection x:Name="MetricsAccordion" HeaderText="Key Metrics">
                                    <controls:AccordionSection.Body>
                                        <Grid ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto,Auto"
                                              ColumnSpacing="10" RowSpacing="10">
                                            <controls:MetricCard x:Name="HeartRateCard" Grid.Row="0" Grid.Column="0"/>
                                            <controls:MetricCard x:Name="SleepCard" Grid.Row="0" Grid.Column="1"/>
                                            <controls:MetricCard x:Name="TemperatureCard" Grid.Row="1" Grid.Column="0" IsVisible="False"/>
                                            <controls:MetricCard x:Name="StepsCard" Grid.Row="1" Grid.Column="1"/>
                                            <controls:MetricCard x:Name="SpO2Card" Grid.Row="2" Grid.Column="0" IsVisible="False"/>
                                            <controls:MetricCard x:Name="BreathingRateCard" Grid.Row="2" Grid.Column="1" IsVisible="False"/>
                                        </Grid>
                                    </controls:AccordionSection.Body>
                                </controls:AccordionSection>

                            </VerticalStackLayout>
                        </Border>

                        <!-- Recent alerts -->
                        <VerticalStackLayout x:Name="AlertsSection" Spacing="20" IsVisible="False">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Recent Alerts" Style="{StaticResource Heading2}"/>
                                <Label Grid.Column="1"
                                       Text="View All"
                                       Style="{StaticResource SectionLink}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnViewAllAlertsTapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout x:Name="AlertsStack" Spacing="11" Padding="0,0,0,6"/>
                            </ScrollView>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <controls:BottomNavBar Grid.Row="3" Tab="Dashboard"/>
    </Grid>
</ContentPage>

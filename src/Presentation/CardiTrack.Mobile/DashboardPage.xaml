<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.DashboardPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}"
>

    <!-- Safe area is claimed per edge, and by this layout rather than by the ContentPage:
         SafeAreaEdges is honoured on layouts, and setting it on the page above has no
         effect on Android (verified on API 37). Top keeps the status-bar inset the header
         band is drawn against; bottom releases it, so BottomNavBar can run to the screen
         edge and pad itself instead — see that control. -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto" SafeAreaEdges="None, Container, None, None">

        <!-- ════════════════════════════════════════
             FIXED HEADER (Figma 101:2872) — edge to edge, so it sits outside the
             content padding rather than inside it.
             ════════════════════════════════════════ -->
        <controls:DashboardHeader x:Name="Header" Grid.Row="0"/>

        <!-- ════════════════════════════════════════
             ACCOUNT BANNERS — the health-data disclosure (Google-mandated,
             once per caregiver, recorded on the account) and the verify-email
             nudge (dismissible, per device). Both above the content so they
             show in every dashboard state.
             ════════════════════════════════════════ -->
        <VerticalStackLayout Grid.Row="1" Spacing="0">

        <controls:HealthDataDisclosureBanner x:Name="DisclosureBanner"/>

        <Border x:Name="VerifyEmailBanner"
                IsVisible="False"
                BackgroundColor="{StaticResource StaleBannerBackground}"
                StrokeThickness="0"
                Margin="20,20,20,0"
                Padding="14,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label x:Name="VerifyEmailLabel"
                       Grid.Column="0"
                       Style="{StaticResource Body2}"
                       TextColor="{StaticResource HeadingText}"
                       VerticalOptions="Center"/>
                <Button Grid.Column="1"
                        Text="✕"
                        FontSize="14"
                        TextColor="{StaticResource BodyText}"
                        BackgroundColor="Transparent"
                        Padding="6,0"
                        MinimumWidthRequest="32"
                        MinimumHeightRequest="32"
                        VerticalOptions="Center"
                        Clicked="OnDismissVerifyEmailClicked"/>
            </Grid>
        </Border>

        </VerticalStackLayout>

        <!-- ════════════════════════════════════════
             CONTENT
             ════════════════════════════════════════ -->
        <RefreshView x:Name="Refresher"
                     Grid.Row="2"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView>
                <Grid Padding="20,20,20,24">

                    <!-- ── Loading skeleton (M1-09a) — block heights track the loaded
                           layout so the content doesn't jump when it arrives ── -->
                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="20" IsVisible="False">
                        <controls:SkeletonView HeightRequest="102"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                            <controls:SkeletonView Grid.Column="0" HeightRequest="84"/>
                            <controls:SkeletonView Grid.Column="1" HeightRequest="84"/>
                            <controls:SkeletonView Grid.Column="2" HeightRequest="84"/>
                        </Grid>
                        <VerticalStackLayout Spacing="11">
                            <controls:SkeletonView HeightRequest="108"/>
                            <controls:SkeletonView HeightRequest="108"/>
                            <controls:SkeletonView HeightRequest="108"/>
                        </VerticalStackLayout>
                        <controls:SkeletonView HeightRequest="96"/>
                    </VerticalStackLayout>

                    <!-- ── Error state ── -->
                    <VerticalStackLayout x:Name="ErrorPanel"
                                         Spacing="10"
                                         IsVisible="False"
                                         Padding="0,60,0,0">
                        <Label Text="We couldn't load the dashboard"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="ErrorDetailLabel"
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource BodyText}"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="Try again"
                                Style="{StaticResource SecondaryOutlineButton}"
                                HorizontalOptions="Center"
                                Clicked="OnRefreshClicked"/>
                    </VerticalStackLayout>

                    <!-- ── No CardiMember yet ── -->
                    <VerticalStackLayout x:Name="NoMemberPanel"
                                         Spacing="10"
                                         IsVisible="False"
                                         Padding="0,60,0,0">
                        <Label Text="Who are you watching over?"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Add the family member you want CardiTrack to keep an eye on."
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource BodyText}"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="Add CardiMember"
                                Style="{StaticResource AuthGradientButton}"
                                HorizontalOptions="Center"
                                Clicked="OnAddMemberClicked"/>
                    </VerticalStackLayout>

                    <!-- ── Loaded content ── -->
                    <VerticalStackLayout x:Name="ContentPanel" Spacing="20" IsVisible="False">

                        <!-- Safety notifications: monitoring is degraded and nothing else on this
                             screen would say so. First in the stack and deliberately unmutable —
                             with one channel, prominence is the only escalation this engine has,
                             so it is spent here and nowhere else. -->
                        <VerticalStackLayout x:Name="SafetyBannerList" Spacing="10" IsVisible="False"/>

                        <!-- "Complete the picture": the top two open nudges. Two, because a third
                             makes it a list, and a list is not a prompt. -->
                        <!-- Every open item now, not the top two: a sideways row, each item a little
                             narrower than the card so the next one shows at the edge and says the
                             row scrolls, and a count on the title so "there are others" is said
                             before anybody swipes. One item fills the card. The horizontal padding
                             lives on the heading and the row's content rather than on the Border, as
                             on the Recent Alerts card: Android clips a Border's content to its padded
                             area, and the row has to slide out under the rounded edge. -->
                        <Border x:Name="CompleteThePictureCard"
                                IsVisible="False"
                                Style="{StaticResource ElevatedCard}"
                                Padding="0,14,0,17">
                            <VerticalStackLayout Spacing="12">
                                <Grid x:Name="NudgeHeader"
                                      ColumnDefinitions="Auto,Auto,*,Auto"
                                      Margin="14,0,13,0">
                                    <Label Grid.Column="0"
                                           Text="Complete the picture"
                                           Style="{StaticResource DashboardSectionTitle}"
                                           VerticalOptions="Center"/>
                                    <!-- The Key Metrics section's count badge, so a count on a
                                         section title reads the same everywhere on the screen. -->
                                    <Border x:Name="NudgeCountBadge"
                                            Grid.Column="1"
                                            WidthRequest="20" HeightRequest="20"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource CountBadgeNeutral}"
                                            VerticalOptions="Center"
                                            IsVisible="False">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Label x:Name="NudgeCountLabel"
                                               FontFamily="QuicksandSemiBold"
                                               FontSize="11"
                                               TextColor="{StaticResource White}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Border>
                                    <Label x:Name="CompleteThePictureLink"
                                           Grid.Column="3"
                                           Text="See all"
                                           Style="{StaticResource SectionLink}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSeeAllNudgesTapped"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                                <ContentView x:Name="SingleNudgeHost" IsVisible="False" Margin="14,0,13,0"/>
                                <ScrollView x:Name="NudgeScroller"
                                            Orientation="Horizontal"
                                            HorizontalScrollBarVisibility="Never"
                                            IsVisible="False">
                                    <HorizontalStackLayout x:Name="NudgeList" Spacing="10" Padding="14,0,13,0"/>
                                </ScrollView>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Monitoring paused (M1-13) — takes precedence over the stale
                             banner, which would otherwise blame a sync that is paused on purpose. -->
                        <Border x:Name="PausedBanner"
                                IsVisible="False"
                                BackgroundColor="{StaticResource StaleBannerBackground}"
                                StrokeThickness="0"
                                Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label x:Name="PausedBannerLabel"
                                   Style="{StaticResource Body2Medium}"
                                   TextColor="{StaticResource HeadingText}"/>
                        </Border>

                        <!-- Offline last-known-good (M4-03a, brought forward). Replaces the
                             stale "pull down" copy while the live call cannot reach the API. -->
                        <controls:SavedDataBanner x:Name="SavedBanner"/>

                        <!-- Stale data banner (M1-09c) -->
                        <Border x:Name="StaleBanner"
                                IsVisible="False"
                                Opacity="0"
                                BackgroundColor="{StaticResource StaleBannerBackground}"
                                StrokeThickness="0"
                                Padding="14,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label x:Name="StaleBannerLabel"
                                   Style="{StaticResource Body2}"
                                   TextColor="{StaticResource HeadingText}"/>
                        </Border>

                        <!-- No device connected (M1-09d) is a modal now — NoDevicePopupPage, opened
                             from the member card's no-device button beside Alerts. -->

                        <!-- CardiMember card: hero, data-freshness/baseline-progress, quick
                             actions and Key Metrics all in one card so a second/third CardiMember
                             can be another instance of the same card, stacked, once multi-member
                             support lands. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="16,15,16,16">
                            <VerticalStackLayout Spacing="16">

                                <controls:StatusHeroCard x:Name="HeroCard"/>

                                <!-- Data-pipeline freshness (deterministic — see
                                     MemberInsightsCalculator.ComputeDataFreshness), the baseline
                                     learning progress while it's still running, and "Updated X
                                     ago" (issue #188 — it used to sit under the CardiMember's
                                     name).

                                     One line, not two. The freshness message ("Data updated") and
                                     the age under it ("Updated 4 minutes ago") were the same fact
                                     said twice, so the age line is the one that stays — it is the
                                     specific one — and it carries the freshness in its colour.
                                     The message itself is not lost: it goes to the label's
                                     semantic description, so a screen reader still hears the
                                     state that sighted readers now take from the colour. -->
                                <VerticalStackLayout x:Name="FreshnessBlock" Spacing="8" Margin="0,-4,0,0">
                                    <ProgressBar x:Name="LearningProgress"
                                                 IsVisible="False"
                                                 HeightRequest="6"/>
                                    <Label x:Name="LastUpdatedFooterLabel"
                                           FontFamily="QuicksandSemiBold"
                                           FontSize="14"/>
                                </VerticalStackLayout>

                                <!-- SOS / Call / Message / Details. The row, its dim-not-hide
                                     rules and its "no number yet" offer live in the control so the
                                     alert detail screen (M1-11) can present the same four actions
                                     rather than a second set worded differently — see
                                     Controls/QuickActionRow.xaml. -->
                                <controls:QuickActionRow x:Name="QuickActions"/>

                                <!-- Poor-sleep nudge (issue #188): points at the real Sleep alert
                                     StatisticalAlertWorker already raises (AlertType.Sleep) rather
                                     than re-deriving a second, parallel judgement of its own —
                                     dismissing this is a local/session convenience, not an
                                     acknowledgement; the alert itself still lives in Alerts until
                                     acted on there. -->
                                <Border x:Name="SleepConcernBanner"
                                        IsVisible="False"
                                        BackgroundColor="{StaticResource StaleBannerBackground}"
                                        StrokeThickness="0"
                                        Padding="14,10">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               x:Name="SleepConcernBannerLabel"
                                               Style="{StaticResource Body2}"
                                               TextColor="{StaticResource HeadingText}"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnSleepConcernTapped"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Button Grid.Column="1"
                                                Text="✕"
                                                FontSize="14"
                                                TextColor="{StaticResource BodyText}"
                                                BackgroundColor="Transparent"
                                                Padding="6,0"
                                                MinimumWidthRequest="32"
                                                MinimumHeightRequest="32"
                                                VerticalOptions="Center"
                                                Clicked="OnDismissSleepConcernClicked"/>
                                    </Grid>
                                </Border>

                                <!-- Key metrics: collapsed by default behind AccordionSection, two
                                     per row instead of full-width so the card has room to stay
                                     compact once more CardiMember cards can stack below it. The
                                     tiles sit directly on the CardiMember card — no wash behind
                                     the grid, so the card carries one surface, not two.

                                     Declared in the order they are read — the night first, then
                                     the day — which is the order DashboardPage.LayoutMetricCards
                                     packs them in: the pairing below is what a member whose
                                     device reports everything sees, and the slots are reassigned
                                     at render time for one whose device reports less (skin
                                     temperature, SpO2 and breathing rate are each optional) so no
                                     tile is left beside a gap. -->
                                <controls:AccordionSection x:Name="MetricsAccordion" HeaderText="Key Metrics" IconSource="icon_action_details.svg">
                                    <controls:AccordionSection.Body>
                                        <Grid ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto,Auto"
                                              ColumnSpacing="10" RowSpacing="10">
                                            <controls:MetricCard x:Name="HeartRateCard" Grid.Row="0" Grid.Column="0"/>
                                            <controls:MetricCard x:Name="SleepCard" Grid.Row="0" Grid.Column="1"/>
                                            <controls:MetricCard x:Name="TemperatureCard" Grid.Row="1" Grid.Column="0" IsVisible="False"/>
                                            <controls:MetricCard x:Name="StepsCard" Grid.Row="1" Grid.Column="1"/>
                                            <controls:MetricCard x:Name="SpO2Card" Grid.Row="2" Grid.Column="0" IsVisible="False"/>
                                            <controls:MetricCard x:Name="BreathingRateCard" Grid.Row="2" Grid.Column="1" IsVisible="False"/>
                                        </Grid>
                                    </controls:AccordionSection.Body>
                                </controls:AccordionSection>

                            </VerticalStackLayout>
                        </Border>

                        <!-- The other half of "Recent alerts": with nothing unresolved the section
                             above simply disappears, which leaves the screen saying nothing at all
                             about whether anyone is watching. This card takes that space once the
                             silence has lasted long enough to mean something — never merely because
                             the list is empty, which is also true of a paused member and of one
                             whose watch has stopped syncing. The server decides; see
                             DashboardResponse.Reassurance. -->
                        <Border x:Name="ReassuranceCard"
                                Style="{StaticResource ElevatedCard}"
                                Padding="16,18,16,18"
                                IsVisible="False">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        WidthRequest="44" HeightRequest="44"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource SelectedOptionBackground}"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Image Source="icon_status_check.svg"
                                           WidthRequest="24" HeightRequest="24"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label x:Name="ReassuranceTitleLabel"
                                           Style="{StaticResource Heading3}"
                                           TextColor="{StaticResource StatusGreen}"/>
                                    <Label x:Name="ReassuranceDetailLabel"
                                           Style="{StaticResource Body2}"
                                           TextColor="{StaticResource BodyText}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Recent alerts: a card, like "Complete the picture" above it, rather
                             than Figma's bare heading over a row of floating tiles (101:2805) —
                             a section title loose on the background read as a different screen's
                             furniture beside two cards that carry their own. The bell tile is
                             Figma's metric-row tile (MetricTileTint) at the Key Metrics size. -->
                        <!-- ElevatedCard's 14,14,13,17 is split rather than set on the Border:
                             Android clips a Border's content to its padded area, so a carousel
                             inside it would be cut off in a hard line 14 in from the rounded
                             edge. The vertical padding stays on the card; the horizontal moves
                             onto the heading, the single-alert host and the carousel's content,
                             which leaves the scroller itself free to run edge to edge. -->
                        <Border x:Name="AlertsSection"
                                IsVisible="False"
                                Style="{StaticResource ElevatedCard}"
                                Padding="0,14,0,17">
                            <VerticalStackLayout Spacing="12">
                                <Grid x:Name="AlertsHeader"
                                      ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="10"
                                      Margin="14,0,13,0">
                                    <Border Style="{StaticResource IconTile}"
                                            BackgroundColor="{StaticResource MetricTileTint}"
                                            Padding="7"
                                            WidthRequest="36" HeightRequest="36"
                                            VerticalOptions="Center">
                                        <Image Source="icon_bell.svg"
                                               WidthRequest="22" HeightRequest="22"/>
                                    </Border>
                                    <!-- The same title style as "Complete the picture": this used
                                         Heading2, a size up from every other section on the
                                         screen, which made alerts the loudest heading on a
                                         dashboard whose top card is the member. -->
                                    <Label Grid.Column="1"
                                           Text="Recent Alerts"
                                           Style="{StaticResource DashboardSectionTitle}"
                                           VerticalOptions="Center"/>
                                    <!-- Text set in code: it carries the count when the strip holds
                                         fewer alerts than are waiting (see ApplyAlerts). Sentence
                                         case, like the "See all" link above. -->
                                    <Label x:Name="ViewAllAlertsLink"
                                           Grid.Column="2"
                                           Text="View all"
                                           Style="{StaticResource SectionLink}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnViewAllAlertsTapped"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>

                                <!-- One alert fills the card; a carousel of one is half a row of
                                     card beside half a row of nothing. -->
                                <ContentView x:Name="SingleAlertHost" IsVisible="False" Margin="14,0,13,0"/>

                                <!-- Two or more scroll, each a little narrower than the card so
                                     the next one shows at the edge and says there is more to
                                     swipe to. Its content is padded in by the card's side
                                     padding, so cards line up with the heading at rest and slide
                                     out under the card's rounded edge rather than vanishing at
                                     an invisible line inside it. -->
                                <ScrollView x:Name="AlertsScroller"
                                            Orientation="Horizontal"
                                            HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout x:Name="AlertsStack" Spacing="10" Padding="14,0,13,0"/>
                                </ScrollView>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <!-- ChatBot launcher — extracted to Controls/ChatBotLauncher so every signed-in page
             carries the same one (chat-everywhere); Apply() feeds it this dashboard's member so
             a tap opens without a lookup. Floats over the content, not part of the
             Figma-specified header (101:2872), which has no room for a fourth icon. -->
        <controls:ChatBotLauncher x:Name="ChatBot" Grid.Row="2"/>

        <controls:BottomNavBar Grid.Row="3" Tab="Dashboard"/>

        <!-- First back-swipe at this tab root: a second swipe within two seconds leaves the app.
             The whole screen dims behind the notice — leaving is a screen-level state, not one
             more card — so the scrim spans every row, declared after the nav bar to sit over it
             too. Both are input-transparent: the second swipe is the whole interaction, and a
             notice that swallowed taps would freeze the app it is about to close. Shown by a
             quick fade in code-behind, matching the popup scrims' timing. -->
        <BoxView x:Name="ExitHintScrim"
                 Grid.RowSpan="4"
                 Color="{StaticResource ScrimOverlay}"
                 IsVisible="False"
                 InputTransparent="True"/>

        <!-- Deep red with the power glyph: this is the one banner in the app that means
             "CardiTrack is about to stop watching", and it must not dress like an ordinary
             card. DangerRed is the removal row's red — the destructive tone, not the alert
             severity token. Above the nav bar's height so it covers no tab a caregiver might
             be aiming for. -->
        <Border x:Name="ExitHintBanner"
                Grid.Row="2"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                IsVisible="False"
                InputTransparent="True"
                BackgroundColor="{StaticResource DangerRed}"
                StrokeThickness="0"
                Margin="20,0,20,16"
                Padding="16,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.25" Radius="14" Offset="0,4"/>
            </Border.Shadow>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                <!-- Decorative — the words are the message. -->
                <Image Source="icon_power_white.svg"
                       WidthRequest="18" HeightRequest="18"
                       VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False"/>
                <Label Text="Go back again to leave CardiTrack"
                       Style="{StaticResource Body1SemiBoldDark}"
                       TextColor="{StaticResource White}"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </HorizontalStackLayout>
        </Border>

        <!-- The second-long "Updating…" while a saved dashboard is replaced by live data — last,
             so it covers everything including the nav bar. See UpdatingOverlay. -->
        <controls:UpdatingOverlay x:Name="Updating" Grid.RowSpan="4"/>
    </Grid>
</ContentPage>

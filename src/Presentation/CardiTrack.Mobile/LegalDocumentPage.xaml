<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.LegalDocumentPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- The terms and the privacy policy, read inside the app rather than handed to the phone's
         browser. Someone part-way through creating an account is being asked to agree to these,
         and leaving for Chrome to read them puts a half-filled form behind an app switch. Modal,
         with its own way back, so the form is exactly where they left it. -->
    <Grid RowDefinitions="Auto,*">

        <!-- The same header as every signed-in screen (Alerts is the reference): this one had
             its own inset, a fixed 44dp circle and a 14pt subtitle, so a document opened from
             the app wore a header from a different app. -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <controls:SquareBorder Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg"
                           WidthRequest="20" HeightRequest="20"
                           VerticalOptions="Center" HorizontalOptions="Center"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label x:Name="TitleLabel"
                           Style="{StaticResource Heading3}"
                           TextColor="{StaticResource White}"/>
                    <Label Text="From carditrack.com"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <!-- Spinner under the WebView rather than over it: the document paints over this as it
             arrives, so there is no flash of a spinner sitting on finished text. -->
        <Grid Grid.Row="1">
            <VerticalStackLayout x:Name="LoadingPanel"
                                 Spacing="10"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}"/>
                <Label Text="Fetching the latest version…"
                       Style="{StaticResource Body2}"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ErrorPanel"
                                 IsVisible="False"
                                 Spacing="10"
                                 Padding="28"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="Couldn't load this"
                       Style="{StaticResource Body1SemiBoldDark}"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="ErrorDetailLabel"
                       Style="{StaticResource Body2}"
                       HorizontalTextAlignment="Center"/>
                <Button Text="Try again"
                        Style="{StaticResource SecondaryOutlineButton}"
                        Clicked="OnRetryClicked"/>
            </VerticalStackLayout>

            <WebView x:Name="DocumentView"
                     Navigating="OnNavigating"
                     Navigated="OnNavigated"
                     IsVisible="False"/>
        </Grid>
    </Grid>
</ContentPage>

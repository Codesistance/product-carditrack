<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.JoinFamilyPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- Asking to join, by Family ID or by a link somebody sent (D-11). The same field the
         Family tab's no-family state carries, as a page of its own for a caregiver who already
         has a family and reached this from the switcher drawer. -->
    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None, Container, None, None">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <controls:SquareBorder Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           SemanticProperties.Description="Back"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Join a family"
                           Style="{StaticResource Heading3}"
                           TextColor="{StaticResource White}"/>
                    <Label Text="With their Family ID, or the link they sent"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,28" Spacing="14">

                <Border Style="{StaticResource ElevatedCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Their Family ID"
                               Style="{StaticResource DashboardSectionTitle}"/>
                        <Label Text="Eight characters, like KTR7-M2Q9. Whoever set CardiTrack up for your family can read it off their own Family tab."
                               Style="{StaticResource Body2}"
                               LineBreakMode="WordWrap"/>
                        <Border Style="{StaticResource AuthEntryBorder}">
                            <Entry x:Name="CodeEntry"
                                   Style="{StaticResource AuthEntry}"
                                   Placeholder="KTR7-M2Q9"
                                   ReturnType="Go"
                                   Completed="OnAskCompleted"
                                   SemanticProperties.Description="Family ID or invitation link"/>
                        </Border>
                        <Button x:Name="AskButton"
                                Text="Ask to join"
                                Style="{StaticResource PrimaryGradientButton}"
                                Clicked="OnAskClicked"/>
                    </VerticalStackLayout>
                </Border>

                <!-- The security property, said out loud rather than left implicit: knowing the
                     code buys the right to ask, and approval is the access gate (D-11). -->
                <Border Style="{StaticResource ElevatedCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="What asking does"
                               Style="{StaticResource DashboardSectionTitle}"/>
                        <controls:FindingsList x:Name="NotesList"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

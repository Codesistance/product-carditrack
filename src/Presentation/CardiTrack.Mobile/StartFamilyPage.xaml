<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.StartFamilyPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- The guest's way out of being a guest (D-12): a family is created the moment they add
         the first person to watch, and the trial starts then — not at sign-up, and not here. -->
    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None, Container, None, None">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <controls:SquareBorder Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           SemanticProperties.Description="Back"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Start a family"
                           Style="{StaticResource Heading3}"
                           TextColor="{StaticResource White}"/>
                    <Label Text="Your own, with you running it"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,28" Spacing="14">

                <Border Style="{StaticResource ElevatedCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="What happens next"
                               Style="{StaticResource DashboardSectionTitle}"/>
                        <controls:FindingsList x:Name="StepsList"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ElevatedCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="About your trial"
                               Style="{StaticResource DashboardSectionTitle}"/>
                        <Label x:Name="TrialLabel"
                               Style="{StaticResource Body2}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <controls:AppButton x:Name="AddMemberButton"
                                    Text="Add the first person to watch"
                                    Clicked="OnAddMemberClicked"
                                    Tone="Primary"
                                    Size="L"/>

                <controls:AppButton Text="Not now"
                                    Clicked="OnNotNowClicked"
                                    Tone="Secondary"
                                    Size="L"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

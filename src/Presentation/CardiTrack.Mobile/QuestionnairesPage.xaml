<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.QuestionnairesPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- Everything the service has asked this member's family, and what they said. Reached from
         the CardiMember detail page; no Figma frame yet, so it is built from the same components
         and styles as the screens either side of it. Full-bleed, like every page.

         The answered history is a CollectionView rather than a stack in a ScrollView: it is the
         only way to get real virtualization and RemainingItemsThreshold lazy-loading, and it must
         not sit inside an outer ScrollView or that virtualization is defeated. Everything that used
         to sit above the answered stack — the intro, the pending card, the search box, the empty
         state — now lives in CollectionView.Header so it scrolls with the list instead of pinning
         above it. -->

    <Grid RowDefinitions="Auto,*,Auto">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,26">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        WidthRequest="40" HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"
                           SemanticProperties.Description="Back"/>
                </Border>

                <Label Grid.Column="1"
                       Text="Questions &amp; Answers"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"
                       VerticalTextAlignment="Center"/>
            </Grid>
        </controls:HeaderBand>

        <Grid Grid.Row="1">

            <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" Padding="20,20" IsVisible="False">
                <controls:SkeletonView HeightRequest="120"/>
                <controls:SkeletonView HeightRequest="120"/>
                <controls:SkeletonView HeightRequest="120"/>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ErrorPanel" Spacing="12" Padding="20,20" IsVisible="False">
                <Label Text="We couldn't load these questions"
                       Style="{StaticResource Heading3}"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="ErrorDetailLabel"
                       Style="{StaticResource Body2}"
                       HorizontalTextAlignment="Center"/>
                <Button Text="Try again"
                        Style="{StaticResource SecondaryOutlineButton}"
                        Clicked="OnRetryClicked"/>
            </VerticalStackLayout>

            <RefreshView x:Name="Refresher"
                         IsVisible="False"
                         RefreshColor="{StaticResource Primary}"
                         Refreshing="OnPullToRefresh">
                <!-- No Padding here: CollectionView doesn't reliably expose it as a bindable
                     property across MAUI/platform versions (it built locally but failed Android's
                     XamlC in CI with XC0009 — "No property ... found for Padding"). Insets are done
                     with Margin instead, which every View supports, applied to the header, each
                     item's root, and the footer so the edges line up. -->
                <CollectionView x:Name="AnsweredList"
                                VerticalScrollBarVisibility="Never"
                                RemainingItemsThreshold="3"
                                RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="14"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="16" Margin="20,20,20,16">

                            <Label x:Name="IntroLabel"
                                   Style="{StaticResource Body2}"
                                   LineBreakMode="WordWrap"/>

                            <!-- The one still waiting, if there is one: a caregiver who scrolled past
                                 it on the member's page can still answer it here. -->
                            <controls:QuestionCard x:Name="PendingCard" IsVisible="False"/>

                            <!-- Full-text search over this member's Q&A history. Hidden until there is
                                 anything to search — a search box over an empty archive is a control
                                 with nothing to do. -->
                            <Border x:Name="SearchBorder"
                                    Style="{StaticResource AuthEntryBorder}"
                                    HeightRequest="48"
                                    IsVisible="False">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="🔍"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           AutomationProperties.IsInAccessibleTree="False"/>

                                    <Entry x:Name="SearchEntry"
                                           Grid.Column="1"
                                           FontFamily="Quicksand"
                                           FontSize="14"
                                           Placeholder="Search your questions and answers"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                           PlaceholderColor="{StaticResource Gray500}"
                                           ReturnType="Search"
                                           TextChanged="OnSearchTextChanged"/>

                                    <Button x:Name="ClearSearchButton"
                                            Grid.Column="2"
                                            Text="✕"
                                            FontFamily="QuicksandSemiBold"
                                            FontSize="13"
                                            TextColor="{StaticResource MutedText}"
                                            BackgroundColor="Transparent"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            Padding="0"
                                            IsVisible="False"
                                            SemanticProperties.Description="Clear search"
                                            Clicked="OnClearSearchClicked"/>
                                </Grid>
                            </Border>

                            <Border x:Name="EmptyPanel"
                                    Style="{StaticResource ElevatedCard}"
                                    Padding="20,17,20,20"
                                    IsVisible="False">
                                <VerticalStackLayout Spacing="6">
                                    <Label x:Name="EmptyTitleLabel"
                                           Style="{StaticResource Heading3}"
                                           HorizontalTextAlignment="Center"/>
                                    <Label x:Name="EmptyDetailLabel"
                                           Style="{StaticResource Body2}"
                                           TextColor="{StaticResource HeadingText}"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="controls:AnsweredQuestionnaireItem">
                            <controls:AnsweredQuestionRow
                                Margin="20,0,20,0"
                                AnswerSubmitted="OnAnsweredRowAnswerSubmitted"
                                DeleteRequested="OnAnsweredRowDeleteRequested"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <!-- Always present (unlike the skeleton it wraps) so the list keeps the same
                             trailing breathing room below the last row whether or not a page is
                             loading — the old page's Grid.Padding bottom inset, reproduced without a
                             CollectionView.Padding. -->
                        <VerticalStackLayout Margin="20,14,20,28">
                            <controls:SkeletonView x:Name="LoadMoreSkeleton"
                                                    HeightRequest="72"
                                                    IsVisible="False"/>
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        </Grid>

        <controls:BottomNavBar Grid.Row="2" Tab="Dashboard"/>
    </Grid>
</ContentPage>

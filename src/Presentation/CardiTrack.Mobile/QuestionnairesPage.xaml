<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.QuestionnairesPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- Everything the service has asked this member's family, and what they said. Reached from
         the CardiMember detail page; no Figma frame yet, so it is built from the same components
         and styles as the screens either side of it. Full-bleed, like every page. -->

    <Grid RowDefinitions="Auto,*,Auto">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,26">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        WidthRequest="40" HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"
                           SemanticProperties.Description="Back"/>
                </Border>

                <Label Grid.Column="1"
                       Text="Questions &amp; Answers"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"
                       VerticalTextAlignment="Center"/>
            </Grid>
        </controls:HeaderBand>

        <RefreshView x:Name="Refresher"
                     Grid.Row="1"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView>
                <Grid Padding="20,20,20,28">

                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                        <controls:SkeletonView HeightRequest="120"/>
                        <controls:SkeletonView HeightRequest="120"/>
                        <controls:SkeletonView HeightRequest="120"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ErrorPanel" Spacing="12" IsVisible="False">
                        <Label Text="We couldn't load these questions"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="ErrorDetailLabel"
                               Style="{StaticResource Body2}"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="Try again"
                                Style="{StaticResource SecondaryOutlineButton}"
                                Clicked="OnRetryClicked"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ContentPanel" Spacing="16" IsVisible="False">

                        <Label x:Name="IntroLabel"
                               Style="{StaticResource Body2}"
                               LineBreakMode="WordWrap"/>

                        <!-- The one still waiting, if there is one: a caregiver who scrolled past
                             it on the member's page can still answer it here. -->
                        <controls:QuestionCard x:Name="PendingCard" IsVisible="False"/>

                        <Border x:Name="EmptyPanel"
                                Style="{StaticResource ElevatedCard}"
                                Padding="20,17,20,20"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="6">
                                <Label x:Name="EmptyTitleLabel"
                                       Text="Nothing to look back on yet"
                                       Style="{StaticResource Heading3}"
                                       HorizontalTextAlignment="Center"/>
                                <Label x:Name="EmptyDetailLabel"
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource HeadingText}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout x:Name="AnsweredStack" Spacing="14"/>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <controls:BottomNavBar Grid.Row="2" Tab="Dashboard"/>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Lists this app's Documents directory in Files, so an export the caregiver chose to save
	     is somewhere they can find it again. Only Documents is exposed, and the only thing the
	     app puts there is a saved export: the offline read cache, the logs and the draft photos
	     all live under AppDataDirectory (Library), which these keys do not reach. See
	     Services/ExportFileSaver.cs. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<!-- Push delivery spine (notification_engine.md Phase 3) — remote-notification background
	     mode lets a silent (content-available) push wake the app briefly; required alongside
	     the aps-environment entitlement in Entitlements.plist. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- CardiMember profile photo (MediaPicker). The camera string backs the photo sheet's
	     "Take a photo"; the library string covers "Choose from library" on the picker paths
	     that still consult it. iOS shows these sentences in the permission prompt. -->
	<key>NSCameraUsageDescription</key>
	<string>CardiTrack uses the camera to take a profile photo of the person you look after.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>CardiTrack uses your photo library to choose a profile photo of the person you look after.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>CardiTrack uses Face ID to confirm it's you before exporting health data.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.codesistance.carditrack.mobile.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>carditrack</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

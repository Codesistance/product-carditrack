<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Export compliance. false means "every use of encryption in this app is exempt", not
	     "this app has no encryption" — it pre-answers Apple's questionnaire so no build stalls on
	     the App Encryption Documentation prompt in App Store Connect. What we actually ship:
	     AES-256-GCM over the offline read cache (Mobile.Core/Offline/EncryptedFileOfflineReadCache.cs),
	     SHA-256 for PKCE (Mobile.Core/Auth/Pkce.cs), and TLS through the OS. Exempt because those are
	     standard published algorithms and the cryptography is ancillary — it protects the app's own
	     data rather than being a function the app offers. Revisit this key if that stops being true
	     (e.g. we ship encryption as a user-facing feature, or roll our own algorithm).
	     Full rationale: docs/apps/mobile/store_provisioning.md, section D. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
	<!-- Push delivery spine (notification_engine.md Phase 3) — remote-notification background
	     mode lets a silent (content-available) push wake the app briefly; required alongside
	     the aps-environment entitlement in Entitlements.plist. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- CardiMember profile photo (MediaPicker). The camera string backs the photo sheet's
	     "Take a photo"; the library string covers "Choose from library" on the picker paths
	     that still consult it. iOS shows these sentences in the permission prompt. -->
	<key>NSCameraUsageDescription</key>
	<string>CardiTrack uses the camera to take a profile photo of the person you look after.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>CardiTrack uses your photo library to choose a profile photo of the person you look after.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.codesistance.carditrack.mobile.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>carditrack</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

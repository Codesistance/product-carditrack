<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push delivery spine (notification_engine.md Phase 3, §4). "development" here matches
	     store_provisioning.md's convention of environment-specific signing, and is what local
	     and simulator builds want.

	     Distribution builds must NOT use this file — App Store Connect rejects an upload
	     carrying aps-environment=development with ITMS-90046, and even if it were accepted,
	     APNs would refuse the token at send time. Entitlements.Release.plist carries the
	     "production" value and is wired explicitly by the signed-IPA step in
	     .github/workflows/deploy-apps-dev.yml. Keep the two in sync when adding capabilities. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>

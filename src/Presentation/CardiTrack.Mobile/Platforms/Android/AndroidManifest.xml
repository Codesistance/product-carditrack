<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:networkSecurityConfig="@xml/network_security_config">
		<!-- Firebase Cloud Messaging (notification_engine.md Phase 3) — required by
		     Plugin.Firebase.CloudMessaging (see its cloud_messaging.md "Android specifics"),
		     confirmed current against the plugin's own sample app manifest. -->
		<!-- What the status bar shows when the FCM SDK renders the notification itself (app
		     killed or backgrounded). Without these Android falls back to @mipmap/appicon, which
		     is an adaptive launcher icon: the system alpha-masks a small icon, so a full-bleed
		     launcher icon masks to a solid square and the notification arrives blank. The
		     drawable is generated from Resources/Images/icon_notification.svg — a white
		     silhouette, the only form that survives that masking. -->
		<meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/icon_notification" />
		<meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_accent" />
		<receiver android:name="com.google.firebase.iid.FirebaseInstanceIdInternalReceiver" android:exported="false" />
		<receiver android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver" android:exported="true" android:permission="com.google.android.c2dm.permission.SEND">
			<intent-filter>
				<action android:name="com.google.android.c2dm.intent.RECEIVE" />
				<action android:name="com.google.android.c2dm.intent.REGISTRATION" />
				<category android:name="${applicationId}" />
			</intent-filter>
		</receiver>
	</application>
	<!-- Package visibility (Android 11 / API 30 and up, so every device we support — minSdk is
	     31). An app can no longer see which other apps handle an implicit intent unless it says
	     which intents it cares about here, and the handoff fails before it starts: the messaging
	     tile threw and reported "Messaging isn't supported on this device" on phones that plainly
	     do support it. These are the two handoffs the quick actions and the CardiMember detail
	     screen make — composing an SMS and opening the dialer — and nothing more: this element is
	     a declaration of what we look for, so it stays as narrow as what we actually launch.
	     ACTION_VIEW and ACTION_SENDTO are both declared for smsto because the SMS composer is
	     reached by either verb depending on which app handles it. -->
	<queries>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="smsto" />
		</intent>
		<intent>
			<action android:name="android.intent.action.SENDTO" />
			<data android:scheme="smsto" />
		</intent>
		<intent>
			<action android:name="android.intent.action.DIAL" />
			<data android:scheme="tel" />
		</intent>
	</queries>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Runtime permission on API 33+; PushRegistrationCoordinator requests it via
	     IFirebaseCloudMessaging.CheckIfValidAsync() at the moment of value (§4), not on launch. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.ExportHealthDataPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <ContentPage.Resources>
        <!-- The format cards are built in code-behind so each can carry its own explanation, so
             their type is declared here rather than repeated three times in C#. -->
        <Style x:Key="FormatNameStyle" TargetType="Label" BasedOn="{StaticResource Body2Dark}">
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>
        <Style x:Key="FormatDetailStyle" TargetType="Label" BasedOn="{StaticResource Body2}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </ContentPage.Resources>

    <!-- Same root as the other detail pages: top keeps the inset the header band is drawn
         against, bottom releases it so BottomNavBar can run white to the screen edge. Full-bleed
         per CLAUDE.md — no page-level card, radius only on the components inside. -->
    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="None, Container, None, None">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <controls:SquareBorder Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <ImageButton Source="icon_back_white.svg"
                                 WidthRequest="20" HeightRequest="20"
                                 BackgroundColor="Transparent"
                                 SemanticProperties.Description="Back"
                                 Clicked="OnBackClicked"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Export Health Data"
                           Style="{StaticResource Heading3}"
                           TextColor="{StaticResource White}"/>
                    <Label x:Name="HeaderSubtitleLabel"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <ScrollView Grid.Row="1">
            <Grid Padding="20,16,20,28">

                <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                    <controls:SkeletonView HeightRequest="80"/>
                    <controls:SkeletonView HeightRequest="160"/>
                    <controls:SkeletonView HeightRequest="220"/>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ErrorPanel" Spacing="10" IsVisible="False" Padding="0,60,0,0">
                    <Label Text="We couldn't open export"
                           Style="{StaticResource Heading3}"
                           HorizontalTextAlignment="Center"/>
                    <Label x:Name="ErrorDetailLabel"
                           Style="{StaticResource Body2}"
                           HorizontalTextAlignment="Center"/>
                    <controls:AppButton Text="Try again"
                                        HorizontalOptions="Center"
                                        Clicked="OnRetryClicked"
                                        Tone="Secondary"
                                        Size="L"/>
                </VerticalStackLayout>

                <!-- M1-17a — the form -->
                <VerticalStackLayout x:Name="FormPanel" Spacing="14" IsVisible="False">
                    <controls:SavedDataBanner x:Name="SavedBanner"/>

                    <!-- Who -->
                    <Border Style="{StaticResource ElevatedCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Export data for" Style="{StaticResource Heading3}" FontSize="16"/>
                            <controls:ChoiceField x:Name="MemberPicker"
                                                  Title="Choose a person"
                                                  Prompt="Export data for"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- When -->
                    <Border Style="{StaticResource ElevatedCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Period" Style="{StaticResource Heading3}" FontSize="16"/>

                            <!-- Presets first: the four windows a caregiver actually asks for.
                                 The pickers below stay live for anything else. -->
                            <HorizontalStackLayout x:Name="PresetRow" Spacing="8">
                                <controls:AppButton Text="7 days"
                                                    CommandParameter="7"
                                                    Clicked="OnPresetClicked"
                                                    Tone="Secondary"
                                                    Size="S"/>
                                <controls:AppButton Text="30 days"
                                                    CommandParameter="30"
                                                    Clicked="OnPresetClicked"
                                                    Tone="Secondary"
                                                    Size="S"/>
                                <controls:AppButton Text="90 days"
                                                    CommandParameter="90"
                                                    Clicked="OnPresetClicked"
                                                    Tone="Secondary"
                                                    Size="S"/>
                                <controls:AppButton Text="All"
                                                    CommandParameter="365"
                                                    Clicked="OnPresetClicked"
                                                    Tone="Secondary"
                                                    Size="S"/>
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="From" Style="{StaticResource Body2}"/>
                                    <controls:DateField x:Name="FromPicker"
                                                        Format="d MMM yyyy"
                                                        SemanticProperties.Description="From"
                                                        DateSelected="OnDateChanged"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="To" Style="{StaticResource Body2}"/>
                                    <controls:DateField x:Name="ToPicker"
                                                        Format="d MMM yyyy"
                                                        SemanticProperties.Description="To"
                                                        DateSelected="OnDateChanged"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Label x:Name="RangeHintLabel" Style="{StaticResource Body2}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- What -->
                    <Border Style="{StaticResource ElevatedCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="What to include" Style="{StaticResource Heading3}" FontSize="16"/>

                            <controls:CheckField x:Name="MetricsCheck" IsChecked="True"
                                                 Text="Activity, heart rate and sleep"
                                                 CheckedChanged="OnSelectionChanged"/>
                            <controls:CheckField x:Name="TrendsCheck" IsChecked="True"
                                                 Text="Graphs for the selected days (PDF)"
                                                 CheckedChanged="OnSelectionChanged"/>
                            <controls:CheckField x:Name="AlertsCheck" IsChecked="True"
                                                 Text="Alerts and events"
                                                 CheckedChanged="OnSelectionChanged"/>
                            <controls:CheckField x:Name="JournalsCheck"
                                                 Text="Journals (Daybook, Weekbook, Monthbook)"
                                                 CheckedChanged="OnSelectionChanged"/>
                            <controls:CheckField x:Name="NoticesCheck"
                                                 Text="Notices (device and account gaps)"
                                                 CheckedChanged="OnSelectionChanged"/>
                            <controls:CheckField x:Name="DevicesCheck"
                                                 Text="Which devices the readings came from"
                                                 CheckedChanged="OnSelectionChanged"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Format -->
                    <Border Style="{StaticResource ElevatedCard}">
                        <VerticalStackLayout x:Name="FormatStack" Spacing="10">
                            <Label Text="Format" Style="{StaticResource Heading3}" FontSize="16"/>
                            <!-- One card per format, built in code-behind so each can carry its
                                 own "who is this for" line and stay in step with the selection. -->
                        </VerticalStackLayout>
                    </Border>

                    <Label x:Name="EstimateLabel"
                           Style="{StaticResource Body2}"
                           HorizontalTextAlignment="Center"/>

                    <controls:AppButton x:Name="ExportButton"
                                        Text="Export Data"
                                        Clicked="OnExportClicked"
                                        Tone="Primary"
                                        Size="L"/>
                </VerticalStackLayout>

                <!-- M1-17b — generating -->
                <VerticalStackLayout x:Name="GeneratingPanel" Spacing="14" IsVisible="False" Padding="0,60,0,0">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" HeightRequest="36"/>
                    <Label Text="Generating export…"
                           Style="{StaticResource Heading3}"
                           HorizontalTextAlignment="Center"/>
                    <Label x:Name="GeneratingDetailLabel"
                           Style="{StaticResource Body2}"
                           HorizontalTextAlignment="Center"/>
                    <controls:AppButton Text="Cancel"
                                        HorizontalOptions="Center"
                                        Clicked="OnCancelGenerationClicked"
                                        Tone="Secondary"
                                        Size="L"/>
                </VerticalStackLayout>

                <!-- M1-17c — complete -->
                <VerticalStackLayout x:Name="CompletePanel" Spacing="12" IsVisible="False" Padding="0,50,0,0">
                    <Label Text="Export complete"
                           Style="{StaticResource Heading3}"
                           HorizontalTextAlignment="Center"/>
                    <Label x:Name="CompleteDetailLabel"
                           Style="{StaticResource Body2}"
                           HorizontalTextAlignment="Center"/>
                    <!-- Two places the file can go, and they are different things. This panel
                         offered "Save or share" — one button naming two actions — so a caregiver
                         who wanted a copy on their phone had to know the share sheet hides a
                         save inside it. The same two choices the export popup offers, in the
                         same words, with Open under them: looking at the file is a real thing
                         to want, and is not a place to put it. -->
                    <controls:AppButton x:Name="SaveButton"
                                        Text="Save to this phone"
                                        Clicked="OnSaveClicked"
                                        Tone="Primary"
                                        Size="L"/>
                    <controls:AppButton Text="Share"
                                        Clicked="OnShareClicked"
                                        Tone="Secondary"
                                        Size="L"/>
                    <controls:AppButton Text="Open"
                                        Clicked="OnOpenClicked"
                                        Tone="Secondary"
                                        Size="L"/>
                    <controls:AppButton Text="Export something else"
                                        Clicked="OnStartOverClicked"
                                        Tone="Secondary"
                                        Size="L"/>
                </VerticalStackLayout>

                <!-- M1-17d — error -->
                <VerticalStackLayout x:Name="FailedPanel" Spacing="12" IsVisible="False" Padding="0,60,0,0">
                    <Label Text="That didn't work — let's try again"
                           Style="{StaticResource Heading3}"
                           HorizontalTextAlignment="Center"/>
                    <Label x:Name="FailedDetailLabel"
                           Style="{StaticResource Body2}"
                           HorizontalTextAlignment="Center"/>
                    <controls:AppButton Text="Try again"
                                        Clicked="OnStartOverClicked"
                                        Tone="Primary"
                                        Size="L"/>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="2" Tab="Dashboard"/>

        <!-- The second-long "Updating…" while the saved member list is replaced by the live
             one — last, so it covers everything. See UpdatingOverlay. -->
        <controls:UpdatingOverlay x:Name="Updating" Grid.RowSpan="3"/>
    </Grid>
</ContentPage>

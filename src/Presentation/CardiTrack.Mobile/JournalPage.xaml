<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.JournalPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- The daybook entries, newest first — one per finished day. Replaces the Family tab, which
         held a "coming soon" card for a feature in R3; a tab that does nothing is worse than
         one fewer tab, and this is the surface the reviews had nowhere to live on.

         No Figma frame: the M1 file's bar is Home/Health/Alerts/Profile and has no Summaries
         screen, so this is a design-sync gap rather than a built frame — see the daybook entry's
         entry in the design-sync backlog. -->

    <!-- Safe area is claimed per edge, and by this layout rather than by the ContentPage:
         SafeAreaEdges is honoured on layouts, and setting it on the page above has no effect
         on Android (verified on API 37). Top keeps the status-bar inset the header band is
         drawn against; bottom releases it, so BottomNavBar can run to the screen edge and pad
         itself instead — see that control. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" SafeAreaEdges="None, Container, None, None">

        <!-- Back arrow, same treatment as Alerts and Settings — a tab root falls back to the
             dashboard when there is no history of its own to pop. The page's two actions, export
             and filter, sit together at the trailing edge as the header squares every other page
             uses for its actions (the Dashboard's bell, Alerts' filter). The filter opens the same
             sheet the Alerts header does (FilterSheetPage); it replaced three chooser chips under
             the search box, each its own popup for one question at a time. -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <!-- Fill + width-bound-to-height: the circle runs from the title's top to
                         the description's bottom and stays square at whatever that is, so every
                         header's icon matches its own text block exactly. The 40 floor keeps the
                         back button a real tap target; 99 clamps to a circle at any size. -->
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"/>
                </controls:SquareBorder>

                <!-- Title with what the page is tight beneath it — one stack, top-aligned
                     with the icon. The description is declared after the title, so screen
                     readers announce them in reading order. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="CardiJournal"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <!-- Whose book this is ("Pop's Daybooks") — the tabs below already say which
                         book, so the line names the person instead of repeating them — and what
                         the list is narrowed to while it is, so a filtered list can be told from a
                         quiet one without scrolling back to the strip. -->
                    <Label x:Name="HeaderSubtitle"
                           Text="Daybooks of finished days"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Start">

                <!-- Export every entry in a range of this book. An icon square rather than the
                     worded ExportAction pill: in the header it sits with the filter as one of the
                     page's two actions, and a screen reader is told what it does. It still asks
                     which range, in the book's own unit, before anything is saved. Shown once there
                     is a member to export — before any entry exists too, since a caregiver can
                     still ask for a range and be told there is nothing in it. -->
                <Border x:Name="ExportButton"
                        IsVisible="False"
                        SemanticProperties.Description="Export Range"
                        Style="{StaticResource HeaderActionSquare}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExportTapped"/>
                    </Border.GestureRecognizers>
                    <Image Source="icon_export.svg"
                           WidthRequest="24" HeightRequest="24"/>
                </Border>

                <!-- The Alerts header's filter square, unchanged: HeaderActionSquare, filled
                     PrimaryDark with a white glyph while a filter is on, and a count of the parts
                     narrowing the list on its corner. Hidden until there is something to filter
                     or someone else to switch to — see PaintFilterChrome. -->
                <Grid x:Name="FilterButtonHost"
                      VerticalOptions="Start"
                      IsVisible="False">
                    <Border x:Name="FilterButton"
                            SemanticProperties.Description="Filter the journal"
                            Style="{StaticResource HeaderActionSquare}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterTapped"/>
                        </Border.GestureRecognizers>
                        <Image x:Name="FilterIcon"
                               Source="icon_filter.svg"
                               WidthRequest="24" HeightRequest="24"/>
                    </Border>
                    <Border x:Name="FilterCountBadge"
                            IsVisible="False"
                            BackgroundColor="{StaticResource White}"
                            Stroke="{StaticResource PrimaryDark}"
                            StrokeThickness="1"
                            WidthRequest="18" HeightRequest="18"
                            HorizontalOptions="End" VerticalOptions="Start"
                            TranslationX="6" TranslationY="-6"
                            InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="9"/>
                        </Border.StrokeShape>
                        <Label x:Name="FilterCountLabel"
                               FontSize="10"
                               FontFamily="QuicksandSemiBold"
                               TextColor="{StaticResource PrimaryDark}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>
                </HorizontalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <!-- Which book is being read. Visible whether or not the member has any entries yet: a
             caregiver whose Daybooks have not started is exactly the one who needs to see that
             weeks exist. Deliberately outside FilterPanel, which hides itself on an empty
             history — this is navigation between series, not a filter within one.

             Three segments now the Monthbook writes: each one selects a series something
             actually produces. The row is the segments alone, in equal thirds across the page:
             export moved up into the header, and with it went the reason the segments were sized
             to their words and pushed to one side. -->
        <Grid x:Name="CadenceRow"
              Grid.Row="1"
              Margin="20,16,20,0"
              IsVisible="False">
        <Border x:Name="CadencePanel"
                Padding="4"
                StrokeThickness="0"
                BackgroundColor="{StaticResource SelectedOptionBackground}"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">

                <Border x:Name="DaysSegment"
                        Grid.Column="0"
                        Padding="18,7"
                        StrokeThickness="0"
                        SemanticProperties.Description="Days"
                        SemanticProperties.Hint="Shows one entry for each finished day">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDaysSegmentTapped"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="DaysSegmentLabel"
                           Text="Days"
                           FontFamily="QuicksandSemiBold"
                           FontSize="13"
                           HorizontalOptions="Center"/>
                </Border>

                <Border x:Name="WeeksSegment"
                        Grid.Column="1"
                        Padding="18,7"
                        StrokeThickness="0"
                        SemanticProperties.Description="Weeks"
                        SemanticProperties.Hint="Shows one entry for each finished week">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWeeksSegmentTapped"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="WeeksSegmentLabel"
                           Text="Weeks"
                           FontFamily="QuicksandSemiBold"
                           FontSize="13"
                           HorizontalOptions="Center"/>
                </Border>

                <Border x:Name="MonthsSegment"
                        Grid.Column="2"
                        Padding="18,7"
                        StrokeThickness="0"
                        SemanticProperties.Description="Months"
                        SemanticProperties.Hint="Shows one entry for each finished month">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMonthsSegmentTapped"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="MonthsSegmentLabel"
                           Text="Months"
                           FontFamily="QuicksandSemiBold"
                           FontSize="13"
                           HorizontalOptions="Center"/>
                </Border>
            </Grid>
        </Border>
        </Grid>

        <!-- Search and the applied-filter strip sit outside the scroller so what narrows the list
             stays in view while it is scrolled — the same reason the Alerts strip does. Hidden
             until the member has any entry at all: a search box over a first-days empty state is
             a control with nothing to do. -->
        <!-- The strip sits closer to the search box than to whatever the list starts with, and
             the panel keeps a little padding under it. With twelve above and none below the old
             chips were flush against the panel's edge, so the first card's own margin was the
             only thing between them and the list — which read as the chips belonging to the card
             rather than to the search above them. -->
        <VerticalStackLayout x:Name="FilterPanel"
                             Grid.Row="2"
                             Spacing="6"
                             Padding="20,20,20,10"
                             IsVisible="False">

            <!-- Same treatment as the questionnaires archive search. Server-side and debounced:
                 the search runs over the whole history, not the loaded page. -->
            <Border Style="{StaticResource AuthEntryBorder}" HeightRequest="48">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="🔍"
                           FontSize="16"
                           VerticalOptions="Center"
                           AutomationProperties.IsInAccessibleTree="False"/>

                    <Entry x:Name="SearchEntry"
                           Grid.Column="1"
                           FontFamily="Quicksand"
                           FontSize="14"
                           Placeholder="Search the journal"
                           TextColor="{StaticResource HeadingText}"
                           PlaceholderColor="{StaticResource Gray500}"
                           ReturnType="Search"
                           TextChanged="OnSearchTextChanged"/>

                    <Button x:Name="ClearSearchButton"
                            Grid.Column="2"
                            Text="✕"
                            FontFamily="QuicksandSemiBold"
                            FontSize="13"
                            TextColor="{StaticResource MutedText}"
                            BackgroundColor="Transparent"
                            WidthRequest="32"
                            HeightRequest="32"
                            Padding="0"
                            IsVisible="False"
                            Clicked="OnClearSearchClicked"/>
                </Grid>
            </Border>

            <!-- What the list is narrowed to, one removable pill per part and a way to clear them
                 all — only while a filter is on. The Alerts strip's pills, built by the same
                 code (FilterStripPill). Run to the screen's edges so a long strip scrolls under
                 them rather than stopping short at the panel's padding. -->
            <ScrollView x:Name="FilterStrip"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Margin="-20,0"
                        IsVisible="False">
                <HorizontalStackLayout x:Name="FilterStripHost" Spacing="8" Padding="20,0"/>
            </ScrollView>
        </VerticalStackLayout>

        <RefreshView x:Name="Refresher"
                     Grid.Row="3"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView>
                <VerticalStackLayout>
                <controls:SavedDataBanner x:Name="SavedBanner" Margin="20,20,20,0"/>

                <Grid Padding="20,20,20,24">

                    <!-- Loading: three quiet placeholder cards rather than a spinner, so the
                         list does not jump when the real ones arrive. -->
                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                        <Border Style="{StaticResource ElevatedCard}" HeightRequest="112"/>
                        <Border Style="{StaticResource ElevatedCard}" HeightRequest="112"/>
                        <Border Style="{StaticResource ElevatedCard}" HeightRequest="112"/>
                    </VerticalStackLayout>

                    <!-- Empty. Two distinct causes, said apart: a member whose first review has
                         not been written yet, and a filter that matched nothing — a bare
                         "nothing here" reads as a fault either way. -->
                    <VerticalStackLayout x:Name="EmptyPanel" IsVisible="False" Spacing="6">
                        <Border Style="{StaticResource ElevatedCard}">
                            <VerticalStackLayout Spacing="6">
                                <Label x:Name="EmptyTitleLabel"
                                       Text="No Daybook entries yet"
                                       Style="{StaticResource Body1SemiBoldDark}"/>
                                <Label x:Name="EmptyDetailLabel"
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource BodyText}"/>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="12">
                        <Border Style="{StaticResource ElevatedCard}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Couldn't load the journal"
                                       Style="{StaticResource Body1SemiBoldDark}"/>
                                <Label x:Name="ErrorDetailLabel"
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource BodyText}"/>
                            </VerticalStackLayout>
                        </Border>
                        <controls:AppButton Text="Try again"
                                            Clicked="OnRetryClicked"
                                            Tone="Secondary"
                                            Size="L"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ReviewsHost" Spacing="14" IsVisible="False"/>

                </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <controls:BottomNavBar Grid.Row="4" Tab="Journal"/>

        <!-- Chat from anywhere; the code-behind feeds it the selected member. -->
        <controls:ChatBotLauncher x:Name="ChatBot" Grid.Row="3"/>

        <!-- The second-long "Updating…" while a saved list is replaced by live data — last, so it
             covers everything. See UpdatingOverlay. -->
        <controls:UpdatingOverlay x:Name="Updating" Grid.RowSpan="5"/>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.AlertDetailPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- Alert detail (M1-11 / M1-12 / M1-16). Chrome matches Member Detail: HeaderBand,
         ElevatedCard, BottomNavBar. Full-bleed — radius is on the cards, not the page. -->

    <!-- Same root as the tab pages: top keeps the inset the header band is drawn against;
         bottom releases it so BottomNavBar can claim it and run white to the screen edge.
         Without this the page kept the bottom inset itself and the bar sat 14dp higher than on
         the tabs, floating on a strip of page ground with the gesture pill on it. -->
    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="None, Container, None, None">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill"
                                       SemanticProperties.Description="Back">
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <!-- Fill + width-bound-to-height: the circle runs from the title's top to
                         the description's bottom and stays square at whatever that is, so every
                         header's icon matches its own text block exactly. The 40 floor keeps the
                         back button a real tap target; 99 clamps to a circle at any size. -->
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <Image Source="icon_back_white.svg"
                           WidthRequest="20"
                           HeightRequest="20"/>
                </controls:SquareBorder>

                <!-- Title with what the page is tight beneath it — one stack, top-aligned
                     with the icon. The description is declared after the title, so screen
                     readers announce them in reading order. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Alert Details"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label Text="What happened, and what you can do about it"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <RefreshView x:Name="Refresher"
                     Grid.Row="1"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView>
                <Grid Padding="20,16,20,28">

                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                        <controls:SkeletonView HeightRequest="88"/>
                        <controls:SkeletonView HeightRequest="160"/>
                        <controls:SkeletonView HeightRequest="80"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ErrorPanel"
                                         Spacing="10"
                                         IsVisible="False"
                                         Padding="0,60,0,0">
                        <Label Text="We couldn't load this alert"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="ErrorDetailLabel"
                               Style="{StaticResource Body2}"
                               HorizontalTextAlignment="Center"/>
                        <controls:AppButton Text="Try again"
                                            HorizontalOptions="Center"
                                            Clicked="OnRetryClicked"
                                            Tone="Secondary"
                                            Size="L"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ContentPanel" Spacing="14" IsVisible="False">

                        <controls:SavedDataBanner x:Name="SavedBanner"/>

                        <!-- Who first, then what: the CardiMember card leads and the severity
                             banner follows it. The badge — NOTICE / URGENT / CRITICAL — sits in
                             this card's top-right corner, in the severity's own colour, in a
                             column of its own so the avatar and the name/type stack keep their
                             places and alignment exactly as before. -->
                        <!-- The severity rail the Alerts list card and the dashboard alert rows
                             wear (AlertListCard): the colour underneath, the white card inset 4
                             from its left edge so the colour rounds into the corners. Coloured in
                             code with the banner (ApplySeverity), so the person and the alert
                             about them read in one colour down the screen. -->
                        <Border x:Name="MemberSeverityRail"
                                StrokeThickness="0"
                                Padding="4,0,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource CardCornerRadius}"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.15" Radius="14" Offset="0,4"/>
                            </Border.Shadow>
                            <Border BackgroundColor="{StaticResource White}"
                                    StrokeThickness="0"
                                    Padding="14,14,13,17">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{StaticResource CardCornerRadius}"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <controls:MemberAvatar x:Name="Avatar" BoxWidth="52"/>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label x:Name="MemberNameLabel"
                                                   Style="{StaticResource Body1SemiBoldDark}"/>
                                            <Label x:Name="MemberTypeLabel"
                                                   Style="{StaticResource Body2}"/>
                                        </VerticalStackLayout>
                                        <Label x:Name="SeverityBadge"
                                               Grid.Column="2"
                                               HorizontalOptions="End"
                                               VerticalOptions="Start"
                                               FontFamily="QuicksandSemiBold"
                                               FontSize="12"/>
                                    </Grid>

                                    <!-- The four ways to reach this person, inside their card and under a
                                         hairline: icon-only and packed to the right, where they sat as a
                                         full row of labelled tiles further down the page. Same control as
                                         the Dashboard's (Compact) — tints, dimming and taps unchanged. -->
                                    <BoxView Style="{StaticResource DividerLine}"/>
                                    <controls:QuickActionRow x:Name="QuickActions" Compact="True"/>
                                </VerticalStackLayout>
                            </Border>
                        </Border>

                        <!-- No padding on the banner itself: the handled strip runs edge to edge
                             across its top and is clipped by its corners, so the padding lives on
                             the strip and on the content below it instead. -->
                        <Border x:Name="SeverityBanner"
                                StrokeThickness="0"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource CardCornerRadius}"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="0">

                                <!-- Once the alert has been dealt with, the banner says so first: a
                                     green strip across its top, part of the same card rather than a
                                     caption under the buttons, because "it settled on its own" or "Tom
                                     acknowledged" changes how everything below it reads. Green once
                                     the episode is over, dark blue while somebody has only
                                     acknowledged it (set in ApplyAcknowledgement), whatever colour the
                                     alert itself was; the severity ground stays underneath so the two
                                     never blur. -->
                                <Grid x:Name="HandledStrip"
                                      IsVisible="False"
                                      BackgroundColor="{StaticResource HandledStripBackground}"
                                      Padding="16,7"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="6">
                                    <Image Source="icon_check_white.svg"
                                           WidthRequest="15" HeightRequest="15"
                                           VerticalOptions="Center"/>
                                    <Label x:Name="AcknowledgedLabel"
                                           Grid.Column="1"
                                           FontFamily="QuicksandSemiBold"
                                           FontSize="12"
                                           TextColor="{StaticResource White}"
                                           VerticalTextAlignment="Center"/>
                                </Grid>
                                <!-- The icon says what the alert is about; the banner's colour already
                                     says how bad it is. It used to be a second severity glyph — and
                                     one stroked in the severity colour at that, so on the yellow and
                                     orange banners it was the same colour as the ground behind it and
                                     the title simply had no icon at all. Hence the translucent-white
                                     tile and the white-stroke variants: on a coloured ground the mark
                                     has to bring its own contrast.

                                     NOTICE / URGENT / CRITICAL is not on this banner at all: it sits
                                     in the top-right of the CardiMember card above, where the banner's
                                     colour has already said how bad it is. The tile spans both rows,
                                     from the title's top to the date's bottom — the same Fill +
                                     width-bound-to-height treatment the header's back button uses. -->
                                <Grid RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="12"
                                      RowSpacing="4"
                                      Padding="16,14">
                                    <!-- Fill + width-bound-to-height: the tile matches the title and
                                         date exactly and stays square at whatever that is. -->
                                    <controls:SquareBorder Grid.Row="0" Grid.RowSpan="2"
                                            Grid.Column="0"
                                            StrokeThickness="0"
                                            BackgroundColor="#33FFFFFF"
                                            VerticalOptions="Fill">
                                        <controls:SquareBorder.StrokeShape>
                                            <RoundRectangle CornerRadius="14"/>
                                        </controls:SquareBorder.StrokeShape>
                                        <Image x:Name="ReasonIcon"
                                               WidthRequest="24" HeightRequest="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </controls:SquareBorder>
                                    <Label x:Name="TitleLabel"
                                           Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource Heading3}"
                                           TextColor="{StaticResource White}"
                                           LineBreakMode="WordWrap"/>
                                    <!-- A size under the body text: when it happened is the least
                                         load-bearing line on the banner, and at body size it competed
                                         with the title. Pinned to the bottom of its row so its last line
                                         sits on the icon tile's bottom edge — the tile spans both rows,
                                         so the two finish on the same line whatever the title wraps to. -->
                                    <Label x:Name="TimeLabel"
                                           Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource Body2}"
                                           FontSize="12"
                                           TextColor="{StaticResource White}"
                                           VerticalOptions="End"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource ElevatedCard}">
                            <Label x:Name="MessageLabel"
                                   Style="{StaticResource Body2Dark}"
                                   LineBreakMode="WordWrap"/>
                        </Border>

                        <Border x:Name="ChartCard"
                                Style="{StaticResource ElevatedCard}"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Style="{StaticResource IconTile}"
                                            BackgroundColor="{StaticResource MetricTileTint}"
                                            WidthRequest="40" HeightRequest="40"
                                            Padding="0"
                                            VerticalOptions="Start">
                                        <Image x:Name="ChartIcon"
                                               WidthRequest="22" HeightRequest="22"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label x:Name="ChartNameLabel"
                                               Style="{StaticResource Body1SemiBoldDark}"/>
                                        <Label x:Name="ChartWindowLabel"
                                               Style="{StaticResource Body2}"
                                               FontSize="12"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2"
                                                         Spacing="1"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="End">
                                        <Label x:Name="ChartValueLabel"
                                               Style="{StaticResource Heading3}"
                                               HorizontalTextAlignment="End"/>
                                        <!-- Names the day the headline belongs to. Without it the
                                             header quoted one day and the comparison card below
                                             quoted another, with nothing on screen to say they
                                             were different days. -->
                                        <Label x:Name="ChartValueDayLabel"
                                               Style="{StaticResource Body2}"
                                               FontSize="12"
                                               HorizontalTextAlignment="End"
                                               IsVisible="False"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <controls:TrendChart x:Name="Chart" HeightRequest="160"/>
                                <Label x:Name="ChartBaselineLabel"
                                       Style="{StaticResource Body2}"
                                       FontSize="12"/>
                                <!-- The day in progress, against the same stretch of yesterday.
                                     See AlertChartResponse.PartialDayLabel. -->
                                <Label x:Name="ChartPartialDayLabel"
                                       Style="{StaticResource Body2}"
                                       FontSize="12"
                                       LineBreakMode="WordWrap"
                                       IsVisible="False"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- The deviation reads as a band across the foot of the card rather than
                             as another line inside it, which is what the design asks for and what
                             the content wants: the two figures above are neutral readings, and
                             this is the judgement drawn from them. Padding moves off the card onto
                             the two sections so the band can run edge to edge; its own bottom
                             corners match the card's, so it stays a band rather than relying on
                             the Border to clip it. -->
                        <Border x:Name="ComparisonCard"
                                Style="{StaticResource ElevatedCard}"
                                Padding="0"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                                      Padding="14,14,13,14">
                                    <VerticalStackLayout Spacing="2">
                                        <Label x:Name="CurrentLabel"
                                               Style="{StaticResource Body2}"/>
                                        <!-- Number and unit as two spans: the reading is what the
                                             eye is here for, and "steps" set at the same weight
                                             competes with the figure it belongs to. -->
                                        <Label>
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span x:Name="CurrentValueNumber"
                                                          FontFamily="QuicksandSemiBold"
                                                          FontSize="18"
                                                          TextColor="{StaticResource HeadingText}"/>
                                                    <Span x:Name="CurrentValueUnit"
                                                          FontFamily="Quicksand"
                                                          FontSize="13"
                                                          TextColor="{StaticResource BodyText}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label x:Name="NormalLabel"
                                               Style="{StaticResource Body2}"/>
                                        <Label>
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span x:Name="NormalValueNumber"
                                                          FontFamily="QuicksandSemiBold"
                                                          FontSize="18"
                                                          TextColor="{StaticResource HeadingText}"/>
                                                    <Span x:Name="NormalValueUnit"
                                                          FontFamily="Quicksand"
                                                          FontSize="13"
                                                          TextColor="{StaticResource BodyText}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>

                                <Border x:Name="ChangeBand"
                                        StrokeThickness="0"
                                        Padding="14,11"
                                        IsVisible="False">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0,0,20,20"/>
                                    </Border.StrokeShape>
                                    <Label x:Name="ChangeLabel"
                                           Style="{StaticResource Body2Medium}"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <Border x:Name="ContextCard"
                                Style="{StaticResource ElevatedCard}"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="What's going on"
                                       Style="{StaticResource DashboardSectionTitle}"/>
                                <Label x:Name="ContextLabel"
                                       Style="{StaticResource Body2}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Why this fired: the rule's own yardstick, composed in .NET from the
                             figures the producer stamped. Sits after the comparison because it
                             explains the two columns above it, and before the model's reading
                             because arithmetic earns the first word. -->
                        <Border x:Name="EvidenceCard"
                                Style="{StaticResource ElevatedCard}"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Why this came through"
                                       Style="{StaticResource DashboardSectionTitle}"/>
                                <Label x:Name="EvidenceRuleLabel"
                                       Style="{StaticResource Caption}"
                                       LineBreakMode="WordWrap"/>
                                <Label x:Name="EvidenceWhyLabel"
                                       Style="{StaticResource Body2}"
                                       LineBreakMode="WordWrap"/>
                                <!-- The line the reading crossed, as a chip so it reads as a
                                     figure rather than as another sentence. -->
                                <Border x:Name="EvidenceThresholdChip"
                                        IsVisible="False"
                                        Padding="10,5"
                                        HorizontalOptions="Start"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource InputBackground}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Label x:Name="EvidenceThresholdLabel"
                                           Style="{StaticResource Caption}"
                                           LineBreakMode="WordWrap"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- The model's reading of the same alert, kept in its own card rather
                             than run together with the evidence above: one is arithmetic this
                             product can stand behind, the other is an interpretation, and a
                             single card would let the second borrow the first's authority. -->
                        <Border x:Name="NarrativeCard"
                                Style="{StaticResource ElevatedCard}"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="What this means"
                                       Style="{StaticResource DashboardSectionTitle}"/>
                                <Label x:Name="NarrativeLabel"
                                       Style="{StaticResource Body2}"
                                       LineBreakMode="WordWrap"/>
                                <Label x:Name="NarrativeActionLabel"
                                       Style="{StaticResource Body2Dark}"
                                       IsVisible="False"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="More Options"
                               Style="{StaticResource DashboardSectionTitle}"
                               Margin="0,6,0,0"/>

                        <!-- M1-11's More Options list, restricted to the rows that do something.
                             Figma also shows Adjust Baseline, Add Note About This Alert and Book a
                             Doctor Visit; none of those has a backend yet (no baseline override,
                             no alert-notes store, no clinician or consent architecture), and a row
                             that opens an apology is worse than a row that is not there. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="4,2">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto" Padding="12,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnViewActivityDataTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label Text="View Detailed Activity Data"
                                           Style="{StaticResource Body2Dark}"
                                           VerticalTextAlignment="Center"/>
                                    <Image Grid.Column="1" Source="icon_chevron.svg"
                                           WidthRequest="14" HeightRequest="14"
                                           VerticalOptions="Center"/>
                                </Grid>

                                <BoxView HeightRequest="1"
                                         Color="{StaticResource Divider}"
                                         Margin="12,0"/>

                                <Grid ColumnDefinitions="*,Auto" Padding="12,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnShareWithFamilyTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label Text="Share"
                                           Style="{StaticResource Body2Dark}"
                                           VerticalTextAlignment="Center"/>
                                    <Image Grid.Column="1" Source="icon_chevron.svg"
                                           WidthRequest="14" HeightRequest="14"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- What the family did (D-20), newest first. The list is the
                             coordination answer this product gives instead of a notes feature:
                             every response is kept, attributed and timestamped, and the whole
                             family reads it on the alert itself. Absent until somebody has
                             answered, because an empty "What the family did" reads as nobody
                             having done anything rather than as nothing having been said. -->
                        <VerticalStackLayout x:Name="ResponsesSection"
                                             Spacing="10"
                                             IsVisible="False">
                            <Label Text="What the family did"
                                   Style="{StaticResource DashboardSectionTitle}"
                                   Margin="0,6,0,0"/>
                            <Border Style="{StaticResource ElevatedCard}" Padding="4,2">
                                <VerticalStackLayout x:Name="ResponsesHost"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- The alert's actions, side by side as equals in one row, the primary one
                             filled: Acknowledge while nobody has, Close once somebody has (see
                             ApplyAcknowledgement, which also packs the row — only the buttons the
                             alert's state allows are placed, so a row never carries a gap).

                             Close is caregiver-owned resolution: the family has dealt with it, and
                             the rule re-arms so a condition that persists fires again rather than
                             staying silent behind a note (D-20). Undo stays on the screen rather
                             than living in a toast that is gone by the time they notice, because
                             acknowledging is a claim a caregiver can make by accident. Remove wears
                             the destructive red outline; it is deliberately not a row inside "More
                             Options", which navigate, and it repeats the list's swipe delete because
                             a caregiver who opened an alert to decide about it should not have to
                             go back and find the row again.

                             Labels are one or two words so three fit a phone's width at 14 — the
                             sentences they replaced ("Mark as not handled") only fitted stacked. -->
                        <!-- The bottom margin clears the floating chat button: without it the row's
                             last button — Remove — sat under the button at the end of the scroll. -->
                        <Grid x:Name="ActionRow" ColumnSpacing="8" Margin="0,4,0,72">
                            <!-- The action buttons (Styles.xaml ActionButton*): the colour is the
                                 meaning — blue does the thing, amber takes it back, red removes.
                                 Acknowledge carries no icon: on a red alert it reads "I'm on my
                                 way", which needs the third of the row it has. -->
                            <controls:AppButton x:Name="AcknowledgeButton"
                                                Clicked="OnAcknowledgeClicked"
                                                Tone="Primary"
                                                Size="M"/>
                            <controls:AppButton x:Name="CloseButton"
                                                Text="Resolve"
                                                Icon="icon_btn_resolve.svg"
                                                Clicked="OnCloseClicked"
                                                Tone="Primary"
                                                Size="M"/>
                            <controls:AppButton x:Name="UndoAcknowledgeButton"
                                                Text="Undo"
                                                Icon="icon_btn_undo_tint.svg"
                                                IsVisible="False"
                                                Clicked="OnUndoAcknowledgeClicked"
                                                Tone="Tonal"
                                                Size="M"/>
                            <controls:AppButton x:Name="RemoveButton"
                                                Text="Remove"
                                                Icon="icon_btn_delete.svg"
                                                Clicked="OnDeleteAlertTapped"
                                                Tone="Danger"
                                                Size="M"/>
                        </Grid>

                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <controls:BottomNavBar Grid.Row="2" Tab="Alerts"/>

        <!-- Chat from anywhere; the code-behind feeds it this alert's member. -->
        <controls:ChatBotLauncher x:Name="ChatBot" Grid.Row="1"/>

        <!-- The second-long "Updating…" while a saved snapshot is replaced by live data — last,
             so it covers everything including the nav bar. See UpdatingOverlay. -->
        <controls:UpdatingOverlay x:Name="Updating" Grid.RowSpan="3"/>
    </Grid>
</ContentPage>

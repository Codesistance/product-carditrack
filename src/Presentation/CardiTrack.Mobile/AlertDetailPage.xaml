<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.AlertDetailPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- Alert detail (M1-11 / M1-12 / M1-16). Chrome matches Member Detail: HeaderBand,
         ElevatedCard, BottomNavBar. Full-bleed — radius is on the cards, not the page. -->

    <Grid RowDefinitions="Auto,*,Auto">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,16,20,26">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Grid.Column="0"
                        WidthRequest="38" HeightRequest="38"
                        StrokeThickness="0"
                        BackgroundColor="#33FFFFFF"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="19"/>
                    </Border.StrokeShape>
                    <ImageButton Source="icon_back_white.svg"
                                 WidthRequest="20" HeightRequest="20"
                                 BackgroundColor="Transparent"
                                 Clicked="OnBackClicked"/>
                </Border>

                <!-- Title with what the page is tight beneath it — one stack, top-aligned
                     with the icon. The description is declared after the title, so screen
                     readers announce them in reading order. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Alert Details"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label Text="What happened, and what you can do about it"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <RefreshView x:Name="Refresher"
                     Grid.Row="1"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView>
                <Grid Padding="20,16,20,28">

                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                        <controls:SkeletonView HeightRequest="88"/>
                        <controls:SkeletonView HeightRequest="160"/>
                        <controls:SkeletonView HeightRequest="80"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ErrorPanel"
                                         Spacing="10"
                                         IsVisible="False"
                                         Padding="0,60,0,0">
                        <Label Text="We couldn't load this alert"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="ErrorDetailLabel"
                               Style="{StaticResource Body2}"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="Try again"
                                Style="{StaticResource SecondaryOutlineButton}"
                                HorizontalOptions="Center"
                                Clicked="OnRetryClicked"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ContentPanel" Spacing="14" IsVisible="False">

                        <controls:OfflineStatusBanner x:Name="OfflineBanner"/>

                        <Border x:Name="SeverityBanner"
                                StrokeThickness="0"
                                Padding="16,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <!-- The icon says what the alert is about; the banner's colour already
                                 says how bad it is. It used to be a second severity glyph — and
                                 one stroked in the severity colour at that, so on the yellow and
                                 orange banners it was the same colour as the ground behind it and
                                 the title simply had no icon at all. Hence the translucent-white
                                 tile and the white-stroke variants: on a coloured ground the mark
                                 has to bring its own contrast. -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border WidthRequest="44" HeightRequest="44"
                                        StrokeThickness="0"
                                        BackgroundColor="#33FFFFFF"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Image x:Name="ReasonIcon"
                                           WidthRequest="24" HeightRequest="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label x:Name="SeverityBadge"
                                           FontFamily="QuicksandSemiBold"
                                           FontSize="12"
                                           TextColor="{StaticResource White}"/>
                                    <Label x:Name="TitleLabel"
                                           Style="{StaticResource Heading3}"
                                           TextColor="{StaticResource White}"
                                           LineBreakMode="WordWrap"/>
                                    <Label x:Name="TimeLabel"
                                           Style="{StaticResource Body2}"
                                           TextColor="{StaticResource White}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ElevatedCard}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <controls:MemberAvatar x:Name="Avatar" BoxWidth="52"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label x:Name="MemberNameLabel"
                                           Style="{StaticResource Body1SemiBoldDark}"/>
                                    <Label x:Name="MemberTypeLabel"
                                           Style="{StaticResource Body2}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ElevatedCard}">
                            <Label x:Name="MessageLabel"
                                   Style="{StaticResource Body2Dark}"
                                   LineBreakMode="WordWrap"/>
                        </Border>

                        <Border x:Name="ChartCard"
                                Style="{StaticResource ElevatedCard}"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Style="{StaticResource IconTile}"
                                            BackgroundColor="{StaticResource MetricTileTint}"
                                            WidthRequest="40" HeightRequest="40"
                                            Padding="0"
                                            VerticalOptions="Start">
                                        <Image x:Name="ChartIcon"
                                               WidthRequest="22" HeightRequest="22"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label x:Name="ChartNameLabel"
                                               Style="{StaticResource Body1SemiBoldDark}"/>
                                        <Label x:Name="ChartWindowLabel"
                                               Style="{StaticResource Body2}"
                                               FontSize="12"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2"
                                                         Spacing="1"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="End">
                                        <Label x:Name="ChartValueLabel"
                                               Style="{StaticResource Heading3}"
                                               HorizontalTextAlignment="End"/>
                                        <!-- Names the day the headline belongs to. Without it the
                                             header quoted one day and the comparison card below
                                             quoted another, with nothing on screen to say they
                                             were different days. -->
                                        <Label x:Name="ChartValueDayLabel"
                                               Style="{StaticResource Body2}"
                                               FontSize="12"
                                               HorizontalTextAlignment="End"
                                               IsVisible="False"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <controls:TrendChart x:Name="Chart" HeightRequest="160"/>
                                <Label x:Name="ChartBaselineLabel"
                                       Style="{StaticResource Body2}"
                                       FontSize="12"/>
                                <!-- The day in progress, against the same stretch of yesterday.
                                     See AlertChartResponse.PartialDayLabel. -->
                                <Label x:Name="ChartPartialDayLabel"
                                       Style="{StaticResource Body2}"
                                       FontSize="12"
                                       LineBreakMode="WordWrap"
                                       IsVisible="False"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- The deviation reads as a band across the foot of the card rather than
                             as another line inside it, which is what the design asks for and what
                             the content wants: the two figures above are neutral readings, and
                             this is the judgement drawn from them. Padding moves off the card onto
                             the two sections so the band can run edge to edge; its own bottom
                             corners match the card's, so it stays a band rather than relying on
                             the Border to clip it. -->
                        <Border x:Name="ComparisonCard"
                                Style="{StaticResource ElevatedCard}"
                                Padding="0"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                                      Padding="14,14,13,14">
                                    <VerticalStackLayout Spacing="2">
                                        <Label x:Name="CurrentLabel"
                                               Style="{StaticResource Body2}"/>
                                        <!-- Number and unit as two spans: the reading is what the
                                             eye is here for, and "steps" set at the same weight
                                             competes with the figure it belongs to. -->
                                        <Label>
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span x:Name="CurrentValueNumber"
                                                          FontFamily="QuicksandSemiBold"
                                                          FontSize="18"
                                                          TextColor="{StaticResource HeadingText}"/>
                                                    <Span x:Name="CurrentValueUnit"
                                                          FontFamily="Quicksand"
                                                          FontSize="13"
                                                          TextColor="{StaticResource BodyText}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label x:Name="NormalLabel"
                                               Style="{StaticResource Body2}"/>
                                        <Label>
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span x:Name="NormalValueNumber"
                                                          FontFamily="QuicksandSemiBold"
                                                          FontSize="18"
                                                          TextColor="{StaticResource HeadingText}"/>
                                                    <Span x:Name="NormalValueUnit"
                                                          FontFamily="Quicksand"
                                                          FontSize="13"
                                                          TextColor="{StaticResource BodyText}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>

                                <Border x:Name="ChangeBand"
                                        StrokeThickness="0"
                                        Padding="14,11"
                                        IsVisible="False">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="0,0,20,20"/>
                                    </Border.StrokeShape>
                                    <Label x:Name="ChangeLabel"
                                           Style="{StaticResource Body2Medium}"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"/>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <Border x:Name="ContextCard"
                                Style="{StaticResource ElevatedCard}"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="What's going on"
                                       Style="{StaticResource DashboardSectionTitle}"/>
                                <Label x:Name="ContextLabel"
                                       Style="{StaticResource Body2}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- The same four actions the Dashboard's CardiMember card offers, and the
                             same control — this screen used to carry its own pair of full-width
                             Call/Message buttons, worded differently and with their own
                             availability rules. -->
                        <controls:QuickActionRow x:Name="QuickActions" Margin="0,2,0,0"/>

                        <Label Text="More Options"
                               Style="{StaticResource DashboardSectionTitle}"
                               Margin="0,6,0,0"/>

                        <!-- M1-11's More Options list, restricted to the rows that do something.
                             Figma also shows Adjust Baseline, Add Note About This Alert and Book a
                             Doctor Visit; none of those has a backend yet (no baseline override,
                             no alert-notes store, no clinician or consent architecture), and a row
                             that opens an apology is worse than a row that is not there. -->
                        <Border Style="{StaticResource ElevatedCard}" Padding="4,2">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto" Padding="12,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnViewActivityDataTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label Text="View Detailed Activity Data"
                                           Style="{StaticResource Body2Dark}"
                                           VerticalTextAlignment="Center"/>
                                    <Image Grid.Column="1" Source="icon_chevron.svg"
                                           WidthRequest="14" HeightRequest="14"
                                           VerticalOptions="Center"/>
                                </Grid>

                                <BoxView HeightRequest="1"
                                         Color="{StaticResource Divider}"
                                         Margin="12,0"/>

                                <Grid ColumnDefinitions="*,Auto" Padding="12,14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnShareWithFamilyTapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label Text="Share with Family"
                                           Style="{StaticResource Body2Dark}"
                                           VerticalTextAlignment="Center"/>
                                    <Image Grid.Column="1" Source="icon_chevron.svg"
                                           WidthRequest="14" HeightRequest="14"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Label x:Name="AcknowledgedLabel"
                               Style="{StaticResource Body2}"
                               HorizontalTextAlignment="Center"
                               Margin="0,6,0,0"
                               IsVisible="False"/>

                        <Button x:Name="AcknowledgeButton"
                                Style="{StaticResource PrimaryGradientButton}"
                                Clicked="OnAcknowledgeClicked"/>

                        <!-- Acknowledging is a claim a caregiver makes about themselves, and they
                             can make it by accident. Undo stays on the screen rather than living
                             in a toast that is gone by the time they notice. -->
                        <Button x:Name="UndoAcknowledgeButton"
                                Text="Undo — mark as not handled"
                                Style="{StaticResource SecondaryOutlineButton}"
                                IsVisible="False"
                                Clicked="OnUndoAcknowledgeClicked"/>

                        <!-- Removal, in the same shape M1-13 gives its destructive row: its own
                             card, red ink, and below the acknowledge pair rather than above it, so
                             the irreversible action never sits where the primary one is expected.
                             The same trash glyph the alert list's swipe action uses — one action
                             reached two ways should not look like two.

                             Deliberately not a row inside "More Options": those two navigate and
                             carry a chevron, and this ends the screen. It repeats the list's swipe
                             delete because a caregiver who opened an alert to decide about it
                             should not have to go back and find the row again to act on it. -->
                        <Border Style="{StaticResource ElevatedCard}"
                                Padding="14,4"
                                Margin="0,2,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteAlertTapped"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HeightRequest="52">
                                <Image Grid.Column="0" Source="icon_trash.svg"
                                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                                <Label Grid.Column="1"
                                       Text="Remove this alert"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       TextColor="{StaticResource DangerRed}"
                                       VerticalTextAlignment="Center"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <controls:BottomNavBar Grid.Row="2" Tab="Alerts"/>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Standard MAUI utility colours ── -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- ── Figma design tokens ── -->
    <Color x:Key="GradientDarkBlue">#174E86</Color>
    <Color x:Key="GradientBlue">#1884DC</Color>
    <Color x:Key="GradientTeal">#36C09B</Color>
    <Color x:Key="Primary">#1884DC</Color>
    <Color x:Key="PrimaryDark">#174E86</Color>
    <Color x:Key="ActiveIndicator">#1A73E8</Color>
    <Color x:Key="InactiveIndicator">#D1D5DC</Color>
    <Color x:Key="HeadingText">#343434</Color>
    <Color x:Key="BodyText">#727272</Color>
    <Color x:Key="MutedText">#939DAA</Color>
    <Color x:Key="InputBackground">#F2F2F4</Color>
    <Color x:Key="InputBorder">#DCDFE4</Color>
    <Color x:Key="InputFocusBorder">#1884DC</Color>
    <Color x:Key="SelectedOptionBackground">#F0F6FF</Color>
    <Color x:Key="Divider">#E2E8F0</Color>
    <Color x:Key="ErrorRed">#E53E3E</Color>
    <Color x:Key="StrengthWeak">#E53E3E</Color>
    <Color x:Key="StrengthMedium">#1884DC</Color>
    <Color x:Key="StrengthStrong">#36C09B</Color>

    <!-- ── Dashboard status tokens (M1-09) ── -->
    <Color x:Key="StatusGreen">#36C09B</Color>
    <Color x:Key="StatusYellow">#F0A92E</Color>
    <Color x:Key="StatusOrange">#ED7B2F</Color>
    <Color x:Key="StatusRed">#E53E3E</Color>
    <Color x:Key="StatusUnknown">#939DAA</Color>
    <Color x:Key="SkeletonGray">#E7EBF0</Color>
    <Color x:Key="SleepPurple">#7C6FDC</Color>
    <Color x:Key="StaleBannerBackground">#FFF7E8</Color>

    <!-- ── M1-09 surface tokens (Figma 101:2805) ──
         The dashboard is the one screen that floats cards on a tinted ground rather than on
         white, so its card treatment is elevation + radius rather than the hairline stroke the
         rest of the app uses. Kept separate from DashboardCard, which eight other screens share. -->
    <Color x:Key="PageGround">#E8F1F4</Color>
    <Color x:Key="CardShadow">#014297</Color>
    <Color x:Key="ProgressTrack">#E5E7EB</Color>

    <!-- Metric row icon tile — Figma rgba(201,225,255,0.41) -->
    <Color x:Key="MetricTileTint">#69C9E1FF</Color>
    <!-- Header refresh button — Figma rgba(255,255,255,0.29) -->
    <Color x:Key="HeaderButtonTint">#4AFFFFFF</Color>

    <!-- Status pills: tint is the status colour at 15%, ink is the colour itself. -->
    <Color x:Key="PillGreenBackground">#2636C09B</Color>
    <Color x:Key="PillYellowBackground">#26F0A92E</Color>
    <Color x:Key="PillOrangeBackground">#26ED7B2F</Color>
    <Color x:Key="PillRedBackground">#26E53E3E</Color>
    <Color x:Key="PillNeutralBackground">#26939DAA</Color>

    <!-- Alert icon tiles — Figma rgba(239,68,68,0.14), generalised across the severity set -->
    <Color x:Key="AlertTileRed">#24E53E3E</Color>
    <Color x:Key="AlertTileOrange">#24ED7B2F</Color>
    <Color x:Key="AlertTileYellow">#24F0A92E</Color>
    <Color x:Key="AlertTileNeutral">#24939DAA</Color>

    <!-- ── Device dataset pills (M1-15) ──
         One tint/ink pair per DatasetFamily, so a device card's pills group by the kind of
         reading they carry. The heart pair is deliberately rosier than ErrorRed: a pill sits
         inches from the DISCONNECTED status chip and must not read as an alarm. -->
    <Color x:Key="DatasetActivityBackground">#E8F3FD</Color>
    <Color x:Key="DatasetActivityText">#10659F</Color>
    <Color x:Key="DatasetHeartBackground">#FDEEF1</Color>
    <Color x:Key="DatasetHeartText">#B93A55</Color>
    <Color x:Key="DatasetSleepBackground">#EEECFB</Color>
    <Color x:Key="DatasetSleepText">#5A4EBF</Color>
    <Color x:Key="DatasetBodyBackground">#E4F6F2</Color>
    <Color x:Key="DatasetBodyText">#1F8A72</Color>
    <Color x:Key="DatasetOtherBackground">#EEF1F5</Color>
    <Color x:Key="DatasetOtherText">#5C6672</Color>
    <!-- A connection sharing nothing is a problem to fix, not a neutral fact, so its pill takes
         the caution tint the NEEDS RECONNECT status chip uses rather than the grey "other" pair. -->
    <Color x:Key="DatasetWarningBackground">#FFF3DE</Color>
    <Color x:Key="DatasetWarningText">#A9741A</Color>

    <!-- ── Solid colour brushes ── -->
    <SolidColorBrush x:Key="CardShadowBrush" Color="{StaticResource CardShadow}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- ── Gradient brushes ── -->
    <LinearGradientBrush x:Key="GradientButtonBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource GradientDarkBlue}" Offset="0.0" />
        <GradientStop Color="{StaticResource GradientBlue}" Offset="0.458" />
        <GradientStop Color="{StaticResource GradientTeal}" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientButtonLightBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#4D174E86" Offset="0.0" />
        <GradientStop Color="#4D1884DC" Offset="0.458" />
        <GradientStop Color="#4D36C09B" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WelcomePageBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0F6FF" Offset="0.0" />
        <GradientStop Color="#FFFFFF" Offset="0.55" />
        <GradientStop Color="#FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroBottomFade" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#E6FFFFFF" Offset="0.0" />
        <GradientStop Color="#00FFFFFF" Offset="0.72" />
    </LinearGradientBrush>

    <!-- ── Status hero card gradients (M1-09) ── -->
    <LinearGradientBrush x:Key="HeroGreenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2AA184" Offset="0.0" />
        <GradientStop Color="#36C09B" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroYellowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D89422" Offset="0.0" />
        <GradientStop Color="#F0A92E" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroOrangeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D2691F" Offset="0.0" />
        <GradientStop Color="#ED7B2F" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroRedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C42F2F" Offset="0.0" />
        <GradientStop Color="#E53E3E" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroUnknownBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#174E86" Offset="0.0" />
        <GradientStop Color="#1884DC" Offset="1.0" />
    </LinearGradientBrush>
    <!-- Paused monitoring: deliberately outside the status palette so it can't be mistaken
         for a health reading. -->
    <LinearGradientBrush x:Key="HeroPausedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5C6672" Offset="0.0" />
        <GradientStop Color="#7E8794" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ── Dashboard header band (Figma 101:2872) ──
         Figma draws this as the brand gradient (#174E86 → #1884DC → #36C09B) on an oversized
         rect, blurred 100px and masked to the band, so only the slice between 55% and 81% of
         the ramp is visible and its right edge feathers out to the white base. MAUI has no
         cheap blur, so the visible slice is baked into the stops below and the feather is a
         second white wash layer — the two together match the rendered frame within ~3%. -->
    <LinearGradientBrush x:Key="DashboardHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1D8ED1" Offset="0.0" />
        <GradientStop Color="#2BABB2" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DashboardHeaderWashBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#00FFFFFF" Offset="0.0" />
        <GradientStop Color="#0FFFFFFF" Offset="0.30" />
        <GradientStop Color="#1AFFFFFF" Offset="0.50" />
        <GradientStop Color="#4DFFFFFF" Offset="0.65" />
        <GradientStop Color="#8CFFFFFF" Offset="0.80" />
        <GradientStop Color="#C3FFFFFF" Offset="0.92" />
        <GradientStop Color="#DBFFFFFF" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
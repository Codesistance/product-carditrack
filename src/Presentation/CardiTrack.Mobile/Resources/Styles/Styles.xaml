<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ════════════════════════════════════════════
         DEFAULT CONTROL STYLES (Quicksand base)
         ════════════════════════════════════════════ -->

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{StaticResource InactiveIndicator}"/>
        <Setter Property="SelectedIndicatorColor" Value="{StaticResource ActiveIndicator}"/>
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}" />
        <Setter Property="StrokeShape" Value="Rectangle"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Gray500}" />
                            <Setter Property="BackgroundColor" Value="{StaticResource Gray200}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource Primary}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Quicksand"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderColor" Value="{StaticResource BodyText}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Quicksand" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource HeadingText}" />
        <Setter Property="FontFamily" Value="Quicksand"/>
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource HeadingText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray500}" />
        <Setter Property="FontFamily" Value="Quicksand" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource HeadingText}, Dark={StaticResource White}}" />
    </Style>

    <!-- ════════════════════════════════════════════
         NAMED TYPOGRAPHY STYLES  (Figma tokens)
         ════════════════════════════════════════════ -->

    <!-- ════════════════════════════════════════════
         TYPE ROLES — the app's type system (see the Type Audit, 4 Sep 2026)

         Roles named for what the text IS, each fixing face, size, line height and default
         ink. One family (Quicksand) in three real faces — Regular, Medium, SemiBold — and no
         FontAttributes="Bold": that was a synthetic bold smeared onto the Regular face, which is
         why two 18pt titles on one page never matched. Weight carries hierarchy; ink carries
         role (Message is the heading ink, Body and Caption are not). LineHeight here is MAUI's
         multiplier on the face's own line spacing, which already carries Quicksand's leading —
         so 1.0 is the natural setting and anything past 1.1 reads loose; the first cut at 1.5 read
         as double-spaced, and 1.2 still did on a card of prose.

         The target state — not yet the codebase's: a page carries Style= and nothing else, no
         inline FontSize, FontFamily or FontAttributes, and TextColor only for a semantic colour
         (status, urgency, error, link), never a neutral. Today ~200 inline sizes and ~130
         unstyled labels remain; they are swept onto the roles one area at a time, and a test
         then fails the build on a new one. The older keys further down are aliases onto these
         roles so nothing had to move in the first change; an alias retires when no page names it.
         ════════════════════════════════════════════ -->

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="LineHeight" Value="1.0"/>
        <Setter Property="TextColor" Value="{StaticResource HeadingText}"/>
    </Style>
    <Style x:Key="DisplayOnBand" TargetType="Label" BasedOn="{StaticResource Display}">
        <Setter Property="TextColor" Value="{StaticResource White}"/>
    </Style>

    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="LineHeight" Value="1.0"/>
        <Setter Property="TextColor" Value="{StaticResource HeadingText}"/>
    </Style>

    <Style x:Key="Section" TargetType="Label">
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="LineHeight" Value="1.0"/>
        <Setter Property="TextColor" Value="{StaticResource HeadingText}"/>
    </Style>
    <Style x:Key="SectionOnBand" TargetType="Label" BasedOn="{StaticResource Section}">
        <Setter Property="TextColor" Value="{StaticResource White}"/>
    </Style>

    <Style x:Key="RowTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="LineHeight" Value="1.05"/>
        <Setter Property="TextColor" Value="{StaticResource HeadingText}"/>
    </Style>
    <Style x:Key="RowTitleOnBand" TargetType="Label" BasedOn="{StaticResource RowTitle}">
        <Setter Property="TextColor" Value="{StaticResource White}"/>
    </Style>

    <!-- Text that is the message to the caregiver — an alert's account, a summary, advice, a
         nudge body. Medium, not bold: clearly heavier than Body, but a paragraph of bold tires. -->
    <Style x:Key="Message" TargetType="Label">
        <Setter Property="FontFamily" Value="QuicksandMedium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="1.1"/>
        <Setter Property="TextColor" Value="{StaticResource HeadingText}"/>
    </Style>

    <!-- Descriptions, row subtitles, field labels: about something, not the thing itself. -->
    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontFamily" Value="Quicksand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="1.1"/>
        <Setter Property="TextColor" Value="{StaticResource BodyText}"/>
    </Style>

    <!-- Body's compact sibling for dense rows — chips, pill neighbours, settings descriptions. -->
    <Style x:Key="Compact" TargetType="Label" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="1.05"/>
    </Style>

    <!-- Dates, "Written …", sources, disclaimers, the header band's second line. -->
    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="Quicksand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="1.05"/>
        <Setter Property="TextColor" Value="{StaticResource MutedText}"/>
    </Style>
    <Style x:Key="CaptionOnBand" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <!-- Small uppercase labels: pills, "LAST SYNC", tab titles. Tracked so it reads at 11. -->
    <Style x:Key="Overline" TargetType="Label">
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="CharacterSpacing" Value="0.6"/>
        <Setter Property="TextColor" Value="{StaticResource MutedText}"/>
    </Style>

    <!-- A tappable phrase in running text or at a row's end. -->
    <Style x:Key="Link" TargetType="Label">
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource Primary}"/>
    </Style>

    <!-- ── Aliases: the pre-roles keys, each pointed at its role ─────────────────────────── -->
    <Style x:Key="Heading1" TargetType="Label" BasedOn="{StaticResource Display}"/>

    <Style x:Key="Heading1White" TargetType="Label" BasedOn="{StaticResource DisplayOnBand}"/>

    <Style x:Key="Heading2" TargetType="Label" BasedOn="{StaticResource Title}"/>

    <Style x:Key="Heading3" TargetType="Label" BasedOn="{StaticResource Section}"/>

    <!-- The title on the three screens that sign a caregiver in. Half again the Heading3 those
         bands used to carry: sign-in, create-account and forgot-password each hold one title and
         a single line under it, so the title is the screen rather than a label on it.

         Tried at double first, which is where the reasoning above leads and where the eye
         disagrees — "Welcome Back" ran nearly the full width and stopped reading as a greeting.
         27 is the size at which it still leads the band without becoming the band.

         Its own key rather than three inline overrides: they change together, and the next person
         to touch one should not have to notice the other two. -->
    <Style x:Key="AuthHeaderTitle" TargetType="Label" BasedOn="{StaticResource DisplayOnBand}"/>

    <!-- The line under an auth title. Two points down from Body1SemiBold, which these carried
         until the title grew: at 16 the longest of them — "Sign in to keep watching over your
         family" — ran the full width of the band and into the brand mark in the corner, so the
         sentence lost contrast exactly where it ended. Smaller also puts air between it and a
         27pt title, which a two-point gap could not.

         Its own key rather than editing Body1SemiBold, which is shared with screens that have no
         title above them and no mark beside them. -->
    <Style x:Key="AuthHeaderSubtitle" TargetType="Label" BasedOn="{StaticResource CaptionOnBand}">
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style x:Key="Body1SemiBold" TargetType="Label" BasedOn="{StaticResource RowTitleOnBand}"/>

    <Style x:Key="Body1SemiBoldDark" TargetType="Label" BasedOn="{StaticResource RowTitle}"/>

    <Style x:Key="Body2Medium" TargetType="Label" BasedOn="{StaticResource Message}"/>

    <Style x:Key="Body2" TargetType="Label" BasedOn="{StaticResource Body}"/>

    <!-- Body copy a reader came for rather than copy that annotates something else: the generated
         summary and the ways to help under it. Same face and size as Body2 in the heading ink —
         Body2's grey is right for a caption beside a number, but it made the two paragraphs that
         are the point of the screen the palest thing on it. Not Body2Medium: that darkens by
         changing the weight too, which reads as emphasis rather than as ordinary prose. -->
    <Style x:Key="Body2Dark" TargetType="Label" BasedOn="{StaticResource Message}"/>

    <!-- Body copy at a section's size: the one-line subtitle under a Display or Title. Based on
         Body, not Section, so it keeps body ink, face and line height and borrows only the size. -->
    <Style x:Key="BodySubtitle" TargetType="Label" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
    </Style>

    <!-- ════════════════════════════════════════════
         NAMED BUTTON STYLES
         ════════════════════════════════════════════ -->

    <!-- 16, not 18: at 18 the label was the largest bold text on most screens that carry one
         of these, outweighing the Heading3 titles above it. Every gradient button takes its
         size from here — no per-instance FontSize — so they all read as one control. -->
    <Style x:Key="PrimaryGradientButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GradientButtonBrush}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="BorderWidth" Value="0"/>
    </Style>

    <!-- Full gradient by default; the light gradient signals "not actionable".
         Disabled buttons dim via the trigger; pages that keep the button enabled
         while a form is incomplete (so taps can surface validation errors) swap
         the Background locally instead, which overrides the trigger. -->
    <Style x:Key="AuthGradientButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GradientButtonBrush}"/>
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Style.Triggers>
            <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource GradientButtonLightBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryOutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="TextColor" Value="{StaticResource Primary}"/>
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="BorderColor" Value="{StaticResource PrimaryDark}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <!-- The action on a card that is one of several. An outlined blue pill was the first try
         and it was wrong twice over: at 52 high with 16px type it outweighed the sentence it
         belonged to, and repeated down a stack of cards the border made every card look like a
         form. This is the quick-action tint the dashboard already uses for a quiet blue action,
         with no border at all — the tint is the affordance — at a corner that matches the card
         around it rather than a page-footer pill. -->
    <Style x:Key="CardActionButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource QuickActionTint}"/>
        <Setter Property="TextColor" Value="{StaticResource PrimaryDark}"/>
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HeightRequest" Value="34"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="Padding" Value="14,0"/>
    </Style>

    <!-- The secondary button for an action that stops something: leaving, disconnecting,
         ending. Same shape and weight as SecondaryOutlineButton — it is still the quieter of
         two choices — but in the red of the banner that follows it, so the button and its
         consequence look like one another. Not for ordinary secondaries ("Try again",
         "Connect a device"): red everywhere is red nowhere. -->
    <Style x:Key="DangerOutlineButton" TargetType="Button" BasedOn="{StaticResource SecondaryOutlineButton}">
        <!-- DangerRed, not ErrorRed: this is 16px label text on white and has to clear 4.5:1,
             which is the whole reason the darker token exists. ErrorRed is for fills and dots. -->
        <Setter Property="TextColor" Value="{StaticResource DangerRed}"/>
        <Setter Property="BorderColor" Value="{StaticResource DangerRed}"/>
    </Style>

    <Style x:Key="GoogleButton" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="Stroke" Value="{StaticResource Primary}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="25"/>
        </Setter>
    </Style>

    <Style x:Key="AppleButton" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Black}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="25"/>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════
         AUTH FORM STYLES
         ════════════════════════════════════════════ -->

    <Style x:Key="AuthFieldLabel" TargetType="Label" BasedOn="{StaticResource Body}">
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="FontFamily" Value="QuicksandMedium"/>
        <Setter Property="TextColor" Value="{StaticResource HeadingText}"/>
    </Style>

    <!-- White fill, not InputBackground: the fields sit on PageGround now, and #F2F2F4 all but
         disappears against #E8F1F4. The InputBorder hairline still marks the field's edge. -->
    <Style x:Key="AuthEntryBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="Stroke" Value="{StaticResource InputBorder}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="Padding" Value="16,4"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="10"/>
        </Setter>
    </Style>

    <Style x:Key="AuthEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="Quicksand"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource BodyText}"/>
        <Setter Property="TextColor" Value="{StaticResource HeadingText}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
    </Style>

    <Style x:Key="AuthErrorLabel" TargetType="Label" BasedOn="{StaticResource Caption}">
        <Setter Property="TextColor" Value="{StaticResource ErrorRed}"/>
    </Style>

    <Style x:Key="PrimaryLink" TargetType="Label" BasedOn="{StaticResource Link}">
        <Setter Property="TextDecorations" Value="Underline"/>
    </Style>

    <!-- The quiet second action on a signed-out screen: resend, go back. It reads as the
         links Forgot Password uses, but stays a Button so a screen reader still announces a
         button and the target stays 44 points. Verify Email spelled these setters out
         inline, which is how it drifted from the screens either side of it. -->
    <!-- ── Action buttons ──
         The app's compact button: 40 tall, 14pt, an icon and one word, corners at the card
         radius. Replacing the 52-tall full-width pills in popups, dialogs and action rows, which
         were the biggest thing on every screen they sat on. The colour is the meaning — see the
         ActionBrush block in Colors.xaml — so a row of them reads at a glance: Cancel dark, the
         step forward blue, Yes green, No and Delete red, Undo amber. Set side by side in a Grid
         of equal columns, the way out on the left and the step forward on the right. The icon
         goes in ImageSource (the icon_btn_* set, white; amber's is dark). -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="ContentLayout" Value="Left,6"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.85"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="ActionButtonBlue" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="{StaticResource ActionBlueBrush}"/>
    </Style>
    <Style x:Key="ActionButtonGreen" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="{StaticResource ActionGreenBrush}"/>
    </Style>
    <Style x:Key="ActionButtonRed" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="{StaticResource ActionRedBrush}"/>
    </Style>
    <Style x:Key="ActionButtonDark" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="{StaticResource ActionDarkBrush}"/>
    </Style>
    <Style x:Key="ActionButtonAmber" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Background" Value="{StaticResource ActionAmberBrush}"/>
        <Setter Property="TextColor" Value="{StaticResource ActionAmberInk}"/>
    </Style>

    <Style x:Key="QuietActionLink" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{StaticResource Primary}"/>
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
    </Style>

    <Style x:Key="AuthActionLink" TargetType="Button" BasedOn="{StaticResource QuietActionLink}"/>

    <!-- The same quiet link in the destructive red, for an irreversible action that should be
         findable but never sit in the row of ordinary ones (Alert Details' "Remove this alert"). -->
    <Style x:Key="DangerActionLink" TargetType="Button" BasedOn="{StaticResource QuietActionLink}">
        <Setter Property="TextColor" Value="{StaticResource DangerRed}"/>
    </Style>

    <Style x:Key="DividerLine" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1"/>
        <Setter Property="BackgroundColor" Value="{StaticResource Divider}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <!-- Used by ConnectionSuccessPage's latest-data rows. M1-09's own metric rows moved to
         Heading3, but this is not dashboard-only — leave it in place. -->
    <Style x:Key="MetricValue" TargetType="Label">
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="TextColor" Value="{StaticResource HeadingText}"/>
    </Style>

    <!-- ── The app's card (Figma 101:2821 / 101:2854 / 101:2902) ──
         Cards float on PageGround everywhere now, so they carry elevation rather than the
         hairline the old DashboardCard used — a hairline all but vanishes against the tinted
         ground. One card style, so a card reads the same on every screen. -->
    <!-- Dashboard quick actions. Flat tint rather than a white card (see QuickActionTint), and a
         glow rather than a drop shadow: no offset, a wider radius and a third of the opacity, so
         the tile sits in a soft halo instead of appearing lifted off the card it is painted on.
         Tighter than a card, too — these are four controls in a row, not four surfaces, and the
         row reads better when they do not each claim a card's worth of height. Each tile brings
         its own BackgroundColor; only the emergency action wears red. -->
    <!-- The icon-only member of the quick-action family: a page's own actions (Member Details'
         alerts and edit, CardiJournal's export). Same tint and the same soft halo as the labelled
         tiles above, so an action reads as an action wherever it sits; 12 rather than 18 because
         a radius drawn for a 60-tall tile turns a 40 square into a circle, and these are chips,
         not pills. One style, so the next page's action cannot invent a third shape. -->
    <Style x:Key="IconActionChip" TargetType="Border">
        <Setter Property="WidthRequest" Value="40"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="BackgroundColor" Value="{StaticResource QuickActionTint}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12"/>
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.30" Radius="10" Offset="0,3"/>
        </Setter>
    </Style>

    <!-- One of two large choices on the export popup: a glyph with its name underneath, sized
         so the pair fills the card's width and the tap target is the whole tile. -->
    <Style x:Key="FormatTile" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="8,18"/>
        <Setter Property="BackgroundColor" Value="{StaticResource InputBackground}"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="16"/>
        </Setter>
    </Style>

    <Style x:Key="FormatTileLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="QuicksandSemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="{StaticResource HeadingText}"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
    </Style>

    <!-- The line under a tile's name, where the two choices are alike enough that the name
         alone does not separate them — Save and Share are both "get the file out of here"
         until one of them says it stays on the phone. A step down in weight and colour so it
         reads as the tile's own subtitle rather than as a second label. -->
    <Style x:Key="FormatTileHint" TargetType="Label" BasedOn="{StaticResource FormatTileLabel}">
        <Setter Property="FontFamily" Value="Quicksand"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextColor" Value="{StaticResource MutedText}"/>
    </Style>

    <!-- A choice that belongs with the tiles above it but is not one of them: the export
         popup's "Open", which is not a place to put the file but a look at it before you
         decide. Same surface and radius as FormatTile, laid out as a row across the card's
         width, so it reads as the quieter thing under the pair rather than a third of three. -->
    <Style x:Key="FormatRow" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="BackgroundColor" Value="{StaticResource InputBackground}"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="16"/>
        </Setter>
    </Style>

    <Style x:Key="QuickActionTile" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="6,12,6,9"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="9"/>
        </Setter>
        <!-- No shadow: the tiles are raised by their fill instead — QuickActionTintBrush and
             QuickActionTintRedBrush, the action buttons' light-top gradient in the tiles' own
             tints (2026-09-25). The shadow read as a glow at best and a dark rim at worst, and on
             Android it needed a gutter round the whole row to escape clipping. -->
    </Style>

    <!-- The corner of every standard card — the two styles below, and the cards that build their
         own Border (the alert banner and list card, the journal and question cards) because they
         stack a severity rail under the white face or need a stroke the styles do not carry.
         One value so they cannot drift apart. Halved from 20 on 2026-09-25: at 20 a full-width
         card read as a pill-ended sheet rather than as a card. Pills, chips, popups and chat
         bubbles keep their own rounder corners — those are not cards. -->
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>

    <Style x:Key="ElevatedCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="14,14,13,17"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="{StaticResource CardCornerRadius}"/>
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.15" Radius="14" Offset="0,4"/>
        </Setter>
    </Style>

    <!-- ── The nested card ──
         Same geometry as ElevatedCard, hairline instead of a shadow. For tiles that sit inside
         another card (the dashboard's Key Metrics grid): a shadow only reads as depth against
         the ground, and stacking one on a surface that is already raised looks like clutter
         rather than hierarchy. The outline draws the same boundary without the second elevation. -->
    <Style x:Key="OutlinedCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource White}"/>
        <Setter Property="Stroke" Value="{StaticResource CardOutline}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Padding" Value="14,14,13,17"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="{StaticResource CardCornerRadius}"/>
        </Setter>
    </Style>

    <!-- Icon tile that opens a metric row or an alert card. -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12"/>
        </Setter>
    </Style>

    <Style x:Key="MetricRowLabel" TargetType="Label" BasedOn="{StaticResource Body}">
        <Setter Property="FontFamily" Value="QuicksandMedium"/>
        <Setter Property="TextColor" Value="{StaticResource HeadingText}"/>
    </Style>

    <!-- Right-hand caption under a metric pill ("68-75 bpm typical"). -->
    <Style x:Key="MetricRowCaption" TargetType="Label" BasedOn="{StaticResource Overline}">
        <Setter Property="HorizontalTextAlignment" Value="End"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="CharacterSpacing" Value="0"/>
        <Setter Property="TextColor" Value="{StaticResource BodyText}"/>
    </Style>

    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12"/>
        </Setter>
    </Style>

    <Style x:Key="StatusPillText" TargetType="Label" BasedOn="{StaticResource Overline}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="CharacterSpacing" Value="0"/>
    </Style>

    <Style x:Key="QuickActionLabel" TargetType="Label" BasedOn="{StaticResource Compact}">
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="QuicksandMedium"/>
        <Setter Property="TextColor" Value="{StaticResource HeadingText}"/>
    </Style>

    <Style x:Key="SectionLink" TargetType="Label" BasedOn="{StaticResource RowTitle}">
        <Setter Property="TextDecorations" Value="Underline"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DashboardSectionTitle" TargetType="Label" BasedOn="{StaticResource Section}"/>

    <!-- ════════════════════════════════════════════
         BOTTOM NAVIGATION (Figma "Body 3 Medium")
         ════════════════════════════════════════════ -->

    <!-- TextColor is set per tab by BottomNavBar: PrimaryDark when selected, MutedText otherwise. -->
    <Style x:Key="TabBarLabel" TargetType="Label" BasedOn="{StaticResource Overline}">
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CharacterSpacing" Value="0"/>
        <!-- One line box whichever size the label is drawn at (the selected tab's is a size up),
             so selecting a tab never changes the bar's height. -->
        <Setter Property="HeightRequest" Value="17"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
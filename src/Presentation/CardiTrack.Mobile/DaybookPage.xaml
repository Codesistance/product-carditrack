<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.DaybookPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- The daybook entries, newest first — one per finished day. Replaces the Family tab, which
         held a "coming soon" card for a feature in R3; a tab that does nothing is worse than
         one fewer tab, and this is the surface the reviews had nowhere to live on.

         No Figma frame: the M1 file's bar is Home/Health/Alerts/Profile and has no Summaries
         screen, so this is a design-sync gap rather than a built frame — see the daybook entry's
         entry in the design-sync backlog. -->

    <!-- Safe area is claimed per edge, and by this layout rather than by the ContentPage:
         SafeAreaEdges is honoured on layouts, and setting it on the page above has no effect
         on Android (verified on API 37). Top keeps the status-bar inset the header band is
         drawn against; bottom releases it, so BottomNavBar can run to the screen edge and pad
         itself instead — see that control. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" SafeAreaEdges="None, Container, None, None">

        <!-- Back arrow, same treatment as Alerts and Settings — a tab root falls back to the
             dashboard when there is no history of its own to pop. -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,26">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <!-- What this page is, said once under the title. Spans the full
                     header so it starts level with the icon, and wears the same
                     treatment as the Dashboard header's greeting line. -->
                <Label Grid.Row="1" Grid.ColumnSpan="2"
                       Text="A full account of each of their finished days"
                       FontFamily="Quicksand"
                       FontSize="14"
                       TextColor="{StaticResource White}"
                       Opacity="0.85"
                       LineBreakMode="TailTruncation"/>

                <Border Grid.Column="0"
                        WidthRequest="40" HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"/>
                </Border>

                <Label Grid.Column="1"
                       Text="Daybook"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"
                       VerticalTextAlignment="Center"/>
            </Grid>
        </controls:HeaderBand>

        <!-- Search and the two filter chips sit outside the scroller so narrowing the list stays
             reachable while it is scrolled — the same reason the alert chips do. Hidden until the
             member has any review at all: a filter row over a first-days empty state is a control
             with nothing to do. -->
        <VerticalStackLayout x:Name="FilterPanel"
                             Grid.Row="1"
                             Spacing="12"
                             Padding="20,20,20,0"
                             IsVisible="False">

            <!-- Same treatment as the questionnaires archive search. Server-side and debounced:
                 the search runs over the whole history, not the loaded page. -->
            <Border Style="{StaticResource AuthEntryBorder}" HeightRequest="48">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="🔍"
                           FontSize="16"
                           VerticalOptions="Center"
                           AutomationProperties.IsInAccessibleTree="False"/>

                    <Entry x:Name="SearchEntry"
                           Grid.Column="1"
                           FontFamily="Quicksand"
                           FontSize="14"
                           Placeholder="Search the daybook entries"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                           PlaceholderColor="{StaticResource Gray500}"
                           ReturnType="Search"
                           TextChanged="OnSearchTextChanged"/>

                    <Button x:Name="ClearSearchButton"
                            Grid.Column="2"
                            Text="✕"
                            FontFamily="QuicksandSemiBold"
                            FontSize="13"
                            TextColor="{StaticResource MutedText}"
                            BackgroundColor="Transparent"
                            WidthRequest="32"
                            HeightRequest="32"
                            Padding="0"
                            IsVisible="False"
                            Clicked="OnClearSearchClicked"/>
                </Grid>
            </Border>

            <!-- Two chooser chips rather than a row per option: five urgencies and four windows
                 as flat chips is a control panel, and the popup chooser is the pattern the app
                 already has (M1-13's pause durations). -->
            <HorizontalStackLayout Spacing="9">
                <!-- Which CardiMember's daybook. Hidden while the account has only one member —
                     a chooser with one choice is a control with nothing to do. -->
                <Border x:Name="MemberChip"
                        Style="{StaticResource OutlinedCard}"
                        Padding="16,8"
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMemberChipTapped"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="MemberChipLabel"
                           FontFamily="QuicksandSemiBold"
                           FontSize="14"
                           TextColor="{StaticResource HeadingText}"/>
                </Border>

                <Border x:Name="UrgencyChip" Style="{StaticResource OutlinedCard}" Padding="16,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnUrgencyChipTapped"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="UrgencyChipLabel"
                           Text="Any urgency"
                           FontFamily="QuicksandSemiBold"
                           FontSize="14"
                           TextColor="{StaticResource HeadingText}"/>
                </Border>

                <Border x:Name="WindowChip" Style="{StaticResource OutlinedCard}" Padding="16,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWindowChipTapped"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="WindowChipLabel"
                           Text="All time"
                           FontFamily="QuicksandSemiBold"
                           FontSize="14"
                           TextColor="{StaticResource HeadingText}"/>
                </Border>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <RefreshView x:Name="Refresher"
                     Grid.Row="2"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView>
                <Grid Padding="20,20,20,24">

                    <!-- Loading: three quiet placeholder cards rather than a spinner, so the
                         list does not jump when the real ones arrive. -->
                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                        <Border Style="{StaticResource ElevatedCard}" HeightRequest="112"/>
                        <Border Style="{StaticResource ElevatedCard}" HeightRequest="112"/>
                        <Border Style="{StaticResource ElevatedCard}" HeightRequest="112"/>
                    </VerticalStackLayout>

                    <!-- Empty. Two distinct causes, said apart: a member whose first review has
                         not been written yet, and a filter that matched nothing — a bare
                         "nothing here" reads as a fault either way. -->
                    <VerticalStackLayout x:Name="EmptyPanel" IsVisible="False" Spacing="6">
                        <Border Style="{StaticResource ElevatedCard}">
                            <VerticalStackLayout Spacing="6">
                                <Label x:Name="EmptyTitleLabel"
                                       Text="No daybook entries yet"
                                       Style="{StaticResource Body1SemiBoldDark}"/>
                                <Label x:Name="EmptyDetailLabel"
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource BodyText}"/>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="12">
                        <Border Style="{StaticResource ElevatedCard}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Couldn't load the daybook"
                                       Style="{StaticResource Body1SemiBoldDark}"/>
                                <Label x:Name="ErrorDetailLabel"
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource BodyText}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Button Text="Try again"
                                Style="{StaticResource SecondaryOutlineButton}"
                                Clicked="OnRetryClicked"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ReviewsHost" Spacing="14" IsVisible="False"/>

                </Grid>
            </ScrollView>
        </RefreshView>

        <controls:BottomNavBar Grid.Row="3" Tab="Daybook"/>
    </Grid>
</ContentPage>

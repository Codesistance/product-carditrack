<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.NotificationsPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- The notification inbox. Full-bleed like every other page: the gradient band runs to the
         edges and the radius lives on the cards inside. Top safe area claimed by this layout,
         not the page (see AlertsPage): the band is drawn against the status-bar inset; the
         bottom is released like every other page's. -->
    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None, Container, None, None">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill"
                                       SemanticProperties.Description="Back">
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <!-- Fill + width-bound-to-height: the circle runs from the title's top to
                         the description's bottom and stays square at whatever that is, so every
                         header's icon matches its own text block exactly. The 40 floor keeps the
                         back button a real tap target; 99 clamps to a circle at any size. -->
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <Image Source="icon_back_white.svg"
                           WidthRequest="20"
                           HeightRequest="20"/>
                </controls:SquareBorder>

                <!-- Title with one line beneath it, top-aligned with the icon like every other
                     header. The line starts as what the page is and becomes the count once the
                     list has loaded ("3 things to look at" / "You're all set") — it used to be a
                     third line in a second stack, centred, which no other band has. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Complete the Picture"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label x:Name="SubtitleLabel"
                           Text="Small things that make their readings say more"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <RefreshView x:Name="Refresher"
                     Grid.Row="1"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView>
                <Grid Padding="20,16,20,28">

                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                        <controls:SkeletonView HeightRequest="150"/>
                        <controls:SkeletonView HeightRequest="150"/>
                        <controls:SkeletonView HeightRequest="150"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ContentPanel" Spacing="14" IsVisible="False">

                        <controls:SavedDataBanner x:Name="SavedBanner"/>

                        <!-- Owned items: the things this caregiver is being asked to do. -->
                        <VerticalStackLayout x:Name="OwnedList" Spacing="14"/>

                        <!-- Everything else the family is dealing with. Kept visible so nobody
                             assumes an outstanding gap is nobody's job, but never actionable. -->
                        <VerticalStackLayout x:Name="FamilySection" Spacing="10" IsVisible="False">
                            <Label Text="Your family is on these"
                                   Style="{StaticResource DashboardSectionTitle}"
                                   Margin="4,10,0,0"/>
                            <VerticalStackLayout x:Name="FamilyList" Spacing="14"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Empty state. "Nothing needed" rather than "no notifications": the absence
                         is the good outcome here, and should read like one. The tick sits beside
                         the words rather than above them, and the words are left-aligned, as on
                         every status card. -->
                    <Border x:Name="EmptyPanel"
                            IsVisible="False"
                            Style="{StaticResource ElevatedCard}"
                            Margin="0,40,0,0"
                            Padding="24,32">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Text="✓"
                                   FontSize="34"
                                   TextColor="{StaticResource StatusGreen}"
                                   VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="10">
                                <Label Text="Nothing needed right now"
                                       Style="{StaticResource Heading3}"/>
                                <Label Text="CardiTrack has everything it needs to keep watching."
                                       Style="{StaticResource Body2}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border x:Name="ErrorPanel"
                            IsVisible="False"
                            Style="{StaticResource ElevatedCard}"
                            Margin="0,40,0,0"
                            Padding="24,28">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Couldn't load your list"
                                   Style="{StaticResource Heading3}"/>
                            <Label x:Name="ErrorDetailLabel"
                                   Style="{StaticResource Body2}"/>
                            <controls:AppButton Text="Try again"
                                                HorizontalOptions="Start"
                                                Clicked="OnRetryClicked"
                                                Tone="Primary"
                                                Size="M"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </ScrollView>
        </RefreshView>

        <!-- Chat from anywhere: notifications span members, so the launcher resolves the
             account's members itself on tap — see ChatBotLauncher. -->
        <controls:ChatBotLauncher Grid.Row="1"/>

        <!-- The second-long "Updating…" while a saved inbox is replaced by live data — last, so it
             covers everything. See UpdatingOverlay. -->
        <controls:UpdatingOverlay x:Name="Updating" Grid.RowSpan="2"/>
    </Grid>
</ContentPage>

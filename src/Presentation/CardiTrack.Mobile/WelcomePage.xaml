<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="RootPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CardiTrack.Mobile"
             x:Class="CardiTrack.Mobile.WelcomePage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageGround}">

    <ScrollView>
    <Grid RowDefinitions="Auto,Auto,Auto,43,Auto">

        <!-- ── Carousel (plain photos; the wave backdrop below is code-drawn, not
             baked into the images — see OnHeroSizeChanged. This fixes two bugs in the old
             Figma-mask-composite PNGs: a mismatch between the photo's mask curve and the
             gradient's own curve left a strip of bare page background showing through near
             the edges, and the fixed 440×610 export cropped unevenly on non-440dp screens.
             A single wave curve, recomputed to the real rendered size, can't produce either. ── -->
        <Grid Grid.Row="0" HeightRequest="571" HorizontalOptions="Fill">
            <BoxView HorizontalOptions="Fill" VerticalOptions="Fill">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#174E86" Offset="0.0"/>
                        <GradientStop Color="#1884DC" Offset="0.458"/>
                        <GradientStop Color="#36C09B" Offset="1.0"/>
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <Border x:Name="HeroClipBorder"
                    StrokeThickness="0"
                    HeightRequest="571"
                    HorizontalOptions="Fill"
                    SizeChanged="OnHeroSizeChanged">
                <CarouselView x:Name="SlideCarousel"
                              HeightRequest="571"
                              ItemsSource="{Binding Source={x:Reference RootPage}, Path=Slides, x:DataType=local:WelcomePage}"
                              Loop="False"
                              IsScrollAnimated="True"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="local:WelcomeSlide">
                            <Image Source="{Binding HeroImage}"
                                   Aspect="AspectFill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
            </Border>

            <Path x:Name="HeroWaveStroke"
                  Stroke="{StaticResource White}"
                  StrokeThickness="2"
                  InputTransparent="True"/>
        </Grid>

        <!-- ── Header overlay (logo + sign-in, Figma y55/y68). The safe-area inset already
             clears the status bar, so this only needs a small margin below it — the previous
             48/55dp values stacked on top of that inset and pushed the row too far down. ── -->
        <Grid Grid.Row="0"
              Padding="{OnPlatform Android='20,16,20,0',
                                   iOS='20,12,20,0',
                                   WinUI='20,24,20,0',
                                   Default='20,24,20,0'}"
              ColumnDefinitions="Auto,*"
              VerticalOptions="Start"
              InputTransparent="False">

            <Border Grid.Column="0"
                    BackgroundColor="{StaticResource White}"
                    WidthRequest="46" HeightRequest="46"
                    StrokeThickness="0"
                    VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9"/>
                </Border.StrokeShape>
                <Image Source="carditrack_logo.png"
                       WidthRequest="37" HeightRequest="32"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <Label Grid.Column="1"
                   Text="Sign in"
                   FontFamily="QuicksandSemiBold"
                   FontSize="16"
                   TextColor="{StaticResource White}"
                   TextDecorations="Underline"
                   HorizontalOptions="End"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSignInTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- ── Title (Figma y591; single line on every slide, 330px text block) ── -->
        <Label x:Name="SlideTitle"
               Grid.Row="1"
               Style="{StaticResource Heading1}"
               HorizontalTextAlignment="Center"
               HorizontalOptions="Center"
               LineBreakMode="WordWrap"
               MaximumWidthRequest="330"
               Margin="24,20,24,0" />

        <!-- ── Subtitle (per-slide top margin and width from Figma) ── -->
        <Label x:Name="SlideSubtitle"
               Grid.Row="2"
               Style="{StaticResource BodySubtitle}"
               HorizontalOptions="Center"
               Margin="24,16,24,0" />

        <!-- Row 3: fixed 43px spacer (Figma subtitle bottom y681 → indicators y724) -->

        <!-- ── Bottom area (Figma y724+) ── -->
        <VerticalStackLayout Grid.Row="4"
                             Spacing="0"
                             Padding="20,0,20,28">

            <!-- Pill indicators (active 32×8, inactive 8×8) -->
            <HorizontalStackLayout x:Name="IndicatorPanel"
                                   HorizontalOptions="Center"
                                   Spacing="8"
                                   Margin="0,0,0,0">
                <BoxView x:Name="Ind0" WidthRequest="32" HeightRequest="8"
                         CornerRadius="4" Color="{StaticResource ActiveIndicator}"/>
                <BoxView x:Name="Ind1" WidthRequest="8" HeightRequest="8"
                         CornerRadius="4" Color="{StaticResource InactiveIndicator}"/>
                <BoxView x:Name="Ind2" WidthRequest="8" HeightRequest="8"
                         CornerRadius="4" Color="{StaticResource InactiveIndicator}"/>
            </HorizontalStackLayout>

            <!-- CTA (Button 1 — 332×52 centered at Figma y781; inner top-left glow
                 approximates Figma's inset shadow 4,4,10 white 56%) -->
            <Border x:Name="CtaBorder"
                    Background="{StaticResource GradientButtonBrush}"
                    StrokeThickness="0"
                    WidthRequest="332"
                    HeightRequest="52"
                    HorizontalOptions="Center"
                    Margin="0,49,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25"/>
                </Border.StrokeShape>
                <Grid>
                    <Border StrokeThickness="0"
                            InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25"/>
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                                <GradientStop Color="#66FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Label Text="Start Free 30-Day Trial"
                           FontFamily="Quicksand"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCtaTapped"/>
                </Border.GestureRecognizers>
            </Border>

            <!-- Pricing disclaimer (Figma y849) -->
            <Label Text="Then $8/month - Cancel anytime"
                   Style="{StaticResource Body2}"
                   HorizontalTextAlignment="Center"
                   Margin="0,16,0,0" />

            <!-- Terms & Privacy (Figma y901) -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="0"
                                   Margin="0,30,0,0">
                <Label Text="By continuing, you agree to "
                       Style="{StaticResource Body2}"
                       VerticalTextAlignment="Center" />
                <Label Text="Terms &amp; Privacy"
                       TextColor="{StaticResource Primary}"
                       FontFamily="ManropeSemiBold"
                       FontSize="14"
                       TextDecorations="Underline"
                       VerticalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTermsTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
    </ScrollView>
</ContentPage>

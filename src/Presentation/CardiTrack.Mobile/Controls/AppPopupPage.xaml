<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.AppPopupPage"
             BackgroundColor="Transparent">

    <Grid x:Name="Scrim" BackgroundColor="#80343434" Opacity="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped"/>
        </Grid.GestureRecognizers>

        <Border x:Name="Card"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Divider}"
                StrokeThickness="1"
                Padding="24"
                Margin="32,0"
                Scale="0.92"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <!-- Swallows taps so they don't fall through to the scrim. -->
                <TapGestureRecognizer/>
            </Border.GestureRecognizers>

            <VerticalStackLayout>
                <Border x:Name="IconBadge"
                        StrokeThickness="0"
                        WidthRequest="56"
                        HeightRequest="56"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28"/>
                    </Border.StrokeShape>
                    <Label x:Name="IconLabel"
                           FontFamily="QuicksandSemiBold"
                           FontSize="26"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <Label x:Name="TitleLabel"
                       Style="{StaticResource Heading3}"
                       HorizontalTextAlignment="Center"
                       Margin="0,16,0,0"/>

                <!-- No ScrollView around this label, deliberately. A ScrollView measures its
                     content with an unbounded cross-axis, so the Label never learned a width to
                     wrap against and ran off the card's right edge, where the Border clipped it —
                     losing the last characters of most lines. Placed directly in the stack, the
                     Label is measured against the card's real content width and wraps.

                     What the ScrollView was for was runaway text at large accessibility font
                     scales. MaxMessageLength already caps the message at 600 characters, which is
                     what actually keeps the card a sensible height; the scroll was insurance on
                     top of a bound that was already doing the work.

                     The card's width is set in code (PopupCard.Fit) rather than capped here, and
                     that is what stops this label losing its last lines — see PopupCard for why a
                     maximum measured the text at one width and drew it at another. -->
                <Label x:Name="MessageLabel"
                       Margin="0,8,0,0"
                       Style="{StaticResource Body2}"
                       HorizontalTextAlignment="Start"
                       LineBreakMode="WordWrap"/>

                <!-- Starts as a single full-width button and only becomes a two-up row when a
                     cancel is supplied. Both the collapsed column AND the spacing have to go:
                     a Grid lays its gutter between every adjacent pair of columns, whether or
                     not one of them measured to nothing, so a 12dp ColumnSpacing left here
                     indented the lone Confirm button 12dp from the card's content box and cut
                     12dp off its width — visibly out of line with the message above it.
                     The gutter is restored alongside the cancel column in code-behind. -->
                <Grid x:Name="ButtonRow" ColumnSpacing="0" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="CancelColumn" Width="0"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CancelBtn"
                            Grid.Column="0"
                            Style="{StaticResource SecondaryOutlineButton}"
                            FontSize="16"
                            Padding="12,0"
                            IsVisible="False"
                            Clicked="OnCancelClicked"/>
                    <Button x:Name="ConfirmBtn"
                            Grid.Column="1"
                            Style="{StaticResource PrimaryGradientButton}"
                            Padding="12,0"
                            Clicked="OnConfirmClicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.MedicalNotesEditPopupPage"
             BackgroundColor="Transparent">

    <!-- The same shell as ContactEditPopupPage, and there for the same reason: the health
         background is one field, and the screen it used to open is the whole M1-14 profile form —
         name, date of birth, sex, relationship, photo — every one of which is a field a caregiver
         can disturb on the way to the one they came for. Keeping the form to the record keeps the
         change as small as the intent was. -->
    <Grid x:Name="Scrim" BackgroundColor="{StaticResource ScrimOverlay}" Opacity="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped"/>
        </Grid.GestureRecognizers>

        <Border x:Name="Card"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Divider}"
                StrokeThickness="1"
                Padding="24"
                Margin="32,0"
                Scale="0.92"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <!-- Swallows taps so they don't fall through to the scrim. -->
                <TapGestureRecognizer/>
            </Border.GestureRecognizers>

            <VerticalStackLayout>
                <Label x:Name="TitleLabel"
                       Style="{StaticResource Heading3}"
                       HorizontalTextAlignment="Center"/>

                <!-- No ScrollView, for the reason the sibling popups have none: a ScrollView
                     measures its content with an unbounded cross-axis, so the text never learns a
                     width to wrap against and runs off the card's edge where the Border clips it. -->
                <Label x:Name="DescriptionLabel"
                       Margin="0,6,0,0"
                       Style="{StaticResource Body2}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>

                <VerticalStackLayout Spacing="4" Margin="0,20,0,0">
                    <Label Text="Conditions, medications, allergies"
                           Style="{StaticResource AuthFieldLabel}"/>
                    <!-- Same borrowed field as the profile form's own notes box (M1-14), so the
                         two look like one control in two places rather than two controls. -->
                    <Border Style="{StaticResource AuthEntryBorder}" HeightRequest="140" Padding="16,8">
                        <!-- An Editor, not an Entry: this runs to paragraphs where a contact is one
                             line. Height is fixed rather than autosized so the card cannot grow
                             past the screen as somebody types, and the Editor scrolls inside it.
                             MaxLength is the server's ceiling, enforced at the keyboard so the
                             2001st character cannot be typed and then refused on save. -->
                        <Editor x:Name="NotesEditor"
                                Placeholder="Allergies, chronic conditions, medications"
                                FontFamily="Quicksand"
                                FontSize="14"
                                PlaceholderColor="{StaticResource BodyText}"
                                TextColor="{StaticResource HeadingText}"
                                BackgroundColor="Transparent"
                                AutoSize="Disabled"
                                MaxLength="2000"
                                TextChanged="OnNotesChanged"/>
                    </Border>

                    <!-- The server's own ceiling, counted down rather than up: what a caregiver
                         needs to know near the limit is how much room is left. -->
                    <Label x:Name="CounterLabel"
                           Style="{StaticResource Caption}"
                           HorizontalTextAlignment="End"/>

                    <Label x:Name="NotesError"
                           Style="{StaticResource AuthErrorLabel}"
                           IsVisible="False"/>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,24,0,0">
                    <Button x:Name="CancelBtn"
                            Grid.Column="0"
                            Text="Cancel"
                            Style="{StaticResource ActionButtonDark}"
                            ImageSource="icon_btn_close.svg"
                            Clicked="OnCancelClicked"/>
                    <Button x:Name="SaveBtn"
                            Grid.Column="1"
                            Text="Save"
                            Style="{StaticResource ActionButtonBlue}"
                            ImageSource="icon_btn_save.svg"
                            Clicked="OnSaveClicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

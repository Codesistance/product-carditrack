<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.MemberAvatar">

    <!-- The one box a CardiMember is shown in — the dashboard hero and Member Detail both use
         this, so the same person can't be shown two different ways depending on the screen.
         Member Detail's treatment is the one both adopt: the gradient tile with white initials.
         Always square — size is a knob because Member Detail's three-line block (80) and the
         hero's status block (76) need different boxes; the shape and treatment never vary. -->
    <!-- Named "Box", not "Frame": a generated field called Frame would hide VisualElement.Frame
         (the element's bounds), which the compiler flags and anyone reading it would misread. -->
    <Border x:Name="Box"
            WidthRequest="64" HeightRequest="64"
            StrokeThickness="0"
            VerticalOptions="Start">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12"/>
        </Border.StrokeShape>
        <Border.Background>
            <StaticResource Key="GradientButtonBrush"/>
        </Border.Background>
        <!-- Initials stay behind the photo rather than being replaced, so a photo that fails to
             load falls back to the gradient monogram rather than an empty tile. -->
        <Grid>
            <Label x:Name="InitialsLabel"
                   FontFamily="QuicksandSemiBold"
                   FontSize="24"
                   TextColor="{StaticResource White}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
            <Image x:Name="PhotoImage"
                   IsVisible="False"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"/>
        </Grid>
    </Border>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.MemberAvatar">

    <!-- The one box a CardiMember is shown in — the dashboard hero and Member Detail both use
         this, so the same person can't be a photo on one screen and a gradient monogram on the
         other. Fixed size on purpose: "the same box" is the point, and a per-screen size knob
         is how two screens drift apart again. -->
    <Border WidthRequest="60" HeightRequest="60"
            StrokeThickness="0"
            BackgroundColor="{StaticResource SelectedOptionBackground}"
            VerticalOptions="Start">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12"/>
        </Border.StrokeShape>
        <!-- Initials stay behind the photo rather than being replaced, so a photo that fails to
             load falls back to something rather than an empty tile. -->
        <Grid>
            <Label x:Name="InitialsLabel"
                   FontFamily="QuicksandSemiBold"
                   FontSize="22"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
            <Image x:Name="PhotoImage"
                   IsVisible="False"
                   Aspect="AspectFill"
                   WidthRequest="60" HeightRequest="60"/>
        </Grid>
    </Border>
</ContentView>

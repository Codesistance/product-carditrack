<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.JournalRangePopupPage"
             BackgroundColor="Transparent">

    <!-- Same shell as the other popups (scrim, card, entry animation). The two fields are the
         app's own DateField, so the dates are picked in the platform's calendar exactly as they
         are on the health-data export. What the cadence changes is the unit: a Weekbook range
         is snapped out to whole weeks and a Monthbook range to whole months, and the line under
         the fields reads the snapped range back before anything is exported. -->
    <Grid x:Name="Scrim" BackgroundColor="{StaticResource ScrimOverlay}" Opacity="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped"/>
        </Grid.GestureRecognizers>

        <Border x:Name="Card"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Divider}"
                StrokeThickness="1"
                Padding="24"
                Margin="32,0"
                Scale="0.92"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <!-- Swallows taps so they don't fall through to the scrim. -->
                <TapGestureRecognizer/>
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="16">

                <!-- No ✕ in the corner: the Cancel beside Export is the way out, and a popup that
                     asks something closes with its Cancel rather than offering two exits. -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Export range"
                           Style="{StaticResource Heading3}"
                           HorizontalTextAlignment="Center"/>
                    <Label x:Name="SubtitleLabel"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource BodyText}"/>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="From" Style="{StaticResource AuthFieldLabel}"/>
                        <controls:DateField x:Name="FromPicker"
                                            Format="d MMM yyyy"
                                            SemanticProperties.Description="From"
                                            DateSelected="OnRangeChanged"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="To" Style="{StaticResource AuthFieldLabel}"/>
                        <controls:DateField x:Name="ToPicker"
                                            Format="d MMM yyyy"
                                            SemanticProperties.Description="To"
                                            DateSelected="OnRangeChanged"/>
                    </VerticalStackLayout>
                </Grid>

                <Border x:Name="SummaryRow"
                        BackgroundColor="{StaticResource InputBackground}"
                        StrokeThickness="0"
                        Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label x:Name="SummaryLabel"
                           Style="{StaticResource Body2Dark}"
                           HorizontalTextAlignment="Start"
                           LineBreakMode="WordWrap"/>
                </Border>

                <!-- The popups' action pair: backing out on the left, going ahead on the right,
                     two equal halves at M. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <controls:AppButton Text="Cancel"
                                        Clicked="OnCancelClicked"
                                        Tone="Neutral"
                                        Size="M"/>
                    <controls:AppButton x:Name="ExportBtn"
                                        Grid.Column="1"
                                        Text="Export"
                                        Clicked="OnExportClicked"
                                        Tone="Primary"
                                        Size="M"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

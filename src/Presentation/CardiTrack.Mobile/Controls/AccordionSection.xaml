<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.AccordionSection">

    <!-- Generic collapsible section, collapsed by default so the body doesn't compete with the
         card's action row for attention. The header wears the Member Detail dropdowns' row —
         52 high, Body1SemiBoldDark, chevron at 20 — so every collapsible in the app reads as
         the same control; the chevron is the affordance, the way it is on Alert Rules. The body
         is animated open/closed by growing/shrinking a clipping Border's height (Border clips
         its content to its bounds; a plain layout wouldn't) rather than snapping IsVisible. -->
    <!-- Bare: no card, no tint, no border. This control sits inside the member card among
         surfaces that already carry their own chrome, and every version that gave it some of its
         own — elevated card, outlined card, tinted tile — read as another thing stacked on the
         card rather than as the card's own last row. The icon, the label and the chevron are the
         control; the height is the dropdowns' 52 less its card padding. -->
    <Grid x:Name="HeaderShell" Padding="0">
        <VerticalStackLayout x:Name="RootLayout" Spacing="10">

            <!-- 8 of spacing against a 20px icon, so the title starts 28 from the card's edge —
                 the same offset the card headers above this one use. At 22 and 12 it started at
                 34, and an accordion sitting inside a card next to a card header stepped its
                 title 6px further in than the heading directly above it. -->
            <!-- Closed, the header wears a tinted rounded band so it reads as a control with
                 something behind it; open, the fill goes and the header becomes the title of
                 what is now on screen. The chrome is present in both states with the same
                 padding and the same radius, so switching the fill on and off moves nothing and
                 the open state pays nothing for the closed one's styling — which was the ask.
                 The padding is real rather than cancelled by a negative margin: a tint that runs
                 to the card's own edge has no corners to round. -->
            <Border x:Name="HeaderChrome"
                    StrokeThickness="1"
                    Stroke="Transparent"
                    BackgroundColor="Transparent"
                    Padding="12,6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" HeightRequest="44">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeaderTapped"/>
                </Grid.GestureRecognizers>

                <Image x:Name="HeaderIconImage"
                       Grid.Column="0"
                       WidthRequest="20" HeightRequest="20"
                       VerticalOptions="Center"
                       IsVisible="False"/>

                <!-- Title and count in one stack so the count hangs off the end of the words
                     rather than off the end of the column: the label takes only the width it
                     needs, and the count follows it. CountLabel is top-aligned against a
                     centred title, which is what makes it read as a superscript — MAUI spans
                     carry no baseline offset, so the raise has to come from layout. -->
                <HorizontalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label x:Name="HeaderLabel"
                           Style="{StaticResource Body1SemiBoldDark}"
                           VerticalOptions="Center"
                           VerticalTextAlignment="Center"/>

                    <!-- A filled disc rather than a raised numeral. As a bare superscript it
                         was 11px of colour against a 16px semibold title and had to be looked
                         for; on a disc it is read at a glance, which is the whole point of
                         putting a count on a collapsed section. Centred on the title's line,
                         because a circle hanging above the text reads as a misalignment rather
                         than as a superscript. -->
                    <Border x:Name="CountBadge"
                            WidthRequest="20"
                            HeightRequest="20"
                            Margin="5,0,4,0"
                            Padding="0"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label x:Name="CountLabel"
                               FontFamily="QuicksandSemiBold"
                               FontSize="11"
                               TextColor="{StaticResource White}"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"/>
                    </Border>
                </HorizontalStackLayout>

                <Image x:Name="ChevronIcon"
                       Grid.Column="2"
                       Source="icon_chevron_down.svg"
                       WidthRequest="20" HeightRequest="20"
                       VerticalOptions="Center"
                       SemanticProperties.Description="Expand"/>
                <!-- Description is kept in step with the state in code-behind: the same
                     control collapses once open, and announcing "Expand" then is wrong. -->
            </Grid>
            </Border>

            <Border x:Name="BodyClip"
                    StrokeThickness="0"
                    BackgroundColor="Transparent"
                    Padding="0"
                    HeightRequest="0">
                <ContentView x:Name="BodyHost" VerticalOptions="Start"/>
            </Border>

        </VerticalStackLayout>
    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.MetricCard">

    <Border Style="{StaticResource DashboardCard}" Padding="12">
        <VerticalStackLayout Spacing="6">

            <Image x:Name="MetricIcon"
                   WidthRequest="22" HeightRequest="22"
                   HorizontalOptions="Start"/>

            <Label x:Name="ValueLabel"
                   Style="{StaticResource MetricValue}"
                   LineBreakMode="TailTruncation"/>

            <!-- Steps: progress toward goal -->
            <ProgressBar x:Name="GoalProgress"
                         IsVisible="False"
                         ProgressColor="{StaticResource Primary}"
                         HeightRequest="6"/>

            <!-- HR range / sleep quality / generic subtitle -->
            <Label x:Name="SubtitleLabel"
                   FontFamily="Quicksand"
                   FontSize="12"
                   TextColor="{StaticResource BodyText}"
                   LineBreakMode="TailTruncation"/>

            <!-- Comparison vs baseline; hidden while baseline is learning -->
            <Label x:Name="ComparisonLabel"
                   FontFamily="QuicksandMedium"
                   FontSize="12"
                   IsVisible="False"
                   LineBreakMode="TailTruncation"/>

            <controls:SparklineView x:Name="Sparkline" HeightRequest="26"/>

        </VerticalStackLayout>
    </Border>
</ContentView>

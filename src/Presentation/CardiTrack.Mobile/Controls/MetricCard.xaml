<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.MetricCard">

    <!-- Figma 101:2807 / 101:2821 / 101:2835, adapted for the half-width Key Metrics grid:
         Figma's single row (icon | name+value | accessory) doesn't fit two-per-row, so this
         stacks icon+name, then value, then the accessory underneath instead of beside it. -->
    <!-- Outlined, not elevated: these tiles sit inside the CardiMember card, and a shadow on a
         surface that is already raised reads as tacky rather than as depth. -->
    <Border Style="{StaticResource OutlinedCard}" Padding="12,14">
        <VerticalStackLayout Spacing="10">

            <HorizontalStackLayout Spacing="8">
                <Border Style="{StaticResource IconTile}"
                        BackgroundColor="{StaticResource MetricTileTint}"
                        WidthRequest="36" HeightRequest="36">
                    <Image x:Name="MetricIcon"
                           WidthRequest="22" HeightRequest="22"/>
                </Border>
                <Label x:Name="NameLabel"
                       Style="{StaticResource MetricRowLabel}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
            </HorizontalStackLayout>

            <Label x:Name="ValueLabel"
                   Style="{StaticResource Heading3}"
                   LineBreakMode="TailTruncation"/>

            <!-- Accessory slot. The trend arrow and the status pill are alternatives — a card
                 shows one or the other — but the star row sits under whichever it got: the pill
                 names the band, the stars give its resolution, both off the same comparison. -->
            <VerticalStackLayout Spacing="3">
                <Label x:Name="TrendLabel"
                       IsVisible="False"
                       FontFamily="QuicksandSemiBold"
                       FontSize="14"/>

                <Border x:Name="StatusPillBorder"
                        IsVisible="False"
                        Style="{StaticResource StatusPill}"
                        HorizontalOptions="Start">
                    <Label x:Name="StatusPillLabel"
                           Style="{StaticResource StatusPillText}"/>
                </Border>

                <controls:StarRatingView x:Name="StarRow" IsVisible="False"/>

                <Label x:Name="CaptionLabel"
                       Style="{StaticResource MetricRowCaption}"/>
            </VerticalStackLayout>

            <!-- Progress track. Activity has a real denominator (the daily step goal) and fills
                 against it; skin temperature has no denominator but does have a previous
                 reading, so it fills to that and marks today against it (see ApplyTemperature).
                 Heart rate and sleep draw no bar at all — a bar there would need a percentage
                 the contract does not carry, and inventing one on a health screen is exactly the
                 sort of implied reading the product must not make. -->
            <Border x:Name="ProgressTrackBorder"
                    IsVisible="False"
                    HeightRequest="7"
                    BackgroundColor="{StaticResource ProgressTrack}"
                    StrokeThickness="0"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid>
                    <Grid x:Name="ProgressGrid" ColumnDefinitions="0*,1*">
                        <Border x:Name="ProgressFill"
                                Grid.Column="0"
                                Background="{StaticResource GradientButtonBrush}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                        </Border>
                    </Grid>

                    <!-- Today's mark, laid over the fill. Positioned by the same two-star-column
                         trick the fill uses, so neither has to measure the track. -->
                    <Grid x:Name="MarkerGrid" ColumnDefinitions="0*,Auto,1*" IsVisible="False">
                        <BoxView x:Name="MarkerTick"
                                 Grid.Column="1"
                                 WidthRequest="3"
                                 Color="{StaticResource HeadingText}"/>
                    </Grid>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </Border>
</ContentView>

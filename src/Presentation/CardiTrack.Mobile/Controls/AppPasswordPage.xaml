<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.AppPasswordPage"
             BackgroundColor="Transparent">

    <Grid x:Name="Scrim" BackgroundColor="{StaticResource ScrimOverlay}" Opacity="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped"/>
        </Grid.GestureRecognizers>

        <Border x:Name="Card"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Divider}"
                StrokeThickness="1"
                Padding="24"
                Margin="32,0"
                Scale="0.92"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer/>
            </Border.GestureRecognizers>

            <VerticalStackLayout>
                <Label x:Name="TitleLabel"
                       Style="{StaticResource Heading3}"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="MessageLabel"
                       Margin="0,8,0,0"
                       Style="{StaticResource Body2}"
                       HorizontalTextAlignment="Start"
                       LineBreakMode="WordWrap"/>
                <Entry x:Name="PasswordEntry"
                       IsPassword="True"
                       Placeholder="Password"
                       Margin="0,16,0,0"
                       Keyboard="Default"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,24,0,0">
                    <Button Text="Cancel"
                            Style="{StaticResource ActionButtonDark}"
                            ImageSource="icon_btn_close.svg"
                            Clicked="OnCancelClicked"/>
                    <Button Grid.Column="1"
                            Text="Confirm"
                            Style="{StaticResource ActionButtonBlue}"
                            ImageSource="icon_check_white.svg"
                            Clicked="OnConfirmClicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.AppPasswordPage"
             BackgroundColor="Transparent">

    <Grid x:Name="Scrim" BackgroundColor="{StaticResource ScrimOverlay}" Opacity="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped"/>
        </Grid.GestureRecognizers>

        <Border x:Name="Card"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Divider}"
                StrokeThickness="1"
                Padding="24"
                Margin="32,0"
                Scale="0.92"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer/>
            </Border.GestureRecognizers>

            <VerticalStackLayout>
                <Label x:Name="TitleLabel"
                       Style="{StaticResource Heading3}"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="MessageLabel"
                       Margin="0,8,0,0"
                       Style="{StaticResource Body2}"
                       HorizontalTextAlignment="Start"
                       LineBreakMode="WordWrap"/>
                <!-- The app's own field, as the contact form draws it (ContactEditPopupPage): a label
                     above, the bordered entry, and an error line under it that stays hidden until
                     there is something to say — a bare platform Entry was the one field in the app
                     that looked like the system's rather than ours. -->
                <VerticalStackLayout Spacing="4" Margin="0,20,0,0">
                    <Label Text="Password" Style="{StaticResource AuthFieldLabel}"/>
                    <Border Style="{StaticResource AuthEntryBorder}">
                        <Entry x:Name="PasswordEntry"
                               Style="{StaticResource AuthEntry}"
                               IsPassword="True"
                               Keyboard="Default"
                               ReturnType="Done"
                               SemanticProperties.Description="Password"
                               TextChanged="OnPasswordChanged"
                               Completed="OnConfirmClicked"/>
                    </Border>
                    <Label x:Name="PasswordError"
                           Style="{StaticResource AuthErrorLabel}"
                           IsVisible="False"/>
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,24,0,0">
                    <controls:AppButton Text="Cancel"
                                        Icon="icon_btn_close.svg"
                                        Clicked="OnCancelClicked"
                                        Tone="Neutral"
                                        Size="M"/>
                    <!-- Dimmed, not disabled, while the field is empty: it still answers a tap, by
                         saying what is missing rather than by doing nothing. -->
                    <controls:AppButton x:Name="ConfirmBtn"
                                        Grid.Column="1"
                                        Text="Confirm"
                                        Icon="icon_check_white.svg"
                                        IsDimmed="True"
                                        Clicked="OnConfirmClicked"
                                        Tone="Primary"
                                        Size="M"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

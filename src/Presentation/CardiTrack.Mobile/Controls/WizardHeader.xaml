<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.WizardHeader"
             x:Name="Root">

    <!-- Onboarding header shared by M1-04..M1-08: back button, title, step indicator, and a
         progress bar sitting on the gradient. The gradient itself is HeaderBand's, the same one
         the dashboard and the auth screens use. Default padding clears the status bar when the
         host page does not claim a top safe-area; pages that pin this header outside the
         scroller (M1-07 / M1-08) pass the compact Alerts/Dashboard inset instead. The band
         sizes to its content rather than to a fixed height, so a wrapped title can't clip. -->
    <controls:HeaderBand ContentPadding="{Binding ContentPadding, Source={x:Reference Root}}">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="22">

            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="16">

                <Border x:Name="BackButton"
                        Grid.Column="0"
                        WidthRequest="40" HeightRequest="40"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        StrokeThickness="0"
                        VerticalOptions="Start"
                        SemanticProperties.Description="Go back">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                    <Image Source="icon_back_white.svg"
                           WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="{Binding Title, Source={x:Reference Root}}"
                           Style="{StaticResource Heading3}"
                           TextColor="{StaticResource White}" />
                    <Label Text="{Binding Step, Source={x:Reference Root}}"
                           Style="{StaticResource Body1SemiBold}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Figma M1-04 progress bar: 8px white pill track, gradient pill fill.
                 Hidden until Progress > 0 (some wizard screens have no progress bar). -->
            <Border x:Name="StepProgress"
                    Grid.Row="1"
                    HeightRequest="8"
                    BackgroundColor="{StaticResource White}"
                    StrokeThickness="0"
                    IsVisible="False"
                    SemanticProperties.Description="Wizard progress">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4"/>
                </Border.StrokeShape>
                <Border x:Name="StepProgressFill"
                        Background="{StaticResource GradientButtonBrush}"
                        StrokeThickness="0"
                        HorizontalOptions="Start"
                        WidthRequest="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4"/>
                    </Border.StrokeShape>
                </Border>
            </Border>

        </Grid>
    </controls:HeaderBand>
</ContentView>

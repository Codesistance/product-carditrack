<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.WizardHeader"
             x:Name="Root">

    <!-- Gradient onboarding header shared by M1-04..M1-08: back button, title,
         step indicator, and a progress bar sitting on the gradient. -->
    <Grid HeightRequest="170" HorizontalOptions="Fill">
        <Image Source="gradient_auth_header.svg"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid Padding="20,48,20,0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="16"
              VerticalOptions="Start">

            <Border x:Name="BackButton"
                    Grid.Column="0"
                    WidthRequest="40" HeightRequest="40"
                    BackgroundColor="#33FFFFFF"
                    StrokeThickness="0"
                    VerticalOptions="Start"
                    SemanticProperties.Description="Go back">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Border.GestureRecognizers>
                <Label Text="&#x2190;"
                       FontSize="20"
                       TextColor="{StaticResource White}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Label Text="{Binding Title, Source={x:Reference Root}}"
                       Style="{StaticResource Heading1White}" />
                <Label Text="{Binding Step, Source={x:Reference Root}}"
                       Style="{StaticResource Body1SemiBold}" />
            </VerticalStackLayout>
        </Grid>

        <ProgressBar x:Name="StepProgress"
                     Progress="{Binding Progress, Source={x:Reference Root}}"
                     ProgressColor="{StaticResource PrimaryDark}"
                     BackgroundColor="#B3FFFFFF"
                     Margin="20,0,20,24"
                     VerticalOptions="End"/>
    </Grid>
</ContentView>

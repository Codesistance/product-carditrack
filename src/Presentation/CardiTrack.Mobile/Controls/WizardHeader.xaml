<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.WizardHeader"
             x:Name="Root">

    <!-- Same chrome as Alerts / Device Management / Dashboard: circular icon spanning
         title-to-subtitle, Heading3 + CaptionOnBand, 12dp column gap. The progress bar
         is the only wizard-only extra, and it stays hidden when Progress is 0 so the
         terminal steps (M1-07 / M1-08) match those screens exactly. -->
    <controls:HeaderBand ContentPadding="{Binding ContentPadding, Source={x:Reference Root}, x:DataType=controls:WizardHeader}">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="0">

            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="12">

                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image x:Name="HeaderIconImage"
                           Source="icon_back_white.svg"
                           WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="{Binding Title, Source={x:Reference Root}, x:DataType=controls:WizardHeader}"
                           Style="{StaticResource Heading3}"
                           TextColor="{StaticResource White}"
                           LineBreakMode="TailTruncation"/>
                    <Label x:Name="StepLabel"
                           Text="{Binding Step, Source={x:Reference Root}, x:DataType=controls:WizardHeader}"
                           Style="{StaticResource CaptionOnBand}"
                           LineBreakMode="TailTruncation"
                           IsVisible="False"/>
                </VerticalStackLayout>
            </Grid>

            <!-- The same pill the signed-out steps use (Controls/StepProgressBar). It hides
                 itself while Progress is 0, so terminal wizard screens have no bar. -->
            <controls:StepProgressBar x:Name="StepProgress"
                                      Grid.Row="1"
                                      Margin="0,12,0,0"/>

        </Grid>
    </controls:HeaderBand>
</ContentView>

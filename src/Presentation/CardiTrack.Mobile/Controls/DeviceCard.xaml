<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.DeviceCard">

    <Border Style="{StaticResource ElevatedCard}">
        <VerticalStackLayout Spacing="12">

            <!-- Identity, sharing and stats read as stale once the connection needs reconnecting —
                 dimmed together (DeviceInfoSection.Opacity) rather than per-element, so nothing
                 here looks more current than the "NEEDS RECONNECT" chip already says it is. The
                 actions below stay at full opacity: Reconnect is the one thing still live. -->
            <VerticalStackLayout x:Name="DeviceInfoSection" Spacing="12">

            <!-- Identity -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        WidthRequest="44" HeightRequest="44"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource SelectedOptionBackground}"
                        VerticalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Image x:Name="ProviderImage"
                           WidthRequest="26" HeightRequest="26"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label x:Name="NameLabel" Style="{StaticResource Body1SemiBoldDark}"/>
                    <HorizontalStackLayout Spacing="8">
                        <Border x:Name="StatusChip"
                                StrokeThickness="0"
                                Padding="8,2"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label x:Name="StatusLabel"
                                   FontFamily="QuicksandSemiBold"
                                   FontSize="10"/>
                        </Border>
                        <!-- Primary as a word beside the status, rather than a star in the
                             corner that said the same thing as the switch further down. -->
                        <Border x:Name="PrimaryPill"
                                IsVisible="False"
                                StrokeThickness="0"
                                Padding="8,2"
                                BackgroundColor="{StaticResource SelectedOptionBackground}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="PRIMARY"
                                   FontFamily="QuicksandSemiBold"
                                   FontSize="10"
                                   TextColor="{StaticResource PrimaryDark}"/>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!-- When it last sent and when it next will, as one sentence. These were a "synced"
                 caption here plus Last Sync and Next Sync tiles below — the first said twice. -->
            <Label x:Name="SyncedLabel"
                   Style="{StaticResource Body2}"
                   FontSize="13"/>

            <!-- What this connection shares: one pill per dataset family, not per dataset. Full
                 card width rather than inside the identity grid — even summary pills read better
                 on their own line than squeezed beside the device name. Each pill that stands
                 for several readings is its own disclosure: a tap lists that family's readings in
                 a strip in the family's tint under the pills, and a second tap (or another pill)
                 folds it. One family at a time, so the card never grows by more than a line or
                 two, and the answer to "which heart readings?" sits under the pill that asked. -->
            <VerticalStackLayout Spacing="6">

                <Label x:Name="SharingLabel"
                       Text="SHARING"
                       FontFamily="QuicksandSemiBold"
                       FontSize="9"
                       TextColor="{StaticResource MutedText}"/>

                <FlexLayout x:Name="DatasetPills"
                            Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Center"
                            AlignContent="Start"/>

                <Border x:Name="SharingStrip"
                        IsVisible="False"
                        StrokeThickness="0"
                        Padding="10,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Label x:Name="SharingStripLabel"
                           FontFamily="Quicksand"
                           FontSize="12"/>
                </Border>
            </VerticalStackLayout>

            <!-- Stats. The battery column collapses to zero width when the provider reports no
                 reading — a hidden child does not release its column, so the width is driven from
                 code-behind rather than by IsVisible alone. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="BatteryColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" StrokeThickness="0" Padding="10,8"
                        BackgroundColor="{StaticResource SelectedOptionBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="TODAY'S DATA" FontFamily="QuicksandSemiBold" FontSize="9"
                               TextColor="{StaticResource MutedText}"/>
                        <Label x:Name="TodayValue" Style="{StaticResource Body2Medium}" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="BatteryTile" Grid.Column="1" StrokeThickness="0" Padding="10,8"
                        IsVisible="False"
                        BackgroundColor="{StaticResource SelectedOptionBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="BATTERY" FontFamily="QuicksandSemiBold" FontSize="9"
                               TextColor="{StaticResource MutedText}"/>
                        <Label x:Name="BatteryValue" Style="{StaticResource Body2Medium}" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            </VerticalStackLayout>

            <BoxView Style="{StaticResource DividerLine}"/>

            <!-- Actions, as small tinted buttons (CompactActionButton) a size down from the app's
                 ActionButton, so they sit in proportion with the pills and tiles above: the ones
                 that do something in blue, Remove in red at the far end. The row's negative
                 margin gives back the tap band each button carries around its pill. Reconnect takes Refresh's place when the provider
                 itself broke the token — retrying Refresh would repeat the same failure, so there
                 is one live action there, not one that works and one that silently can't. -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,-7">
                <controls:CompactActionButton x:Name="RefreshButton"
                        Text="Refresh"
                        IconSource="icon_btn_refresh_tint.svg"
                        Clicked="OnRefreshClicked"/>
                <controls:CompactActionButton x:Name="ReconnectButton"
                        Text="Reconnect"
                        IconSource="icon_btn_connect_tint.svg"
                        IsVisible="False"
                        Clicked="OnReconnectClicked"/>
                <!-- Re-pull: asks the server to re-read a stretch of this device's past days to
                     fill gaps the routine sync left. Withheld while a request is open or cooling
                     down; its progress is the line under the buttons. -->
                <controls:CompactActionButton x:Name="RepullButton"
                        Grid.Column="1"
                        Text="Re-pull"
                        IconSource="icon_btn_history_tint.svg"
                        Clicked="OnRepullClicked"/>
                <controls:CompactActionButton Grid.Column="3"
                        Text="Remove"
                        Tone="Red"
                        IconSource="icon_btn_delete_tint.svg"
                        Clicked="OnRemoveClicked"/>
            </Grid>

            <Label x:Name="RepullStatusLabel"
                   Style="{StaticResource Body2}"
                   FontSize="12"
                   TextColor="{StaticResource MutedText}"
                   IsVisible="False"/>

            <Grid x:Name="PrimaryRow" ColumnDefinitions="*,Auto" ColumnSpacing="12" HeightRequest="40">
                <Label Text="Use as primary device"
                       Style="{StaticResource Body2Medium}" VerticalTextAlignment="Center"/>
                <Switch x:Name="PrimarySwitch"
                        Grid.Column="1"
                        OnColor="{StaticResource Primary}"
                        VerticalOptions="Center"
                        Toggled="OnPrimaryToggled"/>
            </Grid>

        </VerticalStackLayout>
    </Border>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.DeviceCard">

    <Border Style="{StaticResource ElevatedCard}">
        <VerticalStackLayout Spacing="12">

            <!-- Identity -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0"
                        WidthRequest="44" HeightRequest="44"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource SelectedOptionBackground}"
                        VerticalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Image x:Name="ProviderImage"
                           WidthRequest="26" HeightRequest="26"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label x:Name="NameLabel" Style="{StaticResource Body1SemiBoldDark}"/>
                    <HorizontalStackLayout Spacing="8">
                        <Border x:Name="StatusChip"
                                StrokeThickness="0"
                                Padding="8,2"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label x:Name="StatusLabel"
                                   FontFamily="QuicksandSemiBold"
                                   FontSize="10"/>
                        </Border>
                        <Label x:Name="SyncedLabel"
                               Style="{StaticResource Body2}"
                               FontSize="12"
                               VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Image x:Name="PrimaryStar"
                       Grid.Column="2"
                       Source="icon_star.svg"
                       WidthRequest="20" HeightRequest="20"
                       IsVisible="False"
                       VerticalOptions="Start"/>
            </Grid>

            <!-- What this connection shares: one pill per dataset family, not per dataset. Full
                 card width rather than inside the identity grid — even summary pills read better
                 on their own line than squeezed beside the device name. The per-dataset names sit
                 one tap away, so the card answers "is heart data coming in?" at a glance and
                 "which heart readings?" on demand. -->
            <VerticalStackLayout Spacing="8">

                <!-- The header alone carries the tap: it is also where the disclosure state is
                     announced, and an accessibility activation is delivered to the focused
                     element rather than replayed as a touch that bubbles — a gesture on the
                     container would leave the announced affordance unactivatable. Full card
                     width and 28 high so the target stays comfortable, and so a tap on a pill or
                     on the detail text the user is reading does not collapse the panel. The
                     description stays off the container for the same reason it always did: it
                     would fold the pills into one accessibility element and swallow theirs. -->
                <Grid x:Name="SharingHeader" ColumnDefinitions="*,Auto" HeightRequest="28">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSharingTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Text="SHARING"
                           FontFamily="QuicksandSemiBold"
                           FontSize="9"
                           TextColor="{StaticResource MutedText}"
                           VerticalTextAlignment="Center"/>
                    <Image x:Name="SharingChevron"
                           Grid.Column="1"
                           Source="icon_chevron_down.svg"
                           WidthRequest="16" HeightRequest="16"
                           VerticalOptions="Center"/>
                </Grid>

                <FlexLayout x:Name="DatasetPills"
                            Direction="Row"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Center"
                            AlignContent="Start"/>

                <!-- One line per family, revealed by the chevron. -->
                <VerticalStackLayout x:Name="SharingDetail" Spacing="4" IsVisible="False"/>
            </VerticalStackLayout>

            <!-- Stats. The battery column collapses to zero width when the provider reports no
                 reading — a hidden child does not release its column, so the width is driven from
                 code-behind rather than by IsVisible alone. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="BatteryColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" StrokeThickness="0" Padding="10,8"
                        BackgroundColor="{StaticResource SelectedOptionBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="LAST SYNC" FontFamily="QuicksandSemiBold" FontSize="9"
                               TextColor="{StaticResource MutedText}"/>
                        <Label x:Name="LastSyncValue" Style="{StaticResource Body2Medium}" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" StrokeThickness="0" Padding="10,8"
                        BackgroundColor="{StaticResource SelectedOptionBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="NEXT SYNC" FontFamily="QuicksandSemiBold" FontSize="9"
                               TextColor="{StaticResource MutedText}"/>
                        <Label x:Name="NextSyncValue" Style="{StaticResource Body2Medium}" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" StrokeThickness="0" Padding="10,8"
                        BackgroundColor="{StaticResource SelectedOptionBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="TODAY'S DATA" FontFamily="QuicksandSemiBold" FontSize="9"
                               TextColor="{StaticResource MutedText}"/>
                        <Label x:Name="TodayValue" Style="{StaticResource Body2Medium}" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="BatteryTile" Grid.Column="3" StrokeThickness="0" Padding="10,8"
                        IsVisible="False"
                        BackgroundColor="{StaticResource SelectedOptionBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="BATTERY" FontFamily="QuicksandSemiBold" FontSize="9"
                               TextColor="{StaticResource MutedText}"/>
                        <Label x:Name="BatteryValue" Style="{StaticResource Body2Medium}" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <BoxView Style="{StaticResource DividerLine}"/>

            <!-- Actions -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HeightRequest="40">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRefreshTapped"/>
                </Grid.GestureRecognizers>
                <Image Grid.Column="0" Source="icon_refresh.svg"
                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                <Label x:Name="RefreshLabel" Grid.Column="1" Text="Refresh Connection"
                       Style="{StaticResource Body2Medium}" VerticalTextAlignment="Center"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" HeightRequest="40">
                <Image Grid.Column="0" Source="icon_star.svg"
                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="Set as Primary"
                       Style="{StaticResource Body2Medium}" VerticalTextAlignment="Center"/>
                <Switch x:Name="PrimarySwitch"
                        Grid.Column="2"
                        OnColor="{StaticResource Primary}"
                        VerticalOptions="Center"
                        Toggled="OnPrimaryToggled"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HeightRequest="40">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRemoveTapped"/>
                </Grid.GestureRecognizers>
                <Image Grid.Column="0" Source="icon_trash.svg"
                       WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="Remove Device"
                       Style="{StaticResource Body2Medium}"
                       TextColor="{StaticResource ErrorRed}"
                       VerticalTextAlignment="Center"/>
            </Grid>

        </VerticalStackLayout>
    </Border>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.WeatherPopupPage"
             BackgroundColor="Transparent">

    <!-- Same shell as AppPopupPage/AppChooserPage (scrim, card, entry animation), so a third
         popup still reads as the same object as the other two. Only the body differs: a small
         table of readings instead of a message or a list of choices. -->
    <Grid x:Name="Scrim" BackgroundColor="{StaticResource ScrimOverlay}" Opacity="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped"/>
        </Grid.GestureRecognizers>

        <Border x:Name="Card"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Divider}"
                StrokeThickness="1"
                Padding="24"
                Margin="32,0"
                Scale="0.92"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <!-- Swallows taps so they don't fall through to the scrim. -->
                <TapGestureRecognizer/>
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="16">
                <!-- The sky as the app's own drawn glyph in the tinted round badge the other
                     popups lead with (AppPopupPage), rather than an emoji drawn in each platform's
                     colours. The ✕ in the corner is the way out: this popup asks nothing, so it has
                     no Cancel to close with. -->
                <Grid>
                    <Border x:Name="IconBadge"
                            StrokeThickness="0"
                            WidthRequest="56"
                            HeightRequest="56"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28"/>
                        </Border.StrokeShape>
                        <Image x:Name="GlyphImage"
                               WidthRequest="30"
                               HeightRequest="30"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <controls:DismissButton Margin="0,-8,-8,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            SemanticProperties.Description="Close"
                                            Clicked="OnCloseClicked"/>
                </Grid>

                <VerticalStackLayout Spacing="2">
                    <Label x:Name="TemperatureLabel"
                           Style="{StaticResource Heading2}"
                           HorizontalTextAlignment="Center"/>
                    <Label x:Name="ConditionLabel"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource BodyText}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- Rows are built in code-behind: humidity and air quality are each independently
                     optional (EnvironmentalReading — the enrichment pass can succeed for one field
                     and fail for the rest), so the card only ever shows what actually came back. -->
                <VerticalStackLayout x:Name="DetailRows" Spacing="8" Margin="0,4,0,0"/>

                <Label x:Name="AsOfLabel"
                       Style="{StaticResource Body2}"
                       TextColor="{StaticResource MutedText}"
                       HorizontalTextAlignment="Center"
                       Margin="0,4,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

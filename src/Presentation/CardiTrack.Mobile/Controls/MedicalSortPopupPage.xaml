<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.MedicalSortPopupPage"
             BackgroundColor="Transparent">

    <!-- Turns one block of old notes into lines: each statement in it, with what kind of thing it
         is chosen by the caregiver. The shell of MedicalEntryEditPopupPage; the pieces can run
         long, so the list scrolls inside a card that is capped at most of the screen. -->
    <Grid x:Name="Scrim" BackgroundColor="{StaticResource ScrimOverlay}" Opacity="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped"/>
        </Grid.GestureRecognizers>

        <Border x:Name="Card"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Divider}"
                StrokeThickness="1"
                Padding="24"
                Margin="32,0"
                Scale="0.92"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer/>
            </Border.GestureRecognizers>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="0">
                <Label Text="Sort into lines"
                       Style="{StaticResource Heading3}"
                       HorizontalTextAlignment="Center"/>
                <Label Grid.Row="1"
                       Margin="0,6,0,12"
                       Text="Say what each part is. Skip anything that no longer applies — the original stays in the history."
                       Style="{StaticResource Body2}"
                       HorizontalTextAlignment="Start"
                       LineBreakMode="WordWrap"/>

                <!-- A ScrollView here is safe where the sibling popups avoid one: every piece's
                     chips wrap in a FlexLayout, the construction the filter sheet's chips already
                     wrap in inside its own ScrollView, bounded by the card's width. -->
                <ScrollView Grid.Row="2" x:Name="PiecesScroller">
                    <VerticalStackLayout x:Name="PiecesHost" Spacing="14"/>
                </ScrollView>

                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,16,0,0">
                    <controls:AppButton Text="Cancel"
                                        Icon="icon_btn_close.svg"
                                        Clicked="OnCancelClicked"
                                        Tone="Neutral"
                                        Size="M"/>
                    <controls:AppButton Grid.Column="1"
                                        Text="Save"
                                        Icon="icon_btn_save.svg"
                                        Clicked="OnSaveClicked"
                                        Tone="Primary"
                                        Size="M"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.AlertListCard">

    <!-- One row of the Alerts List (Figma 101:6525). Two stacked rounded rects, exactly as the
         design draws it: a severity-coloured one underneath and the white card inset 4px from
         its left edge. That is what makes the severity rail round into the card's corner
         instead of butting against it as a straight bar would.

         The title opens the detail screen. The chevron still expands the preview in place. -->
    <Border x:Name="SeverityRail"
            StrokeThickness="0"
            Padding="4,0,0,0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20"/>
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.15" Radius="14" Offset="0,4"/>
        </Border.Shadow>

        <Border BackgroundColor="{StaticResource White}"
                StrokeThickness="0"
                Padding="15,14,14,14">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14"
                  RowSpacing="4">

                <!-- MemberAvatar rather than a tile of this card's own: it is the one box a
                     CardiMember is shown in, so the person on this row reads the same as they
                     do on the dashboard hero, Member Detail, and the alert's own detail screen.
                     This card used to draw its own — a pale tile with blue initials, per Figma
                     101:6525 — so the same relative changed appearance on the way from this
                     list into the detail.

                     Sized to the two lines beside it — title and "who, when" — rather than to
                     AlertDetailPage's 52: the head of the row was three lines with the badge
                     on top, and the box was sized to that; now it is two, and a taller box
                     would stretch the rows apart to fill itself.

                     It also carries the photo the list already returns; the local tile was
                     initials-only and ignored it. -->
                <controls:MemberAvatar x:Name="Avatar"
                                       Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                       BoxWidth="46"/>

                <Label x:Name="TitleLabel"
                       Grid.Row="0" Grid.Column="1"
                       Style="{StaticResource Heading3}"
                       LineBreakMode="TailTruncation"
                       MaxLines="2">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOpenTapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <!-- Severity badge in the card's top-right corner, small: it is a category
                     stamp, not the headline — the title is. The unread dot sits beside it,
                     since both say "this one still needs you" and belong together. -->
                <HorizontalStackLayout Grid.Row="0" Grid.Column="2" Spacing="8" VerticalOptions="Start">
                    <Border x:Name="UnreadDot"
                            WidthRequest="10" HeightRequest="10"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Primary}"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5"/>
                        </Border.StrokeShape>
                    </Border>
                    <Border x:Name="SeverityPill"
                            StrokeThickness="0"
                            Padding="7,2"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label x:Name="SeverityLabel"
                               FontFamily="QuicksandMedium"
                               FontSize="10"
                               CharacterSpacing="0.4"
                               TextColor="{StaticResource White}"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- "Dad, 6 days ago": who and when on one muted line under the title. -->
                <Label x:Name="MemberLabel"
                       Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                       FontFamily="QuicksandMedium"
                       FontSize="12"
                       TextColor="{StaticResource MutedText}"
                       LineBreakMode="TailTruncation"/>

                <!-- Spans the avatar column too: the expanded message should use the card's
                     full width rather than staying in the narrow text column. -->
                <Label x:Name="MessageLabel"
                       Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                       Margin="0,6,0,0"
                       Style="{StaticResource Body2}"
                       MaxLines="2"
                       LineBreakMode="TailTruncation">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExpandTapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                      Margin="0,10,0,0"
                      ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                      ColumnSpacing="8">

                    <Border x:Name="StatusPillBorder"
                            Grid.Column="0"
                            StrokeThickness="0"
                            Padding="10,4"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Label x:Name="StatusPillLabel"
                               FontFamily="QuicksandMedium"
                               FontSize="12"/>
                    </Border>

                    <Border x:Name="CallButton"
                            Grid.Column="1"
                            WidthRequest="28" HeightRequest="28"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource AlertActionBackground}"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCallTapped"/>
                        </Border.GestureRecognizers>
                        <Image Source="icon_action_call.svg" WidthRequest="16" HeightRequest="16"/>
                    </Border>

                    <Border x:Name="AcknowledgeButton"
                            Grid.Column="2"
                            WidthRequest="28" HeightRequest="28"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource AlertActionBackground}"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAcknowledgeTapped"/>
                        </Border.GestureRecognizers>
                        <Grid>
                            <Image x:Name="AcknowledgeIcon"
                                   Source="icon_action_check.svg"
                                   WidthRequest="16" HeightRequest="16"/>
                            <ActivityIndicator x:Name="AcknowledgeSpinner"
                                               IsVisible="False"
                                               IsRunning="False"
                                               Color="{StaticResource Primary}"
                                               WidthRequest="16" HeightRequest="16"/>
                        </Grid>
                    </Border>

                    <Border x:Name="DeleteButton"
                            Grid.Column="3"
                            HorizontalOptions="End"
                            WidthRequest="28" HeightRequest="28"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource AlertActionBackground}"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Remove this alert">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDeleteTapped"/>
                        </Border.GestureRecognizers>
                        <Image Source="icon_trash.svg" WidthRequest="15" HeightRequest="15"/>
                    </Border>

                    <!-- Wrapped so the tap target is a finger rather than a 20px glyph. -->
                    <Border Grid.Column="4"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            Padding="6"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExpandTapped"/>
                        </Border.GestureRecognizers>
                        <Image x:Name="ExpandChevron"
                               Source="icon_chevron_down.svg"
                               WidthRequest="20" HeightRequest="20"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</ContentView>

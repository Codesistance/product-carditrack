<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.StatusHeroCard">

    <!-- Figma 101:2853, adapted: chrome now comes from the outer CardiMember card (DashboardPage)
         so this control only supplies the hero row content, making room for that card to also
         hold the action row and Key Metrics as multi-CardiMember support lands. The health status
         is still carried by the status line's colour and icon, not by any card fill. Tapping the
         row opens M1-13. -->
    <!-- The name owns the top row on its own, starting at the card's left edge; the avatar and the
         status block share the row under it. Previously the name sat in the avatar's column, which
         indented it and left the status sentence wrapping inside whatever width remained beside a
         monogram — "today." alone on its own line was the tell. Now the sentence wraps against the
         width the avatar leaves, and the name against the whole card. -->
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
          ColumnSpacing="16" RowSpacing="8">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped"/>
        </Grid.GestureRecognizers>

        <!-- MinimumHeightRequest, not a fixed height: the row is 42 tall whether or not the Q&amp;A
             cluster (42) is showing beside the 36 buttons, so the card doesn't jolt when a
             question arrives — but it still grows if a larger system font needs it to. -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
              ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"
              MinimumHeightRequest="42">
            <Label x:Name="NameLabel"
                   Grid.Column="0"
                   Style="{StaticResource Heading2}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"/>

            <!-- Last-session weather (EnvironmentalReading — not live, no stored coordinate).
                 Its own TapGestureRecognizer takes taps before the row's own below, so tapping
                 the chip opens the weather popup rather than M1-13. Hidden outright when the
                 member has no reading, or hasn't granted environmental-context consent. -->
            <HorizontalStackLayout x:Name="WeatherChip"
                                    Grid.Column="1"
                                    Spacing="4"
                                    VerticalOptions="Center"
                                    IsVisible="False">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnWeatherTapped"/>
                </HorizontalStackLayout.GestureRecognizers>
                <Label x:Name="WeatherGlyphLabel" FontSize="16" VerticalOptions="Center"/>
                <Label x:Name="WeatherTemperatureLabel"
                       Style="{StaticResource Body2Dark}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- The card's two ways onward, at its top right: this member's daybook and the
                 alerts. Buttons here rather than links at the card's foot — the foot is where
                 the card's own content ends, not where journeys start. Their taps must win over
                 the card's own M1-13 tap, which they do the same way the weather chip's does. -->
            <!-- The buttons stack rather than each taking a Grid column, because a Grid charges
                 ColumnSpacing on both sides of a column even when the column measured to nothing.
                 With the Q&amp;A cluster hidden — which is most of the time — its empty column still
                 cost 8 either side, so CardiJournal sat 16 from Alerts while Alerts sat 8 from
                 Advise. A HorizontalStackLayout skips a collapsed child and its spacing with it,
                 so the gap is 8 between whichever buttons are actually showing. -->
            <HorizontalStackLayout Grid.Column="2"
                                    Spacing="8"
                                    VerticalOptions="Center">

                <Border WidthRequest="36" HeightRequest="36"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource SelectedOptionBackground}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="CardiJournal"
                        SemanticProperties.Hint="Opens this CardiMember's CardiJournal">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDaybookTapped"/>
                    </Border.GestureRecognizers>
                    <Image Source="icon_tab_journal.svg"
                           WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- Beside the Daybook button, only while a question is waiting on this family (see
                     Apply/ApplyPendingQuestionnaire). Button, pulse ring and count badge share one
                     42x42 cell so the badge can sit proud of the button's top-right corner without
                     any of it crossing this control's own top edge — a superscript hung outside the
                     layout with a negative translation was drawn half-cut, because the row it sits in
                     is the first thing in the card and there is nothing above it to overflow into.
                     The ring, likewise, pulses behind the icon rather than growing past it, the way
                     PendingBotIndicator's does — Alerts sits right beside this, with no room to
                     spill into.
                     The -3 margin is that 42 paying for itself: the cell is 3 wider than the 36
                     face on each side, so without it this button's face would sit 11 from its
                     neighbours where every other pair sits 8. The badge has 5 of the gap left to
                     hang into, which is more than it uses. -->
                <Grid x:Name="QaCluster"
                      WidthRequest="42" HeightRequest="42"
                      Margin="-3,0"
                      VerticalOptions="Center"
                      IsVisible="False">
                    <Ellipse x:Name="QaPulseRing"
                             WidthRequest="34" HeightRequest="34"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             Stroke="{StaticResource Primary}"
                             StrokeThickness="2"
                             Opacity="0"
                             InputTransparent="True"/>

                    <Border x:Name="QaBorder"
                            WidthRequest="36" HeightRequest="36"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource SelectedOptionBackground}"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            SemanticProperties.Description="Questions"
                            SemanticProperties.Hint="Opens the question waiting on this CardiMember">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQaTapped"/>
                        </Border.GestureRecognizers>
                        <Image Source="icon_tab_qa.svg"
                               WidthRequest="20" HeightRequest="20"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <!-- Superscript count, same construction as DashboardHeader's BellBadge, but
                         placed inside the cell rather than translated out of it. Always "1" today —
                         at most one pending question per member — but a number rather than a dot so
                         it reads the same way if that ever stops being true. -->
                    <Border x:Name="QaBadge"
                            BackgroundColor="{StaticResource StatusRed}"
                            StrokeThickness="0"
                            WidthRequest="18" HeightRequest="18"
                            HorizontalOptions="End" VerticalOptions="Start"
                            InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="9"/>
                        </Border.StrokeShape>
                        <Label x:Name="QaBadgeLabel"
                               FontSize="10"
                               FontFamily="QuicksandSemiBold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- Alerts, pulsing while this CardiMember has one nobody has answered yet (see
                     ApplyOpenAlerts). Same construction and same bounds as AdviseCluster below —
                     the ring blooms over the button's own 36 rather than behind it, because a
                     36 face is opaque and there is a neighbour on either side with nothing to
                     spare. Unlike Advise and Q&amp;A this button is always here: it is the way to
                     this member's alerts whether or not any are open, so only the ring comes and
                     goes. A tap opens the list filtered to this member. -->
                <Grid x:Name="AlertsCluster"
                      WidthRequest="36" HeightRequest="36"
                      VerticalOptions="Center"
                      SemanticProperties.Description="Alerts"
                      SemanticProperties.Hint="Opens the alerts list for this CardiMember">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAlertsTapped"/>
                    </Grid.GestureRecognizers>

                    <Border WidthRequest="36" HeightRequest="36"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource SelectedOptionBackground}"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>
                        <Image Source="icon_tab_alerts.svg"
                               WidthRequest="20" HeightRequest="20"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <Ellipse x:Name="AlertsPulseRing"
                             WidthRequest="32" HeightRequest="32"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             Stroke="{StaticResource StatusRed}"
                             StrokeThickness="2"
                             Opacity="0"
                             InputTransparent="True"/>
                </Grid>

                <!-- Advise: last in the row, only while this member has a fresh "Something to try"
                     suggestion waiting (DashboardResponse.HasAdvise). It was a corner badge on the avatar until
                     now — a dot that pulsed at something without saying what, and with nothing to tap.
                     As a button it says both: the same 36 face and 20 glyph as CardiJournal and Alerts
                     beside it, and a tap that lands on the suggestion itself.

                     The cell is 36, the face's own size — there is no badge to hang, so it needs
                     no margin of its own to sit 8 from Alerts and flush with the card's right
                     edge. The ring pulses *over* the button face rather than behind it,
                     because a 36 face is opaque: QaCluster's ring is 34 behind a 36 border and only
                     its outer sliver ever shows. Blooming outward from the glyph keeps the whole
                     animation inside those 36 and still reads. -->
                <Grid x:Name="AdviseCluster"
                      WidthRequest="36" HeightRequest="36"
                      VerticalOptions="Center"
                      IsVisible="False"
                      SemanticProperties.Description="Something to try"
                      SemanticProperties.Hint="Opens a suggestion the family could try with this CardiMember">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAdviseTapped"/>
                    </Grid.GestureRecognizers>

                    <Border WidthRequest="36" HeightRequest="36"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource SelectedOptionBackground}"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>
                        <Image Source="icon_advise.svg"
                               WidthRequest="20" HeightRequest="20"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <Ellipse x:Name="AdvisePulseRing"
                             WidthRequest="32" HeightRequest="32"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             Stroke="{StaticResource Primary}"
                             StrokeThickness="2"
                             Opacity="0"
                             InputTransparent="True"/>
                </Grid>

            </HorizontalStackLayout>
        </Grid>

        <!-- Member Detail's display image box, not one of this card's own: the same person must
             not be a tinted monogram here and a gradient one a tap away. Top-aligned to the status
             block now that the name no longer shares this row — bottom-aligning it against a
             sentence that wraps to two or three lines floated the box away from the text it
             belongs to. -->
        <controls:MemberAvatar x:Name="Avatar"
                               Grid.Row="1" Grid.Column="0"
                               BoxWidth="76"
                               HorizontalOptions="Start" VerticalOptions="Start"/>

        <!-- Two lines, not one: the headline is the note a caregiver reads at a glance — short
             enough to land in one beat — and the sentence under it is the context they read
             second. Grid, not a stack: the label needs a bounded column width to wrap within, and
             the icon stays on the headline's row rather than re-centering against however many
             lines the pair wraps to. Neither label overrides LineHeight — the crammed 1.05 this
             used to carry made a wrapped line look mispadded.

             The sentence spans both columns rather than sitting in the headline's: only the
             headline has a glyph to be indented by, so indenting the sentence too left every line
             of the block starting at a different x. Both rows collapse when their labels are
             hidden, which is what lets the no-baseline tier below render as the sentence alone. -->
        <Grid Grid.Row="1" Grid.Column="1"
              ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
              ColumnSpacing="6" RowSpacing="2">
            <!-- Tinted per tier by the asset itself (icon_status_*.svg): these were authored
                 white for the card's original coloured fill, and stayed invisible — as a bare
                 17dp indent in front of the status line — once the card went white. -->
            <Image x:Name="StatusIcon"
                   Grid.Row="0" Grid.Column="0"
                   Source="icon_status_check.svg"
                   WidthRequest="17" HeightRequest="17"
                   VerticalOptions="Center"/>
            <Label x:Name="StatusHeadlineLabel"
                   Grid.Row="0" Grid.Column="1"
                   FontFamily="QuicksandSemiBold"
                   FontSize="16"
                   LineBreakMode="TailTruncation"
                   VerticalOptions="Center"/>
            <Label x:Name="StatusDetailLabel"
                   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                   Style="{StaticResource Body2}"
                   LineBreakMode="WordWrap"
                   MaxLines="3"/>
        </Grid>
    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.StatusHeroCard">

    <!-- Figma 101:2853, adapted: chrome now comes from the outer CardiMember card (DashboardPage)
         so this control only supplies the hero row content, making room for that card to also
         hold the action row and Key Metrics as multi-CardiMember support lands. The health status
         is still carried by the status line's colour and icon, not by any card fill. Tapping the
         row opens M1-13. -->
    <!-- The name owns the top of the card beside the avatar, starting at the avatar's right, with
         the status block under both. Previously the name sat in the avatar's column, which
         indented it and left the status sentence wrapping inside whatever width remained beside a
         monogram — "today." alone on its own line was the tell. Now the sentence wraps against the
         card's whole width, and the name against its whole column: the buttons that used to share
         the name's row at its right moved to the card's foot (2026-09-26, MemberDashboardCard),
         all but the pin, which rides the name line itself. -->
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
          ColumnSpacing="16" RowSpacing="8">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped"/>
        </Grid.GestureRecognizers>

        <!-- The name is the title; what kind of person they are goes under it. Splitting
             "Dad, 66" this way is what frees the row below: the avatar can come up beside
             the name, and the summary underneath gets the card's whole width instead of
             whatever is left beside a 76pt monogram. -->
        <VerticalStackLayout x:Name="NameBlock"
                             Grid.Row="0" Grid.Column="1"
                             Spacing="1"
                             VerticalOptions="Start">
            <!-- The pin follows the name rather than sitting at the card's right edge, so it
                 reads as a mark on this person instead of a control of the card's. A stack
                 rather than a Grid, so the pin sits right after however long the name is; the
                 name is capped in code (FitName) to the width the pin leaves, since a stack
                 would otherwise let a long one run past the card rather than truncate.

                 The bottom padding and the matching negative margin are the pin's tap band. Its
                 face is 26 but the finger target is 44, and Android will not deliver a touch to
                 a view outside its parent's bounds — so the line carries 18 of transparent room
                 down into the meta line below it without taking any layout room there. The band
                 can only reach downward: above the name is the card's own padding, outside every
                 layout this line sits in. Where the band crosses the weather chip, the chip wins,
                 being later in the tree. -->
            <HorizontalStackLayout x:Name="NameLine"
                                   Spacing="6"
                                   Padding="0,0,0,18"
                                   Margin="0,0,0,-18">
                <Label x:Name="NameLabel"
                       Style="{StaticResource Heading2}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>

                <!-- Pin to the top of the dashboard: only while several members stack, since one
                     card has nowhere else to go (SetPinning). Filled blue while pinned. The cell
                     is the tap target and the accessible node; its tap wins over the card's own
                     M1-13 tap the same way the weather chip's does. -->
                <Grid x:Name="PinButton"
                      WidthRequest="44" HeightRequest="44"
                      Margin="-9,0,-9,-18"
                      BackgroundColor="Transparent"
                      VerticalOptions="Center"
                      IsVisible="False"
                      SemanticProperties.Description="Pin to the top">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPinTapped"/>
                    </Grid.GestureRecognizers>
                    <Border WidthRequest="26" HeightRequest="26"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource SelectedOptionBackground}"
                            HorizontalOptions="Center" VerticalOptions="Start"
                            InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Image x:Name="PinIcon"
                               Source="icon_pin.svg"
                               WidthRequest="14" HeightRequest="14"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <Label x:Name="MemberMetaLabel"
                       Style="{StaticResource Body2Dark}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>

        <!-- Last-session weather (EnvironmentalReading — not live, no stored coordinate).
             Its own TapGestureRecognizer takes taps before the row's own below, so tapping
             the chip opens the weather popup rather than M1-13. Hidden outright when the
             member has no reading, or hasn't granted environmental-context consent. -->
                <HorizontalStackLayout x:Name="WeatherChip"
                                        Spacing="4"
                                        VerticalOptions="Center"
                                        IsVisible="False">
            <HorizontalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnWeatherTapped"/>
            </HorizontalStackLayout.GestureRecognizers>
                    <Label x:Name="WeatherGlyphLabel" FontSize="16" VerticalOptions="Center"/>
                    <Label x:Name="WeatherTemperatureLabel"
                           Style="{StaticResource Body2Dark}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Member Detail's display image box, not one of this card's own: the same person must
             not be a tinted monogram here and a gradient one a tap away. Top-aligned to the status
             block now that the name no longer shares this row — bottom-aligning it against a
             sentence that wraps to two or three lines floated the box away from the text it
             belongs to. -->
        <controls:MemberAvatar x:Name="Avatar"
                               Grid.Row="0" Grid.Column="0"
                               BoxWidth="56"
                               HorizontalOptions="Start" VerticalOptions="Start"/>

        <!-- Two rows, one column: the headline is the note a caregiver reads at a glance, the
             sentence under it the context they read second. Neither label overrides LineHeight —
             the crammed 1.05 this used to carry made a wrapped line look mispadded. Both rows
             collapse when their labels are hidden, which is what lets the no-baseline tier below
             render as the sentence alone.

The tier glyph is back in front of the headline, on its line. It could not
             hold its place before, when this block sat in a narrow column beside the avatar:
             the glyph indented the headline but not the sentence under it, so the two started
             at different x. With the avatar moved up to the name and the block spanning the
             card, the sentence has room to start under the glyph's own column, and the
             headline keeps its left edge whether it wraps or not. `line.Icon` is drawn again
             rather than merely served. -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
              RowDefinitions="Auto,Auto" RowSpacing="2">
            <!-- Two lines, because this one is written rather than composed: the detail below
                 it gets three, and the headline was the only label in the app truncating
                 model-written prose to a single line. "Slower heart rate and less act…" loses
                 the half of the sentence a caregiver came for. It keeps TailTruncation as the
                 backstop so a runaway headline still cannot push the card open. -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Image x:Name="StatusIcon"
                       Grid.Column="0"
                       WidthRequest="18" HeightRequest="18"
                       VerticalOptions="Start"
                       Margin="0,1,0,0"
                       IsVisible="False"
                       AutomationProperties.IsInAccessibleTree="False"/>
                <!-- Same size as the sentence under it, in the heaviest face the app ships:
                     the headline is a summary of the detail, not a heading over it, and at 18
                     it outweighed the member's own name above. -->
                <Label x:Name="StatusHeadlineLabel"
                       Grid.Column="1"
                       FontFamily="QuicksandSemiBold"
                       FontSize="14"
                       LineBreakMode="TailTruncation"
                       MaxLines="2"/>
            </Grid>
            <!-- The sentence starts at the card's left edge, under the glyph rather than
                 under the headline's text: the block spans the card now, and an inset would
                 only make the one paragraph on it narrower than everything around it. -->
            <Label x:Name="StatusDetailLabel"
                   Grid.Row="1"
                   Style="{StaticResource Body2Dark}"
                   FontSize="14"
                   LineBreakMode="WordWrap"
                   MaxLines="3"/>
        </Grid>
    </Grid>
</ContentView>

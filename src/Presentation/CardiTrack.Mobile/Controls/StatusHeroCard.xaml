<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.StatusHeroCard">

    <!-- Figma 101:2853, adapted: chrome now comes from the outer CardiMember card (DashboardPage)
         so this control only supplies the hero row content, making room for that card to also
         hold the action row and Key Metrics as multi-CardiMember support lands. The health status
         is still carried by the status line's colour and icon, not by any card fill. Tapping the
         row opens M1-13. -->
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped"/>
        </Grid.GestureRecognizers>

            <!-- Photo when the member has one, initials otherwise. Both keep the same box so
                 the text column doesn't shift between the two states. Sized down from the
                 original 70x72 to leave room for the status line's now-larger line count. -->
            <Border Grid.Column="0"
                    WidthRequest="56" HeightRequest="58"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource SelectedOptionBackground}"
                    VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Grid>
                    <Label x:Name="InitialsLabel"
                           FontFamily="QuicksandSemiBold"
                           FontSize="20"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    <Image x:Name="PhotoImage"
                           IsVisible="False"
                           Aspect="AspectFill"
                           WidthRequest="56" HeightRequest="58"/>
                </Grid>
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Label x:Name="NameLabel"
                       Style="{StaticResource Heading2}"
                       LineBreakMode="TailTruncation"/>

                <!-- Grid, not a HorizontalStackLayout: the label needs a bounded column width to
                     wrap within, and the icon stays pinned to the first line's top rather than
                     re-centering against however many lines the status text wraps to. -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <Image x:Name="StatusIcon"
                           Grid.Column="0"
                           Source="icon_status_check.svg"
                           WidthRequest="17" HeightRequest="17"
                           VerticalOptions="Start"
                           Margin="0,2,0,0"/>
                    <Label x:Name="StatusLabel"
                           Grid.Column="1"
                           FontFamily="QuicksandSemiBold"
                           FontSize="14"
                           LineBreakMode="WordWrap"
                           MaxLines="3"
                           LineHeight="1.05"/>
                </Grid>
            </VerticalStackLayout>
        </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.StatusHeroCard">

    <!-- Figma 101:2853, adapted: chrome now comes from the outer CardiMember card (DashboardPage)
         so this control only supplies the hero row content, making room for that card to also
         hold the action row and Key Metrics as multi-CardiMember support lands. The health status
         is still carried by the status line's colour and icon, not by any card fill. Tapping the
         row opens M1-13. -->
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped"/>
        </Grid.GestureRecognizers>

        <controls:MemberAvatar x:Name="Avatar" Grid.Column="0"/>

        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
            <Label x:Name="NameLabel"
                   Style="{StaticResource Heading2}"
                   LineBreakMode="TailTruncation"/>

            <!-- Two lines, not one: the headline is the note a caregiver reads at a glance —
                 short enough to land in one beat — and the sentence under it is the context they
                 read second. Grid, not a stack: the label needs a bounded column width to wrap
                 within, and the icon stays on the headline's row rather than re-centering
                 against however many lines the pair wraps to. Neither label overrides LineHeight
                 — the crammed 1.05 this used to carry made a wrapped line look mispadded. -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                  ColumnSpacing="6" RowSpacing="2">
                <Image x:Name="StatusIcon"
                       Grid.Row="0" Grid.Column="0"
                       Source="icon_status_check.svg"
                       WidthRequest="17" HeightRequest="17"
                       VerticalOptions="Center"/>
                <Label x:Name="StatusHeadlineLabel"
                       Grid.Row="0" Grid.Column="1"
                       FontFamily="QuicksandSemiBold"
                       FontSize="16"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center"/>
                <Label x:Name="StatusDetailLabel"
                       Grid.Row="1" Grid.Column="1"
                       Style="{StaticResource Body2}"
                       LineBreakMode="WordWrap"
                       MaxLines="2"/>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentView>

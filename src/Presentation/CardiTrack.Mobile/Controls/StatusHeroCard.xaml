<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.StatusHeroCard">

    <!-- Figma 101:2853. The card is white and the health status is carried by the status line's
         colour and icon, not by the card's fill — the gradient in this design belongs to the
         header band. Tapping the card opens M1-13. -->
    <Border Style="{StaticResource ElevatedCard}" Padding="16,15">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped"/>
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">

            <!-- Photo when the member has one, initials otherwise. Both keep the designed
                 70x72 box so the text column doesn't shift between the two states. -->
            <Border Grid.Column="0"
                    WidthRequest="70" HeightRequest="72"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource SelectedOptionBackground}"
                    VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11"/>
                </Border.StrokeShape>
                <Grid>
                    <Label x:Name="InitialsLabel"
                           FontFamily="QuicksandSemiBold"
                           FontSize="24"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    <Image x:Name="PhotoImage"
                           IsVisible="False"
                           Aspect="AspectFill"
                           WidthRequest="70" HeightRequest="72"/>
                </Grid>
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Label x:Name="NameLabel"
                       Style="{StaticResource Heading2}"
                       LineBreakMode="TailTruncation"/>

                <HorizontalStackLayout Spacing="6">
                    <Label x:Name="StatusLabel"
                           FontFamily="QuicksandSemiBold"
                           FontSize="16"
                           VerticalTextAlignment="Center"/>
                    <Image x:Name="StatusIcon"
                           Source="icon_status_check.svg"
                           WidthRequest="19" HeightRequest="19"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Label x:Name="LastSyncedLabel"
                       FontFamily="Quicksand"
                       FontSize="12"
                       TextColor="{StaticResource BodyText}"/>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>

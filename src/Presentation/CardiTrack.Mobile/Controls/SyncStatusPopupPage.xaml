<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.SyncStatusPopupPage"
             BackgroundColor="Transparent">

    <!-- Same shell as AppPopupPage/AppChooserPage/WeatherPopupPage (scrim, card, entry
         animation); only the body differs. This one answers the dot in the CardiMember card's
         corner, so it opens with that dot's own colour rather than the generic blue "i" badge
         the info popup uses: the thing tapped and the thing shown are visibly the same object.
         The reading leads, the clock time backs it up, and the pipeline's own word for the
         state sits in a row beneath, beside a second copy of the dot. -->
    <Grid x:Name="Scrim" BackgroundColor="{StaticResource ScrimOverlay}" Opacity="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped"/>
        </Grid.GestureRecognizers>

        <Border x:Name="Card"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Divider}"
                StrokeThickness="1"
                Padding="24"
                Margin="32,0"
                Scale="0.92"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <!-- Swallows taps so they don't fall through to the scrim. -->
                <TapGestureRecognizer/>
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="16">

                <!-- The dot from the card, at popup scale: a soft disc of the tier's colour
                     with the dot itself at its centre. -->
                <Border x:Name="Badge"
                        StrokeThickness="0"
                        WidthRequest="56"
                        HeightRequest="56"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28"/>
                    </Border.StrokeShape>
                    <Ellipse x:Name="BadgeDot"
                             WidthRequest="18" HeightRequest="18"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Last synced"
                           Style="{StaticResource Caption}"
                           TextColor="{StaticResource MutedText}"
                           HorizontalTextAlignment="Center"/>
                    <Label x:Name="AgeLabel"
                           Style="{StaticResource Heading2}"
                           HorizontalTextAlignment="Center"/>
                    <Label x:Name="ClockLabel"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource BodyText}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- The pipeline's own verdict, as a row rather than a sentence: it is a state
                     with a colour, not prose, and the dot beside it is the one on the card. -->
                <Border x:Name="StateRow"
                        BackgroundColor="{StaticResource InputBackground}"
                        StrokeThickness="0"
                        Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Ellipse x:Name="StateDot"
                                 WidthRequest="10" HeightRequest="10"
                                 VerticalOptions="Center"
                                 AutomationProperties.IsInAccessibleTree="False"/>
                        <Label x:Name="StateLabel"
                               Style="{StaticResource Body2Dark}"
                               VerticalOptions="Center"
                               LineBreakMode="WordWrap"/>
                    </HorizontalStackLayout>
                </Border>

                <Button x:Name="CloseBtn"
                        Text="Close"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource MutedText}"
                        FontFamily="QuicksandSemiBold"
                        FontSize="16"
                        HeightRequest="44"
                        Margin="0,4,0,0"
                        Clicked="OnCloseClicked"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

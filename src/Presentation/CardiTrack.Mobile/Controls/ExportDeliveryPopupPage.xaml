<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.ExportDeliveryPopupPage"
             BackgroundColor="Transparent">

    <!-- Where the finished file goes, as the same two tiles the format question is asked with
         (ExportFormatPopupPage) — one card, one shell, one glyph language, so the two halves of
         an export read as one flow rather than as a styled question followed by a system list.

         Two places the file can go, and they are genuinely different: Save keeps it on this
         phone, Share hands it to another app. The chooser this replaced offered "Save or share"
         and "Open" as peers, which named one action twice — a caregiver who wanted a copy on
         their phone had to know that the share sheet hides one behind "Save to Files". Open is
         still here, under them, because looking at the file is a real thing to want and is not
         a place to put it. -->
    <Grid x:Name="Scrim" BackgroundColor="{StaticResource ScrimOverlay}" Opacity="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped"/>
        </Grid.GestureRecognizers>

        <Border x:Name="Card"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Divider}"
                StrokeThickness="1"
                Padding="24"
                Margin="32,0"
                Scale="0.92"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <!-- Swallows taps so they don't fall through to the scrim. -->
                <TapGestureRecognizer/>
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="16">

                <Grid>
                    <!-- Like every popup's title, but centred in the space left of the ✕ (36 clear
                         on the right only): held clear of both edges it lost 80dp and wrapped a
                         normal-length title onto two lines. -->
                    <VerticalStackLayout Spacing="2" Margin="0,0,36,0">
                        <Label Text="Your export is ready"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <!-- The filename, quietly: it is what the caregiver will look for in
                             Files or in the app they send it to, and it names the format they
                             picked a moment ago without asking them to remember it. -->
                        <Label x:Name="FileNameLabel"
                               Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="MiddleTruncation"/>
                    </VerticalStackLayout>

                    <!-- Dismissal as a mark, in the corner, the same one the other popups use. -->
                    <controls:DismissButton Margin="0,-8,-8,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            SemanticProperties.Description="Close"
                                            Clicked="OnCloseTapped"/>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                    <Border x:Name="SaveTile"
                            Grid.Column="0"
                            Style="{StaticResource FormatTile}"
                            SemanticProperties.Description="Save"
                            SemanticProperties.Hint="Keeps the file on this phone">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSaveTapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Image Source="icon_save.svg"
                                   WidthRequest="40" HeightRequest="40"
                                   HorizontalOptions="Center"/>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Save"
                                       Style="{StaticResource FormatTileLabel}"/>
                                <!-- Where it lands differs by phone, so the tile says what the
                                     choice means rather than naming a folder it might be wrong
                                     about; the confirmation afterwards names the real place. -->
                                <Label x:Name="SaveHint"
                                       Text="Keep it on this phone"
                                       Style="{StaticResource FormatTileHint}"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="ShareTile"
                            Grid.Column="1"
                            Style="{StaticResource FormatTile}"
                            SemanticProperties.Description="Share"
                            SemanticProperties.Hint="Sends the file to another app">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShareTapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Image Source="icon_share.svg"
                                   WidthRequest="40" HeightRequest="40"
                                   HorizontalOptions="Center"/>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Share"
                                       Style="{StaticResource FormatTileLabel}"/>
                                <Label Text="Send it somewhere"
                                       Style="{StaticResource FormatTileHint}"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Not a third tile. Save and Share are the two places the file can go; Open
                     is a look at it before deciding, and it puts it nowhere. Under the pair, as
                     the everyday tonal button rather than a tile, so it reads as the quieter thing
                     it is — and so three 40-point glyphs are not squeezed across a 296-point card.
                     No glyph: the icon set has no blue-ink "open" to sit on the tonal fill. -->
                <controls:AppButton Text="Open – just look at it"
                                    Tone="Tonal"
                                    Size="M"
                                    SemanticProperties.Hint="Looks at the file now without keeping it"
                                    Clicked="OnOpenTapped"/>

                <!-- The responsibility line, once more and briefly. This is the moment the file
                     actually leaves CardiTrack's keeping, and it is the last screen before it
                     does. -->
                <Label Text="This file is a named health record. You're responsible for who sees it."
                       Style="{StaticResource Caption}"
                       HorizontalTextAlignment="Start"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

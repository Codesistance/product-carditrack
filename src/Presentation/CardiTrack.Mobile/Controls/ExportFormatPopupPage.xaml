<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.ExportFormatPopupPage"
             BackgroundColor="Transparent">

    <!-- Which file to take away, as two things to look at rather than two lines to read. The
         generic chooser stacked them as outlined rows of text, which made a choice between two
         familiar file types — one everybody recognises by its red sheet, one by its green grid —
         into a reading task. Both glyphs are the same folded page, so the pair reads as one family
         of files, marked inside with what each holds — a heartbeat for the report, a grid for the
         data — and told apart at a glance by the red and the green. No Figma frame: picked from
         samples (I1), design sync pending. -->
    <Grid x:Name="Scrim" BackgroundColor="{StaticResource ScrimOverlay}" Opacity="0">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped"/>
        </Grid.GestureRecognizers>

        <Border x:Name="Card"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Divider}"
                StrokeThickness="1"
                Padding="24"
                Margin="32,0"
                Scale="0.92"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <!-- Swallows taps so they don't fall through to the scrim. -->
                <TapGestureRecognizer/>
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="16">

                <Grid>
                    <Label Text="How should this copy look?"
                           Style="{StaticResource Heading3}"
                           Margin="0,0,28,0"/>

                    <!-- Dismissal as a mark, in the corner, the same one the other popups use. -->
                    <controls:DismissButton Margin="0,-8,-8,0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            SemanticProperties.Description="Close"
                                            Clicked="OnCloseTapped"/>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                    <Border x:Name="PdfTile"
                            Grid.Column="0"
                            Style="{StaticResource FormatTile}"
                            SemanticProperties.Description="PDF report"
                            SemanticProperties.Hint="A document to read or print">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPdfTapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Image Source="icon_format_pdf.svg"
                                   WidthRequest="40" HeightRequest="40"
                                   HorizontalOptions="Center"/>
                            <Label Text="PDF report"
                                   Style="{StaticResource FormatTileLabel}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="CsvTile"
                            Grid.Column="1"
                            Style="{StaticResource FormatTile}"
                            SemanticProperties.Description="CSV spreadsheet"
                            SemanticProperties.Hint="Rows to open in a spreadsheet">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCsvTapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Image Source="icon_format_csv.svg"
                                   WidthRequest="40" HeightRequest="40"
                                   HorizontalOptions="Center"/>
                            <Label Text="CSV spreadsheet"
                                   Style="{StaticResource FormatTileLabel}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

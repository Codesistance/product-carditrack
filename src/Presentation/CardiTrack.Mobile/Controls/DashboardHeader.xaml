<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.Controls.DashboardHeader">

    <!-- Figma 101:2872. Chrome comes from HeaderBand, which every header in the app shares;
         this control only supplies what is specific to the dashboard. Figma's band includes a
         simulated status bar; MAUI's ContentPage already insets for the real one, so only the
         86pt below it is drawn here. -->
    <controls:HeaderBand>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">

            <Border Grid.Column="0"
                    WidthRequest="40" HeightRequest="40"
                    BackgroundColor="{StaticResource HeaderButtonTint}"
                    StrokeThickness="0"
                    VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <ImageButton x:Name="RefreshButton"
                             Source="icon_refresh_white.svg"
                             WidthRequest="24" HeightRequest="24"
                             BackgroundColor="Transparent"
                             SemanticProperties.Description="Check in now"
                             SemanticProperties.Hint="Asks the wearable for the latest readings"
                             Clicked="OnRefreshClicked"/>
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Start">
                <Label x:Name="GreetingLabel"
                       Style="{StaticResource Heading2}"
                       TextColor="{StaticResource White}"
                       LineBreakMode="TailTruncation"/>
                <Label x:Name="PresenceLabel"
                       Text="Active Now"
                       FontFamily="QuicksandSemiBold"
                       FontSize="12"
                       TextColor="{StaticResource White}"/>
            </VerticalStackLayout>

            <Grid Grid.Column="2" VerticalOptions="Start">
                <Border WidthRequest="40" HeightRequest="40"
                        BackgroundColor="{StaticResource White}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.15" Radius="14" Offset="0,4"/>
                    </Border.Shadow>
                    <!-- Description is rewritten by SetUnreadCount: the badge carries the
                         count visually, so without that a screen reader loses it. -->
                    <ImageButton x:Name="BellButton"
                                 Source="icon_bell.svg"
                                 WidthRequest="24" HeightRequest="24"
                                 BackgroundColor="Transparent"
                                 SemanticProperties.Description="Alerts"
                                 Clicked="OnBellClicked"/>
                </Border>

                <Border x:Name="BellBadge"
                        IsVisible="False"
                        BackgroundColor="{StaticResource StatusRed}"
                        StrokeThickness="0"
                        WidthRequest="18" HeightRequest="18"
                        HorizontalOptions="End" VerticalOptions="Start"
                        TranslationX="6" TranslationY="-6"
                        InputTransparent="True">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="9"/>
                    </Border.StrokeShape>
                    <Label x:Name="BellBadgeLabel"
                           FontSize="10"
                           FontFamily="QuicksandSemiBold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>

        </Grid>
    </controls:HeaderBand>
</ContentView>

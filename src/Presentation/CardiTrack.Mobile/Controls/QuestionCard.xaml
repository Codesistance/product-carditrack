<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.QuestionCard">

    <!-- One question the service is asking the family, and the answer box it opens into.

         Deliberately without the severity/priority rail AlertListCard and NudgeCard carry: that
         rail is the grammar for "something is wrong", and this is an invitation. Radius on the
         card, never on the page behind it — pages are full-bleed. -->
    <Border BackgroundColor="{StaticResource White}"
            StrokeThickness="0"
            Padding="16,14,14,16">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20"/>
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.12" Radius="12" Offset="0,3"/>
        </Border.Shadow>

        <VerticalStackLayout Spacing="8">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <!-- Decorative: the heading beside it already says what this is. -->
                <Label Grid.Column="0"
                       Text="💬"
                       FontSize="16"
                       VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False"/>

                <Label x:Name="TitleLabel"
                       Grid.Column="1"
                       Style="{StaticResource DashboardSectionTitle}"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap"/>

                <Button x:Name="DismissButton"
                        Grid.Column="2"
                        Text="✕"
                        FontFamily="QuicksandSemiBold"
                        FontSize="15"
                        TextColor="{StaticResource MutedText}"
                        BackgroundColor="Transparent"
                        WidthRequest="40"
                        HeightRequest="40"
                        SemanticProperties.Description="Skip this question"
                        SemanticProperties.Hint="We won't ask it again"
                        Clicked="OnDismissClicked"/>

                <!-- Same slot as skip, only on an answered card. The archive used to hang this
                     trash outside the card, which made the row look like a card plus a toolbar. -->
                <Border x:Name="DeleteButton"
                        Grid.Column="2"
                        WidthRequest="40" HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        VerticalOptions="Center"
                        IsVisible="False"
                        SemanticProperties.Description="Delete this question and answer">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeleteTapped"/>
                    </Border.GestureRecognizers>
                    <Border WidthRequest="28" HeightRequest="28"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource AlertActionBackground}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Image Source="icon_trash.svg"
                               WidthRequest="15" HeightRequest="15"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Border>
            </Grid>

            <Label x:Name="QuestionLabel"
                   Style="{StaticResource Body1SemiBoldDark}"
                   LineBreakMode="WordWrap"/>

            <!-- Why this is being asked. Set apart rather than run on from the question, so a
                 question never arrives looking arbitrary. -->
            <Border x:Name="RationaleCard"
                    IsVisible="False"
                    BackgroundColor="{StaticResource SelectedOptionBackground}"
                    StrokeThickness="0"
                    Padding="12,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Label x:Name="RationaleLabel"
                       Style="{StaticResource Body2Medium}"
                       TextColor="{StaticResource PrimaryDark}"
                       LineBreakMode="WordWrap"/>
            </Border>

            <Label x:Name="OptionalLabel"
                   Style="{StaticResource Body2}"
                   FontSize="12"
                   LineBreakMode="WordWrap"/>

            <Label x:Name="CaptionLabel"
                   FontFamily="Quicksand"
                   FontSize="12"
                   TextColor="{StaticResource BodyText}"
                   IsVisible="False"
                   LineBreakMode="WordWrap"/>

            <Button x:Name="OpenButton"
                    Style="{StaticResource PrimaryGradientButton}"
                    HeightRequest="40"
                    FontSize="14"
                    Margin="0,2,0,0"
                    Clicked="OnOpenClicked"/>

            <!-- Clipped to zero and animated open, the same construction as the pause-duration
                 drop-down: the answer box belongs to the question, so it arrives under it rather
                 than on a page of its own. -->
            <Border x:Name="EditorClip"
                    StrokeThickness="0"
                    BackgroundColor="Transparent"
                    Padding="0"
                    HeightRequest="0">
                <VerticalStackLayout x:Name="EditorPanel" Spacing="8" Margin="0,4,0,0">
                    <Border Style="{StaticResource AuthEntryBorder}"
                            HeightRequest="100"
                            Padding="16,8">
                        <Editor x:Name="AnswerEditor"
                                FontFamily="Quicksand"
                                FontSize="14"
                                PlaceholderColor="{StaticResource BodyText}"
                                TextColor="{StaticResource HeadingText}"
                                BackgroundColor="Transparent"
                                Placeholder="Type your answer…"
                                AutoSize="Disabled"
                                TextChanged="OnAnswerChanged"/>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button x:Name="SaveButton"
                                Grid.Column="0"
                                Text="Save answer"
                                Style="{StaticResource PrimaryGradientButton}"
                                HeightRequest="40"
                                FontSize="14"
                                IsEnabled="False"
                                Clicked="OnSaveClicked"/>

                        <Button x:Name="CancelButton"
                                Grid.Column="1"
                                Text="Cancel"
                                Style="{StaticResource SecondaryOutlineButton}"
                                HeightRequest="40"
                                FontSize="13"
                                Padding="14,0"
                                Clicked="OnCancelClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Border>
</ContentView>

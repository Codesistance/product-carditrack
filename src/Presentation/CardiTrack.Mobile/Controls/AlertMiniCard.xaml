<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.AlertMiniCard">

    <!-- Figma 101:2902, departed from on purpose: the design's status pill is gone (this strip
         only ever carries unacknowledged alerts, so it read "New" on every card and said
         nothing), severity moves to a coloured left edge, and the alert's message is shown so a
         caregiver can decide whether to open it without opening it. The tile keeps its tint.
         Width is the dashboard's call, not the card's — full width when it is the only alert,
         most of the width in the carousel when it is not (see DashboardPage.ApplyAlerts). -->
    <!-- A row inside the Recent Alerts card, not a card of its own: filled and flat like the
         "Complete the picture" rows (NudgeMiniRow) — InputBackground, no stroke, no shadow.
         White with a shadow was right while these floated on the page background; inside a
         white card it is white on white, held apart only by a shadow the card's own clip cuts
         off at the edges.

         The severity edge is the Alerts List's (AlertListCard, Figma 101:6525): two stacked
         rounded rects, the severity colour underneath and the row inset 4 from its left edge,
         so the colour rounds into the corners rather than running down the side as a straight
         bar. The same rail on both lists, so an alert reads as the same object wherever it
         turns up. -->
    <Border x:Name="SeverityRail"
            StrokeThickness="0"
            Padding="4,0,0,0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12"/>
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped"/>
        </Border.GestureRecognizers>

        <Border BackgroundColor="{StaticResource InputBackground}"
                StrokeThickness="0"
                Padding="12,10,10,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <!-- Only the title sits beside the tile. The message and the timestamp run the full
                 width underneath it, from the tile's left edge: indenting them under the title
                 spent a tile's width of every line on nothing, and the message is the line that
                 needs the room. -->
            <Grid RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="11"
                  RowSpacing="4">

                <!-- 40 to sit level with a two-line title (two lines at 15 measure about 38);
                     the 56 this tile carried was sized for a title-and-timestamp stack that
                     no longer sits beside it. The glyph keeps its old proportion, 32 of 56. -->
                <Border x:Name="IconTileBorder"
                        Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource IconTile}"
                        Padding="8"
                        WidthRequest="40" HeightRequest="40"
                        VerticalOptions="Center">
                    <Image x:Name="TypeIcon"
                           WidthRequest="24" HeightRequest="24"/>
                </Border>

                <!-- Two lines rather than one: truncating "Long daytime rest" to one loses the
                     half that says which rest. -->
                <Label x:Name="TitleLabel"
                       Grid.Row="0" Grid.Column="1"
                       FontFamily="QuicksandSemiBold"
                       FontSize="15"
                       LineHeight="1.0"
                       TextColor="{StaticResource HeadingText}"
                       MaxLines="2"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center"/>

                <!-- The same glyph, size and ink as the "Complete the picture" rows' chevron,
                     so the two tappable rows on this screen say "opens" the same way. -->
                <Label Grid.Row="0" Grid.Column="2"
                       Text="›"
                       FontSize="20"
                       TextColor="{StaticResource MutedText}"
                       VerticalOptions="Center"/>

                <!-- Hidden when the alert carries no message, rather than holding an empty
                     line's height open. -->
                <Label x:Name="MessageLabel"
                       Grid.Row="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Body2}"
                       MaxLines="2"
                       LineBreakMode="TailTruncation"/>

                <!-- The least load-bearing line on the card, so the smallest and palest. -->
                <Label x:Name="TimeLabel"
                       Grid.Row="2" Grid.ColumnSpan="3"
                       Style="{StaticResource Caption}"/>
            </Grid>
        </Border>
    </Border>
</ContentView>

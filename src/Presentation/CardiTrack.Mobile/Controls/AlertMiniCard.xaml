<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.AlertMiniCard">

    <!-- Figma 101:2902, departed from on purpose: the design's status pill is gone (this strip
         only ever carries unacknowledged alerts, so it read "New" on every card and said
         nothing), severity moves to a coloured left edge, and the alert's message is shown so a
         caregiver can decide whether to open it without opening it. The tile keeps its tint.
         Width is the dashboard's call, not the card's — full width when it is the only alert,
         most of the width in the carousel when it is not (see DashboardPage.ApplyAlerts). -->
    <!-- Squarer and flatter than the shared ElevatedCard: 20 of radius and a 14-radius shadow
         are drawn for the full-width cards the style was written for, and on a carousel tile
         they eat the corners and pool underneath. 14 and a shadow half the spread at two thirds
         the opacity, sitting 2 down rather than 4, leave the strip reading as a row of cards
         rather than a row of pills. No padding on the Border itself: the severity edge has to
         run flush to the card's edge and be clipped by its corners, so the padding lives on
         the content beside it. Overridden here rather than in the style, which every
         full-width card on every page shares. -->
    <Border Style="{StaticResource ElevatedCard}" Padding="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="14"/>
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.1" Radius="7" Offset="0,2"/>
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped"/>
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="4,*">

            <!-- Severity, the way the "Complete the picture" rows mark priority, but run to the
                 card's edge rather than inset: here it is the card being coloured, not a line
                 of text being flagged. -->
            <BoxView x:Name="SeverityEdge" Grid.Column="0"/>

            <!-- Only the title sits beside the tile. The message and the timestamp run the full
                 width underneath it, from the tile's left edge: indenting them under the title
                 spent a tile's width of every line on nothing, and the message is the line that
                 needs the room. -->
            <Grid Grid.Column="1"
                  Padding="12,10,10,12"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="11"
                  RowSpacing="4">

                <!-- 40 to sit level with a two-line title (two lines at 15 measure about 38);
                     the 56 this tile carried was sized for a title-and-timestamp stack that
                     no longer sits beside it. The glyph keeps its old proportion, 32 of 56. -->
                <Border x:Name="IconTileBorder"
                        Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource IconTile}"
                        Padding="8"
                        WidthRequest="40" HeightRequest="40"
                        VerticalOptions="Center">
                    <Image x:Name="TypeIcon"
                           WidthRequest="24" HeightRequest="24"/>
                </Border>

                <!-- Two lines rather than one: truncating "Long daytime rest" to one loses the
                     half that says which rest. -->
                <Label x:Name="TitleLabel"
                       Grid.Row="0" Grid.Column="1"
                       FontFamily="QuicksandSemiBold"
                       FontSize="15"
                       LineHeight="1.0"
                       TextColor="{StaticResource HeadingText}"
                       MaxLines="2"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center"/>

                <!-- The same glyph, size and ink as the "Complete the picture" rows' chevron,
                     so the two tappable rows on this screen say "opens" the same way. -->
                <Label Grid.Row="0" Grid.Column="2"
                       Text="›"
                       FontSize="20"
                       TextColor="{StaticResource MutedText}"
                       VerticalOptions="Center"/>

                <!-- Hidden when the alert carries no message, rather than holding an empty
                     line's height open. -->
                <Label x:Name="MessageLabel"
                       Grid.Row="1" Grid.ColumnSpan="3"
                       Style="{StaticResource Body2}"
                       MaxLines="2"
                       LineBreakMode="TailTruncation"/>

                <!-- The least load-bearing line on the card, so the smallest and palest. -->
                <Label x:Name="TimeLabel"
                       Grid.Row="2" Grid.ColumnSpan="3"
                       Style="{StaticResource Caption}"/>
            </Grid>
        </Grid>
    </Border>
</ContentView>

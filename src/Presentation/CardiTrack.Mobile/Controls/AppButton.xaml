<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.AppButton"
             MinimumHeightRequest="48">

    <!-- The app's one button (AppButtonTone × AppButtonSize — see the code-behind). The shape is
         the Border, drawn at the size's own height inside a band never shorter than 48 (the mobile
         spec's touch-target floor), which is what takes the tap: a small button is easier to fit,
         never harder to hit. Radius 10 at every size, the unified control radius. The tap is on
         the control itself (see the code-behind), the element a screen reader focuses. -->
    <Grid x:Name="Root">
        <Border x:Name="Fill"
                VerticalOptions="Center"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <HorizontalStackLayout x:Name="Row"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                <Image x:Name="Glyph"
                       VerticalOptions="Center"
                       IsVisible="False"/>
                <!-- The caption, and under it an optional detail line (Detail) — a fact about
                     what the tap will do, such as an export's size, said on the button itself. -->
                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                    <Label x:Name="Caption"
                           FontFamily="QuicksandSemiBold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"/>
                    <Label x:Name="DetailCaption"
                           FontFamily="Quicksand"
                           Opacity="0.85"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="TailTruncation"
                           IsVisible="False"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentView>

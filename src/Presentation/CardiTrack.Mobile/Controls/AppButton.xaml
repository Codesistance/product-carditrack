<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CardiTrack.Mobile.Controls.AppButton"
             MinimumHeightRequest="44">

    <!-- The app's one button (AppButtonTone × AppButtonSize — see the code-behind). The shape is
         the Border, drawn at the size's own height inside a band never shorter than 44, which is
         what takes the tap: a small button is easier to fit, never harder to hit. Radius 10 at
         every size, the unified control radius. -->
    <Grid x:Name="Root">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped"/>
        </Grid.GestureRecognizers>
        <Border x:Name="Fill"
                VerticalOptions="Center"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <HorizontalStackLayout x:Name="Row"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                <Image x:Name="Glyph"
                       VerticalOptions="Center"
                       IsVisible="False"/>
                <Label x:Name="Caption"
                       FontFamily="QuicksandSemiBold"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation"/>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentView>

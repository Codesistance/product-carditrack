<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.DeviceManagementPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- The app-wide gradient band (Controls/HeaderBand). -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,16,20,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="#33FFFFFF"
                        VerticalOptions="Fill">
                    <!-- Fill + width-bound-to-height: the circle runs from the title's top to
                         the description's bottom and stays square at whatever that is, so every
                         header's icon matches its own text block exactly. The 40 floor keeps the
                         back button a real tap target; 99 clamps to a circle at any size. -->
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <ImageButton Source="icon_back_white.svg"
                                 WidthRequest="20" HeightRequest="20"
                                 BackgroundColor="Transparent"
                                 Clicked="OnBackClicked"/>
                </controls:SquareBorder>

                <!-- Title with what the page is tight beneath it — one stack, top-aligned
                     with the icon. The description is declared after the title, so screen
                     readers announce them in reading order. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Connected Devices"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label Text="The wearables their readings come from"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <!-- Icon-only, in the same white rounded square the other detail headers give
                     their single action (CardiMemberDetailPage's edit pencil) — the pill this
                     replaced was the one header action wearing a label. -->
                <Border Grid.Column="2"
                        WidthRequest="40" HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource White}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <ImageButton Source="icon_plus.svg"
                                 WidthRequest="20" HeightRequest="20"
                                 BackgroundColor="Transparent"
                                 SemanticProperties.Description="Add device"
                                 Clicked="OnAddDeviceClicked"/>
                </Border>
            </Grid>
        </controls:HeaderBand>

        <RefreshView x:Name="Refresher"
                     Grid.Row="1"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView>
                <Grid Padding="20,16,20,28">

                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                        <controls:SkeletonView HeightRequest="70"/>
                        <controls:SkeletonView HeightRequest="190"/>
                        <controls:SkeletonView HeightRequest="190"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ErrorPanel"
                                         Spacing="10"
                                         IsVisible="False"
                                         Padding="0,60,0,0">
                        <Label Text="We couldn't load these devices"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="ErrorDetailLabel"
                               Style="{StaticResource Body2}"
                               HorizontalTextAlignment="Center"/>
                        <Button Text="Try again"
                                Style="{StaticResource SecondaryOutlineButton}"
                                HorizontalOptions="Center"
                                Clicked="OnRetryClicked"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ContentPanel" Spacing="14" IsVisible="False">

                        <controls:OfflineStatusBanner x:Name="OfflineBanner"/>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Devices List" Style="{StaticResource Heading2}"/>
                            <Label x:Name="MemberSubtitleLabel" Style="{StaticResource Body2}"/>
                        </VerticalStackLayout>

                        <!-- Empty state -->
                        <VerticalStackLayout x:Name="EmptyPanel" Spacing="10" IsVisible="False" Padding="0,40,0,0">
                            <Label Text="No devices connected yet"
                                   Style="{StaticResource Heading3}"
                                   HorizontalTextAlignment="Center"/>
                            <Label x:Name="EmptyDetailLabel"
                                   Style="{StaticResource Body2}"
                                   HorizontalTextAlignment="Center"/>
                            <Button Text="Connect a device"
                                    Style="{StaticResource AuthGradientButton}"
                                    HorizontalOptions="Center"
                                    Clicked="OnAddDeviceClicked"/>
                        </VerticalStackLayout>

                        <!-- One card per connection, built in code-behind -->
                        <VerticalStackLayout x:Name="DevicesStack" Spacing="14"/>

                        <!-- Troubleshooting -->
                        <Border Style="{StaticResource ElevatedCard}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToggleHelpTapped"/>
                                    </Grid.GestureRecognizers>
                                    <!-- A notch under the section-title size: this is the header
                                         of one collapsible card, not a section of the page, and at
                                         18 it weighed the same as "Devices List" above it. -->
                                    <Label Text="Having trouble?"
                                           Style="{StaticResource DashboardSectionTitle}"
                                           FontSize="16"
                                           VerticalTextAlignment="Center"/>
                                    <Image x:Name="HelpChevron"
                                           Grid.Column="1"
                                           Source="icon_chevron_down.svg"
                                           WidthRequest="20" HeightRequest="20"
                                           VerticalOptions="Center"/>
                                </Grid>
                                <VerticalStackLayout x:Name="HelpPanel" Spacing="8" IsVisible="False">
                                    <Label Text="• Make sure the device has synced with its own app recently."
                                           Style="{StaticResource Body2}"/>
                                    <Label Text="• Try &quot;Refresh Connection&quot; — it renews the link without reconnecting."
                                           Style="{StaticResource Body2}"/>
                                    <Label Text="• Still stuck? Remove the device and connect it again."
                                           Style="{StaticResource Body2}"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <!-- M1-13/M1-14/M1-15 all show the bottom nav in Figma, and these pages sit on
             top of the Dashboard tab. Tapping Home here pops back down to it. -->
        <controls:BottomNavBar Grid.Row="2" Tab="Dashboard"/>

        <!-- Chat from anywhere; the code-behind feeds it this page's member. -->
        <controls:ChatBotLauncher x:Name="ChatBot" Grid.Row="1"/>
    </Grid>
</ContentPage>

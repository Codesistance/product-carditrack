<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.SignInPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageGround}">

    <ScrollView>
        <Grid RowDefinitions="Auto,*">

            <!-- ════════════════════════════════════════
                 GRADIENT HEADER
                 ════════════════════════════════════════ -->
            <controls:HeaderBand Grid.Row="0" ContentPadding="20,24,20,20" ShowWatermark="True">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Welcome Back"
                           Style="{StaticResource AuthHeaderTitle}" />
                    <Label Text="Sign in to keep watching over your family"
                           Style="{StaticResource AuthHeaderSubtitle}" />
                </VerticalStackLayout>
            </controls:HeaderBand>

            <!-- ════════════════════════════════════════
                 FORM (full-bleed)
                 ════════════════════════════════════════ -->
            <Grid Grid.Row="1"
                  Padding="20,20,20,36">
                <VerticalStackLayout Spacing="6">

                    <!-- Email Address -->
                    <Label Text="Email Address" Style="{StaticResource AuthFieldLabel}"/>
                    <Border x:Name="EmailBorder" Style="{StaticResource AuthEntryBorder}">
                        <Entry x:Name="EmailEntry"
                               Style="{StaticResource AuthEntry}"
                               Placeholder="Your email"
                               Keyboard="Email"
                               ReturnType="Next"
                               TextChanged="OnCredentialsChanged"
                               Focused="OnEntryFocused"
                               Unfocused="OnEntryUnfocused"/>
                    </Border>

                    <!-- Password -->
                    <Label Text="Password" Style="{StaticResource AuthFieldLabel}" Margin="0,8,0,2"/>
                    <Border x:Name="PasswordBorder" Style="{StaticResource AuthEntryBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry x:Name="PasswordEntry"
                                   Grid.Column="0"
                                   Style="{StaticResource AuthEntry}"
                                   Placeholder="Enter your password"
                                   IsPassword="True"
                                   ReturnType="Done"
                                   TextChanged="OnCredentialsChanged"
                                   Focused="OnEntryFocused"
                                   Unfocused="OnEntryUnfocused"/>
                            <ImageButton x:Name="PasswordToggle"
                                         Grid.Column="1"
                                         Source="icon_eye_off.svg"
                                         WidthRequest="24" HeightRequest="24"
                                         BackgroundColor="Transparent"
                                         VerticalOptions="Center"
                                         Margin="0,0,4,0"
                                         Clicked="OnPasswordToggleClicked"/>
                        </Grid>
                    </Border>

                    <!-- Remember me + Forgot password row -->
                    <Grid ColumnDefinitions="Auto,Auto,*"
                          Margin="0,8,0,0">
                        <CheckBox Grid.Column="0"
                                  x:Name="RememberCheck"
                                  Color="{StaticResource Primary}"
                                  WidthRequest="20" HeightRequest="20"
                                  VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="Remember me"
                               Style="{StaticResource Body2Medium}"
                               TextColor="{StaticResource BodyText}"
                               VerticalTextAlignment="Center"
                               Margin="4,0,0,0"/>
                        <Label Grid.Column="2"
                               Text="Forgot password"
                               Style="{StaticResource PrimaryLink}"
                               HorizontalOptions="End"
                               VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnForgotPasswordTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Inline sign-in error -->
                    <Label x:Name="SignInError"
                           Style="{StaticResource AuthErrorLabel}"
                           IsVisible="False"
                           Margin="0,8,0,0"/>

                    <!-- Sign in button -->
                    <Button x:Name="SignInBtn"
                            Text="Sign in"
                            Style="{StaticResource AuthGradientButton}"
                            HorizontalOptions="Fill"
                            Margin="0,20,0,0"
                            Clicked="OnSignInClicked"/>

                    <!-- Divider -->
                    <Grid ColumnDefinitions="*,Auto,*"
                          Margin="0,12,0,12">
                        <BoxView Grid.Column="0" Style="{StaticResource DividerLine}"/>
                        <Label Grid.Column="1"
                               Text="Or continue with"
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource MutedText}"
                               Margin="16,0"/>
                        <BoxView Grid.Column="2" Style="{StaticResource DividerLine}"/>
                    </Grid>

                    <!-- Social login buttons -->
                    <Grid ColumnDefinitions="*,12,*">
                        <Border Grid.Column="0" x:Name="GoogleBtn" Style="{StaticResource GoogleButton}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGoogleTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Spacing="8">
                                <Image Source="google_icon.svg"
                                       WidthRequest="22" HeightRequest="22"
                                       VerticalOptions="Center"/>
                                <Label Text="Google" FontFamily="Quicksand" FontAttributes="Bold"
                                       FontSize="18" TextColor="{StaticResource Primary}"
                                       VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <Border Grid.Column="2" x:Name="AppleBtn" Style="{StaticResource AppleButton}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAppleTapped"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Spacing="8">
                                <Image Source="apple_icon.svg"
                                       WidthRequest="22" HeightRequest="22"
                                       VerticalOptions="Center"/>
                                <Label Text="Apple" FontFamily="Quicksand" FontAttributes="Bold"
                                       FontSize="18" TextColor="{StaticResource White}"
                                       VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Sign-up link -->
                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Margin="0,24,0,0"
                                           Spacing="2">
                        <Label Text="Don't have an account"
                               Style="{StaticResource Body2}"
                               VerticalTextAlignment="Center"/>
                        <Label Text="Sign Up"
                               Style="{StaticResource PrimaryLink}"
                               VerticalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSignUpTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
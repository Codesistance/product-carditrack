<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.JournalTimingPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- When each CardiJournal book is written, in the member's own local time. Rows save the
         moment they are picked, the way the alert-rule toggles do — a Save button would imply
         the choice could be half-made, and there is nothing here to lose by committing at once.

         The Weekbook and Monthbook rows are settable before their generators exist (R2). They
         say so on the row rather than being hidden: a caregiver who sets a time and is told
         nothing has been misled, and one who cannot find the setting at all will ask for it
         twice. The API returns the availability flags this reads, so the app never has to guess.

         No Figma frame — see the design-sync backlog. -->

    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None, Container, None, None">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                <controls:SquareBorder Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label x:Name="HeaderTitle"
                           Text="Journal Settings"
                           Style="{StaticResource Heading3}"
                           TextColor="{StaticResource White}"/>
                    <Label x:Name="HeaderSubtitle"
                           Text="Their CardiJournal"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="12">

                <ActivityIndicator x:Name="LoadingSpinner"
                                   IsRunning="True"
                                   IsVisible="True"
                                   HorizontalOptions="Center"
                                   Margin="0,24"/>

                <VerticalStackLayout x:Name="SettingsPanel" IsVisible="False" Spacing="14">

                    <!-- The same shape as Member Details' Alert Rules card: a section card that
                         says what the group is for, and inside it an outlined card of rows parted
                         by hairlines, each row a title, one line of what it does, and its value on
                         the right in the accent ink — the same seat a switch takes over there, so
                         a value reads as the control it is. -->
                    <Border Style="{StaticResource ElevatedCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Timing" Style="{StaticResource DashboardSectionTitle}"/>
                            <Label x:Name="FootnoteLabel" Style="{StaticResource Body2}"/>
                            <Border Style="{StaticResource OutlinedCard}" Padding="14,4">
                                <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                  SemanticProperties.Description="Daybook time"
                                  SemanticProperties.Hint="Choose what time each finished day is written up">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDaybookTimeTapped"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Daybook" Style="{StaticResource Body1SemiBoldDark}"/>
                                    <Label x:Name="DaybookSubtitle" Style="{StaticResource Body2}"/>
                                </VerticalStackLayout>
                                <Label x:Name="DaybookValue"
                                       Grid.Column="1"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       TextColor="{StaticResource Primary}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView Style="{StaticResource DividerLine}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                  SemanticProperties.Description="Weekbook time"
                                  SemanticProperties.Hint="Choose what time each finished week is written up">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWeekbookTimeTapped"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Weekbook" Style="{StaticResource Body1SemiBoldDark}"/>
                                    <Label x:Name="WeekbookSubtitle" Style="{StaticResource Body2}"/>
                                </VerticalStackLayout>
                                <Label x:Name="WeekbookValue"
                                       Grid.Column="1"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       TextColor="{StaticResource Primary}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView Style="{StaticResource DividerLine}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                  SemanticProperties.Description="Week starts on"
                                  SemanticProperties.Hint="Choose which day a journal week begins">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWeekStartTapped"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Week starts on" Style="{StaticResource Body1SemiBoldDark}"/>
                                    <Label x:Name="WeekStartSubtitle" Style="{StaticResource Body2}"/>
                                </VerticalStackLayout>
                                <Label x:Name="WeekStartValue"
                                       Grid.Column="1"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       TextColor="{StaticResource Primary}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView Style="{StaticResource DividerLine}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                  SemanticProperties.Description="Monthbook time"
                                  SemanticProperties.Hint="Choose what time each finished month is written up">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMonthbookTimeTapped"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Monthbook" Style="{StaticResource Body1SemiBoldDark}"/>
                                    <Label x:Name="MonthbookSubtitle" Style="{StaticResource Body2}"/>
                                </VerticalStackLayout>
                                <Label x:Name="MonthbookValue"
                                       Grid.Column="1"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       TextColor="{StaticResource Primary}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- The second question this screen answers, and a different one from the
                         timings above: not when a book is written, but how far a reading has to
                         sit from this member's own usual before the book names a direction for it.
                         Called "What counts as a change" rather than triggers or rules: those
                         words already belong to the alert catalogue, and nothing here fires
                         anything. -->
                    <!-- The same shape as Member Details' Alert Rules card: a section card that
                         says what the group is for, and inside it an outlined card of rows parted
                         by hairlines, each row a title, one line of what it does, and its value on
                         the right in the accent ink — the same seat a switch takes over there, so
                         a value reads as the control it is. -->
                    <Border Style="{StaticResource ElevatedCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="What counts as a change" Style="{StaticResource DashboardSectionTitle}"/>
                            <Label x:Name="ComparisonFootnoteLabel" Style="{StaticResource Body2}"/>
                            <Border Style="{StaticResource OutlinedCard}" Padding="14,4">
                                <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                  SemanticProperties.Description="Bedtime change"
                                  SemanticProperties.Hint="Choose how far their bedtime has to move before a book calls it earlier or later">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBedtimeToleranceTapped"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Bedtime" Style="{StaticResource Body1SemiBoldDark}"/>
                                    <Label x:Name="BedtimeToleranceSubtitle" Style="{StaticResource Body2}"/>
                                </VerticalStackLayout>
                                <Label x:Name="BedtimeToleranceValue"
                                       Grid.Column="1"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       TextColor="{StaticResource Primary}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView Style="{StaticResource DividerLine}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                  SemanticProperties.Description="Wake time change"
                                  SemanticProperties.Hint="Choose how far their waking time has to move before a book calls it earlier or later">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWakeToleranceTapped"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Waking time" Style="{StaticResource Body1SemiBoldDark}"/>
                                    <Label x:Name="WakeToleranceSubtitle" Style="{StaticResource Body2}"/>
                                </VerticalStackLayout>
                                <Label x:Name="WakeToleranceValue"
                                       Grid.Column="1"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       TextColor="{StaticResource Primary}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView Style="{StaticResource DividerLine}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                  SemanticProperties.Description="Far off their usual"
                                  SemanticProperties.Hint="Choose how far apart two times have to be before a book stops saying earlier or later">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDirectionBoundTapped"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Far off their usual" Style="{StaticResource Body1SemiBoldDark}"/>
                                    <Label x:Name="DirectionBoundSubtitle" Style="{StaticResource Body2}"/>
                                </VerticalStackLayout>
                                <Label x:Name="DirectionBoundValue"
                                       Grid.Column="1"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       TextColor="{StaticResource Primary}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView Style="{StaticResource DividerLine}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,8" MinimumHeightRequest="48"
                                  SemanticProperties.Description="Small differences"
                                  SemanticProperties.Hint="Choose how close to their usual a reading has to be before a book calls it level">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLevelToleranceTapped"/>
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Small differences" Style="{StaticResource Body1SemiBoldDark}"/>
                                    <Label x:Name="LevelToleranceSubtitle" Style="{StaticResource Body2}"/>
                                </VerticalStackLayout>
                                <Label x:Name="LevelToleranceValue"
                                       Grid.Column="1"
                                       Style="{StaticResource Body1SemiBoldDark}"
                                       TextColor="{StaticResource Primary}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="WordWrap"
                                       MaximumWidthRequest="150"/>
                            </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="12">
                    <Border Style="{StaticResource ElevatedCard}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Couldn't load these settings"
                                   Style="{StaticResource Body1SemiBoldDark}"/>
                            <Label x:Name="ErrorDetailLabel" Style="{StaticResource Body2}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

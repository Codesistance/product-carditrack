<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.VerifyEmailPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageGround}">

    <Grid RowDefinitions="Auto,*">

        <!-- ════════════════════════════════════════
             GRADIENT HEADER
             ════════════════════════════════════════ -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,48,20,32">
            <VerticalStackLayout Spacing="4">
                <Label Text="Verify your email"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}" />
                <Label Text="Open the link we sent, then come back"
                       Style="{StaticResource Body1SemiBold}" />
            </VerticalStackLayout>
        </controls:HeaderBand>

        <!-- ════════════════════════════════════════
             VERIFY FLOW (full-bleed)
             ════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              Padding="20,0,20,36">
            <ScrollView>
            <Grid Padding="0,32,0,0">

                <VerticalStackLayout Spacing="0" VerticalOptions="Start">

                    <Label Text="We sent a verification link to"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource HeadingText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,6"/>

                    <Label x:Name="EmailLabel"
                           FontFamily="QuicksandSemiBold"
                           FontSize="16"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="MiddleTruncation"
                           Margin="0,0,0,12"/>

                    <Label Text="Can't find it? Check spam or junk."
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource BodyText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,20"/>

                    <Label x:Name="VerifyError"
                           Style="{StaticResource AuthErrorLabel}"
                           IsVisible="False"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,12"/>

                    <ActivityIndicator x:Name="CheckingIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="{StaticResource Primary}"
                                       HeightRequest="28"
                                       WidthRequest="28"
                                       HorizontalOptions="Center"
                                       Margin="0,0,0,12"/>

                    <Button x:Name="ContinueBtn"
                            Text="I've verified — continue"
                            Style="{StaticResource AuthGradientButton}"
                            HorizontalOptions="Fill"
                            SemanticProperties.Hint="Checks whether your email is verified, then continues"
                            Clicked="OnContinueClicked"/>

                    <Button x:Name="OpenMailBtn"
                            Text="Open mail app"
                            Style="{StaticResource SecondaryOutlineButton}"
                            HorizontalOptions="Fill"
                            Margin="0,12,0,0"
                            SemanticProperties.Hint="Opens your email app to find the verification link"
                            Clicked="OnOpenMailClicked"/>

                    <Label Text="Didn't receive the email?"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource HeadingText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,28,0,4"/>

                    <Label x:Name="ResendStatus"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource BodyText}"
                           HorizontalTextAlignment="Center"
                           IsVisible="False"
                           Margin="0,0,0,4"/>

                    <Button x:Name="ResendBtn"
                            Text="Resend verification email"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontFamily="QuicksandSemiBold"
                            FontSize="16"
                            HeightRequest="44"
                            Padding="12,8"
                            BorderWidth="0"
                            HorizontalOptions="Center"
                            SemanticProperties.Hint="Sends another verification email"
                            Clicked="OnResendClicked"/>

                    <Button x:Name="BackBtn"
                            Text="Wrong email? Go back"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontFamily="QuicksandSemiBold"
                            FontSize="16"
                            HeightRequest="44"
                            Padding="12,8"
                            BorderWidth="0"
                            HorizontalOptions="Center"
                            Margin="0,12,0,0"
                            SemanticProperties.Hint="Returns to sign in so you can use a different email"
                            Clicked="OnBackToSignInClicked"/>

                </VerticalStackLayout>

            </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>

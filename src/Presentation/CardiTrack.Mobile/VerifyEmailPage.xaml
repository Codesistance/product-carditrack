<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.VerifyEmailPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageGround}">

    <Grid RowDefinitions="Auto,*">

        <!-- ════════════════════════════════════════
             GRADIENT HEADER
             ════════════════════════════════════════ -->
        <!-- Same band as the other three signed-out screens (Sign In, Create Account, Forgot
             Password): their inset, their title and subtitle styles, their watermark. This
             one had a 48/32 inset around an 18pt title — the tallest band in the app for two
             lines of text, and the odd one out in the flow it sits in.

             It now carries Create Account's step chrome, because it is the same step: the
             account exists but cannot be used until the link is opened. Without it the
             progress bar vanished for one screen and returned at step 2, which read as
             having dropped out of the flow. The subtitle slot holds the step, exactly as on
             Create Account, so the "open the link" instruction moved into the body. -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,24,20,20" ShowWatermark="True">
            <VerticalStackLayout Spacing="4">
                <Label Text="Verify your email"
                       Style="{StaticResource AuthHeaderTitle}" />
                <Label Text="Step 1 of 4"
                       Style="{StaticResource AuthHeaderSubtitle}" />
                <controls:StepProgressBar Progress="0.25" Margin="0,12,0,0"/>
            </VerticalStackLayout>
        </controls:HeaderBand>

        <!-- ════════════════════════════════════════
             VERIFY FLOW (full-bleed)
             ════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              Padding="20,0,20,36">
            <ScrollView>
            <Grid Padding="0,40,0,0">

                <VerticalStackLayout Spacing="0" VerticalOptions="Start">

                    <!-- Opens the way Forgot Password's "Check your email" state opens — the
                         screen this one does the same job as. It had no heading at all, so
                         the body began mid-sentence in Body2 and the page read as though its
                         title had failed to render. -->
                    <Label Text="Check your email"
                           Style="{StaticResource Heading2}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,8"/>

                    <Label Text="We sent a verification link to"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource HeadingText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,6"/>

                    <Label x:Name="EmailLabel"
                           FontFamily="QuicksandSemiBold"
                           FontSize="16"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="MiddleTruncation"
                           Margin="0,0,0,12"/>

                    <Label Text="Can't find it? Check spam or junk."
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource BodyText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,20"/>

                    <Label x:Name="VerifyError"
                           Style="{StaticResource AuthErrorLabel}"
                           IsVisible="False"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,12"/>

                    <ActivityIndicator x:Name="CheckingIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="{StaticResource Primary}"
                                       HeightRequest="28"
                                       WidthRequest="28"
                                       HorizontalOptions="Center"
                                       Margin="0,0,0,12"/>

                    <controls:AppButton x:Name="ContinueBtn"
                                        Text="I've verified — continue"
                                        HorizontalOptions="Fill"
                                        SemanticProperties.Hint="Checks whether your email is verified, then continues"
                                        Clicked="OnContinueClicked"
                                        Tone="Primary"
                                        Size="L"/>

                    <controls:AppButton x:Name="OpenMailBtn"
                                        Text="Open mail app"
                                        HorizontalOptions="Fill"
                                        Margin="0,12,0,0"
                                        SemanticProperties.Hint="Opens your email app to find the verification link"
                                        Clicked="OnOpenMailClicked"
                                        Tone="Secondary"
                                        Size="L"/>

                    <Label Text="Didn't receive the email?"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource HeadingText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,28,0,4"/>

                    <Label x:Name="ResendStatus"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource BodyText}"
                           HorizontalTextAlignment="Center"
                           IsVisible="False"
                           Margin="0,0,0,4"/>

                    <controls:AppButton x:Name="ResendBtn"
                            Text="Resend verification email"
                            Tone="Text"
                            Size="M"
                            HorizontalOptions="Center"
                            SemanticProperties.Hint="Sends another verification email"
                            Clicked="OnResendClicked"/>

                    <controls:AppButton x:Name="BackBtn"
                            Text="Wrong email? Go back"
                            Tone="Text"
                            Size="M"
                            HorizontalOptions="Center"
                            Margin="0,12,0,0"
                            SemanticProperties.Hint="Returns to sign in so you can use a different email"
                            Clicked="OnBackToSignInClicked"/>

                </VerticalStackLayout>

            </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>

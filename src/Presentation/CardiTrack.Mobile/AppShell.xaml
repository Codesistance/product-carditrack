<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CardiTrack.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CardiTrack.Mobile"
    Title="CardiTrack">

    <!-- The platform tab bar is hidden: it can't swap an icon on selection or carry the design's
         upward shadow, so Controls/BottomNavBar draws the Figma bar (101:2949) instead. Each tab
         page sets Shell.TabBarIsVisible="False" itself, the same way the onboarding pages do.
         The TabBar below still owns routing — every bar tap is a "//route" Shell navigation, so
         the Icon values here are no longer rendered. -->
    <TabBar>
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate local:DashboardPage}"
            Route="dashboard" />
        <ShellContent
            Title="Alerts"
            ContentTemplate="{DataTemplate local:AlertsPage}"
            Route="alerts" />
        <ShellContent
            Title="Summaries"
            ContentTemplate="{DataTemplate local:SummariesPage}"
            Route="summaries" />
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>

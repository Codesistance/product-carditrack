<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.ForgotPasswordPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageGround}">

    <Grid RowDefinitions="Auto,*">

        <!-- ════════════════════════════════════════
             GRADIENT HEADER
             ════════════════════════════════════════ -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,48,20,32">
            <Label Text="Forgot Password?"
                   Style="{StaticResource Heading1White}" />
        </controls:HeaderBand>

        <!-- ════════════════════════════════════════
             RESET FLOW (full-bleed)
             ════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              Padding="20,0,20,36">
            <ScrollView>
            <Grid Padding="0,40,0,0">

                <!-- ── State A: request a reset link ── -->
                <VerticalStackLayout x:Name="RequestPanel" Spacing="0" VerticalOptions="Start">

                    <Label Text="Reset your password"
                           Style="{StaticResource Heading2}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,8"/>

                    <Label Text="Enter your account email and we'll send you a reset link"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource HeadingText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,24"/>

                    <Label Text="Email Address" Style="{StaticResource AuthFieldLabel}"/>
                    <Border x:Name="EmailBorder" Style="{StaticResource AuthEntryBorder}" Margin="0,6,0,0">
                        <Entry x:Name="EmailEntry"
                               Style="{StaticResource AuthEntry}"
                               Placeholder="Your email"
                               Keyboard="Email"
                               ReturnType="Done"
                               TextChanged="OnEmailChanged"
                               Focused="OnEntryFocused"
                               Unfocused="OnEntryUnfocused"/>
                    </Border>

                    <Label x:Name="ResetError"
                           Style="{StaticResource AuthErrorLabel}"
                           IsVisible="False"
                           Margin="0,8,0,0"/>

                    <Button x:Name="SendBtn"
                            Text="Send reset link"
                            Style="{StaticResource AuthGradientButton}"
                            HorizontalOptions="Fill"
                            Margin="0,28,0,0"
                            Clicked="OnSendClicked"/>

                    <Label Text="Back to sign in"
                           FontFamily="QuicksandSemiBold"
                           FontSize="16"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"
                           Margin="0,24,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackToSignInTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>

                <!-- ── State B: confirmation ── -->
                <VerticalStackLayout x:Name="ConfirmationPanel"
                                     IsVisible="False"
                                     Spacing="0"
                                     VerticalOptions="Start">

                    <Label Text="Check your email"
                           Style="{StaticResource Heading2}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,8"/>

                    <Label x:Name="ConfirmationDetail"
                           Text="We sent a password reset link to your email"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource HeadingText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,24"/>

                    <Label Text="Didn't receive the email?"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource HeadingText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,20,0,4"/>

                    <Label x:Name="ResendLink"
                           Text="Resend link"
                           FontFamily="QuicksandSemiBold"
                           FontSize="16"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnResendTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Back to sign in"
                           FontFamily="QuicksandSemiBold"
                           FontSize="16"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"
                           Margin="0,28,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackToSignInTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>

            </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>

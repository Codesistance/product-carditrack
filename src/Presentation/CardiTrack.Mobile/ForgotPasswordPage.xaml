<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.ForgotPasswordPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource PageGround}">

    <Grid RowDefinitions="Auto,*">

        <!-- ════════════════════════════════════════
             GRADIENT HEADER
             ════════════════════════════════════════ -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,24,20,20" ShowWatermark="True">
            <VerticalStackLayout Spacing="4">
                <Label Text="Forgot Password?"
                       Style="{StaticResource AuthHeaderTitle}" />
                <Label Text="We'll email you a link to get back in"
                       Style="{StaticResource AuthHeaderSubtitle}" />
            </VerticalStackLayout>
        </controls:HeaderBand>

        <!-- ════════════════════════════════════════
             RESET FLOW (full-bleed)
             ════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              Padding="20,0,20,36">
            <ScrollView>
            <Grid Padding="0,40,0,0">

                <!-- ── State A: request a reset link ── -->
                <VerticalStackLayout x:Name="RequestPanel" Spacing="0" VerticalOptions="Start">

                    <Label Text="Reset your password"
                           Style="{StaticResource Heading2}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,8"/>

                    <Label Text="Enter your account email and we'll send you a reset link"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource HeadingText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,24"/>

                    <Label Text="Email Address" Style="{StaticResource AuthFieldLabel}"/>
                    <Border x:Name="EmailBorder" Style="{StaticResource AuthEntryBorder}" Margin="0,6,0,0">
                        <Entry x:Name="EmailEntry"
                               Style="{StaticResource AuthEntry}"
                               Placeholder="Your email"
                               Keyboard="Email"
                               ReturnType="Done"
                               controls:FieldAutofill.Enabled="True"
                               TextChanged="OnEmailChanged"
                               Focused="OnEntryFocused"
                               Unfocused="OnEntryUnfocused"/>
                    </Border>

                    <Label x:Name="ResetError"
                           Style="{StaticResource AuthErrorLabel}"
                           IsVisible="False"
                           Margin="0,8,0,0"/>

                    <controls:AppButton x:Name="SendBtn"
                                        Text="Send reset link"
                                        HorizontalOptions="Fill"
                                        Margin="0,28,0,0"
                                        Clicked="OnSendClicked"
                                        Tone="Primary"
                                        Size="L"/>

                    <!-- The quiet ways back are the shared Text L; its 48 band carries most of
                         each gap, hence the smaller margins. -->
                    <controls:AppButton Text="Back to sign in"
                                        HorizontalOptions="Center"
                                        Margin="0,10,0,0"
                                        Clicked="OnBackToSignInTapped"
                                        Tone="Text"
                                        Size="L"/>

                </VerticalStackLayout>

                <!-- ── State B: confirmation ── -->
                <VerticalStackLayout x:Name="ConfirmationPanel"
                                     IsVisible="False"
                                     Spacing="0"
                                     VerticalOptions="Start">

                    <Label Text="Check your email"
                           Style="{StaticResource Heading2}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,8"/>

                    <Label x:Name="ConfirmationDetail"
                           Text="We sent a password reset link to your email"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource HeadingText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,24"/>

                    <Label Text="Didn't receive the email?"
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource HeadingText}"
                           HorizontalTextAlignment="Center"
                           Margin="0,20,0,4"/>

                    <controls:AppButton x:Name="ResendLink"
                                        Text="Resend link"
                                        HorizontalOptions="Center"
                                        Clicked="OnResendTapped"
                                        Tone="Text"
                                        Size="L"/>

                    <controls:AppButton Text="Back to sign in"
                                        HorizontalOptions="Center"
                                        Margin="0,4,0,0"
                                        Clicked="OnBackToSignInTapped"
                                        Tone="Text"
                                        Size="L"/>

                </VerticalStackLayout>

            </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>

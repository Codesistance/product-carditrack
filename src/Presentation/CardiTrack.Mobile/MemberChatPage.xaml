<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             xmlns:mobile="clr-namespace:CardiTrack.Mobile"
             x:Class="CardiTrack.Mobile.MemberChatPage"
             x:DataType="mobile:MemberChatPage">

    <!-- A caregiver's persisted, multi-turn conversation about one CardiMember's readings.
         No Figma frame — as-built, see the design-sync backlog in
         .claude/skills/product-manager/references/figma.md.

         Presented as a sheet over a dimmed scrim — same pattern as Controls/AppPopupPage
         (transparent ContentPage + a semi-opaque Grid), so the screen underneath (Dashboard or
         Member Detail) stays visible and out of focus rather than being fully replaced. The
         Border below is the sheet: rounded top corners, a top margin that leaves the scrim
         visible above it, and its own tap recognizer to swallow taps so they don't fall through
         to the scrim's dismiss handler. -->

    <ContentView.Resources>
        <!-- The sheet's quiet actions — "Start a new conversation", "Back to conversation",
             the selection controls — share one tonal-pill language: unmistakably controls,
             with real 44dp targets, but tinted rather than elevated so none of them ever
             competes with Send. -->
        <Style x:Key="ActionPill" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource SelectedOptionBackground}"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="StrokeShape">
                <RoundRectangle CornerRadius="99"/>
            </Setter>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinimumHeightRequest" Value="44"/>
        </Style>
        <!-- The Link role, centred in its pill. -->
        <Style x:Key="ActionPillText" TargetType="Label" BasedOn="{StaticResource Link}">
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
    </ContentView.Resources>

    <Grid x:Name="Scrim" BackgroundColor="{StaticResource ScrimOverlay}">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped"/>
        </Grid.GestureRecognizers>

    <Border BackgroundColor="{StaticResource PageGround}"
            Margin="14,60,14,24"
            StrokeThickness="0"
            VerticalOptions="Fill" HorizontalOptions="Fill">
        <Border.Shadow>
            <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.3" Radius="20" Offset="0,6"/>
        </Border.Shadow>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="24"/>
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer/>
        </Border.GestureRecognizers>

    <Grid RowDefinitions="Auto,*">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <controls:SquareBorder Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <!-- Down, not back: this page is always presented modally (see
                         MemberChatLauncher), so the affordance is dismiss, not navigate-back.
                         Same line-icon weight as icon_back_white.svg. Not the chips' caret
                         (icon_caret_down_white.svg), which is a stroked chevron too now but is
                         drawn 18x9 for a 14x7 box, so it arrives squashed at this size. -->
                    <Image Source="icon_chevron_down_white.svg" WidthRequest="20" HeightRequest="20"
                           SemanticProperties.Description="Close"/>
                </controls:SquareBorder>

                <!-- Who this conversation is about, on the subtitle line: "About", their photo
                     at 16, and their name in full white semibold where the rest of the line is
                     faded — so it stands out without changing the header. It is the same line,
                     at the same height, as the plain subtitle the other states show (choosing
                     someone, browsing past conversations), so the band never grows or jumps when
                     the caregiver switches member. With more than one member it is also the way
                     to change that: a tap puts the "who" question back in the conversation area,
                     and the chevron after the name says so. -->
                <VerticalStackLayout x:Name="TitleBlock" Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSubtitleTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="Chat"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <!-- The label is in a Grid, not a HorizontalStackLayout: a stack measures its
                         children with unbounded width, so the subtitle never truncated and its
                         overflow squeezed the header's round buttons out of shape. The pill's
                         name is capped for the same reason. -->
                    <Grid HorizontalOptions="Start">
                        <Label x:Name="SubtitleLabel"
                               Text="What would you like to know?"
                               FontFamily="Quicksand"
                               FontSize="12"
                               TextColor="{StaticResource White}"
                               Opacity="0.85"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center"/>
                        <HorizontalStackLayout x:Name="MemberPill"
                                               IsVisible="False"
                                               Spacing="5"
                                               VerticalOptions="Center">
                            <Label Text="About"
                                   FontFamily="Quicksand"
                                   FontSize="12"
                                   TextColor="{StaticResource White}"
                                   Opacity="0.85"
                                   VerticalOptions="Center"/>
                            <controls:MemberAvatar x:Name="PillAvatar"
                                                   BoxWidth="16"
                                                   VerticalOptions="Center"/>
                            <Label x:Name="PillName"
                                   FontFamily="QuicksandSemiBold"
                                   FontSize="12"
                                   TextColor="{StaticResource White}"
                                   LineBreakMode="TailTruncation"
                                   MaximumWidthRequest="160"
                                   VerticalOptions="Center"/>
                            <Image x:Name="SwitchChevron"
                                   Source="icon_chevron_down_white.svg"
                                   WidthRequest="12" HeightRequest="12"
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- Past conversations. A toggle as much as a door: from the thread it opens the
                     history list, from the list it returns to the thread, and from a reopened old
                     conversation it steps back out to the list. -->
                <controls:SquareBorder x:Name="HistoryButton"
                        Grid.Column="2"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_history_white.svg" WidthRequest="20" HeightRequest="20"
                           SemanticProperties.Description="Past conversations"/>
                </controls:SquareBorder>
            </Grid>
        </controls:HeaderBand>

        <!-- Rows: conversation, pending reply, suggestion chips, input bar, new-conversation
             action. -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto,Auto,Auto">

            <VerticalStackLayout x:Name="SkeletonPanel" Grid.Row="0" Grid.RowSpan="5"
                                  Spacing="14" Padding="20,20" IsVisible="False">
                <controls:SkeletonView HeightRequest="60"/>
                <controls:SkeletonView HeightRequest="60"/>
                <controls:SkeletonView HeightRequest="60"/>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ErrorPanel" Grid.Row="0" Grid.RowSpan="5"
                                  Spacing="12" Padding="20,60,20,20" IsVisible="False">
                <Label Text="We couldn't load this"
                       Style="{StaticResource Heading3}"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="ErrorDetailLabel"
                       Style="{StaticResource Body2}"
                       TextColor="{StaticResource BodyText}"
                       HorizontalTextAlignment="Center"/>
                <controls:AppButton Text="Try again"
                                    HorizontalOptions="Center"
                                    Clicked="OnRetryClicked"
                                    Tone="Secondary"
                                    Size="L"/>
            </VerticalStackLayout>

            <!-- "Who do you want to chat about?" — asked by the bot, in the conversation area,
                 when the sheet opens with several members and none chosen, and again when the
                 caregiver taps the subtitle to switch. One row per member, as the dashboard shows
                 them: their avatar, their name, and the line their card carries today (see
                 ChatMemberChoice). The input bar stays, locked, until someone is picked. -->
            <ScrollView x:Name="ChooserPanel" Grid.Row="0" IsVisible="False">
                <VerticalStackLayout Padding="16,18,16,12" Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <controls:SquareBorder WidthRequest="40" HeightRequest="40"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource White}"
                                VerticalOptions="Start">
                            <controls:SquareBorder.StrokeShape>
                                <RoundRectangle CornerRadius="99"/>
                            </controls:SquareBorder.StrokeShape>
                            <Image Source="icon_chatbot.svg" WidthRequest="26" HeightRequest="26"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </controls:SquareBorder>
                        <Border Grid.Column="1"
                                BackgroundColor="{StaticResource White}"
                                StrokeThickness="0"
                                Padding="14,10"
                                HorizontalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4,20,20,20"/>
                            </Border.StrokeShape>
                            <Label x:Name="ChooserQuestion"
                                   Text="Who do you want to chat about?"
                                   Style="{StaticResource Body2}"
                                   TextColor="{StaticResource HeadingText}"/>
                        </Border>
                    </Grid>
                    <VerticalStackLayout x:Name="ChoiceList" Spacing="10"/>
                </VerticalStackLayout>
            </ScrollView>

            <RefreshView x:Name="Refresher" Grid.Row="0" Refreshing="OnPullToRefresh" IsVisible="False">
                <CollectionView x:Name="TurnsList"
                                Margin="0,0,0,0"
                                SelectionMode="None"
                                ItemsUpdatingScrollMode="KeepLastItemInView">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <BoxView HeightRequest="16" Color="Transparent"/>
                    </CollectionView.Header>

                    <!-- EmptyView carries the copy only. The suggestion chips live in their own
                         row below (SuggestionsPanel) rather than in here: they have to survive
                         the first send long enough to be tappable while a reply is in flight,
                         and an EmptyView is torn down the instant the first turn lands. -->
                    <!-- The greeting a new conversation opens on: the bot springs in, then stays
                         alive while the conversation is empty — floating over a soft shadow, a
                         heartbeat sweeping its screen, its antenna pulsing (PlayGreeting) — says
                         hello by name, and offers one thing it can do, a different one each
                         conversation (ChatFunFacts). The bot is layered for that: the body is
                         icon_chatbot.svg without its antenna tip and trace, which are drawn on top
                         at the same places (72 of 240, so every figure below is the SVG's × 0.3). -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20,44,20,20" Spacing="12">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="2" HorizontalOptions="Center">
                                <Grid x:Name="GreetingBot"
                                      WidthRequest="72" HeightRequest="72"
                                      Opacity="0"
                                      Scale="0.4"
                                      AnchorY="1">
                                    <Image Source="icon_chatbot_body.svg"
                                           WidthRequest="72" HeightRequest="72"/>
                                    <Ellipse x:Name="AntennaHalo"
                                             Fill="#36C09B"
                                             WidthRequest="4.8" HeightRequest="4.8"
                                             HorizontalOptions="Start" VerticalOptions="Start"
                                             Margin="33.6,7.2,0,0"
                                             Opacity="0"/>
                                    <Ellipse Fill="#36C09B"
                                             WidthRequest="4.8" HeightRequest="4.8"
                                             HorizontalOptions="Start" VerticalOptions="Start"
                                             Margin="33.6,7.2,0,0"/>
                                    <controls:EcgTraceView x:Name="GreetingTrace"
                                                           WidthRequest="34.8" HeightRequest="21.6"
                                                           HorizontalOptions="Start" VerticalOptions="Start"
                                                           Margin="18.6,28.2,0,0"/>
                                </Grid>
                                <Ellipse x:Name="GreetingShadow"
                                         Grid.Row="1"
                                         Fill="#174E86"
                                         Opacity="0"
                                         WidthRequest="44" HeightRequest="6"
                                         HorizontalOptions="Center"/>
                            </Grid>
                            <Label x:Name="GreetingTitle"
                                   Text="I'm here to help"
                                   Style="{StaticResource Heading3}"
                                   HorizontalTextAlignment="Center"/>
                            <Border x:Name="FunFactCard"
                                    BackgroundColor="{StaticResource White}"
                                    StrokeThickness="0"
                                    Padding="14,10"
                                    Opacity="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label x:Name="FunFactLabel"
                                       Style="{StaticResource Body2}"
                                       TextColor="{StaticResource BodyText}"
                                       LineBreakMode="WordWrap"/>
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="mobile:ChatTurnItem">
                            <Grid Padding="16,0" HorizontalOptions="{Binding BubbleAlignment}">
                                <!-- Not ElevatedCard: only the caregiver's own bubbles carry its
                                     shadow (BubbleShadow, per item). The bot's replies sit flat
                                     so the conversation reads as one surface rather than a
                                     stack of floating cards. -->
                                <!-- A reply carrying charts runs the full width of the sheet:
                                     a 248px plot inside a 300px bubble was the narrowest thing
                                     on the screen, and it is the one thing here meant to be
                                     read closely. Text-only bubbles keep the 300px measure that
                                     makes a conversation readable. -->
                                <Border BackgroundColor="{Binding BubbleBackground}"
                                        StrokeThickness="0"
                                        Shadow="{Binding BubbleShadow}"
                                        Padding="14,10"
                                        MaximumWidthRequest="{Binding BubbleMaxWidth}"
                                        HorizontalOptions="{Binding BubbleAlignment}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding RoleLabel}"
                                               FontFamily="QuicksandSemiBold"
                                               FontSize="11"
                                               TextColor="{StaticResource BodyText}"
                                               IsVisible="{Binding ShowRoleLabel}"/>
                                        <Label Text="{Binding Content}"
                                               Style="{StaticResource Body2}"
                                               TextColor="{Binding TextColor}"/>
                                        <!-- The supporting charts behind the reply — drawn, not
                                             summarised. ChartSummary below survives only for
                                             series too thin to plot (fewer than two readings).
                                             A carousel rather than a stack, matching the Member
                                             Detail trends: charts swipe continuously (looping
                                             past the last back to the first, like that page's
                                             Key Metric Trends), with dots saying how many there
                                             are. No peek: a sliver of the neighbouring chart
                                             blended into this one's own axis and legend at
                                             bubble width, so the "there are more" affordance is
                                             the pair of arrows flanking the dots — tappable,
                                             and shown only when there is somewhere to go.

                                             One Grid holds both rows deliberately: the arrows'
                                             tap handlers find the carousel by walking up to the
                                             Grid that directly contains it (see
                                             MoveChartCarousel), so they must stay inside it. -->
                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="2"
                                              IsVisible="{Binding HasCharts}">
                                            <!-- Sized to what ChatSeriesChart actually stacks
                                                 (title, the 120px plot with its dates row, the
                                                 legend) — the old 205 bought clearance for
                                                 arrows that floated over the plot, and once
                                                 they moved down beside the dots it was just
                                                 dead space under the legend. -->
                                            <CarouselView ItemsSource="{Binding Charts}"
                                                          HeightRequest="{Binding ChartsHeight}"
                                                          Loop="{Binding ChartsLoop}"
                                                          IsSwipeEnabled="{Binding ChartsLoop}"
                                                          IndicatorView="ChartDots">
                                                <CarouselView.ItemTemplate>
                                                    <DataTemplate x:DataType="controls:ChatChartItem">
                                                        <controls:ChatSeriesChart Item="{Binding .}"
                                                                                  HorizontalOptions="Fill"/>
                                                    </DataTemplate>
                                                </CarouselView.ItemTemplate>
                                            </CarouselView>

                                            <!-- The pager row: arrows either side of the dots,
                                                 not floating over the plot — the line never
                                                 passes under a control, and the three pieces
                                                 read as one pager. Tonal discs like the sheet's
                                                 other quiet controls (the white-with-shadow
                                                 treatment vanished against the white bubble);
                                                 a tap advances the carousel the way a swipe
                                                 would, wrap-around included. -->
                                            <HorizontalStackLayout Grid.Row="1"
                                                                   IsVisible="{Binding ChartsLoop}"
                                                                   Spacing="12"
                                                                   HorizontalOptions="Center">
                                                <Border WidthRequest="32" HeightRequest="32"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{StaticResource SelectedOptionBackground}"
                                                        SemanticProperties.Description="Previous chart">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10"/>
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnChartPrevTapped"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="‹"
                                                           FontFamily="QuicksandSemiBold"
                                                           FontSize="22"
                                                           TextColor="{StaticResource Primary}"
                                                           HorizontalOptions="Center" VerticalOptions="Center"
                                                           Margin="0,0,0,3"/>
                                                </Border>
                                                <IndicatorView x:Name="ChartDots"
                                                               IndicatorSize="6"
                                                               IndicatorColor="{StaticResource MutedText}"
                                                               SelectedIndicatorColor="{StaticResource Primary}"
                                                               VerticalOptions="Center"/>
                                                <Border WidthRequest="32" HeightRequest="32"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{StaticResource SelectedOptionBackground}"
                                                        SemanticProperties.Description="Next chart">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10"/>
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnChartNextTapped"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="›"
                                                           FontFamily="QuicksandSemiBold"
                                                           FontSize="22"
                                                           TextColor="{StaticResource Primary}"
                                                           HorizontalOptions="Center" VerticalOptions="Center"
                                                           Margin="0,0,0,3"/>
                                                </Border>
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <!-- Was 12pt at 0.75 opacity over a white bubble, which
                                             put the only figures some replies carry below what a
                                             caregiver reading at arm's length can make out. Full
                                             opacity, and quieted by the muted colour token that
                                             every other secondary line on this page uses. -->
                                        <Label Text="{Binding ChartSummary}"
                                               Style="{StaticResource Body2}"
                                               FontSize="13"
                                               TextColor="{StaticResource MutedText}"
                                               IsVisible="{Binding HasChartSummary}"/>
                                        <!-- The reply's citation line, split out of the prose so
                                             each authority can be a link to where its guidance is
                                             published (see ChatTurnItem.SplitReference). Quiet
                                             like ChartSummary: the citation supports the answer,
                                             it is not part of it. -->
                                        <Label FormattedText="{Binding ReferenceText}"
                                               Style="{StaticResource Body2}"
                                               FontSize="13"
                                               IsVisible="{Binding HasReference}"/>
                                        <!-- When this was said. Quiet and trailing: a returning
                                             caregiver needs to know whether "steady today" was
                                             this morning, without the time competing with the
                                             answer. -->
                                        <Label Text="{Binding Timestamp}"
                                               FontFamily="Quicksand"
                                               FontSize="10"
                                               TextColor="{Binding TextColor}"
                                               Opacity="0.6"
                                               HorizontalOptions="End"
                                               IsVisible="{Binding HasTimestamp}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- The history list: the caregiver's completed conversations about this member,
                 newest started first — never the one the window is still having. Each row is
                 named by its generated theme, or by its opening question until the theming job
                 has visited it. Shares row 0 with the thread; the code-behind's mode
                 transitions decide which of the two is showing. -->
            <CollectionView x:Name="SessionsList" Grid.Row="0" SelectionMode="None" IsVisible="False">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <BoxView HeightRequest="16" Color="Transparent"/>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20,60,20,20" Spacing="8">
                        <Label Text="No past conversations yet"
                               Style="{StaticResource Heading3}"
                               HorizontalTextAlignment="Center"/>
                        <Label Text="Conversations you finish here are kept, so you can come back to an answer later."
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource BodyText}"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="mobile:ChatSessionItem">
                        <Grid Padding="16,0">
                            <!-- Flat white rows like the bot's bubbles, not ElevatedCard — the
                                 list belongs to the same surface as the conversation it indexes. -->
                            <Border BackgroundColor="{StaticResource White}"
                                    StrokeThickness="0"
                                    Padding="16,12"
                                    SemanticProperties.Description="{Binding Title}"
                                    SemanticProperties.Hint="Double tap to open this conversation">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSessionTapped"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <!-- Selection mode's checkmark: an empty ring until tapped,
                                         a filled tick after. Two stacked Borders rather than one
                                         restyled — the template stays converter-free, and each
                                         state is plainly its own element. -->
                                    <Grid Grid.Column="0" WidthRequest="24"
                                          VerticalOptions="Center"
                                          IsVisible="{Binding IsSelecting}">
                                        <Border WidthRequest="22" HeightRequest="22"
                                                StrokeThickness="1.5"
                                                Stroke="{StaticResource MutedText}"
                                                BackgroundColor="Transparent">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="99"/>
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border"
                                                             Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <Border WidthRequest="22" HeightRequest="22"
                                                StrokeThickness="0"
                                                BackgroundColor="{StaticResource Primary}"
                                                IsVisible="{Binding IsSelected}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="99"/>
                                            </Border.StrokeShape>
                                            <Label Text="✓"
                                                   FontFamily="QuicksandSemiBold"
                                                   FontSize="13"
                                                   TextColor="{StaticResource White}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding Title}"
                                               FontFamily="QuicksandSemiBold"
                                               FontSize="14"
                                               TextColor="{StaticResource HeadingText}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2"/>
                                        <Label Text="{Binding Meta}"
                                               Style="{StaticResource Body2}"
                                               FontSize="12"
                                               TextColor="{StaticResource MutedText}"/>
                                    </VerticalStackLayout>
                                    <Image Grid.Column="2" Source="icon_chevron.svg"
                                           WidthRequest="16" HeightRequest="16"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding ShowChevron}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- The reply-in-progress bubble: the bot mark breathing while the model chain works,
                 beside the step the server reports as each one starts (streamed, see
                 MemberChatStep). Once the route is known, a step bar and "Step n of N" sit under
                 it; once a step has been on screen for a few seconds, lines written for this
                 question rotate beneath the step (see SendAsync). A pinned row below the
                 conversation rather than a CollectionView item, because its text changes as
                 the steps arrive and its animation must run continuously — an immutable ChatTurnItem
                 would have to be swapped out per tick, recreating the bubble and restarting the
                 pulse mid-breath. -->
            <Grid x:Name="PendingPanel" Grid.Row="1" Padding="16,4,16,8" IsVisible="False">
                <!-- Flat like the reply bubble it becomes — see the turn template's remark. -->
                <Border BackgroundColor="{StaticResource White}"
                        StrokeThickness="0"
                        Padding="10,6,14,6"
                        MaximumWidthRequest="300"
                        HorizontalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                        <controls:PendingBotIndicator Grid.RowSpan="3" VerticalOptions="Center"/>
                        <Label x:Name="PendingTextLabel"
                               Grid.Column="1"
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource BodyText}"
                               VerticalOptions="Center"
                               MaximumWidthRequest="210"
                               LineBreakMode="WordWrap"/>
                        <Label x:Name="PendingDetailLabel"
                               Grid.Column="1" Grid.Row="1"
                               Style="{StaticResource Caption}"
                               TextColor="{StaticResource MutedText}"
                               FontAttributes="Italic"
                               MaximumWidthRequest="210"
                               LineBreakMode="WordWrap"
                               IsVisible="False"/>
                        <HorizontalStackLayout x:Name="PendingProgressRow"
                                               Grid.Column="1" Grid.Row="2"
                                               Spacing="8" Margin="0,4,0,2"
                                               IsVisible="False">
                            <!-- One segment per step, filled up to the current one; rebuilt when the
                                 total changes (a second look or a retry adds steps). -->
                            <Grid x:Name="PendingStepBar" WidthRequest="120" HeightRequest="4"
                                  ColumnSpacing="3" VerticalOptions="Center"/>
                            <Label x:Name="PendingStepLabel"
                                   Style="{StaticResource Caption}"
                                   TextColor="{StaticResource MutedText}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </Grid>

            <!-- Question chips, shown until the caregiver's first message of the session: what
                 this assistant can be asked, in its own words, tappable. Deterministic server
                 copy (no model call), so they appear instantly with the sheet. A horizontal
                 scroller rather than a wrap panel — same pill language as the Alerts filter
                 sheet's chips (FilterSheetPage), which this deliberately mirrors rather than
                 shares, since those are built for its four fixed questions. -->
            <!-- Stacked, three at most, every question readable in full: a sideways row showed
                 one and a half of six and hid the rest behind a swipe nobody was told about.
                 The caption names where the questions came from when they are the caregiver's
                 own recent ones (ShowSuggestions). -->
            <VerticalStackLayout x:Name="SuggestionsPanel" Grid.Row="2" Padding="16,4" Spacing="8"
                                 Margin="0,0,0,4" IsVisible="False">
                <Label x:Name="SuggestionsCaption"
                       Text="Recently you asked"
                       Style="{StaticResource Body2}"
                       FontSize="12"
                       TextColor="{StaticResource MutedText}"
                       IsVisible="False"/>
                <VerticalStackLayout x:Name="SuggestionsRow" Spacing="8"/>
            </VerticalStackLayout>

            <!-- Pinned input bar. SendButton is a sibling of the Border, not a child of it —
                 Border clips its content to StrokeShape regardless of how much padding surrounds
                 a child, so a shadow on anything inside it gets cut against the rounded corner no
                 matter the numbers. Both share the one Grid cell: the Border fills the full
                 width so the field runs behind the icon, and the button floats End-aligned on
                 top of it — the Border's right padding (72) reserves the strip under the button
                 so the Editor's text never disappears beneath it. -->
            <Grid x:Name="InputBar" Grid.Row="3" Margin="16,8,16,16">
                <Border Style="{StaticResource AuthEntryBorder}"
                        HeightRequest="-1"
                        MinimumHeightRequest="64"
                        Padding="20,16,72,16">
                    <Editor x:Name="MessageEditor"
                            FontFamily="Quicksand"
                            FontSize="14"
                            PlaceholderColor="{StaticResource BodyText}"
                            TextColor="{StaticResource HeadingText}"
                            BackgroundColor="Transparent"
                            Placeholder="Ask a question…"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="32"
                            MaximumHeightRequest="140"/>
                </Border>

                <!-- The chatbot mark itself, not a generic send arrow — same icon as the
                     Dashboard launcher, so the two read as one feature. OnSendTapped gives it a
                     small bounce so sending reads as sending to something, not just submitting a
                     form field. -->
                <controls:SquareBorder x:Name="SendButton"
                        WidthRequest="48" HeightRequest="48"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource White}"
                        HorizontalOptions="End" VerticalOptions="Center"
                        Margin="0,0,10,0"
                        SemanticProperties.Description="Send message">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.Shadow>
                        <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.3" Radius="8" Offset="0,2"/>
                    </controls:SquareBorder.Shadow>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSendTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image x:Name="SendIcon" Source="icon_chatbot.svg" WidthRequest="30" HeightRequest="30"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </controls:SquareBorder>
            </Grid>

            <!-- Takes the input bar's row while the caregiver is browsing the history list.
                 Two states: browsing offers the way back plus the door into selection mode, and
                 selection mode swaps them for the delete (with its live count) and the way out.
                 The same tonal-pill language as "Start a new conversation" — these are quiet
                 actions, not the sheet's main event. -->
            <Grid x:Name="BackToChatPanel" Grid.Row="3" Margin="16,8,16,16" IsVisible="False">
                <HorizontalStackLayout x:Name="HistoryActions" Spacing="10" HorizontalOptions="Center">
                    <Border Style="{StaticResource ActionPill}"
                            SemanticProperties.Description="Back to conversation"
                            SemanticProperties.Hint="Double tap to return to the live conversation">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackToChatClicked"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="‹"
                                   Style="{StaticResource ActionPillText}"
                                   FontSize="17"
                                   Margin="0,0,0,1"/>
                            <Label Text="Back to conversation" Style="{StaticResource ActionPillText}"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Border x:Name="SelectSessionsAction"
                            Style="{StaticResource ActionPill}"
                            IsVisible="False"
                            SemanticProperties.Description="Select conversations"
                            SemanticProperties.Hint="Double tap to select conversations to delete">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSelectSessionsTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="Select" Style="{StaticResource ActionPillText}"/>
                    </Border>
                </HorizontalStackLayout>

                <HorizontalStackLayout x:Name="SelectionActions" Spacing="10" HorizontalOptions="Center"
                                       IsVisible="False">
                    <!-- Red for what it is: the one permanently destructive act on this sheet.
                         The confirmation popup carries the "can't be undone" warning; this pill
                         carries the count, so the caregiver always deletes a number they've
                         read, never a selection they've lost track of. -->
                    <Border x:Name="DeleteSelectedAction"
                            Style="{StaticResource ActionPill}"
                            BackgroundColor="{StaticResource PillRedBackground}"
                            SemanticProperties.Description="Delete selected conversations"
                            SemanticProperties.Hint="Double tap to permanently delete the selected conversations">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDeleteSelectedTapped"/>
                        </Border.GestureRecognizers>
                        <Label x:Name="DeleteSelectedLabel"
                               Text="Delete"
                               Style="{StaticResource ActionPillText}"
                               TextColor="{StaticResource ErrorRed}"/>
                    </Border>
                    <Border Style="{StaticResource ActionPill}"
                            SemanticProperties.Description="Cancel selection">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelSelectTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="Cancel" Style="{StaticResource ActionPillText}"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- Takes the input bar's row while a past conversation is open. Reading it is
                 free; continuing it is a deliberate act — this button reopens it server-side as
                 the active conversation (ending whatever was), so typing can never silently land
                 in a thread other than the one on screen.

                 Sized to the sheet's own footer pills rather than to a page's primary button:
                 full-bleed at 52dp it read as the point of the screen, when the point is the
                 conversation above it. Hugging its text at pill scale keeps it plainly a
                 control — and still the only one here — without out-shouting what it follows. -->
            <Grid x:Name="ContinuePanel" Grid.Row="3" Margin="16,6,16,14" IsVisible="False">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <controls:AppButton Text="Continue this conversation"
                                        Clicked="OnContinueClicked"
                                        Tone="Secondary"
                                        Size="M"/>
                    <!-- Beside Continue, not instead of it: a conversation worth keeping a copy
                         of is usually one the caregiver is about to take somewhere, and the two
                         are the only things there is to do with a finished thread. The app's one
                         export control, so this reads as the same action the journal offers. -->
                    <controls:ExportAction
                            Text="Export"
                            SemanticProperties.Hint="Saves or shares a copy of this conversation"
                            Tapped="OnExportPastSessionTapped"/>
                </HorizontalStackLayout>
            </Grid>

            <!-- The way to close the current conversation and start clean, one glance below the
                 composer. Was a bare muted text line, which read as a caption and was routinely
                 missed — now a tonal pill: unmistakably a control, with a real 44dp target, but
                 tinted rather than elevated so it still never competes with sending, which is
                 what this row's neighbour is for. -->
            <HorizontalStackLayout Grid.Row="4"
                                   Spacing="10"
                                   HorizontalOptions="Center"
                                   Margin="20,0,20,14">
                <Border x:Name="NewConversationAction"
                        Style="{StaticResource ActionPill}"
                        IsVisible="False"
                        SemanticProperties.Description="Start a new conversation"
                        SemanticProperties.Hint="Double tap to end this conversation and start a fresh one">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNewConversationTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <!-- A plus, not a broom: the action starts something, and the glyph should
                             promise the fresh thread rather than dwell on discarding this one. -->
                        <Label Text="+"
                               Style="{StaticResource ActionPillText}"
                               FontSize="17"
                               Margin="0,0,0,1"/>
                        <Label Text="Start a new conversation" Style="{StaticResource ActionPillText}"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Same row: a caregiver who has just been told something worth taking to an
                     appointment should not have to close the conversation and find it again in
                     history to keep a copy of it. The app's one export control rather than this
                     sheet's tonal pill — the pill language belongs to the sheet's own quiet
                     actions ("Start a new conversation"), and this is the same action the
                     journal offers, so it should look like it. -->
                <controls:ExportAction x:Name="ExportThreadAction"
                        Text="Export"
                        IsVisible="False"
                        SemanticProperties.Hint="Saves or shares a copy of this conversation"
                        Tapped="OnExportThreadTapped"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Last child of the sheet's root grid and spanning both its rows, so the wait while an
             export is prepared covers the whole sheet. See UpdatingOverlay. -->
        <controls:UpdatingOverlay x:Name="Updating" Grid.RowSpan="2"/>
    </Grid>
    </Border>
    </Grid>
</ContentView>

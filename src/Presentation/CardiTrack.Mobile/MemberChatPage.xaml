<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             xmlns:mobile="clr-namespace:CardiTrack.Mobile"
             x:Class="CardiTrack.Mobile.MemberChatPage"
             x:DataType="mobile:MemberChatPage">

    <!-- A caregiver's persisted, multi-turn conversation about one CardiMember's readings.
         No Figma frame — as-built, see the design-sync backlog in
         .claude/skills/product-manager/references/figma.md.

         Presented as a sheet over a dimmed scrim — same pattern as Controls/AppPopupPage
         (transparent ContentPage + a semi-opaque Grid), so the screen underneath (Dashboard or
         Member Detail) stays visible and out of focus rather than being fully replaced. The
         Border below is the sheet: rounded top corners, a top margin that leaves the scrim
         visible above it, and its own tap recognizer to swallow taps so they don't fall through
         to the scrim's dismiss handler. -->

    <Grid x:Name="Scrim" BackgroundColor="#80343434">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScrimTapped"/>
        </Grid.GestureRecognizers>

    <Border BackgroundColor="{StaticResource PageGround}"
            Margin="14,60,14,24"
            StrokeThickness="0"
            VerticalOptions="Fill" HorizontalOptions="Fill">
        <Border.Shadow>
            <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.3" Radius="20" Offset="0,6"/>
        </Border.Shadow>
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="24"/>
        </Border.StrokeShape>
        <Border.GestureRecognizers>
            <TapGestureRecognizer/>
        </Border.GestureRecognizers>

    <Grid RowDefinitions="Auto,*">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,26">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <controls:SquareBorder Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <!-- Down, not back: this page is always presented modally (see
                         MemberChatLauncher), so the affordance is dismiss, not navigate-back.
                         Same 2px-stroke line-icon weight as icon_back_white.svg, not the filled
                         caret (icon_caret_down_white.svg), which reads as a different, heavier
                         icon language next to it. -->
                    <Image Source="icon_chevron_down_white.svg" WidthRequest="20" HeightRequest="20"
                           SemanticProperties.Description="Close"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Chat"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label x:Name="SubtitleLabel"
                           Text="What would you like to know?"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <!-- Rows: conversation, pending reply, suggestion chips, input bar. -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto,Auto">

            <VerticalStackLayout x:Name="SkeletonPanel" Grid.Row="0" Grid.RowSpan="4"
                                  Spacing="14" Padding="20,20" IsVisible="False">
                <controls:SkeletonView HeightRequest="60"/>
                <controls:SkeletonView HeightRequest="60"/>
                <controls:SkeletonView HeightRequest="60"/>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ErrorPanel" Grid.Row="0" Grid.RowSpan="4"
                                  Spacing="12" Padding="20,60,20,20" IsVisible="False">
                <Label Text="We couldn't load this"
                       Style="{StaticResource Heading3}"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="ErrorDetailLabel"
                       Style="{StaticResource Body2}"
                       TextColor="{StaticResource BodyText}"
                       HorizontalTextAlignment="Center"/>
                <Button Text="Try again"
                        Style="{StaticResource SecondaryOutlineButton}"
                        HorizontalOptions="Center"
                        Clicked="OnRetryClicked"/>
            </VerticalStackLayout>

            <RefreshView x:Name="Refresher" Grid.Row="0" Refreshing="OnPullToRefresh" IsVisible="False">
                <CollectionView x:Name="TurnsList"
                                Margin="0,0,0,0"
                                SelectionMode="None"
                                ItemsUpdatingScrollMode="KeepLastItemInView">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <BoxView HeightRequest="16" Color="Transparent"/>
                    </CollectionView.Header>

                    <!-- EmptyView carries the copy only. The suggestion chips live in their own
                         row below (SuggestionsPanel) rather than in here: they have to survive
                         the first send long enough to be tappable while a reply is in flight,
                         and an EmptyView is torn down the instant the first turn lands. -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20,60,20,20" Spacing="8">
                            <Label Text="Ask anything about their readings"
                                   Style="{StaticResource Heading3}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Recent activity, alerts, and how things compare to their usual pattern."
                                   Style="{StaticResource Body2}"
                                   TextColor="{StaticResource BodyText}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="mobile:ChatTurnItem">
                            <Grid Padding="16,0" HorizontalOptions="{Binding BubbleAlignment}">
                                <!-- Not ElevatedCard: only the caregiver's own bubbles carry its
                                     shadow (BubbleShadow, per item). The bot's replies sit flat
                                     so the conversation reads as one surface rather than a
                                     stack of floating cards. -->
                                <!-- A reply carrying charts runs the full width of the sheet:
                                     a 248px plot inside a 300px bubble was the narrowest thing
                                     on the screen, and it is the one thing here meant to be
                                     read closely. Text-only bubbles keep the 300px measure that
                                     makes a conversation readable. -->
                                <Border BackgroundColor="{Binding BubbleBackground}"
                                        StrokeThickness="0"
                                        Shadow="{Binding BubbleShadow}"
                                        Padding="14,10"
                                        MaximumWidthRequest="{Binding BubbleMaxWidth}"
                                        HorizontalOptions="{Binding BubbleAlignment}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding RoleLabel}"
                                               FontFamily="QuicksandSemiBold"
                                               FontSize="11"
                                               TextColor="{StaticResource BodyText}"
                                               IsVisible="{Binding ShowRoleLabel}"/>
                                        <Label Text="{Binding Content}"
                                               Style="{StaticResource Body2}"
                                               TextColor="{Binding TextColor}"/>
                                        <!-- The supporting charts behind the reply — drawn, not
                                             summarised. ChartSummary below survives only for
                                             series too thin to plot (fewer than two readings). -->
                                        <VerticalStackLayout Spacing="10"
                                                             IsVisible="{Binding HasCharts}"
                                                             BindableLayout.ItemsSource="{Binding Charts}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="controls:ChatChartItem">
                                                    <controls:ChatSeriesChart Item="{Binding .}"
                                                                              HorizontalOptions="Fill"/>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                        <Label Text="{Binding ChartSummary}"
                                               Style="{StaticResource Body2}"
                                               FontSize="12"
                                               TextColor="{Binding TextColor}"
                                               Opacity="0.75"
                                               IsVisible="{Binding HasChartSummary}"/>
                                        <!-- When this was said. Quiet and trailing: a returning
                                             caregiver needs to know whether "steady today" was
                                             this morning, without the time competing with the
                                             answer. -->
                                        <Label Text="{Binding Timestamp}"
                                               FontFamily="Quicksand"
                                               FontSize="10"
                                               TextColor="{Binding TextColor}"
                                               Opacity="0.6"
                                               HorizontalOptions="End"
                                               IsVisible="{Binding HasTimestamp}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- The reply-in-progress bubble: the bot mark breathing while the model chain works,
                 beside a line of waiting copy the code-behind cycles (LLM-written for this
                 question, canned if that generation loses its race). A pinned row below the
                 conversation rather than a CollectionView item, because its text changes every
                 few seconds and its animation must run continuously — an immutable ChatTurnItem
                 would have to be swapped out per tick, recreating the bubble and restarting the
                 pulse mid-breath. -->
            <Grid x:Name="PendingPanel" Grid.Row="1" Padding="16,4,16,8" IsVisible="False">
                <!-- Flat like the reply bubble it becomes — see the turn template's remark. -->
                <Border BackgroundColor="{StaticResource White}"
                        StrokeThickness="0"
                        Padding="10,6,14,6"
                        MaximumWidthRequest="300"
                        HorizontalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="6">
                        <controls:PendingBotIndicator VerticalOptions="Center"/>
                        <Label x:Name="PendingTextLabel"
                               Style="{StaticResource Body2}"
                               TextColor="{StaticResource BodyText}"
                               VerticalOptions="Center"
                               MaximumWidthRequest="210"
                               LineBreakMode="WordWrap"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Question chips, shown until the caregiver's first message of the session: what
                 this assistant can be asked, in its own words, tappable. Deterministic server
                 copy (no model call), so they appear instantly with the sheet. A horizontal
                 scroller rather than a wrap panel — same pill language as FilterChipBar, which
                 this deliberately mirrors rather than generalises, since that control is
                 enum-typed to AlertFilter. -->
            <ScrollView x:Name="SuggestionsPanel" Grid.Row="2" Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never" Margin="0,0,0,4" IsVisible="False">
                <HorizontalStackLayout x:Name="SuggestionsRow" Padding="16,4" Spacing="9"/>
            </ScrollView>

            <!-- Pinned input bar. SendButton is a sibling of the Border, not a child of it —
                 Border clips its content to StrokeShape regardless of how much padding surrounds
                 a child, so a shadow on anything inside it gets cut against the rounded corner no
                 matter the numbers. Both share the one Grid cell: the Border fills the full
                 width so the field runs behind the icon, and the button floats End-aligned on
                 top of it — the Border's right padding (72) reserves the strip under the button
                 so the Editor's text never disappears beneath it. -->
            <Grid Grid.Row="3" Margin="16,8,16,16">
                <Border Style="{StaticResource AuthEntryBorder}"
                        HeightRequest="-1"
                        MinimumHeightRequest="64"
                        Padding="20,16,72,16">
                    <Editor x:Name="MessageEditor"
                            FontFamily="Quicksand"
                            FontSize="14"
                            PlaceholderColor="{StaticResource BodyText}"
                            TextColor="{StaticResource HeadingText}"
                            BackgroundColor="Transparent"
                            Placeholder="Ask a question…"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="32"
                            MaximumHeightRequest="140"/>
                </Border>

                <!-- The chatbot mark itself, not a generic send arrow — same icon as the
                     Dashboard launcher, so the two read as one feature. OnSendTapped gives it a
                     small bounce so sending reads as sending to something, not just submitting a
                     form field. -->
                <controls:SquareBorder x:Name="SendButton"
                        WidthRequest="48" HeightRequest="48"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource White}"
                        HorizontalOptions="End" VerticalOptions="Center"
                        Margin="0,0,10,0"
                        SemanticProperties.Description="Send message">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.Shadow>
                        <Shadow Brush="{StaticResource CardShadowBrush}" Opacity="0.3" Radius="8" Offset="0,2"/>
                    </controls:SquareBorder.Shadow>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSendTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image x:Name="SendIcon" Source="icon_chatbot.svg" WidthRequest="30" HeightRequest="30"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </controls:SquareBorder>
            </Grid>
        </Grid>
    </Grid>
    </Border>
    </Grid>
</ContentView>

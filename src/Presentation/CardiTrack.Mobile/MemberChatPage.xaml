<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             xmlns:mobile="clr-namespace:CardiTrack.Mobile"
             x:Class="CardiTrack.Mobile.MemberChatPage"
             x:DataType="mobile:MemberChatPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- A caregiver's persisted, multi-turn conversation about one CardiMember's readings.
         No Figma frame — as-built, see the design-sync backlog in
         .claude/skills/product-manager/references/figma.md.

         Same header/skeleton/error shape as MedicalInformationPage; the body swaps a static
         notes card for a scrolling turn history plus an input bar pinned to the bottom. -->

    <Grid RowDefinitions="Auto,*">

        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,26">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <controls:SquareBorder Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"
                           SemanticProperties.Description="Back"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Chat"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label x:Name="SubtitleLabel"
                           Text="Ask about their readings"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <Grid Grid.Row="1" RowDefinitions="*,Auto">

            <VerticalStackLayout x:Name="SkeletonPanel" Grid.Row="0" Grid.RowSpan="2"
                                  Spacing="14" Padding="20,20" IsVisible="False">
                <controls:SkeletonView HeightRequest="60"/>
                <controls:SkeletonView HeightRequest="60"/>
                <controls:SkeletonView HeightRequest="60"/>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ErrorPanel" Grid.Row="0" Grid.RowSpan="2"
                                  Spacing="12" Padding="20,60,20,20" IsVisible="False">
                <Label Text="We couldn't load this"
                       Style="{StaticResource Heading3}"
                       HorizontalTextAlignment="Center"/>
                <Label x:Name="ErrorDetailLabel"
                       Style="{StaticResource Body2}"
                       TextColor="{StaticResource BodyText}"
                       HorizontalTextAlignment="Center"/>
                <Button Text="Try again"
                        Style="{StaticResource SecondaryOutlineButton}"
                        HorizontalOptions="Center"
                        Clicked="OnRetryClicked"/>
            </VerticalStackLayout>

            <RefreshView x:Name="Refresher" Grid.Row="0" Refreshing="OnPullToRefresh" IsVisible="False">
                <CollectionView x:Name="TurnsList"
                                Margin="0,0,0,0"
                                SelectionMode="None"
                                ItemsUpdatingScrollMode="KeepLastItemInView">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.Header>
                        <BoxView HeightRequest="16" Color="Transparent"/>
                    </CollectionView.Header>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20,60,20,20" Spacing="8">
                            <Label Text="Ask anything about their readings"
                                   Style="{StaticResource Heading3}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Recent activity, alerts, and how things compare to their usual pattern."
                                   Style="{StaticResource Body2}"
                                   TextColor="{StaticResource BodyText}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="mobile:ChatTurnItem">
                            <Grid Padding="16,0" HorizontalOptions="{Binding RowAlignment}">
                                <Border Style="{StaticResource ElevatedCard}"
                                        BackgroundColor="{Binding BubbleBackground}"
                                        Padding="14,10"
                                        MaximumWidthRequest="300"
                                        HorizontalOptions="{Binding RowAlignment}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding RoleLabel}"
                                               FontFamily="QuicksandSemiBold"
                                               FontSize="11"
                                               TextColor="{StaticResource BodyText}"
                                               IsVisible="{Binding ShowRoleLabel}"/>
                                        <Label Text="{Binding Content}"
                                               Style="{StaticResource Body2}"
                                               TextColor="{Binding TextColor}"/>
                                        <Label Text="{Binding ChartSummary}"
                                               Style="{StaticResource Body2}"
                                               FontSize="12"
                                               TextColor="{Binding TextColor}"
                                               Opacity="0.75"
                                               IsVisible="{Binding HasChartSummary}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Pinned input bar. Border rather than raw Grid background so it reads as a
                 distinct surface above the scrolling history, the same visual language
                 AuthEntryBorder gives an Editor elsewhere in the app. -->
            <Border Grid.Row="1"
                    Style="{StaticResource AuthEntryBorder}"
                    Margin="16,8,16,16"
                    Padding="14,4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Editor x:Name="MessageEditor"
                            Grid.Column="0"
                            FontFamily="Quicksand"
                            FontSize="14"
                            PlaceholderColor="{StaticResource BodyText}"
                            TextColor="{StaticResource HeadingText}"
                            BackgroundColor="Transparent"
                            Placeholder="Ask a question…"
                            AutoSize="TextChanges"
                            MaximumHeightRequest="100"/>
                    <controls:SquareBorder x:Name="SendButton"
                            Grid.Column="1"
                            WidthRequest="40" HeightRequest="40"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource HeaderButtonTint}"
                            VerticalOptions="End"
                            SemanticProperties.Description="Send message">
                        <controls:SquareBorder.StrokeShape>
                            <RoundRectangle CornerRadius="99"/>
                        </controls:SquareBorder.StrokeShape>
                        <controls:SquareBorder.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSendTapped"/>
                        </controls:SquareBorder.GestureRecognizers>
                        <Image Source="icon_chevron.svg" WidthRequest="18" HeightRequest="18"
                               Rotation="270" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </controls:SquareBorder>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>

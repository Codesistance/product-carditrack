<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.FamilyPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Back arrow, same treatment as Alerts and Settings — a tab root falls back to the
             dashboard when there is no history of its own to pop. -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,26">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                <Border Grid.Column="0"
                        WidthRequest="40" HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"/>
                </Border>

                <Label Grid.Column="1"
                       Text="Family"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"
                       VerticalTextAlignment="Center"/>
            </Grid>
        </controls:HeaderBand>

        <!-- Placeholder until MVP 2 — same card treatment as the rest of the app. -->
        <Grid Grid.Row="1" Padding="20,20,20,24" VerticalOptions="Start">
            <Border Style="{StaticResource ElevatedCard}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nothing here yet"
                           Style="{StaticResource Body1SemiBoldDark}"/>
                    <Label Text="Family sharing (MVP 2) is coming soon."
                           Style="{StaticResource Body2}"
                           TextColor="{StaticResource BodyText}"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <controls:BottomNavBar Grid.Row="2" Tab="Family"/>
    </Grid>
</ContentPage>

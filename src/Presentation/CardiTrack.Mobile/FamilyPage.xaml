<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.FamilyPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <!-- The Family tab (D-18), in the third slot the original Family stub held before the
         Journal took it. Three states, all drawn from the same content stack rather than from
         three pages: no family, in one, or running one — see FamilyTabState.

         No Figma frame; the design-sync backlog carries it. Full-bleed, as every page is:
         radius sits on the cards, never on the shell. -->

    <!-- Safe area per edge, and on the layout rather than the ContentPage (no effect there on
         Android). Top keeps the status-bar inset the header band is drawn against; bottom
         releases it so BottomNavBar can claim it and run white to the screen edge. -->
    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="None, Container, None, None">

        <!-- The family's name is the switcher (D-19): tapping it opens the drawer, and so does
             re-tapping the tab. The chevron says the name is a control rather than a title. -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,14,20,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource HeaderButtonTint}"
                        VerticalOptions="Fill">
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <controls:SquareBorder.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </controls:SquareBorder.GestureRecognizers>
                    <Image Source="icon_back_white.svg" WidthRequest="20" HeightRequest="20"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           SemanticProperties.Description="Back"/>
                </controls:SquareBorder>

                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6" HorizontalOptions="Start">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSwitchFamilyTapped"/>
                        </Grid.GestureRecognizers>
                        <Label x:Name="FamilyNameLabel"
                               Text="Family"
                               Style="{StaticResource Heading3}"
                               TextColor="{StaticResource White}"
                               LineBreakMode="TailTruncation"/>
                        <Image Grid.Column="1"
                               Source="icon_caret_down_white.svg"
                               WidthRequest="14" HeightRequest="7"
                               VerticalOptions="Center"
                               SemanticProperties.Description="Switch family"/>
                    </Grid>
                    <Label x:Name="HeaderSubtitle"
                           Text="Who else is watching with you"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>
            </Grid>
        </controls:HeaderBand>

        <RefreshView x:Name="Refresher"
                     Grid.Row="1"
                     RefreshColor="{StaticResource Primary}"
                     Refreshing="OnPullToRefresh">
            <ScrollView>
                <Grid Padding="20,16,20,28">

                    <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                        <controls:SkeletonView HeightRequest="96"/>
                        <controls:SkeletonView HeightRequest="140"/>
                        <controls:SkeletonView HeightRequest="80"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ErrorPanel"
                                         Spacing="10"
                                         IsVisible="False"
                                         Padding="0,60,0,0">
                        <Label Text="We couldn't load your family"
                               Style="{StaticResource Heading3}"/>
                        <Label x:Name="ErrorDetailLabel"
                               Style="{StaticResource Body2}"/>
                        <controls:AppButton Text="Try again"
                                            HorizontalOptions="Start"
                                            Clicked="OnRetryClicked"
                                            Tone="Secondary"
                                            Size="L"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ContentPanel" Spacing="14" IsVisible="False">

                        <controls:SavedDataBanner x:Name="SavedBanner"/>

                        <!-- ── No family ────────────────────────────────────────────────────
                             A guest: an ask they are waiting on, or nothing at all. Both ways
                             forward sit here, and the trial sentence (D-12) is said outright
                             rather than discovered on the next screen. -->
                        <VerticalStackLayout x:Name="NoFamilyPanel" Spacing="14" IsVisible="False">

                            <VerticalStackLayout x:Name="PendingAskHost" Spacing="14"/>

                            <Border Style="{StaticResource ElevatedCard}">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="Start your own family"
                                           Style="{StaticResource DashboardSectionTitle}"/>
                                    <Label x:Name="StartFamilyDetailLabel"
                                           Style="{StaticResource Body2}"
                                           LineBreakMode="WordWrap"/>
                                    <controls:AppButton Text="Start a family"
                                                        Clicked="OnStartFamilyClicked"
                                                        Tone="Primary"
                                                        Size="L"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Style="{StaticResource ElevatedCard}">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="Join a family"
                                           Style="{StaticResource DashboardSectionTitle}"/>
                                    <Label Text="Ask whoever set up CardiTrack for their Family ID, or paste the link they sent you. Their admin decides what you can see."
                                           Style="{StaticResource Body2}"
                                           LineBreakMode="WordWrap"/>
                                    <Border Style="{StaticResource AuthEntryBorder}">
                                        <Entry x:Name="JoinEntry"
                                               Style="{StaticResource AuthEntry}"
                                               Placeholder="Family ID, or a link"
                                               ReturnType="Go"
                                               Completed="OnJoinCompleted"
                                               SemanticProperties.Description="Family ID or invitation link"/>
                                    </Border>
                                    <controls:AppButton x:Name="JoinButton"
                                                        Text="Ask to join"
                                                        Clicked="OnJoinClicked"
                                                        Tone="Secondary"
                                                        Size="L"/>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- ── In a family ──────────────────────────────────────────────────
                             Admin and member share this stack; the cards that only an admin
                             may act on hide themselves. -->
                        <VerticalStackLayout x:Name="FamilyPanel" Spacing="14" IsVisible="False">

                            <!-- Who runs it and what the caller can see. For an admin this is
                                 also where the Family ID lives, because it is the thing they
                                 hand to somebody on the phone. -->
                            <!-- Padding off the card and onto its two halves, so the night-cover
                                 row can be a band across the foot rather than another paragraph
                                 inside it — the same shape the alert comparison card uses, and
                                 for the same reason: the lines above are facts about the family,
                                 and this one is a setting the caregiver can act on. -->
                            <Border Style="{StaticResource ElevatedCard}" Padding="0">
                                <VerticalStackLayout Spacing="0">
                                    <VerticalStackLayout Padding="14,14,14,12" Spacing="8">
                                        <Label x:Name="RoleLabel" Style="{StaticResource DashboardSectionTitle}"/>
                                        <Label x:Name="RoleDetailLabel"
                                               Style="{StaticResource Body2}"
                                               LineBreakMode="WordWrap"/>
                                        <Label x:Name="WatchedLabel"
                                               Style="{StaticResource Body2}"
                                               LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>

                                    <!-- What the accept flow wrote (D-8), where a caregiver can
                                         see it without going to Settings — and change it, since
                                         the whole row is the tap target rather than two words at
                                         the end of a sentence. -->
                                    <Border x:Name="NightCoverageRow"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource InputBackground}"
                                            Padding="14,12"
                                            IsVisible="False">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="{StaticResource CardFootCornerRadius}"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnNightCoverageTapped"/>
                                        </Border.GestureRecognizers>
                                        <!-- The label heads the band from its left edge rather
                                             than sitting in the icon's column: it names the whole
                                             row, and indented under the moon it read as a caption
                                             belonging to the sentence beside it. -->
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="At night"
                                                   Style="{StaticResource Caption}"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <!-- Top of the sentence, not its middle: the mark
                                                     belongs to the first line, and centred against
                                                     two lines it floated between them. -->
                                                <Image Grid.Column="0"
                                                       Source="icon_moon.svg"
                                                       WidthRequest="20" HeightRequest="20"
                                                       VerticalOptions="Start"
                                                       Margin="0,1,0,0"
                                                       AutomationProperties.IsInAccessibleTree="False"/>
                                                <Label x:Name="NightCoverageLabel"
                                                       Grid.Column="1"
                                                       Style="{StaticResource Body2Dark}"
                                                       VerticalOptions="Start"
                                                       LineBreakMode="WordWrap"/>
                                                <Label Grid.Column="2"
                                                       Text="Change"
                                                       Style="{StaticResource Link}"
                                                       VerticalOptions="Start"
                                                       VerticalTextAlignment="Start"/>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <Border x:Name="FamilyIdCard" Style="{StaticResource ElevatedCard}" IsVisible="False">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="Your Family ID"
                                           Style="{StaticResource DashboardSectionTitle}"/>
                                    <Label Text="Anybody with this can ask to join. Knowing it is not access — you still decide."
                                           Style="{StaticResource Body2}"
                                           LineBreakMode="WordWrap"/>
                                    <!-- The code in a tinted chip with its Copy inside it, so the
                                         copy reads as belonging to the code; sharing, the way an
                                         admin more often hands it on, gets the card's full width
                                         under it. No Figma frame: picked from samples (F1). -->
                                    <Border BackgroundColor="{StaticResource SelectedOptionBackground}"
                                            StrokeThickness="0"
                                            Padding="12,8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <Label x:Name="FamilyIdLabel"
                                                   Style="{StaticResource Heading2}"
                                                   CharacterSpacing="2"
                                                   TextColor="{StaticResource PrimaryDark}"
                                                   VerticalOptions="Center"
                                                   SemanticProperties.Description="Your Family ID"/>
                                            <controls:AppButton x:Name="CopyFamilyIdButton"
                                                                Grid.Column="1"
                                                                Text="Copy"
                                                                Icon="icon_btn_copy_tint.svg"
                                                                VerticalOptions="Center"
                                                                Clicked="OnCopyFamilyIdClicked"
                                                                Tone="Secondary"
                                                                Size="S"/>
                                        </Grid>
                                    </Border>
                                    <controls:AppButton Text="Share invite"
                                                        Icon="icon_btn_share.svg"
                                                        Clicked="OnShareFamilyIdClicked"
                                                        Tone="Primary"
                                                        Size="M"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Admin only: who is waiting. Above the roster, because it is the
                                 thing on this screen that is waiting on them. -->
                            <VerticalStackLayout x:Name="QueueSection" Spacing="10" IsVisible="False">
                                <Label x:Name="QueueTitleLabel"
                                       Style="{StaticResource DashboardSectionTitle}"
                                       Margin="4,4,4,0"/>
                                <VerticalStackLayout x:Name="QueueHost" Spacing="10"/>
                            </VerticalStackLayout>

                            <Label Text="Everyone in this family"
                                   Style="{StaticResource DashboardSectionTitle}"
                                   Margin="4,4,4,0"/>
                            <VerticalStackLayout x:Name="RosterHost" Spacing="10"/>

                            <!-- The people this family watches — photo, name and when their
                                 device last sent anything — and, for the admin, a card to add
                                 another. Built in code-behind (ApplyWatched). -->
                            <VerticalStackLayout x:Name="WatchedSection" Spacing="10" IsVisible="False">
                                <Label Text="Who we watch"
                                       Style="{StaticResource DashboardSectionTitle}"
                                       Margin="4,4,4,0"/>
                                <VerticalStackLayout x:Name="WatchedHost" Spacing="10"/>
                            </VerticalStackLayout>

                            <controls:AppButton x:Name="LeaveButton"
                                                Text="Leave this family"
                                                Margin="0,6,0,0"
                                                Clicked="OnLeaveClicked"
                                                Tone="Danger"
                                                Size="L"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </RefreshView>

        <controls:BottomNavBar Grid.Row="2" Tab="Family"/>

        <controls:UpdatingOverlay x:Name="Updating" Grid.RowSpan="3"/>
    </Grid>
</ContentPage>

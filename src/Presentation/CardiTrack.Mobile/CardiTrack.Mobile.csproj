<Project Sdk="Microsoft.NET.Sdk">

	<!-- Developer-local config overrides (git-ignored). Must import before the defaults
	     below so values set there win. See Local.props.sample. -->
	<Import Project="Local.props" Condition="Exists('Local.props')" />

	<!-- Backend/auth configuration. CI stamps these via -p:ApiBaseUrl=... etc.; they are
	     compiled into the app as assembly metadata read by AppConfig. -->
	<PropertyGroup>
		<ApiBaseUrl Condition="'$(ApiBaseUrl)' == '' And '$(Configuration)' == 'Debug'">https://api.dev.carditrack.com</ApiBaseUrl>
		<ApiBaseUrl Condition="'$(ApiBaseUrl)' == ''">https://api.carditrack.com</ApiBaseUrl>
		<Auth0Domain Condition="'$(Auth0Domain)' == ''"></Auth0Domain>
		<Auth0ClientId Condition="'$(Auth0ClientId)' == ''"></Auth0ClientId>
		<Auth0Audience Condition="'$(Auth0Audience)' == ''"></Auth0Audience>
		<!-- Mobile monitoring, mirroring the server's Apm contract: ApmEngine names an
		     entry in the app's MobileApm registry; ApmData is that engine's client-side
		     connection JSON (base64 or raw), embed-safe identifiers only. Empty = off. -->
		<ApmEngine Condition="'$(ApmEngine)' == ''"></ApmEngine>
		<ApmData Condition="'$(ApmData)' == ''"></ApmData>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="ApiBaseUrl" Value="$(ApiBaseUrl)" />
		<AssemblyMetadata Include="Auth0Domain" Value="$(Auth0Domain)" />
		<AssemblyMetadata Include="Auth0ClientId" Value="$(Auth0ClientId)" />
		<AssemblyMetadata Include="Auth0Audience" Value="$(Auth0Audience)" />
		<AssemblyMetadata Include="ApmEngine" Value="$(ApmEngine)" />
		<AssemblyMetadata Include="ApmData" Value="$(ApmData)" />
	</ItemGroup>

	<PropertyGroup>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>CardiTrack.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Compile bindings that set Source= (XamlC warning XC0025) -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Display name -->
		<ApplicationTitle>CardiTrack</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.codesistance.carditrack.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
		<!-- Android 31+ (was 23, which the Datadog SDK core and Firebase both still require as a
		     floor). Raised to 31 for the splash: below API 31 the OS draws the supplied bitmap
		     as-is, at 31 and above it goes through the platform SplashScreen API, which sizes and
		     circle-masks it. Supporting both meant no single design could match the OS splash on
		     every device — a circle that matched Android 12+ was a regression on Android 11-, and
		     the rounded tile that matched Android 11- was clipped on 12+. One floor, one
		     rendering, one design to match (see SplashPage.xaml and MainActivity).
		     Set before launch deliberately: there is no installed base to strand today, and
		     raising a floor after release silently strands whoever is already below it. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">31.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- R8 shrinks the Java/Kotlin layer and emits bin/**/mapping.txt, which CI
	     uploads to Play Console so crash stack traces can be deobfuscated. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidLinkTool>r8</AndroidLinkTool>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon. Do not raise ForegroundScale above 0.58: the logo's outermost
		     point (the top-right mesh node) then leaves Android's adaptive-icon safe
		     zone — the centre 66 of 108 dp — and circular launcher masks clip it.
		     0.58 measures ~1.1 dp of clearance at every generated density; 0.60
		     measures ~0 dp, which is already too close to rely on. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#F5F6F8" ForegroundScale="0.58" />

		<!-- Splash Screen. The asset is deliberately the same white rounded tile SplashPage
		     draws (88dp tile, 17dp radius, 79x68 logo AspectFit inside — see SplashPage.xaml)
		     on the same #174E86 that page grounds itself in, so the OS-to-app handover shows
		     the same mark in the same place and reads as one screen rather than two.

		     The tile sits in a transparent canvas 192/88 of its own size, and BaseSize describes
		     that canvas rather than the tile. That padding is what makes the two agree on Android
		     12+, where the platform SplashScreen API draws the icon across a circle-masked 192dp
		     (measured: 575x576 px on a 480dpi device). Handed the bare tile, the platform stretched
		     it over that whole circle — the mark rendered at 192dp with its corners shaved off, then
		     halved to SplashPage's 88dp rounded tile the instant the app took over. Padded, the
		     tile lands at 88.0dp with its 17dp corners intact and the mask clips only empty space,
		     so the OS frame and the loading screen's first frame are the same picture.

		     The gradient SplashPage fades in afterwards is deliberately not represented here and
		     cannot be: Android 12+ takes windowSplashScreenBackground as a colour, not a drawable.
		     It fades in over the top after the handover, which is the point at which the loading
		     screen starts being itself rather than continuing the splash. -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#174E86" BaseSize="192,192" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiImage Update="Resources\Images\carditrack_logo.png" BaseSize="88,78" />
		<!-- No Resize/BaseSize override: these are now plain, un-composited photos (see
		     WelcomePage's OnHeroSizeChanged) at their own native aspect ratio, rendered with
		     Aspect="AspectFill" — forcing them through the 440x571 resize bucket risked
		     distorting a source that's no longer authored to that exact aspect. -->
		<MauiImage Update="Resources\Images\welcome_hero_a.png" />
		<MauiImage Update="Resources\Images\welcome_hero_b.png" />
		<MauiImage Update="Resources\Images\welcome_hero_c.png" />
		<MauiImage Update="Resources\Images\device_fitbit.png" Resize="True" BaseSize="85,96" />
		<MauiImage Update="Resources\Images\device_garmin.png" Resize="True" BaseSize="96,96" />
		<MauiImage Update="Resources\Images\device_apple_watch.png" Resize="True" BaseSize="85,96" />
		<MauiImage Update="Resources\Images\device_samsung.png" Resize="True" BaseSize="85,96" />
		<MauiImage Update="Resources\Images\device_withings.png" Resize="True" BaseSize="96,96" />
		<MauiImage Update="Resources\Images\device_other.png" Resize="True" BaseSize="85,96" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<!-- Log/trace monitoring wraps the native Android/iOS SDKs — no Windows support -->
		<PackageReference Include="Datadog.Maui" Version="0.2.0" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
		<!-- FCM HTTP v1, both platforms (notification_engine.md §2) — no Windows support; push
		     registration/handlers are no-ops on that target (see PushRegistrationService.cs). -->
		<PackageReference Include="Plugin.Firebase.CloudMessaging" Version="4.0.1" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
	</ItemGroup>

	<!-- Firebase project configuration, paired with the Plugin.Firebase.CloudMessaging reference
	     above. Both files are committed next to the platform they configure, but neither is picked
	     up by a default glob: MAUI auto-includes Platforms\iOS\Resources\**, and this plist sits
	     above that folder, while google-services.json has no default build action at all. Without
	     these two items the SDK still links and ships — every Firebase framework is in the bundle —
	     but it has no project to talk to, so FirebaseApp silently fails to initialise and every
	     GetTokenAsync() throws "Default FirebaseApp is not initialized". That is not a build error;
	     it surfaces only at runtime as push never arriving, which is exactly how it went unnoticed
	     (verified 2026-08-13 against the shipped 0.2.163 APK and IPA — both carried the frameworks
	     and neither carried the config).

	     Neither file is a secret: google-services.json and GoogleService-Info.plist hold client
	     identifiers that ship inside every copy of the app. FCM send authority lives server-side
	     with the Cloud Run service account (see PushServiceExtensions), never here. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<GoogleServicesJson Include="Platforms\Android\google-services.json" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<BundleResource Include="Platforms\iOS\GoogleService-Info.plist" LogicalName="GoogleService-Info.plist" />
		<!-- APNs custom sound: must sit in the main bundle under this exact filename. The FCM
		     payload's aps.sound names NotificationChannels.AlertSoundFile. Remove the SDK's
		     implicit include first so we don't embed the same file twice. -->
		<BundleResource Remove="Platforms\iOS\Resources\carditrack_alert.wav" />
		<BundleResource Include="Platforms\iOS\Resources\carditrack_alert.wav" LogicalName="carditrack_alert.wav" />
		<BundleResource Remove="Platforms\iOS\Resources\carditrack_nudge.wav" />
		<BundleResource Include="Platforms\iOS\Resources\carditrack_nudge.wav" LogicalName="carditrack_nudge.wav" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Core\CardiTrack.Application\CardiTrack.Application.csproj" />
	  <ProjectReference Include="..\CardiTrack.Mobile.Core\CardiTrack.Mobile.Core.csproj" />
	</ItemGroup>

</Project>

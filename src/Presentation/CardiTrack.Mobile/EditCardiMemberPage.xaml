<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CardiTrack.Mobile.Controls"
             x:Class="CardiTrack.Mobile.EditCardiMemberPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageGround}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- The app-wide gradient band (Controls/HeaderBand). -->
        <controls:HeaderBand Grid.Row="0" ContentPadding="20,16,20,26">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <controls:SquareBorder x:Name="HeaderIcon"
                        Grid.Column="0"
                        MinimumHeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="#33FFFFFF"
                        VerticalOptions="Fill">
                    <!-- Fill + width-bound-to-height: the circle runs from the title's top to
                         the description's bottom and stays square at whatever that is, so every
                         header's icon matches its own text block exactly. The 40 floor keeps the
                         back button a real tap target; 99 clamps to a circle at any size. -->
                    <controls:SquareBorder.StrokeShape>
                        <RoundRectangle CornerRadius="99"/>
                    </controls:SquareBorder.StrokeShape>
                    <ImageButton Source="icon_back_white.svg"
                                 WidthRequest="20" HeightRequest="20"
                                 BackgroundColor="Transparent"
                                 Clicked="OnCancelClicked"/>
                </controls:SquareBorder>

                <!-- Title with what the page is tight beneath it — one stack, top-aligned
                     with the icon. The description is declared after the title, so screen
                     readers announce them in reading order. -->
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Start">
                    <Label Text="Edit Profile"
                       Style="{StaticResource Heading3}"
                       TextColor="{StaticResource White}"/>
                    <Label Text="Who they are and how to reach them"
                           FontFamily="Quicksand"
                           FontSize="12"
                           TextColor="{StaticResource White}"
                           Opacity="0.85"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Text="Save"
                        FontFamily="QuicksandSemiBold"
                        FontSize="15"
                        TextColor="{StaticResource Primary}"
                        BackgroundColor="{StaticResource White}"
                        CornerRadius="18"
                        HeightRequest="36"
                        Padding="18,0"
                        VerticalOptions="Center"
                        Clicked="OnSaveClicked"/>
            </Grid>
        </controls:HeaderBand>

        <ScrollView x:Name="FormScroller" Grid.Row="1">
            <Grid Padding="20,18,20,28">

                <VerticalStackLayout x:Name="SkeletonPanel" Spacing="14" IsVisible="False">
                    <controls:SkeletonView HeightRequest="80"/>
                    <controls:SkeletonView HeightRequest="80"/>
                    <controls:SkeletonView HeightRequest="140"/>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ErrorPanel"
                                     Spacing="10"
                                     IsVisible="False"
                                     Padding="0,60,0,0">
                    <Label Text="We couldn't load this profile"
                           Style="{StaticResource Heading3}"
                           HorizontalTextAlignment="Center"/>
                    <Label x:Name="ErrorDetailLabel"
                           Style="{StaticResource Body2}"
                           HorizontalTextAlignment="Center"/>
                    <Button Text="Try again"
                            Style="{StaticResource SecondaryOutlineButton}"
                            HorizontalOptions="Center"
                            Clicked="OnRetryClicked"/>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="FormPanel" Spacing="14" IsVisible="False">

                    <!-- Avatar. "Change Photo" is deliberately absent: there is no photo
                         upload path yet, so the button would do nothing. -->
                    <Border WidthRequest="88" HeightRequest="88"
                            StrokeThickness="0"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="44"/>
                        </Border.StrokeShape>
                        <Border.Background>
                            <StaticResource Key="GradientButtonBrush"/>
                        </Border.Background>
                        <Label x:Name="InitialsLabel"
                               FontFamily="QuicksandSemiBold"
                               FontSize="32"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Full Name*" Style="{StaticResource AuthFieldLabel}"/>
                        <Border Style="{StaticResource AuthEntryBorder}">
                            <Entry x:Name="NameEntry"
                                   Style="{StaticResource AuthEntry}"
                                   Placeholder="Full name"
                                   TextChanged="OnNameChanged"/>
                        </Border>
                        <Label x:Name="NameError"
                               Style="{StaticResource AuthErrorLabel}"
                               IsVisible="False"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Date of Birth*" Style="{StaticResource AuthFieldLabel}"/>
                        <Border Style="{StaticResource AuthEntryBorder}">
                            <DatePicker x:Name="DobPicker"
                                        Format="d MMM yyyy"
                                        FontFamily="Quicksand"
                                        FontSize="14"
                                        TextColor="{StaticResource HeadingText}"
                                        BackgroundColor="Transparent"
                                        />
                        </Border>
                        <Label x:Name="DobError"
                               Style="{StaticResource AuthErrorLabel}"
                               IsVisible="False"/>
                    </VerticalStackLayout>

                    <!-- Sex. Left unselected for a member recorded before the add form asked,
                         so the empty picker reads as the open question it is. -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sex" Style="{StaticResource AuthFieldLabel}"/>
                        <Border Style="{StaticResource AuthEntryBorder}">
                            <Picker x:Name="SexPicker"
                                    Title="Not recorded"
                                    FontFamily="Quicksand"
                                    FontSize="14"
                                    TextColor="{StaticResource HeadingText}"
                                    BackgroundColor="Transparent"
                                    SemanticProperties.Hint="Used to read heart rate and sleep against the right range"
                                    />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Relationship" Style="{StaticResource AuthFieldLabel}"/>
                        <Border Style="{StaticResource AuthEntryBorder}">
                            <Picker x:Name="RelationshipPicker"
                                    FontFamily="Quicksand"
                                    FontSize="14"
                                    TextColor="{StaticResource HeadingText}"
                                    BackgroundColor="Transparent"
                                    />
                        </Border>
                    </VerticalStackLayout>

                    <BoxView Style="{StaticResource DividerLine}" Margin="0,6"/>

                    <Label Text="Medical &amp; Emergency" Style="{StaticResource DashboardSectionTitle}"/>

                    <VerticalStackLayout x:Name="MedicalNotesFieldSection" Spacing="4">
                        <Label Text="Medical Notes" Style="{StaticResource AuthFieldLabel}"/>
                        <Border Style="{StaticResource AuthEntryBorder}" HeightRequest="120" Padding="16,8">
                            <Editor x:Name="MedicalNotesEditor"
                                    Placeholder="Allergies, chronic conditions, etc."
                                    FontFamily="Quicksand"
                                    FontSize="14"
                                    PlaceholderColor="{StaticResource BodyText}"
                                    TextColor="{StaticResource HeadingText}"
                                    BackgroundColor="Transparent"
                                    AutoSize="Disabled"
                                    MaxLength="2000"
                                    />
                        </Border>
                        <Label x:Name="MedicalNotesError"
                               Style="{StaticResource AuthErrorLabel}"
                               IsVisible="False"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Emergency Contact Name" Style="{StaticResource AuthFieldLabel}"/>
                        <Border Style="{StaticResource AuthEntryBorder}">
                            <Entry x:Name="EmergencyNameEntry"
                                   Style="{StaticResource AuthEntry}"
                                   Placeholder="Who should we call?"
                                   />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="EmergencyPhoneFieldSection" Spacing="4">
                        <Label Text="Emergency Contact Number" Style="{StaticResource AuthFieldLabel}"/>
                        <Border Style="{StaticResource AuthEntryBorder}">
                            <Entry x:Name="EmergencyPhoneEntry"
                                   Style="{StaticResource AuthEntry}"
                                   Keyboard="Telephone"
                                   />
                        </Border>
                        <Label x:Name="EmergencyPhoneError"
                               Style="{StaticResource AuthErrorLabel}"
                               IsVisible="False"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="PhoneFieldSection" Spacing="4">
                        <Label Text="Phone Number" Style="{StaticResource AuthFieldLabel}"/>
                        <Border Style="{StaticResource AuthEntryBorder}">
                            <Entry x:Name="PhoneEntry"
                                   Style="{StaticResource AuthEntry}"
                                   Keyboard="Telephone"
                                   />
                        </Border>
                        <Label x:Name="PhoneError"
                               Style="{StaticResource AuthErrorLabel}"
                               IsVisible="False"/>
                    </VerticalStackLayout>

                    <Label Text="Monitoring Preferences" Style="{StaticResource DashboardSectionTitle}"/>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Alert Sensitivity" Style="{StaticResource AuthFieldLabel}"/>
                        <Border Style="{StaticResource AuthEntryBorder}">
                            <Picker x:Name="SensitivityPicker"
                                    FontFamily="Quicksand"
                                    FontSize="14"
                                    TextColor="{StaticResource HeadingText}"
                                    BackgroundColor="Transparent"
                                    />
                        </Border>
                        <Label Text="Saved with them. Alerting itself isn't live yet, so this won't change what you're notified about today."
                               Style="{StaticResource Body2}"
                               FontSize="12"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- M1-13/M1-14/M1-15 all show the bottom nav in Figma, and these pages sit on
             top of the Dashboard tab. Tapping Home here pops back down to it. -->
        <controls:BottomNavBar Grid.Row="2" Tab="Dashboard"/>
    </Grid>
</ContentPage>

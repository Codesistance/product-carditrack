<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>CardiTrack.HealthWebhookReceiver</RootNamespace>
    <!-- Overridden by the release pipeline via -p:Version=<semver>; see CardiTrack.API.csproj. -->
    <Version>0.0.0-local</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.PubSub.V1" Version="3.24.0" />

    <!-- Logging — same shape as the other hosts -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
  </ItemGroup>

  <!-- Deliberately NO reference to Application or Infrastructure: this is the platform's only
       public-ingress pipeline surface, and it holds no database access, no AI configuration and
       no business logic to leak. It authenticates, acknowledges, and forwards — nothing else. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Infrastructure\CardiTrack.Observability\CardiTrack.Observability.csproj" />
    <ProjectReference Include="..\..\Infrastructure\CardiTrack.Shared\CardiTrack.Shared.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Diagnostic tool, deliberately NOT in CardiTrack.sln and not built by CI:
    it is run by hand against a live Google Health API account.
    See tools/HealthApiProbe/README.md for how to run it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CardiTrack.Tools.HealthApiProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced so the probe exercises the real GoogleHealthApiClient, not a copy of it. -->
    <ProjectReference Include="..\..\src\Infrastructure\CardiTrack.Infrastructure\CardiTrack.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The console provider, so GoogleHealthApiClient's warning/debug shape-mismatch logs are
         actually visible in this tool's output rather than going to a logger with no sink. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline labelling instrument, deliberately NOT in CardiTrack.sln and not built by CI —
    the same convention tools/AiSplitEvaluator follows. Unlike that tool this one needs no
    database, no model endpoint and no network: it shuffles a fixture into blind labelling
    sheets and scores the sheets people hand back. See tools/ChatRoutingEval/README.md.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CardiTrack.Tools.ChatRoutingEval</RootNamespace>
    <AssemblyName>CardiTrack.Tools.ChatRoutingEval</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced so the labelling vocabulary comes from ChatWorkflowCatalogue itself rather
         than a hand-copied list. A new catalogue entry with no row in Vocabulary.Ids then fails
         the next command with a named error rather than going out on a sheet unnamed. That check
         is a runtime one — the compiler cannot see a missing dictionary row, so this build stays
         green and the tool refuses to run. -->
    <ProjectReference Include="..\..\src\Core\CardiTrack.Application\CardiTrack.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="cases.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>

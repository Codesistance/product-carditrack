         test project to reach into the Worker for one. -->
    <ProjectReference Include="..\..\src\Worker\CardiTrack.Worker\CardiTrack.Worker.csproj" />
    <ProjectReference Include="..\..\src\Presentation\CardiTrack.Web\CardiTrack.Web.csproj" />
